

-- 1. 建立暫存表
IF OBJECT_ID('tempdb..#TrxnAcctFinalMapping') IS NOT NULL
    DROP TABLE #TrxnAcctFinalMapping;

CREATE TABLE #TrxnAcctFinalMapping
(
    SourceAcctKey NVARCHAR(100),
    FinalAcctKey  NVARCHAR(100)
);

-- 2. 產製 #TrxnAcctFinalMapping (代入 @AcctMappingTable='XREF', @Prefix='SK_' 等)
WITH MappedAccounts AS (
    SELECT
        A.ACCT_KEY AS SourceAcctKey,
        -- 若 XREF 有對應則取 INTN_REF_NO，無對應則自動補 'SK_' + A.ACCT_KEY
        COALESCE(M.[INTN_REF_NO], 'SK_' + A.ACCT_KEY) AS FinalAcctKey,
        ROW_NUMBER() OVER (PARTITION BY A.ACCT_KEY ORDER BY (SELECT 1)) AS rn
    FROM dbo.LoadTrxn_Migrate_buffer A
    LEFT JOIN [XREF] M
        ON M.[EXTN_REF_NO] = (
            CASE 
                WHEN LEN(A.ACCT_KEY) < 25 
                THEN RIGHT(REPLICATE('0', 25) + A.ACCT_KEY, 25) 
                ELSE A.ACCT_KEY 
            END
        )
)
INSERT INTO #TrxnAcctFinalMapping (SourceAcctKey, FinalAcctKey)
SELECT
    SourceAcctKey,
    FinalAcctKey
FROM MappedAccounts
WHERE rn = 1 
  AND ISNULL(SourceAcctKey, '') <> '';

CREATE CLUSTERED INDEX IX_SourceAcctKey ON #TrxnAcctFinalMapping(SourceAcctKey);


-- 3. 原本的寫入語法 (帶入參數後)
DECLARE @StartTime DATETIME = GETDATE();
DECLARE @InsertedCount INT = 0;

-- 執行寫入
INSERT INTO dbo.TTL_MTHLY_ACCT_SMRY
(
    CIF_KEY, APPL, ACCT_KEY, YYYYMM, TTL, CRTTL, DRTTL,
    CNT, CRCNT, DRCNT, MIN, MAX, CRMIN, DRMIN, CRMAX, DRMAX
)
SELECT  
    B.NEW_CIF_KEY,
    A.APPL,
    ISNULL(C.FinalAcctKey, 'SK_' + A.ACCT_KEY),
    A.YYYYMM,
    A.TTL, A.CRTTL, A.DRTTL, A.CNT, A.CRCNT, A.DRCNT,
    A.MIN, A.MAX, A.CRMIN, A.DRMIN, A.CRMAX, A.DRMAX
FROM dbo.LoadTrxn_Migrate_buffer A
LEFT JOIN #TrxnAcctFinalMapping C 
    ON A.ACCT_KEY = C.SourceAcctKey
INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
    ON A.CIF_KEY = B.SOURCE_CIF_KEY
WHERE A.TrxnType = 'TTL MTHLY SMRY'
  AND NOT EXISTS (
      SELECT 1
      FROM dbo.TTL_MTHLY_ACCT_SMRY Z
      WHERE Z.CIF_KEY = B.NEW_CIF_KEY
        AND Z.YYYYMM = A.YYYYMM 
        AND Z.ACCT_KEY = C.FinalAcctKey
  );

-- 取得寫入筆數
SET @InsertedCount = @@ROWCOUNT;

-- 記錄執行時間與筆數到 Log
INSERT INTO dbo.Migrator_LOG (PROC_DATE, MSG_LOG, FLAG)
SELECT 
    CONVERT(VARCHAR, dbo.ConvertToBankLocalTime(GETUTCDATE()), 109),
    'TTL MTHLY SMRY inserted ' + CAST(@InsertedCount AS VARCHAR(10)) 
    + ' rows. Duration: ' + CAST(DATEDIFF(SECOND, @StartTime, GETDATE()) AS VARCHAR(10)) + 's',
    'N';
