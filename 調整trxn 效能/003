WHERE A.TrxnType = 'TTL MTHLY SMRY'
  AND NOT EXISTS (
      SELECT 1
      FROM dbo.TTL_MTHLY_ACCT_SMRY Z
      WHERE Z.YYYYMM = A.YYYYMM
        AND Z.CIF_KEY = B.NEW_CIF_KEY
        AND Z.APPL = A.APPL
        AND (
            (C.FinalAcctKey IS NOT NULL AND Z.ACCT_KEY = C.FinalAcctKey)
            OR (C.FinalAcctKey IS NULL AND Z.ACCT_KEY = 'SK_' + A.ACCT_KEY)
        )
  )
