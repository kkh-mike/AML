-- 作者 : [請填入你的名字 / Mike]
-- 應用系統名稱 : AML / CFT
-- Server名稱 : AMLDB1
-- DataBase名稱 : BSADBTW
-- 提案單號 : [請填入]
-- =============================================
-- 查詢名稱 : 高風險個人客戶詳細資料查詢 (Risk Score 70-99)
-- 建立/整理日期 : 2026-07-03
-- 說明 : 
--   本查詢用於提取「高風險個人客戶」的完整風險相關資料，
--   包含客戶基本資訊、風險等級與分數、PEP身分各類標記、
--   SAR通報紀錄、職業/職稱/行業別、是否久未往來等，
--   主要供 AML 定期審核、風險監控報表、高風險客戶覆核使用。
-- 使用時機 :
--   - 每季/定期高風險客戶清單產出
--   - 提供給 RM (Relationship Manager) 進行客戶審核
--   - 風險評估或內部調查報表
-- 注意事項 :
--   1. 已使用 WITH (NOLOCK) 提升查詢效能，但請留意高並行環境下的資料一致性風險
--   2. CUSTOMERNO、QUEUENAME 等識別欄位已加 '_' 前綴遮罩，保護客戶隱私（適合匯出給業務單位）
--   3. 篩選條件：個人客戶 (CUST_TYPE_CDE='P') + 有效客戶 (RECORDSTATUS='O') + 風險分數 70~99
--   4. 「是否久未往來」目前以 D.CUSTOMERLEVEL = '2' 判斷，請確認此邏輯是否仍符合業務定義（原註解曾提及超過12個月未往來）
--   5. SAR 日期取自 BatchJobDB..SARFiledList 的最早通報日期
-- =============================================

USE BSADBTW;
GO

SELECT 
    -- ==================== 客戶基本資訊 ====================
    B.CUST_TYPE_CDE AS '客戶類型',
    B.CUSTOMER_SEGMENT,
    '_' + D.CUSTOMERNO AS 'CUSTOMERNO',
    '_' + ISNULL(A.QUEUENAME, '') AS 'RM_工作群組',
    B.CUST_NME AS '姓名1',
    B.NATIVE_CUST_NME AS '姓名2',
    '_' + B.BRNCH_NBR AS '所屬分行',
    CONVERT(CHAR(8), E.ReviewDt, 112) AS '下次審核日期',
    
    -- ==================== 風險等級與分數 ====================
    D.HIGHRISK AS '風險等級',
    D.RISKSCORE AS '風險分數',
    
    -- ==================== PEP / 制裁 / 負面新聞 ====================
    F.PEP AS 'PEP',
    F.ForeignPEP AS 'ForeignPEP',
    F.LocalPEP AS 'LocalPEP',
    F.ForeignOrgPEP AS 'ForeignOrgPEP',
    F.ExPEP AS 'ExPEP',
    F.CustRPIsPEP AS 'RCA',
    F.BlackList AS 'BlackList',
    F.NN AS 'NegativeNews',
    
    -- ==================== 開戶與國籍 ====================
    CONVERT(CHAR(8), B.OPEN_DTE, 112) AS '開戶日期',
    ISNULL(B.NATIONALITY_1, '') AS 'NATIONALITY',
    
    -- ==================== 職業 / 職稱 / 任職機構 ====================
    CASE 
        WHEN B.CUST_TYPE_CDE = 'P' THEN D.OCCUP + '_' + RTRIM(G.OCCUPDESC) 
        ELSE '' 
    END AS 'OCCUP',
    CASE 
        WHEN B.CUST_TYPE_CDE = 'P' AND H.JobTitle_Code IS NOT NULL 
        THEN H.JobTitle_Code + '_' + RTRIM(H.JobTitle_Desc) 
        ELSE '' 
    END AS '職稱',
    ISNULL(D.SERVING_ENTITY, '') AS '任職機構',
    
    -- ==================== 行業別 ====================
    ISNULL(D.NAICS_CDE, '') + '_' + RTRIM(I.Description) AS '行業別',
    
    -- ==================== 公司客戶特有欄位 (本查詢限個人客戶，欄位保留供參考) ====================
    CASE 
        WHEN B.CUST_TYPE_CDE = 'N' THEN ISNULL(D.Main_Business_Country, '') 
        ELSE '' 
    END AS '主要營業國家',
    CASE 
        WHEN B.CUST_TYPE_CDE = 'N' AND ISNULL(F.IsBearerShares, '') = 1 THEN 'Y'
        WHEN B.CUST_TYPE_CDE = 'N' AND ISNULL(F.IsBearerShares, '') = 0 THEN 'N'
        ELSE '' 
    END AS '無記名股票',
    CASE 
        WHEN B.CUST_TYPE_CDE = 'N' AND ISNULL(D.IsComplexStructure, '') = 1 THEN 'Y'
        WHEN B.CUST_TYPE_CDE = 'N' AND ISNULL(D.IsComplexStructure, '') = 0 THEN 'N'
        ELSE '' 
    END AS '股權複雜度',
    
    -- ==================== 久未往來 / SAR 通報 ====================
    CASE 
        WHEN D.CUSTOMERLEVEL = '2' THEN 'Y' 
        ELSE 'N' 
    END AS '是否久未往來(超過12個月)',
    CASE 
        WHEN ISNULL(D.IsSARFiled, '') = 1 THEN 'Y'
        WHEN ISNULL(D.IsSARFiled, '') = 0 THEN 'N'
        ELSE '' 
    END AS '是否通報SAR',
    CASE 
        WHEN ISNULL(D.IsSARFiled, '') = 1 AND K.SARFiled_Date IS NOT NULL 
            THEN CONVERT(CHAR(8), K.SARFiled_Date, 112)
        WHEN ISNULL(D.IsSARFiled, '') = 1 AND K.SARFiled_Date IS NULL 
            THEN CONVERT(CHAR(8), D.IsSARFiled_LastUpdatedDate, 112)
        ELSE '' 
    END AS 'FileSAR日期',
    
    -- ==================== 其他狀態 ====================
    B.RECORDSTATUS AS '客戶狀態',
    CASE 
        WHEN ISNULL(D.OBUFlag, '') <> 'Y' THEN 'N' 
        ELSE D.OBUFlag 
    END AS 'OBUFlag',
    D.IsBelievedSuspicious AS '是否為高風險客戶',
    D.IsBelievedSuspiciousRemark AS '高風險客戶備註'

FROM BSADBTW..PB_CUSTOMER_FACT B WITH (NOLOCK)

    -- RM 工作群組 (只取未結案的 HRS 案件)
    LEFT JOIN (
        SELECT A.BATCHID, A.CIF_KEY, A.STATUS, B.QUEUENAME
        FROM BSADBTW..HRS_CUST_RISK_MGMT A WITH (NOLOCK)
        JOIN BSADBTW..WORKFLOW_MGMT_QUEUE B WITH (NOLOCK) 
            ON A.QUEUEID = B.QUEUEID
        WHERE STATUS <> '3' 
          AND SRC = 'HRS'
    ) A ON B.CIF_KEY = A.CIF_KEY

    -- 風險事實表 (核心風險資料)
    INNER JOIN BSADBTW..BSA_SUB_CUST_FACT D WITH (NOLOCK) 
        ON B.CIF_KEY = D.CIF_KEY

    -- 下次審核日期 (取最近一筆 Pending 狀態的 EDD Review)
    LEFT JOIN (
        SELECT DISTINCT C.CIFKEY, C.ReviewDt
        FROM BSADBTW..EDD_ReviewSchedule C WITH (NOLOCK)
        JOIN (
            SELECT CIFKEY, MIN(ReviewDt) AS ReviewDt
            FROM BSADBTW..EDD_ReviewSchedule WITH (NOLOCK)
            WHERE STATUS = 'P'
            GROUP BY CIFKEY
        ) C2 ON C.CIFKey = C2.CIFKey 
             AND C.ReviewDt = C2.ReviewDt
    ) E ON B.CIF_KEY = E.CIFKEY

    -- PEP / BlackList / Negative News 擴充欄位 (使用 Bitwise 解碼)
    LEFT JOIN (
        SELECT CIF_KEY, 
               IsBearerShares,
               CASE WHEN PEPBitwiseCode & 1 = 1 THEN 'Y' ELSE 'N' END AS BlackList,
               CASE WHEN PEPBitwiseCode & 2 = 2 THEN 'Y' ELSE 'N' END AS PEP,
               CASE WHEN PEPBitwiseCode & 8 = 8 THEN 'Y' ELSE 'N' END AS ForeignPEP,
               CASE WHEN PEPBitwiseCode & 16 = 16 THEN 'Y' ELSE 'N' END AS LocalPEP,
               CASE WHEN PEPBitwiseCode & 32 = 32 THEN 'Y' ELSE 'N' END AS ForeignOrgPEP,
               CASE WHEN PEPBitwiseCode & 64 = 64 THEN 'Y' ELSE 'N' END AS ExPEP,
               CASE WHEN PEPBitwiseCode & 128 = 128 THEN 'Y' ELSE 'N' END AS CustRPIsPEP,
               CASE WHEN PEPBitwiseCode & 4 = 4 THEN 'Y' ELSE 'N' END AS NN
        FROM BSADBTW..BSA_SUB_CUST_FACT_Extension
    ) F ON B.CIF_KEY = F.CIF_KEY

    -- 職業描述
    LEFT JOIN BSADBTW..OCCUPATION_DIM G ON D.OCCUP = G.OCCUPCD

    -- 職稱描述
    LEFT JOIN BSADBTW..JobTitle_DIM H ON D.JobTitle = H.ID

    -- 行業別描述 (NAICS)
    LEFT JOIN BSADBTW..FINCEN_NAICS_DIM I ON B.NAICS_CDE = I.NAICS_Code

    -- SAR 通報日期 (取最早一筆)
    LEFT JOIN (
        SELECT CustomerNo, MIN(SARFiled_Date) AS SARFiled_Date
        FROM BatchJobDB..SARFiledList
        GROUP BY CustomerNo
    ) K ON D.IDNUM = K.CUSTOMERNO

WHERE B.RECORDSTATUS = 'O'
  AND B.CUST_TYPE_CDE = 'P'
  AND D.RISKSCORE < 100
  AND D.RISKSCORE > 69
;
