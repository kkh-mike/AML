SELECT 
    B.CUST_TYPE_CDE     AS '客戶類型',       -- P:個人, C:法人...等
    B.CUSTOMER_SEGMENT  AS '客戶群體',       -- 客戶所屬的客群分類
    B.CUST_NME          AS '姓名1',          -- 客戶中文姓名/主要名稱
    B.NATIVE_CUST_NME   AS '姓名2',          -- 客戶英文姓名/原生名稱
    B.RecordStatus      AS '客戶狀態',       -- 客戶目前的帳戶/往來狀態
    B.REM_CDE           AS 'AO_CODE',        -- 客戶經理 (AO) 代號
    B.REM_NME           AS 'AO_NAME',        -- 客戶經理 (AO) 姓名

     ISNULL(B.NATIONALITY_1, '') AS 'NATIONALITY 客戶國籍', -- 客戶國籍
            '_' + B.BRNCH_NBR   AS '所屬分行',       -- 客戶開戶分行代號 (來自 B 表)
    CONVERT(CHAR(8), B.OPEN_DTE, 112) AS '開戶日期'     -- 客戶最初開戶日 (來自 B 表)
FROM PB_CUSTOMER_FACT  B
WHERE CIF_KEY in (
'AF6C54C0-181D-F111-AE3C-0050568A471B',
'B66F54C0-181D-F111-AE3C-0050568A471B',
'5A7054C0-181D-F111-AE3C-0050568A471B'
)








DECLARE @CheckID TABLE (CustomerNo VARCHAR(50));
INSERT INTO @CheckID VALUES ('681474'), ('682380'), ('682572');

SELECT 
    J.CustomerNo AS 欲查詢編號,
    CASE WHEN B.CIF_KEY IS NOT NULL THEN 'Y' ELSE 'N (主表無資料!)' END AS [PB_CUSTOMER_FACT存在狀態],
    CASE WHEN D.CIF_KEY IS NOT NULL THEN 'Y' ELSE 'N (BSA副表無資料!)' END AS [BSA_SUB_CUST_FACT存在狀態],
    B.CUST_TYPE_CDE AS 客戶類型,
    B.RecordStatus AS 客戶狀態,
    D.CoreSystem AS 系統來源
FROM @CheckID J
LEFT JOIN BSADBHK..BSA_SUB_CUST_FACT D ON J.CustomerNo = D.CustomerNo
LEFT JOIN BSADBHK..PB_CUSTOMER_FACT B ON D.CIF_KEY = B.CIF_KEY;





