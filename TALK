--預估 RM 起案數量

USE BSADBTW

SELECT CONVERT(varchar(6), DATEADD(MM,-2,B.ReviewDt),112) CaseDate
      ,a.HIGHRISK
      ,'_'+D.BRNCH_NBR BRNCH_NBR
      ,COUNT(*) CNT
FROM   BSADBTW..BSA_SUB_CUST_FACT A WITH (NOLOCK)
       JOIN BSADBTW..PB_CUSTOMER_FACT D WITH (NOLOCK) on a.CIF_KEY = d.CIF_KEY
       JOIN BSADBTW..EDD_ReviewSchedule B WITH (NOLOCK) on A.CIF_KEY = B.CIFKey and B.status = 'P' --and B.ReviewDt between '2022-09-01 00:00:00.000' and '2023-08-31 23:59:59.999'
       LEFT JOIN (SELECT A.BATCHID, A.CIF_KEY, A.STATUS
                  FROM   BSADBTW..HRS_CUST_RISK_MGMT A WITH (NOLOCK)
                  WHERE  A.STATUS <> '3'
                  ) C ON A.CIF_KEY = C.CIF_KEY
WHERE  C.CIF_KEY is null and D.RecordStatus = 'O' and D.Customer_Segment <> 'NCR'
GROUP BY CONVERT(varchar(6), DATEADD(MM,-2,B.ReviewDt),112), a.HIGHRISK, D.BRNCH_NBR
ORDER BY CaseDate, D.BRNCH_NBR



