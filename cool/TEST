                                BEGIN
                                        INSERT INTO @Temp_HRS_CustData_Buffer (BatchId, CIFKey, TemplateId, Answer1)
                                                SELECT BatchId, CIFKey, 11, CASE WHEN IsSupplier = 'Y' THEN 'TRUE' ELSE 'FALSE' END
                                                        FROM dbo.HRS_Customer_Fact WITH (NOLOCK)
                                                        WHERE ISNULL(IsSupplier, '') <> '' AND BatchId = @BatchId AND CIFKey = @CIFKey;
                                        IF @@ERROR != 0
                                        BEGIN
                                                SET @Error = 'HRST0011'
                                                SET @Status = 'F'  
                                                GOTO FINALLY
                                        END 
                                END
                
                                /*HRST0012    The account holder is foreign entity : {Parameter1}*/
                                IF EXISTS(SELECT 1 FROM dbo.HRS_ScenarioTemplates A WITH (NOLOCK) 
