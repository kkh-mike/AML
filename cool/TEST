# ==========================================
# 0. 透過安控 DLL 動態取得帳密與伺服器資訊
# ==========================================
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (!(Test-Path $dllPath)) {
    Write-Host "找不到安控組件：$dllPath" -ForegroundColor Red
    exit 1
}

Add-Type -Path $dllPath
$App = New-Object Tsbldapdbc.RunBat
$App.SSL = $false
$App.ldapHost = "10.13.60.66"
$App.searchBase = "o=tsbank"
$sApp = "AML"
$iCStr = 1
$ret2 = $App.GetRunBat($sApp, $iCStr)

Write-Host "取得安控資訊: $ret2"

if ($ret2 -like "Error:*" -or [string]::IsNullOrWhiteSpace($ret2)) {
    Write-Error "取得連線字串失敗: $ret2"
    exit 1
}

# 解析連線字串各欄位 (忽略大小寫)
$Server   = if ($ret2 -match "(?i)server=([^;]+)") { $matches[1] } else { "" }
$User     = if ($ret2 -match "(?i)user\s*id=([^;]+)") { $matches[1] } else { "" }
$Password = if ($ret2 -match "(?i)password=([^;]+)") { $matches[1] } else { "" }
$Database = "SARCaseWarehouse"  # 指定目標 Database

Write-Host "========================================="
Write-Host "Server   : $Server"
Write-Host "User     : $User"
Write-Host "Database : $Database"
Write-Host "========================================="

# ==========================================
# 1. 檢查來源 SQL
# ==========================================
$SourceFile   = Join-Path -Path $PSScriptRoot -ChildPath "SAR_Trxn_Detail_All.sql"
$OutputFolder = Join-Path -Path $PSScriptRoot -ChildPath "Split"
$LogFolder    = Join-Path -Path $PSScriptRoot -ChildPath "Log"

if (!(Test-Path $SourceFile)) {
    Write-Host "找不到 $SourceFile" -ForegroundColor Red
    exit 1
}

# ==========================================
# 2. 建立資料夾
# ==========================================
if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}

# ==========================================
# 3. 清除舊的分割 SQL / Log
# ==========================================
Write-Host "清除舊檔案..."
Remove-Item "$OutputFolder\SAR_Trxn_Detail_T1200017*.sql" -Force -ErrorAction SilentlyContinue
Remove-Item "$LogFolder\SAR_Trxn_Detail_T1200017*.log" -Force -ErrorAction SilentlyContinue

# ==========================================
# 4. 讀取原始 SQL
# ==========================================
Write-Host "讀取 $SourceFile ..."
$Content = Get-Content $SourceFile -Raw -Encoding UTF8

# ==========================================
# 5. 依 GO 分割
# ==========================================
$Batches = [regex]::Split(
    $Content,
    '(?im)^\s*GO\s*;?\s*$'
)

# ==========================================
# 6. 移除空白 Batch
# ==========================================
$Batches = $Batches | Where-Object { ![string]::IsNullOrWhiteSpace($_) }
Write-Host ""
Write-Host "共找到 $($Batches.Count) 個 SQL Batch"
Write-Host ""

# ==========================================
# 7. 產生分割 SQL
# ==========================================
$Index = 1
foreach ($Batch in $Batches) {
    $OutputFile = Join-Path $OutputFolder "SAR_Trxn_Detail_T1200017$Index.sql"
    $SqlContent = $Batch.Trim() + "`r`nGO`r`n"
    Set-Content -Path $OutputFile -Value $SqlContent -Encoding UTF8
    Write-Host "產生：$OutputFile"
    $Index++
}

# ==========================================
# 8. 開始執行 SQL (使用 sqlcmd 帶入解析出的變數)
# ==========================================
Write-Host ""
Write-Host "========================================="
Write-Host "開始執行 SQL"
Write-Host "========================================="
Write-Host ""

$Total   = $Batches.Count
$Success = 0
$Failed  = 0

for ($i = 1; $i -le $Total; $i++) {
    $SqlFile = Join-Path $OutputFolder "SAR_Trxn_Detail_T1200017$i.sql"
    $LogFile = Join-Path $LogFolder "SAR_Trxn_Detail_T1200017$i.log"
    
    Write-Host "-----------------------------------------"
    Write-Host "執行 [$i / $Total]"
    Write-Host "$SqlFile"
    Write-Host "-----------------------------------------"
    
    sqlcmd `
        -S $Server `
        -U $User `
        -P $Password `
        -d $Database `
        -i $SqlFile `
        -o $LogFile
        
    $ExitCode = $LASTEXITCODE
    if ($ExitCode -eq 0) {
        Write-Host "SUCCESS：第 $i 份執行成功" -ForegroundColor Green
        $Success++
    }
    else {
        Write-Host "FAILED：第 $i 份執行失敗" -ForegroundColor Red
        Write-Host "請檢查：$LogFile" -ForegroundColor Yellow
        $Failed++
        Write-Host ""
        Write-Host "SQL 執行失敗，停止後續執行。" -ForegroundColor Red
        break
    }
}

# ==========================================
# 9. 執行結果
# ==========================================
Write-Host ""
Write-Host "========================================="
Write-Host "執行完成"
Write-Host "========================================="
Write-Host "總 Batch：$Total"
Write-Host "成功：$Success"
Write-Host "失敗：$Failed"

if ($Failed -eq 0) {
    Write-Host ""
    Write-Host "全部 SQL 執行成功！" -ForegroundColor Green
}
else {
    Write-Host ""
    Write-Host "有 SQL 執行失敗，請檢查 Log。" -ForegroundColor Red
}
Write-Host ""
Read-Host "按 Enter 結束"

