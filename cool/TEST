# ==========================================
# 自動抓取 LDAP 連線資訊 + 目錄下所有 SQL 分割執行
# ==========================================

# 1. 載入 LDAP DLL 並取得連線字串
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (-not (Test-Path -Path $dllPath)) {
    Write-Error "找不到 DLL 檔案: $dllPath"
    exit 1
}

if (-not ([System.Management.Automation.PSTypeName]'Tsbldapdbc.RunBat').Type) {
    Add-Type -Path $dllPath
}

$App = New-Object Tsbldapdbc.RunBat
$App.SSL = $false
$App.ldapHost = "10.13.60.66"
$App.searchBase = "o=tsbank"
$sApp = "AML"
$iCStr = 7

$connStr = $App.GetRunBat($sApp, $iCStr)
Write-Host "取得連線字串: $connStr" -ForegroundColor Cyan

# 2. 自動解析連線字串參數 (Regex 穩定提取)
$Server   = if ($connStr -match '(?:Data Source|Server)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Database = if ($connStr -match '(?:Initial Catalog|Database)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$User     = if ($connStr -match '(?:User ID|UID)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Password = if ($connStr -match '(?:Password|PWD)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }

Write-Host "解析連線資訊 -> Server: $Server | DB: $Database | User: $User" -ForegroundColor DarkCyan

if ([string]::IsNullOrWhiteSpace($Server) -or [string]::IsNullOrWhiteSpace($Database)) {
    Write-Error "無法正確解析 Server 或 Database 連線資訊！"
    Read-Host "按 Enter 結束"
    exit 1
}

# ==========================================
# 3. 資料夾準備
# ==========================================
$OutputFolder = Join-Path -Path $PSScriptRoot -ChildPath "Split"
$LogFolder    = Join-Path -Path $PSScriptRoot -ChildPath "Log"

if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}

# 清除舊的分割 SQL 與 Log
Write-Host "清除舊的 Split 與 Log 檔案..."
Remove-Item "$OutputFolder\*.sql" -Force -ErrorAction SilentlyContinue
Remove-Item "$LogFolder\*.log" -Force -ErrorAction SilentlyContinue

# ==========================================
# 4. 搜尋當前目錄下所有的 .sql 檔案（排除 Split 目錄）
# ==========================================
$SqlFiles = Get-ChildItem -Path $PSScriptRoot -Filter "*.sql" -File | 
            Where-Object { $_.DirectoryName -ne $OutputFolder }

if ($SqlFiles.Count -eq 0) {
    Write-Host "目前目錄找不到任何 .sql 檔案！" -ForegroundColor Yellow
    Read-Host "按 Enter 結束"
    exit 0
}

Write-Host "找到 $($SqlFiles.Count) 個 SQL 主檔案待處理。" -ForegroundColor Green

# ==========================================
# 5. 逐一處理每個 SQL 檔案
# ==========================================
$HasError = $false

foreach ($file in $SqlFiles) {
    $BaseName = $file.BaseName
    Write-Host ""
    Write-Host "=========================================" -ForegroundColor Yellow
    Write-Host "開始處理檔案: $($file.Name)" -ForegroundColor Yellow
    Write-Host "=========================================" -ForegroundColor Yellow

    # 讀取並依 GO 分割
    $Content = Get-Content $file.FullName -Raw
    $Batches = [regex]::Split($Content, '(?im)^\s*GO\s*;?\s*$') | 
               Where-Object { ![string]::IsNullOrWhiteSpace($_) }

    Write-Host "共切割為 $($Batches.Count) 個 Batch"

    # 產出分割檔
    $BatchFiles = @()
    $Index = 1
    foreach ($Batch in $Batches) {
        $OutputFile = Join-Path $OutputFolder "$($BaseName)_$Index.sql"
        $SqlContent = $Batch.Trim() + "`r`nGO`r`n"
        Set-Content -Path $OutputFile -Value $SqlContent -Encoding UTF8
        $BatchFiles += $OutputFile
        $Index++
    }

    # 依序執行分割後的 SQL
    $CurrentIndex = 1
    foreach ($SqlFile in $BatchFiles) {
        $LogFile = Join-Path $LogFolder "$($BaseName)_$CurrentIndex.log"

        Write-Host "-----------------------------------------"
        Write-Host "執行 [$CurrentIndex / $($Batches.Count)] -> $(Split-Path $SqlFile -Leaf)"
        
        # 呼叫 sqlcmd 執行
        sqlcmd `
            -S $Server `
            -U $User `
            -P $Password `
            -d $Database `
            -i $SqlFile `
            -o $LogFile

        $ExitCode = $LASTEXITCODE
        if ($ExitCode -eq 0) {
            Write-Host "SUCCESS：第 $CurrentIndex 份執行成功" -ForegroundColor Green
        } else {
            Write-Host "FAILED：第 $CurrentIndex 份執行失敗！" -ForegroundColor Red
            Write-Host "請檢查 Log：$LogFile" -ForegroundColor Yellow
            $HasError = $true
            break
        }
        $CurrentIndex++
    }

    if ($HasError) {
        Write-Host ""
        Write-Host "檔案 [$($file.Name)] 執行發生錯誤，中斷後續所有作業。" -ForegroundColor Red
        break
    }
}

# ==========================================
# 6. 最終結果
# ==========================================
Write-Host ""
Write-Host "========================================="
if (-not $HasError) {
    Write-Host "全部 SQL 檔案與 Batch 皆已成功執行完成！" -ForegroundColor Green
} else {
    Write-Host "作業未完全執行，請檢查 Log。" -ForegroundColor Red
}
Write-Host "========================================="
Write-Host ""
Read-Host "按 Enter 結束"
