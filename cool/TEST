		SET @ROLE_COLUMN = 'ROLE_DESC'
	END
	
	SELECT @OriginalCulture = Culture FROM GCMAINDB.dbo.BankDBProfile WHERE BNK_NBR = @BNK_NBR
	
	SELECT @WORD_YOUR = dbo.GetResourceString('word_your')
	
	/*Fall back to english if no data in dim*/
	IF @WORD_YOUR IS NULL SET @WORD_YOUR = 'your';
	
	/* TABLE DECLARATION */
	CREATE Table #CASEDETECTOR_EMAILCASE 
