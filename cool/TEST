# ==========================================
# 自動抓取 LDAP 連線資訊 + 指定清單 SQL 分割執行
# ==========================================

# 1. 資料夾準備與全域 Log 初始化
$OutputFolder = Join-Path -Path $PSScriptRoot -ChildPath "Split"
$LogFolder    = Join-Path -Path $PSScriptRoot -ChildPath "Log"

if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}

$Timestamp    = Get-Date -Format "yyyyMMdd_HHmmss"
$MainLogFile  = Join-Path -Path $LogFolder -ChildPath "Execution_$Timestamp.log"

# 定義雙向輸出函式 (螢幕 + 主 Log 檔)
function Write-Log {
    param (
        [string]$Message,
        [ConsoleColor]$ForegroundColor = [ConsoleColor]::White,
        [switch]$IsError
    )
    $timePrefix = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $formattedMsg = "[$timePrefix] $Message"
    
    # 寫入螢幕
    Write-Host $Message -ForegroundColor $ForegroundColor
    # 寫入檔案
    Add-Content -Path $MainLogFile -Value $formattedMsg -Encoding UTF8
}

Write-Log "=== 開始執行指定 SQL 批次處理作業 ===" -ForegroundColor Cyan
Write-Log "主執行紀錄檔: $MainLogFile" -ForegroundColor DarkGray

# 清除舊的分割 SQL 檔案
Write-Log "清除舊的 Split 檔案..."
Remove-Item "$OutputFolder\*.sql" -Force -ErrorAction SilentlyContinue

# ==========================================
# 2. 載入 LDAP DLL 並取得連線字串
# ==========================================
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (-not (Test-Path -Path $dllPath)) {
    Write-Log "錯誤：找不到 DLL 檔案: $dllPath" -ForegroundColor Red -IsError
    exit 1
}

try {
    if (-not ([System.Management.Automation.PSTypeName]'Tsbldapdbc.RunBat').Type) {
        Add-Type -Path $dllPath
    }

    $App = New-Object Tsbldapdbc.RunBat
    $App.SSL = $false
    $App.ldapHost = "10.13.60.66"
    $App.searchBase = "o=tsbank"
    $sApp = "AML"
    $iCStr = 7

    $connStr = $App.GetRunBat($sApp, $iCStr)
    # Write-Log "成功取得 LDAP 連線字串: $connStr" -ForegroundColor Cyan
}
catch {
    Write-Log "錯誤：讀取 LDAP 連線資訊時發生例外: $($_.Exception.Message)" -ForegroundColor Red -IsError
    exit 1
}

# 3. 自動解析連線字串參數 (Regex 穩定提取)
$Server   = if ($connStr -match '(?:Data Source|Server)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Database = if ($connStr -match '(?:Initial Catalog|Database)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$User     = if ($connStr -match '(?:User ID|UID)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Password = if ($connStr -match '(?:Password|PWD)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }

Write-Log "解析連線資訊 -> Server: $Server | DB: $Database | User: $User" -ForegroundColor DarkCyan

if ([string]::IsNullOrWhiteSpace($Server) -or [string]::IsNullOrWhiteSpace($Database)) {
    Write-Log "錯誤：無法正確解析 Server 或 Database 連線資訊！" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 4. 定義欲指定的 SQL 檔案清單並驗證存在性
# ==========================================
$TargetFileList = @(
    "BRANCH_SK.sql",
    "BatchControl.sql",
    "SAR_Acct_Info.sql",
    "SAR_Case_Main.sql",
    "SAR_Case_Trxn_Branch.sql",
    "SAR_Case_Trxn_Date_Range.sql",
    "SAR_Conductor_Info.sql",
    "SAR_Matched_Scenarios.sql",
    "SAR_Suspect_Info.sql",
    "SAR_Trxn_Detail_T1200017.sql",
    "SAR_Trxn_Detail_T1200162.sql",
    "SAR_Trxn_Summary.sql",
    "SK_SAR_SuspiciousActivityCharacteristicsDim.Table.sql"
)

$SqlFiles = @()

foreach ($rawName in $TargetFileList) {
    # 去除多餘空白或分號
    $cleanName = $rawName.Trim().TrimEnd(';')
    $fullPath  = Join-Path -Path $PSScriptRoot -ChildPath $cleanName

    if (Test-Path -Path $fullPath) {
        $SqlFiles += Get-Item -Path $fullPath
    } else {
        Write-Log "警告：指定檔案不存在，已略過 -> $cleanName" -ForegroundColor Yellow
    }
}

if ($SqlFiles.Count -eq 0) {
    Write-Log "錯誤：找不到任何有效的指定 SQL 檔案，結束作業。" -ForegroundColor Red -IsError
    exit 1
}

Write-Log "共確認 $($SqlFiles.Count) 個指定 SQL 檔案待處理。" -ForegroundColor Green

# ==========================================
# 5. 逐一處理每個 SQL 檔案
# ==========================================
$HasError = $false

foreach ($file in $SqlFiles) {
    $BaseName = $file.BaseName
    Write-Log ""
    Write-Log "=========================================" -ForegroundColor Yellow
    Write-Log "開始處理檔案: $($file.Name)" -ForegroundColor Yellow
    Write-Log "=========================================" -ForegroundColor Yellow

    # 讀取並依 GO 分割
    $Content = Get-Content $file.FullName -Raw
    $Batches = [regex]::Split($Content, '(?im)^\s*GO\s*;?\s*$') | 
               Where-Object { ![string]::IsNullOrWhiteSpace($_) }

    Write-Log "共切割為 $($Batches.Count) 個 Batch"

    # 產出分割檔
    $BatchFiles = @()
    $Index = 1
    foreach ($Batch in $Batches) {
        $OutputFile = Join-Path $OutputFolder "$($BaseName)_$Index.sql"
        $SqlContent = $Batch.Trim() + "`r`nGO`r`n"
        Set-Content -Path $OutputFile -Value $SqlContent -Encoding UTF8
        $BatchFiles += $OutputFile
        $Index++
    }

    # 依序執行分割後的 SQL
    $CurrentIndex = 1
    foreach ($SqlFile in $BatchFiles) {
        $BatchLogFile = Join-Path $LogFolder "$($BaseName)_$CurrentIndex.log"

        Write-Log "-----------------------------------------"
        Write-Log "執行 [$CurrentIndex / $($Batches.Count)] -> $(Split-Path $SqlFile -Leaf)"
        
        # 呼叫 sqlcmd 執行 (-b 代表發生 SQL Error 時中斷並回傳非 0 ExitCode)
        sqlcmd `
            -b `
            -S $Server `
            -U $User `
            -P $Password `
            -d $Database `
            -i $SqlFile `
            -o $BatchLogFile

        $ExitCode = $LASTEXITCODE
        if ($ExitCode -eq 0) {
            Write-Log "SUCCESS：第 $CurrentIndex 份執行成功" -ForegroundColor Green
        } else {
            Write-Log "FAILED：第 $CurrentIndex 份執行失敗！" -ForegroundColor Red
            Write-Log "請檢查 Batch Log：$BatchLogFile" -ForegroundColor Yellow
            $HasError = $true
            break
        }
        $CurrentIndex++
    }

    if ($HasError) {
        Write-Log "檔案 [$($file.Name)] 執行發生錯誤，中斷後續所有作業。" -ForegroundColor Red
        break
    }
}

# ==========================================
# 6. 最終結果與 Exit Code 回傳
# ==========================================
Write-Log ""
Write-Log "========================================="
if (-not $HasError) {
    Write-Log "全部指定 SQL 檔案與 Batch 皆已成功執行完成！" -ForegroundColor Green
    Write-Log "========================================="
    exit 0
} else {
    Write-Log "作業未完全執行，發生錯誤！" -ForegroundColor Red
    Write-Log "========================================="
    exit 1
}


