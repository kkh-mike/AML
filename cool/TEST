                                                SET @Error = 'HRST0039'
                                                SET @Status = 'F'  
                                                GOTO FINALLY
                                        END
                                END
                
                                /*HRST0040    The account holder does not supply his/her DOB. {Parameter1}*/
                                IF EXISTS(SELECT 1 FROM dbo.HRS_ScenarioTemplates A WITH (NOLOCK) 
