CREATE PROCEDURE [dbo].[HRS_PersistQuestionaireDataToPB]
	@BatchId BIGINT,
	@CifKey UNIQUEIDENTIFIER,
	@UserId NVARCHAR(40)
AS
BEGIN
	SET NOCOUNT ON;
	/*
		This SP is used to override HRS questionaire data into PB level tables
		Data that will be override includes:
			1. Customer level's info (including MSB related info)
			2. Customer Accounts info, including
				a. account purpose
				b. account opening method
				c. product and services
				d. anticipated activities info
			3. Legal Agents
			4. Board of directors
			5. Main Clients
			6. Main shared holders
			7. Appointers
			7. Additional questions' answer(questions are from CIP)
			8. Other Related Party
	*/

	DECLARE @Today_UTC DATETIME = GETUTCDATE();
	DECLARE @Today_Local DATETIME = dbo.ConvertToBankLocalTime(@Today_UTC);
	DECLARE @HRSRISKRANKING CHAR(1);
	DECLARE @HRSCORE DECIMAL(7,2);
	
	SELECT @HRSRISKRANKING = HRSRISKRANKING, @HRSCORE = HRScore 
	FROM dbo.HRS_CUST_RISK_MGMT WITH (NOLOCK)
	WHERE CIF_KEY = @CifKey AND BatchId = @BatchId
	
	/*begin override customer level info*/
	;WITH SourceData AS (
		SELECT [A].[CifKey], [OccupationCode], 
			[IdentificationMethodCode], [IdentificationNo],
			[IdentificationIssuedByCountry], [IdentificationIssueByState],
			[BusinessOwnershipCode], [BusinessEstablishedYearCode],
			[BusinessLegalId],
			[IsHighRisk], [HighRiskReason],
			[IsPEP], [IsBlackList],
			[HasNegativeNews], [NegativeNewsDescription],
			[TransmitFundsAsAgent], [LocatedAtNevada],
			[TransmitFundsOverOwnNetwork], [CashChecksOrExchangeCurrency],
			[SellsOrRedeemsCash],
			[IsSARFiled], 
			[IsSARFiled_LastUpdatedDate],
			[IsSARFiled_LastUpdatedDate_UTC],
			[IsHoldMailAccount],
			[IsDepositNetAsset],
			[BankDealingPeriodCode], 
			[IdentificationOther],
			[IsMultipleAcctName], 
			[IsComplexStructure],
			[IsOtherPersonHandleBusiness], 
			[IslkNegNewsRelatedParties], 
			[IslkAcctPositionListedCompany], 
			[IslkCustSpecLocation], 
			[lkCustWealthCtry],
			[PlaceOfBirth],
			CASE [B].[TrusteeFlag] WHEN 1 THEN 'Y' WHEN 0 THEN 'N' END TrusteeFlag,
			CASE B.[WarnRestrictAccount] WHEN 1 THEN 'Y' WHEN 0 THEN 'N' END WarnRestrictAccount,
			B.JobTitle,
			CASE B.OBUFlag WHEN 1 THEN 'Y' WHEN 0 THEN 'N' END OBUFlag
		FROM [dbo].[HRS_Customer_Fact] A WITH (NOLOCK)
		LEFT JOIN dbo.HRS_Customer_Fact_Extension B WITH(NOLOCK) ON A.CifKey = B.CifKey AND A.BatchId = B.BatchId
		WHERE A.[BatchId] = @BatchId AND 
			A.[CifKey] = @CifKey
	)
	MERGE [dbo].[BSA_SUB_CUST_FACT] AS MergeTarget
	USING [SourceData] AS MergeSource
	ON [MergeSource].[CifKey] = [MergeTarget].[CIF_KEY]
	WHEN MATCHED THEN 
		UPDATE SET [MergeTarget].[OCCUP] = [MergeSource].[OccupationCode],
			[MergeTarget].[IDENT] = [MergeSource].[IdentificationMethodCode],
			[MergeTarget].[IDNUM] = [MergeSource].[IdentificationNo],
			[MergeTarget].[IDENTO] = [MergeSource].[IdentificationOther],
			[MergeTarget].[ISSBY] = [MergeSource].[IdentificationIssuedByCountry],
			[MergeTarget].[ISSBY_STATE] = [MergeSource].[IdentificationIssueByState],
			[MergeTarget].[BizOwnershipCode] = [MergeSource].[BusinessOwnershipCode],
			[MergeTarget].[BIZ_ESTABLISH_YR] = [MergeSource].[BusinessEstablishedYearCode],
			[MergeTarget].[Legal_ID] = [MergeSource].[BusinessLegalId],
			[MergeTarget].[IsBelievedSuspicious] = [MergeSource].[IsHighRisk],
			[MergeTarget].[IsBelievedSuspiciousRemark] = [MergeSource].[HighRiskReason],
