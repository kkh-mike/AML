			[MergeTarget].[IsCashRedeemer] = [MergeSource].[SellsOrRedeemsCash],
			[MergeTarget].[IsSARFiled] = [MergeSource].[IsSARFiled],
			[MergeTarget].[IsSARFiled_LastUpdatedDate] = [MergeSource].[IsSARFiled_LastUpdatedDate],
			[MergeTarget].[IsSARFiled_LastUpdatedDate_UTC] = [MergeSource].[IsSARFiled_LastUpdatedDate_UTC],
			[MergeTarget].[HoldMailAcct] = [MergeSource].[IsHoldMailAccount],
			[MergeTarget].[DepositNetAsset] = [MergeSource].[IsDepositNetAsset],
			[MergeTarget].[BankDealingPeriodCode] = [MergeSource].[BankDealingPeriodCode],
			[MergeTarget].[IsMultipleAcctName] = [MergeSource].[IsMultipleAcctName],
			[MergeTarget].[IsComplexStructure] = [MergeSource].[IsComplexStructure],
			[MergeTarget].[IsOtherPersonHandleBusiness] = [MergeSource].[IsOtherPersonHandleBusiness],
			[MergeTarget].[IslkNegNewsRelatedParties] = [MergeSource].[IslkNegNewsRelatedParties],
			[MergeTarget].[IslkAcctPositionListedCompany] = [MergeSource].[IslkAcctPositionListedCompany],
			[MergeTarget].[IslkCustSpecLocation] = [MergeSource].[IslkCustSpecLocation],
			[MergeTarget].[lkCustWealthCtry] = [MergeSource].[lkCustWealthCtry],
			[MergeTarget].[Place_Of_Birth] = [MergeSource].[PlaceOfBirth],
