CREATE PROCEDURE [dbo].[HRS_GetQuestionaireCustomerAccountDetails]
	@BatchId BIGINT,
	@CifKey UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	
	/*account level info*/
	SELECT A.[Id], A.[BatchId], A.[CifKey], A.[AccountKey], A.[APPL], 
		A.[OpeningMethodCode], A.[LastUpdatedBy], A.[LastUpdatedDate],
		B.[ASTATCD] AS 'AccountStatus', B.[MULTI_CCY_ACCNO] AS 'MultiCurrencyAccountNo',
		B.[ADTOPN] AS 'OpeningDate', A.BRNCH_NBR AS 'BranchNo',
		CASE WHEN A.[LastUpdatedDate] IS NULL THEN 'N' ELSE 'Y' END AS IsReview
	FROM [dbo].[HRS_CustomerAccounts_Fact] A
	LEFT JOIN [dbo].[ACCT_XREF_DIM] B
	ON A.[CifKey] = B.[CIF_KEY] AND
		A.[AccountKey] = B.[ACCT_KEY] AND
		A.[APPL] = B.[APPL]
	WHERE A.[BatchId] = @BatchId AND
		A.[CifKey] = @CifKey AND
		(B.[APPL] <> 'XXX' AND
		B.[ADTOPN] > '1900/01/01')
	ORDER BY IsReview, B.ADTOPN	
			
	/*product and services*/
	SELECT B.[Id] AS 'AccountId', A.[BatchId], A.[CifKey], A.[AccountKey], 
		A.[APPL], A.[ProductCode]
	FROM [dbo].[HRS_CustomerAccountProductAndServices] A
	LEFT JOIN [dbo].[HRS_CustomerAccounts_Fact] B
	ON [A].[BatchId] = [B].[BatchId] AND
		A.[CifKey] = B.[CifKey] AND
		A.[AccountKey] = B.[AccountKey] AND
		A.[APPL] = B.[APPL]
	WHERE A.[BatchId] = @BatchId AND
		A.[CifKey] = @CifKey
	
	/*account purposes*/
	SELECT B.[Id] AS 'AccountId', A.[BatchId], A.[CifKey], A.[AccountKey], 
		A.[APPL], [AccountPurposeCode] 
	FROM [dbo].[HRS_CustomerAccountPurposes] A
	LEFT JOIN [dbo].[HRS_CustomerAccounts_Fact] B
