            Pipe   = $powershell
            Result = $powershell.BeginInvoke()
        })
    }

    # 收集該批次結果
    foreach ($job in $jobs) {
        $res = $job.Pipe.EndInvoke($job.Result)
        $job.Pipe.Dispose()

        if ($res.Status -eq 'SUCCESS') {
            $globalSuccessCount++
            Write-Host "[$globalSeq/$total] [SUCCESS] File: $($res.FileName) | RefNo: $($res.ReferenceNo) | Time: $($res.ElapsedMs) ms" -ForegroundColor Green
        }
        else {
            $globalFailedCount++
            Write-Host "[$globalSeq/$total] [FAILED ] File: $($res.FileName) | RefNo: $($res.ReferenceNo) | Error: $($res.ErrorMessage)" -ForegroundColor Red
        }
        $globalSeq++
    }

    $runspacePool.Close()
    $runspacePool.Dispose()

    # 如果不是最後一批，休息指定秒數讓後端喘息
    if ($batchNum -lt $totalBatches) {
        Write-Host "Batch $batchNum completed. Resting for $SleepIntervalSec seconds..." -ForegroundColor Yellow
        Start-Sleep -Seconds $SleepIntervalSec
    }
}

$batchWatch.Stop()

# ============================================================
# Summary
# ============================================================

Write-Host ""
Write-Host "============================================================"
Write-Host "Batch Summary"
Write-Host "============================================================"
Write-Host "Total      : $total"
Write-Host "Success    : $globalSuccessCount" -ForegroundColor Green
Write-Host "Failed     : $globalFailedCount" -ForegroundColor Red
Write-Host "Total Time : $([math]::Round($batchWatch.Elapsed.TotalSeconds, 2)) sec"
Write-Host "============================================================"
