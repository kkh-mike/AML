# 1. 取得此 ps1 指令碼所在資料夾內的 Tsbldapdbc.dll
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

# 載入 DLL
Add-Type -Path $dllPath

$App = New-Object Tsbldapdbc.RunBat
$App.SSL = $false
$App.ldapHost = "10.13.60.66"
$App.searchBase = "o=tsbank"
$sApp = "AML"
$iCStr = 1
$ret2 = $App.GetRunBat($sApp, $iCStr)

Write-Host "Raw Result: $ret2"

# 檢查是否成功取得連線字串
if ($ret2 -like "Error:*" -or [string]::IsNullOrWhiteSpace($ret2)) {
    Write-Error "取得連線字串失敗: $ret2"
    exit 1
}

# 2. 解析連線字串並抽換 Database
$builder = New-Object System.Data.SqlClient.SqlConnectionStringBuilder($ret2)

# 指定目標資料庫名稱
$builder.InitialCatalog = "SARCaseWarehouse"  # 對應 Database

$server   = $builder.DataSource               # Server / Data Source
$user     = $builder.UserID                   # User ID
$password = $builder.Password                 # Password
$targetDb = $builder.InitialCatalog

Write-Host "=========================================="
Write-Host "Target Server   : $server"
Write-Host "Target Database : $targetDb"
Write-Host "User            : $user"
Write-Host "=========================================="

# 3. 搜尋當下目錄下所有的 .sql 檔案
$sqlFiles = Get-ChildItem -Path $PSScriptRoot -Filter "*.sql"

if ($sqlFiles.Count -eq 0) {
    Write-Warning "當前目錄下找不到任何 .sql 檔案！"
    exit 0
}

# 4. 連線資料庫並逐一執行 .sql
$conn = New-Object System.Data.SqlClient.SqlConnection($builder.ConnectionString)

try {
    Write-Host "正在連線至資料庫..."
    $conn.Open()
    Write-Host "資料庫連線成功！" -ForegroundColor Green

    foreach ($file in $sqlFiles) {
        Write-Host "正在執行: $($file.Name) ..."
        
        # 讀取 SQL 內容 (依編碼需求可調整 -Encoding UTF8 或 Default)
        $sqlContent = Get-Content -Path $file.FullName -Raw -Encoding UTF8

        if ([string]::IsNullOrWhiteSpace($sqlContent)) {
            Write-Warning "$($file.Name) 內容為空，略過。"
            continue
        }

        # 處理 T-SQL 中常見的 GO 分隔符號（如果有的話）
        $statements = $sqlContent -split "(?im)^\s*GO\s*$"

        foreach ($stmt in $statements) {
            if (-not [string]::IsNullOrWhiteSpace($stmt)) {
                $cmd = $conn.CreateCommand()
                $cmd.CommandText = $stmt
                $cmd.CommandTimeout = 300  # 設定逾時秒數 (可依需求調整)
                [void]$cmd.ExecuteNonQuery()
            }
        }
        
        Write-Host "  -> $($file.Name) 執行完成！" -ForegroundColor Green
    }
}
catch {
    Write-Error "執行過程中發生錯誤: $_"
}
finally {
    if ($conn.State -eq [System.Data.ConnectionState]::Open) {
        $conn.Close()
        Write-Host "資料庫連線已關閉。"
    }
}
