CREATE PROCEDURE [dbo].[GM_GETCUSTOMERDETAILS]
	@CIF_KEY NVARCHAR(100) = NULL
AS  
BEGIN 
DECLARE 
	--@NSTRSQL NVARCHAR(MAX),
	@CULTURE CHAR(5),
	@BNK_NBR VARCHAR(10),
	--@COL_CTRYDESC NVARCHAR(128),
	--@NSTRSQL2 NVARCHAR(MAX)= '',
	@CIF_KEY_UNIQUEIDENTIFIER UNIQUEIDENTIFIER
	
	SET @CIF_KEY_UNIQUEIDENTIFIER = CONVERT(UNIQUEIDENTIFIER ,@CIF_KEY)
	SELECT @BNK_NBR = REPLACE(DB_NAME(), 'BSADB', '')
	SELECT @CULTURE = ISNULL((SELECT CultureForDBColumnExtension FROM GCMAINDB..BankDBProfile WHERE BNK_NBR = @BNK_NBR), '')
	--SELECT @COL_CTRYDESC = 'ISO_CountryDescription' + '_' + REPLACE(@CULTURE, '-', '_')
	
	--IF NOT EXISTS (SELECT * FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'COUNTRY_DIM' AND COLUMN_NAME = @COL_CTRYDESC)  
	--BEGIN  
		--SET @COL_CTRYDESC = N'ISO_CountryDescription';  
	--END
	
	IF OBJECT_ID('tempdb..#CustStatEvent_Fact') IS NOT NULL
		DROP TABLE #CustStatEvent_Fact
	
	SELECT CIF_KEY, STUFF((
		SELECT ', ' + CustStatEventFlagCode + '-' + Y.Description
		FROM CustStatEvent_Fact X JOIN (SELECT DISTINCT Code, Description FROM dbo.CustStatEvent_Dim) Y ON X.CustStatEventFlagCode = Y.Code
		WHERE (CIF_KEY = A.CIF_KEY) FOR XML PATH(''),TYPE).value('(./text())[1]','NVARCHAR(MAX)') ,1,2,'') AS Event
	INTO #CustStatEvent_Fact
	FROM dbo.CustStatEvent_Fact A 
	WHERE A.CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER
	GROUP BY CIF_KEY
	
	IF OBJECT_ID('tempdb..#TriggerEvent_Fact') IS NOT NULL
		DROP TABLE #TriggerEvent_Fact
	
	SELECT CIF_KEY, STUFF((
		SELECT ', ' + TriggerEventFlagCode + '-' + Y.Description
		FROM TriggerEvent_Fact X JOIN dbo.TriggerEvent_Dim Y ON X.TriggerEventFlagCode = Y.Code
		WHERE (CIF_KEY = A.CIF_KEY) FOR XML PATH(''),TYPE).value('(./text())[1]','NVARCHAR(MAX)') ,1,2,'') AS Event
	INTO #TriggerEvent_Fact
	FROM dbo.TriggerEvent_Fact A
	WHERE A.CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER
	GROUP BY CIF_KEY
	
	IF OBJECT_ID('tempdb..#temp_OFAC_CUSTOMER_FACT') IS NOT NULL
		DROP TABLE #temp_OFAC_CUSTOMER_FACT
	
	SELECT TOP 1 A.CIF_KEY, CONVERT(DATE, A.time_key) AS CDCLastScannedDt, A.LastBatchUID AS CDCLastScannedBatchID
	INTO #temp_OFAC_CUSTOMER_FACT
	FROM dbo.OFAC_CUSTOMER_FACT A
	WHERE A.CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER AND LastBatchUID IS NOT NULL 
	ORDER BY time_key DESC
	
	IF OBJECT_ID('tempdb..#temp_DBCHK_Review_Main') IS NOT NULL
		DROP TABLE #temp_DBCHK_Review_Main
	
	SELECT TOP 1 A.CIF_KEY, CONVERT(DATE, A.LstUpdate_Date) AS CDCLastReviewedDt, A.Last_Upd_UserId AS CDCLastReviewedBy
	INTO #temp_DBCHK_Review_Main
	FROM dbo.DBCHK_Review_Main A
	WHERE A.CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER AND Status = 3
	ORDER BY LstUpdate_Date DESC

		SELECT A.BNK_NBR, A.CIF_KEY, A.CUST_TYPE_CDE, A.BRNCH_NBR, 
				BRNCH_NME = (SELECT TOP 1 BRNCH_DESC from dbo.BRANCH_DIM C WHERE C.BRNCH_NBR = A.BRNCH_NBR), 
				A.CUST_NME, A.NATIVE_CUST_NME, A.FNAME, A.RecordStatus,
				A.MNAME, A.LNAME, B.Alias_Name, CONVERT(DATE, A.BIRTHDT) 'BIRTHDT', 
				Place_Of_Birth = (SELECT TOP 1 CASE WHEN @CULTURE = 'zh-TW' THEN ISO_CountryDescription_zh_TW ELSE ISO_CountryDescription END FROM dbo.COUNTRY_DIM WITH(NOLOCK) WHERE ISO_2_CountryCode = B.Place_Of_Birth), 
				CONVERT(DATE, A.INCORPORATION_DATE) 'INCORPORATION_DATE', A.TAXIDCD, A.TAXID, A.NAICS_CDE, A.NATIONALITY_1 , A.NATIONALITY_2,
				CONVERT(DATE, A.OPEN_DTE) 'OPEN_DTE', CONVERT(DATE, A.CLOSED_DTE) 'CLOSED_DTE', A.CUSTFLAG, A.C_ADDRESS_1, A.C_ADDRESS_2, A.C_ADDRESS_3, A.C_ADDRESS_4, A.C_ZIP_CODE, 
				A.C_ZIP_4, A.C_CITY, A.C_STATE, A.FAX_NBR, A.HANDPHONE_NBR, A.EMAIL, A.RecordStatus, A.Customer_Segment, A.IsCIPEnable,
				C_CTRY_DESC = (SELECT TOP 1 CASE WHEN @CULTURE = 'zh-TW' THEN ISO_CountryDescription_zh_TW ELSE ISO_CountryDescription END FROM dbo.COUNTRY_DIM WITH(NOLOCK) WHERE ISO_2_CountryCode = A.C_CTRYCD),
				A.C_CTRYCD, A.P_ADDRESS_1, A.P_ADDRESS_2, A.P_ADDRESS_3, A.P_ADDRESS_4, A.P_ZIP_CODE, A.P_ZIP_4, A.P_CITY, A.P_STATE, 
				P_CTRY_DESC = (SELECT TOP 1 CASE WHEN @CULTURE = 'zh-TW' THEN ISO_CountryDescription_zh_TW ELSE ISO_CountryDescription END FROM dbo.COUNTRY_DIM WITH(NOLOCK) WHERE ISO_2_CountryCode = A.P_CTRYCD),
				A.P_CTRYCD, A.M_ADDRESS_1, A.M_ADDRESS_2, A.M_ADDRESS_3, A.M_ADDRESS_4, A.M_ZIP_CODE, A.M_ZIP_4, A.M_CITY, A.M_STATE,
				M_CTRY_DESC = (SELECT TOP 1 CASE WHEN @CULTURE = 'zh-TW' THEN ISO_CountryDescription_zh_TW ELSE ISO_CountryDescription END FROM dbo.COUNTRY_DIM WITH(NOLOCK) WHERE ISO_2_CountryCode = A.M_CTRYCD),
				A.M_CTRYCD, A.HOME_PHONE_NBR, A.HOME_PHONE_EXT, A.BUSINESS_PHONE_NBR, A.BUSINESS_PHONE_EXT, A.BUSINESS_PHONE_NBR, A.REM_CDE, A.REM_NME,
				NATIONALITY_1_DESC = (SELECT TOP 1 CASE WHEN @CULTURE = 'zh-TW' THEN ISO_CountryDescription_zh_TW ELSE ISO_CountryDescription END FROM dbo.COUNTRY_DIM WITH(NOLOCK) WHERE ISO_2_CountryCode = A.NATIONALITY_1),
				NATIONALITY_2_DESC = (SELECT TOP 1 CASE WHEN @CULTURE = 'zh-TW' THEN ISO_CountryDescription_zh_TW ELSE ISO_CountryDescription END FROM dbo.COUNTRY_DIM WITH(NOLOCK) WHERE ISO_2_CountryCode = A.NATIONALITY_2),
				A.Employee_Ind,
				B.CUSTOMERNO, B.IDENT, B.IDNUM, B.IDENTO,  B.LEGAL_ID, B.OCCUP, B.CTRYCD, B.ISSBY_STATE, B.ISSBY, B.CIPRISKRANKING, B.CIPSCORE, 
				B.CIP_LastReviewedDt, B.HRSRISKRANKING, B.HRSCORE,  B.HR_LastReviewedDt, B.HIGHRISK, B.RISKSCORE, B.RISK_LastReviewedDt, 
				B.HIGHRISK, B.SUSPICIOUS, B.VERIFIED, B.EXEMPTED, B.NegativeNewsRemark, B.IsPEPHit, B.IsOtherListHit, B.HasNegativeNews, 
				B.CustomerCategory, B.IsBelievedSuspicious, B.IsForeignEntity, B.BizOwnershipCode, B.CoreSystem, 
				(SELECT TOP 1 JobTitle_Desc FROM dbo.JobTitle_DIM WHERE dbo.JobTitle_DIM.ID = B.JobTitle) JobTitle,
				B.AnnualIncome, 
				(SELECT TOP 1 GenderDescription FROM dbo.Gender_Dim WHERE dbo.Gender_Dim.GenderCode = B.Gender) Gender,
				(SELECT TOP 1 DESCR FROM dbo.CUST_MTD_OF_OPENING_ACCT WHERE CUST_MTD_OF_OPENING_ACCT.CODE = B.Cust_Method_Of_Opening) Cust_Method_Of_Opening,
				STUFF((SELECT '~' + CODE
					FROM PB_CustProdAndServicesUsed WITH (NOLOCK)
					WHERE CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER
					ORDER BY CODE
					FOR XML PATH(''),TYPE).value('(./text())[1]','VARCHAR(MAX)')
				  ,1,1,'') AS 'Cust_Product_Service', 
				STUFF((SELECT '~' + CODE
					FROM PB_CustPurposeOfAcc WITH (NOLOCK) 
					WHERE CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER
					ORDER BY CODE
					FOR XML PATH(''),TYPE).value('(./text())[1]','VARCHAR(MAX)')
				  ,1,1,'') AS 'Cust_Account_Purpose',
				STUFF((SELECT '~' + CODE
					FROM PB_SourceOfFunds WITH (NOLOCK) 
					WHERE CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER
					ORDER BY CODE
					FOR XML PATH(''),TYPE).value('(./text())[1]','VARCHAR(MAX)')
				  ,1,1,'') AS 'Cust_Source_Of_Fund',
				STUFF((SELECT '~' + CODE
					FROM PB_SourceOfWealth WITH (NOLOCK) 
					WHERE CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER
					ORDER BY CODE
					FOR XML PATH(''),TYPE).value('(./text())[1]','VARCHAR(MAX)')
				  ,1,1,'') AS 'Cust_Source_Of_Wealth',
				HR_LastReviewedBy =  CASE WHEN HR_LastReviewedBy =  'SYSTEMADMIN' THEN 'System' 
									WHEN NOT EXISTS (SELECT 1 FROM USERACCOUNTS WHERE USERID = HR_LastReviewedBy) THEN HR_LastReviewedBy
									 ELSE
									 (SELECT TOP 1 USERID + ' (' + RTRIM(LTRIM(ISNULL(FirstName, '') + ' ' + ISNULL(LastName, ''))) + ')' 
									 FROM USERACCOUNTS 
									 WHERE USERID = B.HR_LastReviewedBy ORDER BY Deleted) END ,
				CIP_LastReviewedBy = (SELECT TOP 1 USERID + ' (' + RTRIM(LTRIM(ISNULL(FirstName, '') + ' ' + ISNULL(LastName, ''))) + ')' 
									 FROM USERACCOUNTS 
									 WHERE USERID = B.CIP_LastReviewedBy ORDER BY Deleted),
				Risk_LastReviewedBy = CASE
										WHEN NOT EXISTS (SELECT 1 FROM USERACCOUNTS WHERE USERID = B.Risk_LastReviewedBy) THEN B.Risk_LastReviewedBy
										ELSE (SELECT TOP 1 USERID + ' (' + RTRIM(LTRIM(ISNULL(FirstName, '') + ' ' + ISNULL(LastName, ''))) + ')' 
												 FROM USERACCOUNTS 
												 WHERE USERID = B.Risk_LastReviewedBy ORDER BY Deleted) END,
				HasPendingCDDCase =	CASE		
										WHEN EXISTS (SELECT 1 FROM dbo.HRS_CUST_RISK_MGMT WHERE CIF_KEY = A.CIF_KEY AND STATUS <> '3') THEN 'TRUE'
										WHEN EXISTS (SELECT 1 FROM dbo.CIP_CUST_RISK_MGMT WHERE CIF_KEY = A.CIF_KEY AND STATUS <> '3') THEN 'TRUE' ELSE 'FALSE' END,
				B.ElectricalPaymentAccount, B.IdentityAuthenticationMechanism1, B.IdentityAuthenticationMechanism2, ISNULL(C.IsHitTerroristsList, 0) AS IsHitTerroristsList,
				D.Event AS CustStatEvent, E.Event AS TriggerEvent, F.CDCLastScannedDt, F.CDCLastScannedBatchID, G.CDCLastReviewedDt, G.CDCLastReviewedBy, B.IsComplexStructure,
				STUFF((SELECT '~' + CountryCode
					FROM PB_CustomerCountriesQuestionAnswers WITH (NOLOCK) 
					WHERE CifKey = @CIF_KEY_UNIQUEIDENTIFIER AND CIPTemplateId='lkMainBusinessCtry' AND HRSTemplateId='833'
					ORDER BY CountryCode
					FOR XML PATH(''),TYPE).value('(./text())[1]','VARCHAR(MAX)')
				  ,1,1,'') AS 'MainBusinessCountry',
				B.Serving_Entity 'ServingEntity', B.Cust_With_Bearer_Shares 'CustWithBearerShares', 
				B.Spec_Product_Risk_Code 'SpecProductRiskCode', CustomerLevel = (SELECT TOP 1 CustLvl_Desc FROM dbo.CustomerLevel_DIM WHERE ID = B.CustomerLevel), 
				B.Warn_Restrict_Account 'WarnRestrictAccount',
				IsRejectedRelationship = (SELECT TOP 1 Answer FROM dbo.PB_CustomerYesNoQuestionAnswers WHERE CIPTemplateId = 'lkRejectedRelationWithOtherBanks' AND CifKey = B.CIF_KEY),
				IsAuthorizedSignatories = (SELECT TOP 1 Answer FROM dbo.PB_CustomerYesNoQuestionAnswers WHERE CIPTemplateId = 'lkTaxEvasionAuthorizedSignatories' AND CifKey = B.CIF_KEY),
				IsBelongToAnyGroupCompany = CASE WHEN EXISTS (SELECT TOP 1 1 FROM GRP_COMPANY_FACT WHERE CUSTOMER_ID = B.CustomerNo AND DELETE_FLAG = 0) THEN 'True' ELSE 'False' END
		FROM dbo.PB_CUSTOMER_FACT A WITH(NOLOCK)
		JOIN dbo.BSA_SUB_CUST_FACT B WITH(NOLOCK) ON A.CIF_KEY = B.CIF_KEY 
		LEFT JOIN PB_CUSTOMER_IsHitTerroristsList C WITH(NOLOCK) ON A.CIF_KEY = C.CIF_KEY
		LEFT JOIN #CustStatEvent_Fact D ON A.CIF_KEY = D.CIF_KEY
		LEFT JOIN #TriggerEvent_Fact E ON A.CIF_KEY = E.CIF_KEY
		LEFT JOIN #temp_OFAC_CUSTOMER_FACT F ON A.CIF_KEY = F.CIF_KEY
		LEFT JOIN #temp_DBCHK_Review_Main G ON A.CIF_KEY = G.CIF_KEY
		WHERE A.CIF_KEY = @CIF_KEY_UNIQUEIDENTIFIER 

END


