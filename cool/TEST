CREATE PROCEDURE [dbo].[NMCHK_GetRCMatchesByKey]
@RANDNUM NVARCHAR(80),
@KEY	 NVARCHAR(20),
@Type	 NVARCHAR(5) = NULL --= 'Q'
AS
DECLARE @BankNo VARCHAR(10), @Culture CHAR(5),
		@Word_Matched NVARCHAR(100),
		@Word_NotMatched NVARCHAR(100)
		
SELECT @BankNo = REPLACE(DB_NAME(), 'BSADB', '')
SELECT @Culture = ISNULL((SELECT CULTURE FROM GCMAINDB..BankDBProfile WITH (NOLOCK) WHERE BNK_NBR = @BankNo), '')		
SELECT @Word_Matched = dbo.GetResourceString('Matched') 
SELECT @Word_NotMatched = dbo.GetResourceString('NotMatched')

IF OBJECT_ID('tempdb..#NMCHK_ResultHistory_CustInfo') IS NOT NULL
	DROP TABLE #NMCHK_ResultHistory_CustInfo

CREATE TABLE #NMCHK_ResultHistory_CustInfo
(	
	uid NVARCHAR(20) NULL,
	userid NVARCHAR(50) NULL, 
	rel_corr_chosen INT NULL, 
	new_acct_key INT NULL, 
	relationship NVARCHAR(50) NULL, 
	address NVARCHAR(160) NULL, 
	city NVARCHAR(50) NULL, 
	country NVARCHAR(50) NULL, 
	new_acct_name NVARCHAR(350) NULL,
	relative_correlation INT NULL, 
	alt_num INT NULL, 
	ent_num INT NULL, 
	sdn_type NVARCHAR(15) NULL, 
	sdn_name NVARCHAR(350) NULL, 
	OFACMatch NVARCHAR(10) NULL, 
	OFACNotMatch NVARCHAR(10) NULL, 
	Reason NVARCHAR(255) NULL, 
	user_brnch_nbr NVARCHAR(50) NULL,
	TAXID NVARCHAR(50) NULL, 
	IDENT NVARCHAR(1) NULL, 
	IDENTO NVARCHAR(40) NULL, 
	ISSBY NVARCHAR(2) NULL, 
	IDNUM NVARCHAR(200) NULL, 
	REMARK NVARCHAR(MAX) NULL, 
	SECTION NVARCHAR(3) NULL, 
	DOB NVARCHAR(10) NULL, 
	Reduction_IND CHAR(10) NULL, 
	Ori_RC INT NULL, 
	last_updated_date DATETIME NULL, 
	DETECTED VARCHAR(1) NULL, 
	sdn_grp_num INT NULL, 
	NamePropertyBitCode INT NULL
)
		
	IF EXISTS(SELECT 1 FROM dbo.NMCHK_ResultHistory WITH(NOLOCK) WHERE UID = @RANDNUM AND new_acct_key = @KEY)
	BEGIN
		
		INSERT INTO #NMCHK_ResultHistory_CustInfo (uid, userid, rel_corr_chosen, new_acct_key, relationship, address, city, country, new_acct_name,
		                                            relative_correlation, alt_num, ent_num, sdn_type, sdn_name, OFACMatch, OFACNotMatch, Reason, user_brnch_nbr, TAXID,
		                                            IDENT, IDENTO, ISSBY, IDNUM, REMARK, SECTION, DOB, Reduction_IND, Ori_RC, last_updated_date, DETECTED, sdn_grp_num,
		                                            NamePropertyBitCode)
		SELECT A.uid, B.userid, B.rel_corr_chosen, A.new_acct_key, B.relationship, B.address, B.city, B.country, B.new_acct_name,
			A.relative_correlation, A.alt_num, A.ent_num, A.sdn_type, A.sdn_name, A.OFACMatch, A.OFACNotMatch, A.Reason, B.user_brnch_nbr, B.TAXID, 
			B.IDENT, B.IDENTO, B.ISSBY, B.IDNUM, B.REMARK, A.SECTION, B.DOB, ISNULL(A.Reduction_IND,''), ISNULL(A.Ori_RC,''), B.last_updated_date, B.DETECTED, A.sdn_grp_num, 
			ISNULL(A.NamePropertyBitCode,0)
		FROM dbo.NMCHK_ResultHistory A WITH (NOLOCK)
			JOIN dbo.NMCHK_CustInfo B WITH (NOLOCK) ON A.uid = B.uid AND A.new_acct_key = B.new_acct_key
		WHERE A.uid = @RANDNUM AND A.new_acct_key = @KEY
		
		SELECT A.*, 
		(CASE WHEN ISNULL(OFACNotMatch,'') = 'Y' THEN @Word_Matched 
			  WHEN ISNULL(OFACMatch,'') = 'Y' THEN @Word_NotMatched ELSE '-' END) AS IsMatchWithBlacklist, 
		CASE WHEN EXISTS (SELECT 1 FROM UN_SANCTIONS_LIST C WITH (NOLOCK) JOIN UN_Program_DIM D ON D.ProgramCode = C.UN_LIST_TYPE
							WHERE A.sdn_type IN ('UN', 'UN ALT') AND A.ent_num = C.ENT_NUM AND D.IsTerroristFinancing = 1  AND C.DEL_IND = 'N')
				OR EXISTS(SELECT 1 FROM dbo.UN_Vessel_List C WITH(NOLOCK) JOIN dbo.UN_Program_DIM D ON D.ProgramCode = C.UN_List_Type
							WHERE A.sdn_type IN ('UN', 'UN ALT') AND A.ent_num = C.EntNum AND D.IsTerroristFinancing = 1 AND C.IsDeleted = 0)
				OR EXISTS (SELECT 1 FROM OFAC_SPEC E WITH (NOLOCK)
							JOIN lowrisklistgroups F WITH (NOLOCK) ON E.GROUPID = F.GROUPID
							JOIN dbo.OFAC_SpecType_Dim G WITH (NOLOCK) ON F.SpecType = G.ID
							WHERE A.sdn_type = 'SPEC'
							AND A.ent_num = E.ent_num
							AND A.sdn_grp_num = E.GROUPID
							AND E.DInd = 'N'
							AND G.SpecType = 'TW Sanctions List'
						   ) 
		THEN 
			CASE WHEN A.sdn_type IN('SPEC', 'SPEC_CN') THEN N' (' + C.GROUPDESCR + N')'
				WHEN A.sdn_type IN('GLSPEC', 'GLSPEC_CN') THEN N' (' + D.GROUPDESCR + N')'
			ELSE '' END + CASE WHEN @Culture = 'zh-TW' THEN N' (資恐)' ELSE N' (Terrorist Financing List)' END 
		ELSE 
			CASE WHEN A.sdn_type IN('SPEC', 'SPEC_CN') THEN N' (' + C.GROUPDESCR + N')'
				WHEN A.sdn_type IN('GLSPEC', 'GLSPEC_CN') THEN N' (' + D.GROUPDESCR + N')'
			END 
		END AS GROUPDESCR 
		FROM #NMCHK_ResultHistory_CustInfo A
		LEFT JOIN dbo.lowrisklistgroups C WITH(NOLOCK) ON A.sdn_type IN('SPEC', 'SPEC_CN') AND A.sdn_grp_num = C.GROUPID
		LEFT JOIN BSADB.dbo.lowrisklistgroups D WITH(NOLOCK) ON A.sdn_type IN('GLSPEC', 'GLSPEC_CN') AND A.sdn_grp_num = D.GROUPID
		LEFT JOIN BlackList_PriorityList_dim E WITH (NOLOCK) ON A.sdn_type = E.List
		ORDER BY A.RELATIVE_CORRELATION DESC, E.Priority, A.sdn_name
	END
	ELSE
	BEGIN
		
		INSERT INTO #NMCHK_ResultHistory_CustInfo (uid, userid, rel_corr_chosen, new_acct_key, relationship, address, city, country, new_acct_name,
		                                            relative_correlation, alt_num, ent_num, sdn_type, sdn_name, OFACMatch, OFACNotMatch, Reason, user_brnch_nbr, TAXID,
		                                            IDENT, IDENTO, ISSBY, IDNUM, REMARK, SECTION, DOB, Reduction_IND, Ori_RC, last_updated_date, DETECTED, sdn_grp_num,
		                                            NamePropertyBitCode)
		SELECT A.uid, B.userid, B.rel_corr_chosen, A.new_acct_key, B.relationship, B.address, B.city, B.country, B.new_acct_name,
			A.relative_correlation, A.alt_num, A.ent_num, A.sdn_type, A.sdn_name, A.OFACMatch, A.OFACNotMatch, A.Reason, B.user_brnch_nbr, B.TAXID, 
			B.IDENT, B.IDENTO, B.ISSBY, B.IDNUM, B.REMARK, A.SECTION, B.DOB, ISNULL(A.Reduction_IND,''), ISNULL(A.Ori_RC,''), B.last_updated_date, B.DETECTED, A.sdn_grp_num, 
			ISNULL(A.NamePropertyBitCode,0)
		FROM dbo.NMCHK_ResultHistory_FILTER_RC A WITH (NOLOCK)
			JOIN dbo.NMCHK_CustInfo B WITH (NOLOCK) ON A.uid = B.uid AND A.new_acct_key = B.new_acct_key
		WHERE A.uid = @RANDNUM AND A.new_acct_key = @KEY
		
		;WITH CTE_FILTER_RC AS (
			SELECT A.*, 
			(CASE WHEN ISNULL(OFACNotMatch,'') = 'Y' THEN 'Yes' 
			  WHEN ISNULL(OFACMatch,'') = 'Y' THEN 'No' ELSE '-' END) AS IsMatchWithBlacklist, 
			CASE WHEN EXISTS (SELECT 1 FROM UN_SANCTIONS_LIST C WITH (NOLOCK) 
								JOIN UN_Program_DIM D ON D.ProgramCode = C.UN_LIST_TYPE
								WHERE A.sdn_type IN ('UN', 'UN ALT')
								AND A.ent_num = C.ENT_NUM
								AND D.IsTerroristFinancing = 1 
								AND C.DEL_IND = 'N')
					OR EXISTS(SELECT 1 FROM dbo.UN_Vessel_List C WITH(NOLOCK) JOIN dbo.UN_Program_DIM D ON D.ProgramCode = C.UN_List_Type
							WHERE A.sdn_type IN ('UN', 'UN ALT') AND A.ent_num = C.EntNum AND D.IsTerroristFinancing = 1 AND C.IsDeleted = 0)
					OR EXISTS (SELECT 1 FROM OFAC_SPEC E WITH (NOLOCK)
								JOIN lowrisklistgroups F WITH (NOLOCK) ON E.GROUPID = F.GROUPID
								JOIN dbo.OFAC_SpecType_Dim G WITH (NOLOCK) ON F.SpecType = G.ID
								WHERE A.sdn_type = 'SPEC'
								AND A.ent_num = E.ent_num
								AND A.sdn_grp_num = E.GROUPID
								AND E.DInd = 'N'
								AND G.SpecType = 'TW Sanctions List'
							   ) 
			THEN 
				CASE WHEN A.sdn_type IN('SPEC', 'SPEC_CN') THEN N' (' + C.GROUPDESCR + N')'
					WHEN A.sdn_type IN('GLSPEC', 'GLSPEC_CN') THEN N' (' + D.GROUPDESCR + N')'
				ELSE '' END + CASE WHEN @Culture = 'zh-TW' THEN N' (資恐)' ELSE N' (Terrorist Financing List)' END 
			ELSE 
				CASE WHEN A.sdn_type IN('SPEC', 'SPEC_CN') THEN N' (' + C.GROUPDESCR + N')'
					WHEN A.sdn_type IN('GLSPEC', 'GLSPEC_CN') THEN N' (' + D.GROUPDESCR + N')'
				END 
			END AS GROUPDESCR, 
			DENSE_RANK() OVER(ORDER BY A.relative_correlation DESC) AS RowDense
			FROM #NMCHK_ResultHistory_CustInfo A
			LEFT JOIN dbo.lowrisklistgroups C WITH(NOLOCK) ON A.sdn_type IN('SPEC', 'SPEC_CN') AND A.sdn_grp_num = C.GROUPID
			LEFT JOIN BSADB.dbo.lowrisklistgroups D WITH(NOLOCK) ON A.sdn_type IN('GLSPEC', 'GLSPEC_CN') AND A.sdn_grp_num = D.GROUPID
		)
		SELECT A.* FROM CTE_FILTER_RC A
		LEFT JOIN BlackList_PriorityList_dim E WITH (NOLOCK) ON A.sdn_type = E.List
		WHERE A.RowDense = 1
