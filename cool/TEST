        ReferenceNo = $referenceNo
        RawMessage  = $rawMessage
    })
}

# ============================================================
# Chunking Logic (相容 PowerShell 5.1 的陣列切塊)
# ============================================================

$batches = @()
for ($i = 0; $i -lt $fileDataList.Count; $i += $BatchSize) {
    $count = [Math]::Min($BatchSize, $fileDataList.Count - $i)
    $batches += ,@($fileDataList.GetRange($i, $count))
}

$totalBatches = $batches.Count
$globalSuccessCount = 0
