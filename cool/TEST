CREATE PROCEDURE [dbo].[EDD_GetDocumentDetails]
	@DocumentId INT,
	@Mode NVARCHAR(40),
	@IncludeDisabled BIT = 'TRUE',
	@PageIndex INT = NULL
AS
BEGIN
	SET NOCOUNT ON;
	
	DECLARE @TempQuestions TABLE(
			Id INT NOT NULL,
			PageIndex INT NOT NULL,
			QuestionIndex INT NOT NULL,
			Question NVARCHAR(MAX) NULL,
			AnswerListId INT NOT NULL,
			[Enabled] BIT NOT NULL,
			AnswerType TINYINT NOT NULL
		)	
		
	IF @Mode = 'Existing'
	BEGIN
		SELECT Id, Title, [Description], ProductCode, Category, CreatedBy, IsActive, [DocumentVersion]
		FROM dbo.EDD_Documents
		WHERE Id = @DocumentId

		INSERT INTO @TempQuestions( Id, PageIndex, QuestionIndex, Question, 
			AnswerListId, [Enabled], AnswerType)
		SELECT Q.Id, Q.PageIndex, Q.QuestionIndex, Q.Question, 
			Q.AnswerListId, Q.[Enabled], Q.AnswerType
		FROM dbo.EDD_Questions Q
		WHERE Q.DocumentId = @DocumentId AND
		(@PageIndex IS NULL OR Q.PageIndex = @PageIndex) AND
		Q.Deleted = 'FALSE' AND
		((@IncludeDisabled IS NULL OR @IncludeDisabled = 'TRUE') OR
			Q.[Enabled] <> @IncludeDisabled)
		
		SELECT Id, PageIndex, QuestionIndex, Question, AnswerListId, [Enabled], AnswerType
		FROM @TempQuestions;
		
		SELECT Id, ListName
		FROM dbo.EDD_AnswerNameLists L
		WHERE EXISTS(SELECT NULL FROM @TempQuestions Q
			WHERE L.Id = Q.AnswerListId)
	END
	ELSE IF @Mode = 'Pending'
	BEGIN
		SELECT Id, Title, [Description], ProductCode, Category, CreatedBy, IsActive, [DocumentVersion]
		FROM dbo.EDD_PendingDocuments
		WHERE Id = @DocumentId	

		INSERT INTO @TempQuestions( Id, PageIndex, QuestionIndex, Question, 
			AnswerListId, [Enabled], AnswerType)
		SELECT Q.Id, Q.PageIndex, Q.QuestionIndex, Q.Question, 
			Q.AnswerListId, Q.[Enabled], Q.AnswerType
		FROM dbo.EDD_PendingQuestions Q
		WHERE Q.DocumentId = @DocumentId AND
		(@PageIndex IS NULL OR Q.PageIndex = @PageIndex) AND
		Q.Deleted = 'FALSE' AND
		((@IncludeDisabled IS NULL OR @IncludeDisabled = 'TRUE') OR
			Q.[Enabled] <> @IncludeDisabled)
		
		SELECT Id, PageIndex, QuestionIndex, Question, AnswerListId, [Enabled], AnswerType
		FROM @TempQuestions;
		
		SELECT Id, ListName
		FROM dbo.EDD_AnswerNameLists L
		WHERE EXISTS(SELECT NULL FROM @TempQuestions Q
			WHERE L.Id = Q.AnswerListId)
	END
	
END

