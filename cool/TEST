                                /*HRST0059    Any of the account holder’s legal ID issuing country, nationality, country of permanent address, country of mailing/correspondent address are in the following country : {Parameter1}*/
                                IF EXISTS(SELECT 1 FROM dbo.HRS_ScenarioTemplates A WITH (NOLOCK) 
