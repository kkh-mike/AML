CREATE PROCEDURE [dbo].[HRS_GetSyntaxesHistory] 
	@Type NVARCHAR(30),
	@SESSIONID BIGINT,
	@Seq INT,
	@CIF_KEY UNIQUEIDENTIFIER,
	@StartIndex INT = 0,
	@RowCount INT = 10,
	@SortExpression NVARCHAR(30) = NULL,
	@CultureName VARCHAR(5) = NULL,
	@SyntaxId INT = NULL
AS
BEGIN

	SET NOCOUNT ON;
	
	SET @Type = COALESCE(@Type, '');
	SET @SortExpression = LTRIM(RTRIM(@SortExpression))

	SELECT  @StartIndex = COALESCE(@StartIndex, 0);
	SELECT  @RowCount = COALESCE(@RowCount, 10);
		
	DECLARE @EndIndex INT;
	SET @EndIndex = @StartIndex + @RowCount;

	CREATE TABLE #TempSyntaxes_Final(
		TemplateId INT NOT NULL,
		Parameter1 NVARCHAR(100) NULL,
		Parameter2 NVARCHAR(100) NULL,
		Parameter3 NVARCHAR(100) NULL,
		Parameter4 NVARCHAR(100) NULL,
		Parameter5 NVARCHAR(100) NULL,
		Parameter6 NVARCHAR(100) NULL,
		Parameter7 NVARCHAR(100) NULL,
		Parameter8 NVARCHAR(100) NULL,
		Parameter9 NVARCHAR(100) NULL,
		Parameter10 NVARCHAR(100) NULL,
		Score DECIMAL(7,2) NOT NULL,
		DetectionPart INT NULL,
		SyntaxId INT NOT NULL,
		TotalCount INT NOT NULL,
		SyntaxQueryId NVARCHAR(15) NULL
	)
	
	IF @Seq = 0
	BEGIN
	
	IF OBJECT_ID('tempdb..#DetectionDetailsKeys') IS NOT NULL
	DROP TABLE #DetectionDetailsKeys;
	
	IF OBJECT_ID('tempdb..#TempSyntaxes') IS NOT NULL
	DROP TABLE #TempSyntaxes;
	
	IF OBJECT_ID('tempdb..#TempSyntaxes_Row') IS NOT NULL
	DROP TABLE #TempSyntaxes_Row;
	
	IF OBJECT_ID('tempdb..#HRS_DetectionDetails') IS NOT NULL
	DROP TABLE #HRS_DetectionDetails;
	
	IF OBJECT_ID('tempdb..#HRS_DetectionDetails_RMDLog') IS NOT NULL
	DROP TABLE #HRS_DetectionDetails_RMDLog;
	
	CREATE TABLE #HRS_DetectionDetails
	(
		[Id] [bigint] NOT NULL IDENTITY(1, 1),
		[BatchId] [bigint] NULL,
		[CIFKey] [uniqueidentifier] NULL,
		[SyntaxId] [int] NULL,
		[TemplateId] [int] NULL,
		[Parameter1] [nvarchar] (400) NULL,
		[Parameter2] [nvarchar] (400) NULL,
		[Parameter3] [nvarchar] (400) NULL,
		[Parameter4] [nvarchar] (400) NULL,
		[Parameter5] [nvarchar] (400) NULL,
		[Parameter6] [nvarchar] (400) NULL,
		[Parameter7] [nvarchar] (400) NULL,
		[Parameter8] [nvarchar] (400) NULL,
		[Parameter9] [nvarchar] (400) NULL,
		[Parameter10] [nvarchar] (400) NULL,
		[Score] [DECIMAL](7,2) NULL,
		[IsIncluded] [bit] NULL,
		[IsCritical] [bit] NOT NULL ,
		[WeightValue] [smallint] NOT NULL,
		[Threshold] [int] NULL,
		[Ranking] [char] (1) NULL
	) 
	
	CREATE TABLE #HRS_DetectionDetails_RMDLog
	(
	[Id] [bigint] NOT NULL IDENTITY(1, 1),
	[BatchId] [bigint] NULL,
	[CIFKey] [uniqueidentifier] NULL,
	[SyntaxId] [int] NULL,
	[TemplateId] [int] NULL,
	[Parameter1] [nvarchar] (400) NULL,
	[Parameter2] [nvarchar] (400) NULL,
	[Parameter3] [nvarchar] (400) NULL,
	[Parameter4] [nvarchar] (400) NULL,
	[Parameter5] [nvarchar] (400) NULL,
	[Parameter6] [nvarchar] (400) NULL,
	[Parameter7] [nvarchar] (400) NULL,
	[Parameter8] [nvarchar] (400) NULL,
	[Parameter9] [nvarchar] (400) NULL,
	[Parameter10] [nvarchar] (400) NULL,
	[Score] [DECIMAL](7,2) NULL,
	[IsIncluded] [bit] NULL,
	[IsCritical] [bit] NOT NULL ,
	[WeightValue] [smallint] NOT NULL,
	[Threshold] [int] NULL,
	[Ranking] [char] (1) NULL
	)

	
	INSERT INTO #HRS_DetectionDetails (BatchId ,  CIFKey , SyntaxId ,TemplateId , Parameter1 ,
	       Parameter2 ,Parameter3 , Parameter4 ,Parameter5 ,Parameter6 ,
	       Parameter7 ,Parameter8 ,Parameter9 ,Parameter10 ,Score ,
	       IsIncluded ,IsCritical ,WeightValue ,Threshold ,Ranking )
	SELECT BatchId ,  CIFKey , SyntaxId ,TemplateId , Parameter1 ,
	       Parameter2 ,Parameter3 , Parameter4 ,Parameter5 ,Parameter6 ,
	       Parameter7 ,Parameter8 ,Parameter9 ,Parameter10 ,Score ,
	       IsIncluded ,IsCritical ,WeightValue ,Threshold ,Ranking 
	FROM [HRS_DetectionDetails] WITH (NOLOCK)
	WHERE [BatchId] = @SESSIONID AND CIFKey = @CIF_KEY
	
	INSERT INTO #HRS_DetectionDetails_RMDLog (BatchId ,CIFKey ,SyntaxId ,TemplateId ,
	       Parameter1 ,Parameter2 ,Parameter3 ,Parameter4 ,
	       Parameter5 ,Parameter6 ,Parameter7 ,Parameter8 ,
	       Parameter9 ,Parameter10 , Score ,IsIncluded ,IsCritical ,
	       WeightValue ,Threshold)
	SELECT  BatchId ,CIFKey ,SyntaxId ,TemplateId ,
	       Parameter1 ,Parameter2 ,Parameter3 ,Parameter4 ,
	       Parameter5 ,Parameter6 ,Parameter7 ,Parameter8 ,
	       Parameter9 ,Parameter10 , Score ,IsIncluded ,IsCritical ,
	       WeightValue ,Threshold 
	FROM dbo.HRS_DetectionDetails_RMDLog WITH (NOLOCK)
	WHERE [BatchId] = @SESSIONID AND CIFKey = @CIF_KEY


	SELECT B.[Id] INTO #DetectionDetailsKeys 
	FROM 
	(
		SELECT A.[Id]
		FROM #HRS_DetectionDetails A WITH (NOLOCK)
		WHERE A.[BatchId] = @SESSIONID AND 
			A.[CIFKey] = @CIF_KEY AND
			A.[IsIncluded] = 'TRUE'
		UNION
		SELECT A.[Id]
		FROM #HRS_DetectionDetails_RMDLog A WITH (NOLOCK)
		WHERE A.[BatchId] = @SESSIONID AND 
			A.[CIFKey] = @CIF_KEY AND
			A.[IsIncluded] = 'TRUE'
	)B 
	 
	SELECT [Id], [BatchId], [CIFKey],[SyntaxId],[TemplateId], [Parameter1],
			[Parameter2], [Parameter3],[Parameter4],[Parameter5],[Parameter6],
			[Parameter7],[Parameter8],[Parameter9],[Parameter10],[Score],
			[IsIncluded],[DetectionPart],[SyntaxQueryId] INTO #TempSyntaxes 
	FROM 
	(
		SELECT  A.[Id], A.[BatchId], A.[CIFKey], A.[SyntaxId], A.[TemplateId], 
						CASE WHEN B.AnswerType IN ('TXTBX', 'TXTA', 'TXTDATE') THEN '' ELSE A.[Parameter1] END AS Parameter1,
						A.[Parameter2], A.[Parameter3], A.[Parameter4], A.[Parameter5], A.[Parameter6],
						A.[Parameter7], A.[Parameter8], A.[Parameter9], A.[Parameter10], A.[Score],
						A.[IsIncluded], B.[DetectionPart], D.[qryId] AS 'SyntaxQueryId'
				FROM #DetectionDetailsKeys C
				JOIN #HRS_DetectionDetails A WITH (NOLOCK)
				ON C.[Id] = A.[Id]
				JOIN [dbo].[HRS_ScenarioTemplates] B WITH (NOLOCK)
				ON A.[TemplateId] = B.[ID]
				JOIN [dbo].[HRS_QuerySyntaxes] D WITH (NOLOCK)
				ON A.[SyntaxId] = D.[ID]
				WHERE A.BatchId = @SESSIONID AND (B.TemplateType = 'DIM' OR B.AnswerType IN ('TXTBX', 'TXTA', 'TXTDATE')) AND
					(
						@Type <> N'CIPReview' OR
						(@Type = N'CIPReview' AND B.[DetectionPart] IN(2,3))
					)
					AND (@SyntaxId IS NULL OR A.[SyntaxId] = @SyntaxId)
				UNION
				SELECT  A.[Id], A.[BatchId], A.[CIFKey], A.[SyntaxId], A.[TemplateId], QUOTENAME(A.[Parameter1]) + ' ' + (SELECT E.Descr FROM dbo.SDS_AnswerOptions E WITH (NOLOCK) WHERE E.TemplateID = A.TemplateId AND E.Code = A.[Parameter1]) AS Parameter1,
						A.[Parameter2], A.[Parameter3], A.[Parameter4], A.[Parameter5], A.[Parameter6],
						A.[Parameter7], A.[Parameter8], A.[Parameter9], A.[Parameter10], A.[Score],
						A.[IsIncluded], B.[DetectionPart], D.[qryId] AS 'SyntaxQueryId'
				FROM #DetectionDetailsKeys C
				JOIN #HRS_DetectionDetails A WITH (NOLOCK)
				ON C.[Id] = A.[Id]
				JOIN [dbo].[HRS_ScenarioTemplates] B WITH (NOLOCK)
				ON A.[TemplateId] = B.[ID]
				JOIN [dbo].[HRS_QuerySyntaxes] D WITH (NOLOCK)
				ON A.[SyntaxId] = D.[ID]
				WHERE A.BatchId = @SESSIONID AND (B.TemplateType = 'DEFINE' AND B.AnswerType IN ('RDL', 'CHKBX', 'DDL'))
					AND (@SyntaxId IS NULL OR A.[SyntaxId] = @SyntaxId)
				UNION
				SELECT  A.[Id], A.[BatchId], A.[CIFKey], A.[SyntaxId], A.[TemplateId], 
						CASE WHEN B.AnswerType IN ('TXTBX', 'TXTA', 'TXTDATE') THEN '' ELSE A.[Parameter1] END AS Parameter1,
						A.[Parameter2], A.[Parameter3], A.[Parameter4], A.[Parameter5], A.[Parameter6],
						A.[Parameter7], A.[Parameter8], A.[Parameter9], A.[Parameter10], A.[Score],
						A.[IsIncluded], B.[DetectionPart], D.[qryId] AS 'SyntaxQueryId'
				FROM #DetectionDetailsKeys C
				JOIN #HRS_DetectionDetails_RMDLog A WITH (NOLOCK)
				ON C.[Id] = A.[Id]
				JOIN [dbo].[HRS_ScenarioTemplates] B WITH (NOLOCK)
				ON A.[TemplateId] = B.[ID]
				JOIN [dbo].[HRS_QuerySyntaxes] D WITH (NOLOCK)
				ON A.[SyntaxId] = D.[ID]
				WHERE A.BatchId = @SESSIONID AND (B.TemplateType = 'DIM' OR B.AnswerType IN ('TXTBX', 'TXTA', 'TXTDATE')) AND
					(
						@Type <> N'CIPReview' OR
						(@Type = N'CIPReview' AND B.[DetectionPart] IN(2,3))
					)
					AND (@SyntaxId IS NULL OR A.[SyntaxId] = @SyntaxId)
				UNION
				SELECT  A.[Id], A.[BatchId], A.[CIFKey], A.[SyntaxId], A.[TemplateId], QUOTENAME(A.[Parameter1]) + ' ' + (SELECT E.Descr FROM dbo.SDS_AnswerOptions E  WITH (NOLOCK) WHERE E.TemplateID = A.TemplateId AND E.Code = A.[Parameter1]) AS Parameter1,
						A.[Parameter2], A.[Parameter3], A.[Parameter4], A.[Parameter5], A.[Parameter6],
						A.[Parameter7], A.[Parameter8], A.[Parameter9], A.[Parameter10], A.[Score],
						A.[IsIncluded], B.[DetectionPart], D.[qryId] AS 'SyntaxQueryId'
				FROM #DetectionDetailsKeys C 
				JOIN #HRS_DetectionDetails_RMDLog A WITH (NOLOCK)
				ON C.[Id] = A.[Id]
				JOIN [dbo].[HRS_ScenarioTemplates] B WITH (NOLOCK)
				ON A.[TemplateId] = B.[ID]
				JOIN [dbo].[HRS_QuerySyntaxes] D WITH (NOLOCK)
				ON A.[SyntaxId] = D.[ID]
				WHERE A.BatchId = @SESSIONID AND (B.TemplateType = 'DEFINE' AND B.AnswerType IN ('RDL', 'CHKBX', 'DDL'))
				AND (@SyntaxId IS NULL OR A.[SyntaxId] = @SyntaxId)
	)B 
	
	
		SELECT [TemplateId], [Parameter1], [Parameter2],
			[Parameter3], [Parameter4], [Parameter5], [Parameter6], [Parameter7],
			[Parameter8], [Parameter9], [Parameter10], [Score], [DetectionPart], 
			COUNT([A].[Id]) OVER() AS 'TotalCount', [SyntaxId], [SyntaxQueryId],
			ROW_NUMBER() OVER( ORDER BY
				CASE WHEN @SortExpression IS NULL OR @SortExpression = '' THEN A.[Score] END DESC,
				CASE WHEN @SortExpression = 'Score' THEN A.[Score] END ASC,
				CASE WHEN @SortExpression = 'Score DESC' THEN A.[Score] END DESC,
				CASE WHEN @SortExpression = 'SyntaxQueryId' THEN A.[SyntaxQueryId] END ASC,
				CASE WHEN @SortExpression = 'SyntaxQueryId DESC' THEN A.[SyntaxQueryId] END DESC
			) AS 'RowNumber' INTO #TempSyntaxes_Row
		FROM #TempSyntaxes A 
		
		
		INSERT INTO #TempSyntaxes_Final([TemplateId], [Parameter1], [Parameter2],
			[Parameter3], [Parameter4], [Parameter5], [Parameter6], [Parameter7],
			[Parameter8], [Parameter9], [Parameter10], [Score], [DetectionPart], 
			[TotalCount], [SyntaxId], [SyntaxQueryId])
		SELECT [TemplateId], [Parameter1], [Parameter2],
			[Parameter3], [Parameter4], [Parameter5], [Parameter6], [Parameter7],
			[Parameter8], [Parameter9], [Parameter10], [Score], [DetectionPart], 
			[TotalCount], [SyntaxId], [SyntaxQueryId]
		FROM #TempSyntaxes_Row
		WHERE RowNumber BETWEEN (@StartIndex + 1) AND @EndIndex ;
		
		SELECT  [TemplateId], [Parameter1], [Parameter2], [Parameter3],
				[Parameter4], [Parameter5], [Parameter6], [Parameter7],
				[Parameter8], [Parameter9], [Parameter10], [Score],
				[DetectionPart], [TotalCount], [SyntaxId], [SyntaxQueryId]
		FROM    #TempSyntaxes_Final
		
		SELECT TemplateId, ParameterName, ParameterType, OptionListName, 
			CASE WHEN @CultureName IS NULL OR @CultureName = 'en-US' THEN 
				[ParameterDescription] 
			ELSE
				[ParameterDescription_zh_TW]
			END AS ParameterDescription 
		FROM dbo.HRS_ParametersInfo A WITH (NOLOCK) 
		WHERE EXISTS(SELECT NULL FROM #TempSyntaxes_Final B 
		WHERE A.TemplateId = B.TemplateId)

				
	END
	ELSE
	BEGIN
	
	IF OBJECT_ID('tempdb..#DetectionDetailsKeys2') IS NOT NULL
	DROP TABLE #DetectionDetailsKeys2;
	
	IF OBJECT_ID('tempdb..#TempSyntaxes2') IS NOT NULL
	DROP TABLE #TempSyntaxes2;
	
	IF OBJECT_ID('tempdb..#TempSyntaxes_Row2') IS NOT NULL
	DROP TABLE #TempSyntaxes_Row2;
	
	IF OBJECT_ID('tempdb..#HRS_DetectionDetails_Autodone_RMDLog') IS NOT NULL
	DROP TABLE #HRS_DetectionDetails_Autodone_RMDLog;
	
	CREATE TABLE #HRS_DetectionDetails_Autodone_RMDLog
	(
	[Id] [bigint] NOT NULL IDENTITY(1, 1),
	[BatchId] [bigint] NULL,
	[CIFKey] [uniqueidentifier] NULL,
	[SyntaxId] [int] NULL,
	[TemplateId] [int] NULL,
	[Parameter1] [nvarchar] (200) NULL,
