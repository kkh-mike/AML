	--PRINT 'CASEDETECTOR PROCESSING EMAIL'
	SET @TBL_EMAIL = 'CASEDETECTOR_TEMP_EMAIL'
	
	IF ISNULL(@ID, '') <> ''
		SET @TBL_EMAIL = 'CASEDETECTOR_TEMP_EMAIL_'  + @ID
	
	IF ISNULL(@ID, '') <> ''
		SET @TBL_EMAIL_DETAIL = 'CASEDETECTOR_TEMP_EMAIL_DETAIL_'  + @ID
	
	IF NOT EXISTS(SELECT 1 FROM SYSOBJECTS WHERE NAME = @TBL_EMAIL)
		RETURN
	
	IF EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS A WHERE TABLE_NAME = 'CASEDETECTOR_TEMP_EMAIL' AND NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS B WHERE TABLE_NAME = @TBL_EMAIL AND A.COLUMN_NAME = B.COLUMN_NAME))
	BEGIN
		DECLARE @COLUMN_NAME NVARCHAR(MAX), @DATA_TYPE VARCHAR(MAX), @CHARACTER_MAXIMUM_LENGTH INT
		DECLARE CUR CURSOR FOR  
		SELECT COLUMN_NAME, DATA_TYPE, CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS A
		WHERE TABLE_NAME = 'CASEDETECTOR_TEMP_EMAIL' AND NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS B WHERE TABLE_NAME = @TBL_EMAIL AND A.COLUMN_NAME = B.COLUMN_NAME)
		OPEN CUR  
		FETCH NEXT FROM CUR INTO @COLUMN_NAME, @DATA_TYPE, @CHARACTER_MAXIMUM_LENGTH
		WHILE @@FETCH_STATUS = 0  
		BEGIN  
				SET @NSTRSQL = 'ALTER TABLE dbo.[' + @TBL_EMAIL + '] ADD ' + @COLUMN_NAME + ' ' + @DATA_TYPE + CASE WHEN @CHARACTER_MAXIMUM_LENGTH IS NOT NULL THEN ' (' + CONVERT(VARCHAR, @CHARACTER_MAXIMUM_LENGTH) + ')' ELSE '' END
			EXEC (@NSTRSQL)
			FETCH NEXT FROM CUR INTO @COLUMN_NAME, @DATA_TYPE, @CHARACTER_MAXIMUM_LENGTH
		END  
		CLOSE CUR  
		DEALLOCATE CUR
	END
	
	/* INIT VARIABLE */
	SELECT @BNK_NBR = REPLACE(DB_NAME(), 'BSADB', '')
	
	SELECT @CULTURE = ISNULL((SELECT CultureForDBColumnExtension FROM GCMAINDB..BankDBProfile WHERE BNK_NBR = @BNK_NBR), '')
	
	SELECT @DATELOCAL = dbo.ConvertToBankLocalTime(GETUTCDATE()),
			@DATEUTC = GETUTCDATE()
			
	SELECT @MAX_RECORD_CNT_PER_EMAIL = 5000,
			@SENDER = ISNULL((SELECT CTRLVAL FROM dbo.POCTRL WHERE CTRLKEY = 'EMAIL_NOTIFICATION'), ''), 
			@PRIORITY = 'HIGH', 
			@STATUS = 'PENDING',
			@TIMELOCAL = CONVERT(VARCHAR, @DATELOCAL, 108)
	
	IF @CULTURE = 'zh-TW'
