        DROP TABLE #ACCT_XREF_DIM_TMP
        
SELECT * INTO #ACCT_XREF_DIM_TMP FROM dbo.ACCT_XREF_DIM WHERE CIF_KEY = @CIFKey AND ASTATCD = 0

CREATE UNIQUE CLUSTERED INDEX [acct_xref_dim_tmp_idx] ON #ACCT_XREF_DIM_TMP ([CIF_KEY], [APPL], [ACCT_KEY]) ON [PRIMARY]

BEGIN
        SET NOCOUNT ON;
        
        /*SET VARIABLE STARTS*/
        BEGIN
                SET @Status = 'I';
                SET @tempUTCDt = GETUTCDATE();
                SET @tempDt = dbo.ConvertToBankLocalTime(@tempUTCDt);
                SET @BatchStartDT_YYYYMM = LEFT(CONVERT(varchar, @BatchStartDT, 112), 6);
                SET @BatchEndDT_YYYYMM = LEFT(CONVERT(varchar, @BatchEndDT, 112), 6);
                
                SELECT @BatchStartDT = DetectionStartDt, @BatchEndDT = DetectionEndDt 
                        FROM dbo.HRS_DetectionBatch 
                        WHERE Id = @BatchId;
                        
                SELECT TOP 1 @CustomerType = [TYPE], @ScenarioGroupId = ScenarioGroupId 
                        FROM dbo.HRS_CUST_RISK_MGMT WITH (NOLOCK) WHERE CIF_KEY = @CIFKey AND BatchId = @BatchId;
        
                --get bank country
                SELECT @BankCountry = CtrlVal   
                        FROM dbo.POCTRL   
                        WHERE CtrlKey = 'BANK_COUNTRY' AND Module IS NULL;
                        
                --get hrs ranking
                SELECT TOP 1 @HRS_MED = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'HRS_MED' AND Module = 'HRS'
                SELECT TOP 1 @HRS_HIGH = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'HRS_HIGH' AND Module = 'HRS'
        END
        /*SET VARIABLE ENDS*/
        
        /*DATA PREPARATION STARTS*/
        BEGIN
                /***Part 1 (Customer background from CIP)***/
                BEGIN
                        /*Individual*/
                        IF @CustomerType = 'P'
                        BEGIN
                                /*HRST0001 - The primary business for account holder is : {Parameter1}*/
                                IF EXISTS(SELECT 1 FROM dbo.HRS_ScenarioTemplates A WITH (NOLOCK) 
                                                  JOIN dbo.HRS_ScenarioTemplateSettings B WITH (NOLOCK) ON A.ID = B.TemplateId 
                                                  WHERE A.ID = 1 AND A.Visible = 'TRUE' AND B.Enabled = 1 AND B.ScenarioGroupId = @ScenarioGroupId)
                                BEGIN
                                        INSERT INTO @Temp_HRS_CustData_Buffer (BatchId, CIFKey, TemplateId, Answer1)
                                                SELECT BatchId, CIFKey, 1, NAICSCode 
                                                        FROM dbo.HRS_Customer_Fact WITH (NOLOCK)
                                                        WHERE ISNULL(NAICSCode, '') <> '' AND BatchId = @BatchId AND CIFKey = @CIFKey;
                                        IF @@ERROR != 0
                                        BEGIN
                                                SET @Error = 'HRST0001';
                                                SET @Status = 'F';
                                                GOTO FINALLY;
                                        END 
                                END
                
                                /*HRST0005 - Has form a reasonable belief that the account holder is a high risk customer (Ex: customer with suspicious transactions filed etc.)? {Parameter1}*/
                                IF EXISTS(SELECT 1 FROM dbo.HRS_ScenarioTemplates A WITH (NOLOCK) 
                                                  JOIN dbo.HRS_ScenarioTemplateSettings B WITH (NOLOCK) ON A.ID = B.TemplateId 
                                                  WHERE A.ID = 5 AND A.Visible = 'TRUE' AND B.Enabled = 1 AND B.ScenarioGroupId = @ScenarioGroupId)
                                BEGIN
                                        INSERT INTO @Temp_HRS_CustData_Buffer (BatchId, CIFKey, TemplateId, Answer1)
                                                SELECT BatchId, CIFKey, 5, CASE WHEN IsHighRisk = 'Y' THEN 'TRUE' ELSE 'FALSE' END
                                                        FROM dbo.HRS_Customer_Fact WITH (NOLOCK)
                                                        WHERE ISNULL(IsHighRisk, '') <> '' AND BatchId = @BatchId AND CIFKey = @CIFKey;
                                        IF @@ERROR != 0
                                        BEGIN
                                                SET @Error = 'HRST0005'
                                                SET @Status = 'F'  
                                                GOTO FINALLY
                                        END
                                END 

                                /*HRST0009 - The account holder is an employee of the financial institution (CTCB) : {Parameter1}*/
                                IF EXISTS(SELECT 1 FROM dbo.HRS_ScenarioTemplates A WITH (NOLOCK) 
                                                  JOIN dbo.HRS_ScenarioTemplateSettings B WITH (NOLOCK) ON A.ID = B.TemplateId 
                                                  WHERE A.ID = 9 AND A.Visible = 'TRUE' AND B.Enabled = 1 AND B.ScenarioGroupId = @ScenarioGroupId)
