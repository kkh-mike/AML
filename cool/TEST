	/* INSERT DATA */	
	SET @NSTRSQL = 'SELECT BATCHID,
							B.CIF_KEY, 
							CUST_NO = (SELECT CustomerNo FROM dbo.BSA_SUB_CUST_FACT WITH(NOLOCK) WHERE CIF_KEY = B.CIF_KEY),
							CUST_NAME = B.CUST_NME,
							SRC, 
							SRC_DESC = (SELECT ' + @SRC_COLUMN + ' FROM dbo.WORKFLOW_MGMT_MODULE WITH(NOLOCK) WHERE MEMBERCODE = A.SRC),
							QUEUEID, 
							QUEUENAME = (SELECT QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = A.QUEUEID), 
							B.BRNCH_NBR, 
							BRNCH_DESC = (SELECT BRNCH_DESC FROM WAREHOUSE' + @BNK_NBR + '..BRANCH_DIM WITH(NOLOCK) WHERE BRNCH_NBR = B.BRNCH_NBR), 
							CUST_TYPE = CASE B.CUST_TYPE_CDE WHEN ''P'' THEN ''Individual'' WHEN ''N'' THEN ''Business'' ELSE '''' END,
							HANDLEDBY = HANDLEDBY,
							HANDLEDBY_NAME = (SELECT LTRIM(RTRIM(ISNULL(FirstName,'''') + '' '' + ISNULL(LastName,''''))) FROM dbo.USERACCOUNTS WITH(NOLOCK) WHERE USERID = A.HANDLEDBY AND DELETED = 0),
							ROLE,
							ROLE_DESC = ISNULL((SELECT ' + @ROLE_COLUMN + ' FROM dbo.WORKFLOW_MGMT_ROLE WITH(NOLOCK) WHERE ID = A.ROLE), ''''),
							TYPE,
							TIMEOUT = ISNULL(TIMEOUT, ''''),
							B.REM_CDE,
							B.REM_NME,
							A.CreatedDate,
							A.RiskRanking,
							A.CaseType
					FROM dbo.[' + @TBL_EMAIL + '] A WITH(NOLOCK), dbo.PB_CUSTOMER_FACT B WITH(NOLOCK)
					WHERE A.SRC NOT IN (''SAR'',''FST'') AND A.CIF_KEY = B.CIF_KEY '
					
	
	
	INSERT INTO #CASEDETECTOR_EMAILCASE (BATCHID, REF_KEY, CUST_NO, CUST_NAME, SRC, SRC_DESC, QUEUEID, QUEUENAME, BRNCH_NBR, BRNCH_DESC, CUST_TYPE, 
											HANDLEDBY, HANDLEDBY_NAME, [ROLE], ROLE_DESC, [TYPE], [TIMEOUT], RMCode, RMName, CreatedDate, RiskRanking, CaseType)
	EXEC SP_EXECUTESQL @NSTRSQL
	
	
	SET @NSTRSQL = ' SELECT BATCHID,
							REF_KEY, 
							CUST_NO = (SELECT STUFF(
										(SELECT CONCAT(ISNULL(CASE WHEN LEN(Value)> 5
													THEN 
													ISNULL(REPLICATE(N''X'', LEN(Value)-5),'''') + ISNULL(SUBSTRING(Value,LEN(Value)-4,5),'''')
													ELSE
													ISNULL(SUBSTRING(Value,0,LEN(Value)-1),'''')+''XX''
													END,''''), ''|'')
										FROM dbo.fnStringSplitter(SUBSTRING(B.CustomerNo, 0, LEN(B.CustomerNo)), ''|'') FOR XML PATH('''')), 1, 0, '''')),
							CUST_NAME = (SELECT STUFF(
											(SELECT CONCAT(ISNULL((CASE WHEN UNICODE(SUBSTRING(Y.CUST_NAME,1,1)) > 128
												THEN
												(CASE WHEN LEN(Y.CUST_NAME) > 2  
												THEN
												SUBSTRING(Y.CUST_NAME,1,1) + ''X'' + SUBSTRING(Y.CUST_NAME,3,1) + ISNULL(REPLICATE(N''X'', LEN(Y.CUST_NAME)-3),'''')
												ELSE
												SUBSTRING(Y.CUST_NAME,1,1) + ''X''
												END )
												ELSE
												SUBSTRING(Y.CUST_NAME+'' '', 1, CHARINDEX('' '',Y.CUST_NAME+'' '',1)) + ISNULL(REPLICATE(N''X'', LEN(Y.CUST_NAME+'' '')-CHARINDEX('' '',Y.CUST_NAME+'' '',1)),'''')
												END),''''), ''|'')
											FROM (
												SELECT SUBSTRING(X.Value, 0, CHARINDEX(''('', X.Value)) AS CUST_NAME
												FROM (
													SELECT Value FROM dbo.fnStringSplitter(SUBSTRING(B.AllCustomerName, 0, LEN(B.AllCustomerName)), ''|'')
												) X
											) Y FOR XML PATH('''')), 1, 0, '''')),
							SRC, 
							SRC_DESC = (SELECT ' + @SRC_COLUMN + ' FROM dbo.WORKFLOW_MGMT_MODULE WITH(NOLOCK) WHERE MEMBERCODE = A.SRC),
							A.QUEUEID, 
							QUEUENAME = (SELECT QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = A.QUEUEID), 
							BRNCH_NBR = B.BranchNo, 
							BRNCH_DESC = (SELECT BRNCH_DESC FROM WAREHOUSE' + @BNK_NBR + '..BRANCH_DIM WITH(NOLOCK) WHERE BRNCH_NBR = B.BranchNo), 
							CUST_TYPE = '''',
							HANDLEDBY = A.HANDLEDBY,
							HANDLEDBY_NAME = (SELECT LTRIM(RTRIM(ISNULL(FirstName,'''') + '' '' + ISNULL(LastName,''''))) FROM USERLICENSE' + @BNK_NBR + '.dbo.USERACCOUNTS WITH(NOLOCK) WHERE USERID = A.HANDLEDBY AND DELETED = 0),
							A.ROLE,
							ROLE_DESC = ISNULL((SELECT ' + @ROLE_COLUMN + ' FROM dbo.WORKFLOW_MGMT_ROLE WITH(NOLOCK) WHERE ID = A.ROLE), ''''),
							TYPE,
							TIMEOUT = ISNULL(TIMEOUT, ''''),
							RMCode = (SELECT STUFF((SELECT CONCAT(C.REM_CDE, ''|'') 
										FROM PB_Customer_Fact C 
										WHERE C.CIF_KEY IN (SELECT CIF_KEY FROM dbo.BSA_SUB_CUST_FACT WHERE CustomerNo IN (SELECT Value FROM dbo.fnStringSplitter(SUBSTRING(B.CustomerNo, 0, LEN(B.CustomerNo)), ''|'')))
										FOR XML PATH('''')), 1, 0, '''')),
							RMName = (SELECT STUFF((SELECT CONCAT(C.REM_NME, ''|'') 
										FROM PB_Customer_Fact C 
										WHERE C.CIF_KEY IN (SELECT CIF_KEY FROM dbo.BSA_SUB_CUST_FACT WHERE CustomerNo IN (SELECT Value FROM dbo.fnStringSplitter(SUBSTRING(B.CustomerNo, 0, LEN(B.CustomerNo)), ''|'')))
										FOR XML PATH('''')), 1, 0, '''')),
							B.CreatedDate
					FROM dbo.[' + @TBL_EMAIL + '] A WITH(NOLOCK) LEFT JOIN dbo.SAR_Header_Main B WITH(NOLOCK) ON A.BATCHID = B.BATID AND A.REF_KEY = B.GROUPID
					WHERE SRC IN (''SAR'',''FST'') '
	
	INSERT INTO #CASEDETECTOR_EMAILCASE (BATCHID, REF_KEY, CUST_NO, CUST_NAME, SRC, SRC_DESC, QUEUEID, QUEUENAME, BRNCH_NBR, BRNCH_DESC, CUST_TYPE, 
											HANDLEDBY, HANDLEDBY_NAME, [ROLE], ROLE_DESC, [TYPE], [TIMEOUT], RMCode, RMName, CreatedDate)
	EXEC SP_EXECUTESQL @NSTRSQL
	
	SELECT @INTCNT = 0,
			@MAXCNT = ISNULL((SELECT MAX(ID) FROM #CASEDETECTOR_EMAILCASE), 0)
			
	WHILE @INTCNT < @MAXCNT
	BEGIN
		SELECT @INTCNT = @INTCNT + 1,
				@SEND_ALL = 'N'
		
		SELECT	
			@BATCHID = BATCHID,
			@QUEUEID = QUEUEID,
			@REF_KEY = REF_KEY,
			@SRC = SRC,
			@HANDLEDBY = HANDLEDBY,
			@ROLE = [ROLE],
			@TYPE = [TYPE]
		FROM #CASEDETECTOR_EMAILCASE 
		WHERE ID = @INTCNT
		
		IF @SRC = 'CIP'
		BEGIN
			/* FOR APPROVE AND RETURN - HANDLEDBY & ROLE PASSED IS THE ACTION PERSON */
			IF @TYPE IN ('APPROVE')
			BEGIN
				SET @NSTRSQL = 'SELECT @HANDLEDBY = HANDLEDBY, 
										@ROLE = ROLE 
								FROM dbo.[' + @TBL_EMAIL + '] WITH(NOLOCK) 
								WHERE CIF_KEY = CAST(@REF_KEY AS UNIQUEIDENTIFIER) '
				EXEC SP_EXECUTESQL @NSTRSQL, N'@REF_KEY NVARCHAR(100), @HANDLEDBY NVARCHAR(60) OUTPUT, @ROLE INT OUTPUT', @REF_KEY, @HANDLEDBY OUTPUT, @ROLE OUTPUT
			END
			
			IF @TYPE IN ('RETURN')
			BEGIN
				SET @NSTRSQL = 'SELECT @HANDLEDBY = HANDLEDBY, 
										@ROLE = ROLE 
								FROM dbo.CIP_CUST_RISK_MGMT WITH(NOLOCK) 
								WHERE CIF_KEY = CAST(@REF_KEY AS UNIQUEIDENTIFIER) '
				EXEC SP_EXECUTESQL @NSTRSQL, N'@REF_KEY NVARCHAR(100), @HANDLEDBY NVARCHAR(60) OUTPUT, @ROLE INT OUTPUT', @REF_KEY, @HANDLEDBY OUTPUT, @ROLE OUTPUT
			END
			
			SET @NSTRSQL = 'SELECT CIF_KEY, APPL, ACCT_KEY FROM dbo.CIP_ACCT_RISK_MGMT WITH(NOLOCK) WHERE CIF_KEY = CAST(@REF_KEY AS UNIQUEIDENTIFIER) AND NEWACCTFLAG = ''Y'''
			INSERT INTO #CASEDETECTOR_EMAILACCT (REF_KEY, APPL, ACCT_KEY)
			EXEC SP_EXECUTESQL @NSTRSQL, N'@REF_KEY NVARCHAR(100)', @REF_KEY
		END
		ELSE IF @SRC = 'HRS'
		BEGIN
			/* FOR APPROVE AND RETURN - HANDLEDBY & ROLE PASSED IS THE ACTION PERSON */
			IF @TYPE IN ('APPROVE')
			BEGIN
				SET @NSTRSQL = 'SELECT @HANDLEDBY = HANDLEDBY, 
										@ROLE = ROLE 
								FROM dbo.[' + @TBL_EMAIL + '] WITH(NOLOCK) 
								WHERE BATCHID = @BATCHID
								AND CIF_KEY = CAST(@REF_KEY AS UNIQUEIDENTIFIER) '
				EXEC SP_EXECUTESQL @NSTRSQL, N'@BATCHID NVARCHAR(50), @REF_KEY NVARCHAR(100), @HANDLEDBY NVARCHAR(60) OUTPUT, @ROLE INT OUTPUT', @BATCHID, @REF_KEY, @HANDLEDBY OUTPUT, @ROLE OUTPUT
			END
			
			IF @TYPE IN ('RETURN')
			BEGIN
				SET @NSTRSQL = 'SELECT @HANDLEDBY = HANDLEDBY, 
										@ROLE = ROLE 
								FROM dbo.HRS_CUST_RISK_MGMT WITH(NOLOCK) 
								WHERE BATCHID = @BATCHID
								AND CIF_KEY = CAST(@REF_KEY AS UNIQUEIDENTIFIER) '
				EXEC SP_EXECUTESQL @NSTRSQL, N'@BATCHID NVARCHAR(50), @REF_KEY NVARCHAR(100), @HANDLEDBY NVARCHAR(60) OUTPUT, @ROLE INT OUTPUT', @BATCHID, @REF_KEY, @HANDLEDBY OUTPUT, @ROLE OUTPUT
			END
		END
		ELSE IF @SRC IN ('SAR','FST')
		BEGIN
			/* FOR APPROVE AND RETURN - HANDLEDBY & ROLE PASSED IS THE ACTION PERSON */
			IF @TYPE IN ('APPROVE')
			BEGIN
				SET @NSTRSQL = 'SELECT @HANDLEDBY = HANDLEDBY, 
										@ROLE = ROLE 
								FROM dbo.[' + @TBL_EMAIL + '] WITH(NOLOCK) 
								WHERE REF_KEY = @REF_KEY 
								AND BATID = @BATCHID'
				EXEC SP_EXECUTESQL @NSTRSQL, N'@BATCHID NVARCHAR(50), @REF_KEY NVARCHAR(100), @HANDLEDBY NVARCHAR(60) OUTPUT, @ROLE INT OUTPUT', @BATCHID, @REF_KEY, @HANDLEDBY OUTPUT, @ROLE OUTPUT
			END
			
			IF @TYPE IN ('RETURN')
			BEGIN
				SET @NSTRSQL = 'SELECT @HANDLEDBY = HANDLEDBY, 
										@ROLE = ROLE 
								FROM dbo.SAR_Header_Main WITH(NOLOCK) 
								WHERE GROUPID = @REF_KEY 
								AND BATID = @BATCHID'
				EXEC SP_EXECUTESQL @NSTRSQL, N'@BATCHID NVARCHAR(50), @REF_KEY NVARCHAR(100), @HANDLEDBY NVARCHAR(60) OUTPUT, @ROLE INT OUTPUT', @BATCHID, @REF_KEY, @HANDLEDBY OUTPUT, @ROLE OUTPUT
			END
		END
		
		IF ISNULL(@HANDLEDBY, '') = ''
			SET @SEND_ALL = 'Y'
		
		IF @TYPE IN ('NEW', 'TIMEOUT', 'ESCALATE')
		BEGIN
			IF @SEND_ALL = 'Y'
			BEGIN
				SET @NSTRSQL = '
					SELECT 
						@BATCHID,
						@REF_KEY, 
						A.USERID, 
						USERNAME = LTRIM(RTRIM(ISNULL(A.FirstName,'''') + '' '' + ISNULL(A.LastName,''''))),
						A.EMAIL,
						B.QUEUEID,
						QUEUENAME = ISNULL((SELECT QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = B.QUEUEID), ''''),
						B.ROLE,
						ROLE_DESC = ISNULL((SELECT ' + @ROLE_COLUMN + ' FROM dbo.WORKFLOW_MGMT_ROLE WITH(NOLOCK) WHERE ID = B.ROLE), ''''),
						@TYPE
					FROM dbo.USERACCOUNTS A WITH(NOLOCK), dbo.WORKFLOW_MGMT_USERS B WITH(NOLOCK) 
					WHERE ISNULL(EMAIL, '''') <> ''''
					AND A.USERID = B.USERID
					AND A.DELETED = 0 
					AND A.DISABLED = 0
					AND B.QUEUEID = @QUEUEID
					AND ISNULL(B.ALERTMAIN,'''') <> ''N''
					AND @TIMELOCAL >= CONVERT(VARCHAR,ISNULL(B.ALERTMAIN_FROM,''00:00:00''),108)
					AND @TIMELOCAL <= CONVERT(VARCHAR,ISNULL(B.ALERTMAIN_TO,''23:59:59''),108)
					AND EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = @QUEUEID 
							AND ((@TYPE = ''NEW'') OR (ALERT = ''Y'' AND @TYPE = ''TIMEOUT''))
							AND ((@ROLE = 1 AND ((B.[ROLE] = @ROLE) OR (B.[ROLE] = 2)))
								OR (@ROLE = 2 AND B.[ROLE] = @ROLE)
								OR (@ROLE = 3 AND ((B.[ROLE] = @ROLE) OR (B.[ROLE] = 4)))
								OR (@ROLE = 4 AND B.[ROLE] = @ROLE)))'
			END
			ELSE
			BEGIN
				SET @NSTRSQL = '
					SELECT 
						@BATCHID,
						@REF_KEY, 
						A.USERID, 
						USERNAME = LTRIM(RTRIM(ISNULL(A.FirstName,'''') + '' '' + ISNULL(A.LastName,''''))),
						A.EMAIL,
						B.QUEUEID,
						QUEUENAME = ISNULL((SELECT QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = B.QUEUEID), ''''),
						B.ROLE,
						ROLE_DESC = ISNULL((SELECT ' + @ROLE_COLUMN + ' FROM dbo.WORKFLOW_MGMT_ROLE WITH(NOLOCK) WHERE ID = B.ROLE), ''''),
						@TYPE
					FROM dbo.USERACCOUNTS A WITH(NOLOCK), dbo.WORKFLOW_MGMT_USERS B WITH(NOLOCK) 
					WHERE ISNULL(EMAIL, '''') <> ''''
					AND A.USERID = B.USERID
					AND A.DELETED = 0 
					AND A.DISABLED = 0
					AND B.QUEUEID = @QUEUEID
					AND ISNULL(B.ALERTPERSONAL,'''') <> ''N''
					AND @TIMELOCAL >= CONVERT(VARCHAR,ISNULL(B.ALERTPERSONAL_FROM,''00:00:00''),108)
					AND @TIMELOCAL <= CONVERT(VARCHAR,ISNULL(B.ALERTPERSONAL_TO,''23:59:59''),108)
					AND EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = B.QUEUEID 
								AND ((@TYPE = ''NEW'') OR (ALERT_PERSONAL = ''Y'' AND @TYPE = ''TIMEOUT''))
								AND ((@ROLE = 1 AND ((B.USERID = @USERID AND B.[ROLE] = @ROLE) OR (B.[ROLE] = 2)))
										OR (@ROLE = 2 AND B.USERID = @USERID AND B.[ROLE] = @ROLE)
										OR (@ROLE = 3 AND ((B.USERID = @USERID AND B.[ROLE] = @ROLE) OR (B.[ROLE] = 4)))
										OR (@ROLE = 4 AND B.USERID = @USERID AND B.[ROLE] = @ROLE)))'
			END
		END
		ELSE IF @TYPE IN ('APPROVE')
		BEGIN
			SET @NSTRSQL = '
				SELECT 
					@BATCHID,
					@REF_KEY, 
					A.USERID, 
					USERNAME = LTRIM(RTRIM(ISNULL(A.FirstName,'''') + '' '' + ISNULL(A.LastName,''''))),
					A.EMAIL,
					B.QUEUEID,
					QUEUENAME = ISNULL((SELECT QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE QUEUEID = B.QUEUEID), ''''),
					B.ROLE,
					ROLE_DESC = ISNULL((SELECT ' + @ROLE_COLUMN + ' FROM dbo.WORKFLOW_MGMT_ROLE WITH(NOLOCK) WHERE ID = B.ROLE), ''''),
					@TYPE
				FROM dbo.USERACCOUNTS A WITH(NOLOCK), dbo.WORKFLOW_MGMT_USERS B WITH(NOLOCK)
				WHERE A.USERID = B.USERID
				AND ISNULL(A.EMAIL, '''') <> ''''
				AND A.DELETED = 0 
				AND A.DISABLED = 0
				AND QUEUEID = @QUEUEID
				AND ROLE < @ROLE
				AND @ROLE > 2
				AND ISNULL(B.ALERTMAIN, '''') <> ''N''
				AND @TIMELOCAL >= CONVERT(VARCHAR,ISNULL(ALERTMAIN_FROM,''00:00:00''),108)
				AND @TIMELOCAL <= CONVERT(VARCHAR,ISNULL(ALERTMAIN_TO,''23:59:59''),108) '
		END
		ELSE IF @TYPE IN ('RELEASE', 'ISSUE')
		BEGIN
			 IF @ROLE > 1
				SET @NSTRSQL = '
					SELECT 
						@BATCHID,
