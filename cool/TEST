# ==========================================
# 0. 透過安控 DLL 動態取得帳密與伺服器資訊
# ==========================================
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (!(Test-Path $dllPath)) {
    Write-Host "找不到安控組件：$dllPath" -ForegroundColor Red
    exit 1
}

Add-Type -Path $dllPath
$App = New-Object Tsbldapdbc.RunBat
$App.SSL = $false
$App.ldapHost = "10.13.60.66"
$App.searchBase = "o=tsbank"
$sApp = "AML"
$iCStr = 1
$ret2 = $App.GetRunBat($sApp, $iCStr)

Write-Host "取得安控資訊: $ret2"

if ($ret2 -like "Error:*" -or [string]::IsNullOrWhiteSpace($ret2)) {
    Write-Error "取得連線字串失敗: $ret2"
    exit 1
}

# 解析連線字串
$Server   = if ($ret2 -match "(?i)server=([^;]+)") { $matches[1] } else { "" }
$User     = if ($ret2 -match "(?i)user\s*id=([^;]+)") { $matches[1] } else { "" }
$Password = if ($ret2 -match "(?i)password=([^;]+)") { $matches[1] } else { "" }
$Database = "SARCaseWarehouse"  # 指定目標 Database

Write-Host "========================================="
Write-Host "Server   : $Server"
Write-Host "User     : $User"
Write-Host "Database : $Database"
Write-Host "========================================="

# ==========================================
# 1. 建立資料夾
# ==========================================
$OutputFolder = Join-Path -Path $PSScriptRoot -ChildPath "Split"
$LogFolder    = Join-Path -Path $PSScriptRoot -ChildPath "Log"

if (!(Test-Path $OutputFolder)) { New-Item -ItemType Directory -Path $OutputFolder | Out-Null }
if (!(Test-Path $LogFolder))    { New-Item -ItemType Directory -Path $LogFolder    | Out-Null }

# 清除舊的分割檔與 Log
Write-Host "清除舊的 Split 與 Log 檔案..."
Remove-Item "$OutputFolder\*.sql" -Force -ErrorAction SilentlyContinue
Remove-Item "$LogFolder\*.log"    -Force -ErrorAction SilentlyContinue

# ==========================================
# 2. 搜尋當下目錄所有的 .sql 來源檔案
# ==========================================
# 只抓取當前目錄（不遞迴抓取 Split 目錄）
$SourceSqlFiles = Get-ChildItem -Path $PSScriptRoot -Filter "*.sql" -File

if ($SourceSqlFiles.Count -eq 0) {
    Write-Host "當前目錄下找不到任何 .sql 檔案！" -ForegroundColor Red
    exit 1
}

Write-Host "共找到 $($SourceSqlFiles.Count) 個 SQL 來源檔案。"

# ==========================================
# 3. 逐一處理每個 SQL 檔：分割並執行
# ==========================================
$TotalAllBatches = 0
$TotalSuccess    = 0
$TotalFailed     = 0
$HasError        = $false

foreach ($SourceFile in $SourceSqlFiles) {
    $baseName = $SourceFile.BaseName
    Write-Host "`n========================================="
    Write-Host "正在處理檔案: $($SourceFile.Name)"
    Write-Host "========================================="

    # 讀取檔案內容
    $Content = Get-Content $SourceFile.FullName -Raw -Encoding UTF8
    
    # 依 GO 分割
    $Batches = [regex]::Split($Content, '(?im)^\s*GO\s*;?\s*$') | Where-Object { ![string]::IsNullOrWhiteSpace($_) }
    
    if ($Batches.Count -eq 0) {
        Write-Host "檔案為空或無有效 Batch，略過。" -ForegroundColor Yellow
        continue
    }

    Write-Host "共分割為 $($Batches.Count) 個 Batch，開始產生分割檔與執行..."

    for ($i = 1; $i -le $Batches.Count; $i++) {
        $TotalAllBatches++
        $OutputFile = Join-Path $OutputFolder "${baseName}_$i.sql"
        $LogFile    = Join-Path $LogFolder    "${baseName}_$i.log"

        # 寫入分割後的 SQL 檔
        $SqlContent = $Batches[$i - 1].Trim() + "`r`nGO`r`n"
        Set-Content -Path $OutputFile -Value $SqlContent -Encoding UTF8

        # 執行 sqlcmd
        Write-Host "執行 [$i / $($Batches.Count)] -> $($OutputFile | Split-Path -Leaf)"
        
        sqlcmd `
            -S $Server `
            -U $User `
            -P $Password `
            -d $Database `
            -i $OutputFile `
            -o $LogFile

        if ($LASTEXITCODE -eq 0) {
            Write-Host "  -> SUCCESS：執行成功" -ForegroundColor Green
            $TotalSuccess++
        }
        else {
            Write-Host "  -> FAILED：執行失敗，請檢查 $LogFile" -ForegroundColor Red
            $TotalFailed++
            $HasError = $true
            break  # 當前檔案出錯即中斷後續執行
        }
    }

    # 如果有錯誤，直接停止後續其他檔案的執行
    if ($HasError) {
        Write-Host "`n偵測到錯誤，終止後續所有 SQL 執行。" -ForegroundColor Red
        break
    }
}

# ==========================================
# 4. 總結執行結果
# ==========================================
Write-Host "`n========================================="
Write-Host "全部作業執行完成"
Write-Host "========================================="
Write-Host "已處理 Batch 總數 : $TotalAllBatches"
Write-Host "成功 Batch 數     : $TotalSuccess"
Write-Host "失敗 Batch 數     : $TotalFailed"

if (-not $HasError) {
    Write-Host "`n🎉 所有目錄下的 SQL 檔案皆順利執行完畢！" -ForegroundColor Green
}
else {
    Write-Host "`n⚠️ 部分 SQL 執行失敗，請至 Log 資料夾查看詳細原因。" -ForegroundColor Red
}

Write-Host ""
Read-Host "按 Enter 結束"
