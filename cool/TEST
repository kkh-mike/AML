USE [BSADBJP];
GO

-- 定義測試用隨機碼
DECLARE @RAND NVARCHAR(20) = 'TEST' + REPLACE(CONVERT(VARCHAR(8), GETDATE(), 112), ':', '') + '01';

-- 步驟 1：初始化並寫入輸入名字
EXEC dbo.NMCHK_InitiateNewAcctTables
    @RANDNUM              = @RAND,
    @NAME                 = N'Rahmani, Arsalan',
    @RELATIONSHIP         = 'Primary',
    @UserID               = 'SYSTEM',
    @CombineKey           = 0,
    @NameCategory         = 1; -- 1: Individual, 2: Entity

-- 步驟 2：呼叫比對引擎主程序進行比對
EXEC dbo.NMCHK_AUTOMATION @RANDNUM = @RAND;

-- 步驟 3：查看比對引擎產生了哪些結果暫存表
SELECT name, create_date 
FROM sys.tables 
WHERE name LIKE '%' + @RAND + '%'
ORDER BY create_date DESC;
