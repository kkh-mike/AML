                                BEGIN
                                        INSERT INTO @Temp_HRS_CustData_Buffer (BatchId, CIFKey, TemplateId, Answer1)
                                                SELECT BatchId, CIFKey, 10, CASE WHEN IsContractor = 'Y' THEN 'TRUE' ELSE 'FALSE' END
                                                        FROM dbo.HRS_Customer_Fact WITH (NOLOCK)
                                                        WHERE ISNULL(IsContractor, '') <> '' AND BatchId = @BatchId AND CIFKey = @CIFKey;
                                        IF @@ERROR != 0
