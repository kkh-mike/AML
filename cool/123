# ============================================
# Input Path
# ============================================
$folderPath = "D:\AML\SK\DTLBK"

# ============================================
# Baseline File
# ============================================
$baselineFile = Join-Path `
    $folderPath `
    "AML_CHECK_SUM.csv"

# ============================================
# Output Path
# ============================================
$outputPath = "D:\AML\SK\DTLBK"

# ============================================
# Output Files
# ============================================
$resultFile = Join-Path `
    $outputPath `
    "CHECK_RESULT_DTLBK.txt"

$logFile = Join-Path `
    $outputPath `
    "SKcheck_CHECK_SUM_DTLBK.log"

# ============================================
# 刪除舊結果
# ============================================
if (Test-Path $resultFile) {
    Remove-Item $resultFile -Force
}

if (Test-Path $logFile) {
    Remove-Item $logFile -Force
}

# ============================================
# Log Function
# ============================================
function Write-Log {
    param(
        [string]$msg
    )

    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    Add-Content `
        -Path $logFile `
        -Value "[$time] $msg"
}

# ============================================
# Start
# ============================================
Write-Log "============================================"
Write-Log "JOB START"
Write-Log "============================================"
Write-Log "Input Path   : $folderPath"
Write-Log "Baseline File: $baselineFile"
Write-Log "Output Path  : $outputPath"
Write-Log "Result File  : $resultFile"
Write-Log "Log File     : $logFile"
Write-Log "============================================"

$hasError = $false

# ============================================
# 檢查 Input Folder
# ============================================
if (!(Test-Path $folderPath)) {
    Write-Log "ERROR TYPE : INPUT FOLDER NOT FOUND"
    Write-Log "PATH       : $folderPath"
    $hasError = $true
}

# ============================================
# 檢查 Baseline
# ============================================
if (!$hasError -and !(Test-Path $baselineFile)) {
    Write-Log "ERROR TYPE : BASELINE FILE NOT FOUND"
    Write-Log "FILE       : AML_CHECK_SUM.csv"
    Write-Log "PATH       : $baselineFile"
    $hasError = $true
}

# ============================================
# 基本環境錯誤處理
# ============================================
if ($hasError) {
    "0" | Out-File -FilePath $resultFile -Encoding utf8
    Write-Log "============================================"
    Write-Log "FINAL RESULT: 0"
    Write-Log "STATUS      : FAILED"
    Write-Log "============================================"
    Write-Host "0"
    exit 1
}

# ============================================
# 讀取 AML_CHECK_SUM.csv
# ============================================
$baseline = @{}

try {
    $lines = Get-Content -Path $baselineFile -Encoding utf8

    foreach ($line in $lines) {
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        $parts = $line.Split(";")

        if ($parts.Count -lt 3) {
            Write-Log "============================================"
            Write-Log "ERROR TYPE : BASELINE FORMAT ERROR"
            Write-Log "LINE       : $line"
            Write-Log "============================================"
            $hasError = $true
            continue
        }

        $fileName  = $parts[0].Trim()
        $countText = $parts[1].Trim()
        $md5       = $parts[2].Trim().ToLowerInvariant()

        if ([string]::IsNullOrWhiteSpace($fileName)) {
            Write-Log "============================================"
            Write-Log "ERROR TYPE : EMPTY FILE NAME"
            Write-Log "LINE       : $line"
            Write-Log "============================================"
            $hasError = $true
            continue
        }

        $expectedCount = 0
        if (-not [int64]::TryParse($countText, [ref]$expectedCount)) {
            Write-Log "============================================"
            Write-Log "ERROR TYPE : INVALID COUNT"
            Write-Log "FILE       : $fileName"
            Write-Log "COUNT      : $countText"
            Write-Log "============================================"
            $hasError = $true
            continue
        }

        if ($md5 -notmatch '^[0-9a-f]{32}$') {
            Write-Log "============================================"
            Write-Log "ERROR TYPE : INVALID MD5"
            Write-Log "FILE       : $fileName"
            Write-Log "MD5        : $md5"
            Write-Log "============================================"
            $hasError = $true
            continue
        }

        $key = $fileName.ToLowerInvariant()
        $baseline[$key] = @{
            FileName = $fileName
            Count    = $expectedCount
            MD5      = $md5
        }
    }
}
catch {
    Write-Log "============================================"
    Write-Log "ERROR TYPE : BASELINE READ ERROR"
    Write-Log "MESSAGE    : $($_.Exception.Message)"
    Write-Log "============================================"
    $hasError = $true
}

if ($hasError) {
    "0" | Out-File -FilePath $resultFile -Encoding utf8
    Write-Log "FINAL RESULT: 0"
    Write-Log "STATUS      : FAILED"
    Write-Host "0"
    exit 1
}

# ============================================
# 開始逐檔比對 (支援 SQL & CSV 自動尋找相應檔案)
# ============================================
foreach ($key in $baseline.Keys) {

    $expectedFileName = $baseline[$key].FileName
    $expectedCount    = $baseline[$key].Count
    $expectedMD5      = $baseline[$key].MD5

    $targetFile = $null

    # 1. 直接比對原始檔名
    $directPath = Join-Path $folderPath $expectedFileName
    if (Test-Path $directPath) {
        $targetFile = $directPath
    }
    else {
        # 2. 自動嘗試變體名（容錯 .Table.sql / .sql / .csv）
        $baseStem = $expectedFileName -replace '(\.Table)?\.(sql|csv)$', ''
        
        $candidateFiles = @(
            (Join-Path $folderPath "$baseStem.sql"),
            (Join-Path $folderPath "$baseStem.Table.sql"),
            (Join-Path $folderPath "$baseStem.csv")
        )

        foreach ($candidate in $candidateFiles) {
            if (Test-Path $candidate) {
                $targetFile = $candidate
                $matchedLeaf = Split-Path $targetFile -Leaf
                Write-Log "INFO: Matched '$expectedFileName' -> local file '$matchedLeaf'"
                break
            }
        }
    }

    # 檢查是否成功定位檔案
    if ($null -eq $targetFile) {
        Write-Log "============================================"
        Write-Log "ERROR TYPE : FILE NOT FOUND"
        Write-Log "FILE       : $expectedFileName"
        Write-Log "PATH       : $directPath"
        Write-Log "============================================"
        $hasError = $true
        continue
    }

    # ========================================
    # 計算 Count + MD5
    # ========================================
    try {
        # Count 計算
        $actualCount = 0
        $reader = New-Object System.IO.StreamReader($targetFile)
        try {
            while ($reader.ReadLine() -ne $null) {
                $actualCount++
            }
        }
        finally {
            $reader.Close()
            $reader.Dispose()
        }

        # MD5 計算
        $actualMD5 = (
            Get-FileHash `
                -Path $targetFile `
                -Algorithm MD5
        ).Hash.ToLowerInvariant()

        # 比對 Count
        if ($actualCount -ne $expectedCount) {
            Write-Log "============================================"
            Write-Log "ERROR TYPE : COUNT MISMATCH"
            Write-Log "FILE       : $expectedFileName"
            Write-Log "ACTUAL FILE: $(Split-Path $targetFile -Leaf)"
            Write-Log "EXPECTED   : $expectedCount"
            Write-Log "ACTUAL     : $actualCount"
            Write-Log "============================================"
            $hasError = $true
        }

        # 比對 MD5
        if ($actualMD5 -ne $expectedMD5) {
            Write-Log "============================================"
            Write-Log "ERROR TYPE : MD5 MISMATCH"
            Write-Log "FILE       : $expectedFileName"
            Write-Log "ACTUAL FILE: $(Split-Path $targetFile -Leaf)"
            Write-Log "EXPECTED   : $expectedMD5"
            Write-Log "ACTUAL     : $actualMD5"
            Write-Log "============================================"
            $hasError = $true
        }
    }
    catch {
        Write-Log "============================================"
        Write-Log "ERROR TYPE : FILE PROCESS ERROR"
        Write-Log "FILE       : $expectedFileName"
        Write-Log "MESSAGE    : $($_.Exception.Message)"
        Write-Log "============================================"
        $hasError = $true
    }
}

# ============================================
# Final Result
# ============================================
Write-Log "============================================"

if ($hasError) {
    "0" | Out-File -FilePath $resultFile -Encoding utf8
    Write-Log "FINAL RESULT: 0"
    Write-Log "STATUS      : FAILED"
    Write-Log "============================================"
    Write-Host "0"
    exit 1
}
else {
    "1" | Out-File -FilePath $resultFile -Encoding utf8
    Write-Log "FINAL RESULT: 1"
    Write-Log "STATUS      : SUCCESS"
    Write-Log "============================================"
    Write-Host "1"
    exit 0
}



