# 1. 載入 PatriotOfficer 相關的服務元件 DLL
Add-Type -Path "D:\AML\SK\EXE\PatriotOfficer.Services.dll"
# 若有介面或依賴元件也可一併載入
# Add-Type -Path "D:\AML\SK\EXE\PatriotOfficer.Services.Interfaces.dll"

# 2. 建立 DefaultEncryptionService 物件實例
$encService = New-Object PatriotOfficer.Services.DefaultEncryptionService

# 3. 填入你的加密連線字串
$cipherText = ""

# 4. 呼叫解密方法 (通常為 Decrypt 或 DecryptString)
$plainText = $encService.Decrypt($cipherText)

# 5. 輸出解密後的連線資訊
Write-Output $plainText
