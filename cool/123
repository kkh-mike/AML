NMCHK_BULK_CombineResultsByBatch	SQL_STORED_PROCEDURE	2025-03-10 14:07:40.023	CREATE PROCEDURE [dbo].[NMCHK_BULK_CombineResultsByBatch]  @BatchID INT,  @DefaultRC INT  AS  DECLARE   @NMCHK_RC_Reduction INT = 0, --country = 1; dob = 2; low risk = 4;  /*   @NMCHK_RC_Reduction Bitwise   1 - Country   2 - DOB   4 - Low Risk List   8 - Nationality (CTBC)   16 - Gender (CTBC)   32 - Customer Type (CTBC)   64 - Native Name (Standard)   128 - Identification Number (Standard)  */  @NMCHK_CTRY_CHECK CHAR(1) = 'Y' -- Y to enable country checking    SELECT TOP 1 @NMCHK_CTRY_CHECK = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'NMCHK_CTRY_CHECK' AND Module = 'NMCHK';    IF OBJECT_ID('tempdb..#NMCHK_CustInfo', 'U') IS NOT NULL  BEGIN   DROP TABLE #NMCHK_CustInfo  END   CREATE TABLE #NMCHK_CustInfo(   UID NVARCHAR(20) NOT NULL,    new_acct_key INT NOT NULL,    new_acct_name NVARCHAR(350) NULL,    country NVARCHAR(50) NULL,    Nationality NVARCHAR(50) NULL,    DOB NVARCHAR(10) NULL,    AMLRefNo NVARCHAR(20) NULL,    NameSource NVARCHAR(20) NULL,    Gender NVARCHAR(2),   IdentificationNumber NVARCHAR(MAX),    NameCategory INT,   VesselIMONo NVARCHAR(MAX),   PRIMARY KEY (UID, new_acct_key)  )    IF OBJECT_ID('tempdb..#Temp_New_Acct_Matches_Table', 'U') IS NOT NULL  BEGIN   DROP TABLE #Temp_New_Acct_Matches_Table  END   CREATE TABLE #Temp_New_Acct_Matches_Table (   UID NVARCHAR(20) NOT NULL,   new_acct_key INT NOT NULL,    ent_num INT NOT NULL,    alt_num INT NOT NULL,    Ori_RC INT NULL,    Reduction_IND CHAR(10) NULL,   relative_correlation INT NULL,    sdn_name NVARCHAR (350) NULL,   sdn_type NVARCHAR (50) NOT NULL,    sdn_grp_num INT NOT NULL,   name_cat int NULL,   updated_date NVARCHAR (10) NULL,   section NVARCHAR (3) NULL,   NamePropertyBitCode int NULL,   SourceColumn VARCHAR(20) NULL   --PRIMARY KEY (UID, new_acct_key, sdn_type, sdn_grp_num, ent_num, alt_num)  )    CREATE NONCLUSTERED INDEX idx_#Temp_New_Acct_Matches_Table_1 ON #Temp_New_Acct_Matches_Table(uid, new_acct_key)    BEGIN  SET NOCOUNT ON    SELECT TOP 1 @NMCHK_RC_Reduction = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'NMCHK_RC_Reduction' AND Module = 'NMCHK'    INSERT INTO #NMCHK_CustInfo (UID, new_acct_key, new_acct_name, country, Nationality, DOB, AMLRefNo, NameSource,          Gender, IdentificationNumber, NameCategory, VesselIMONo)  SELECT A.uid, A.new_acct_key, A.new_acct_name, A.country, A.Nationality, A.DOB, A.REFNO, A.NameSource,       Gender, IDNUM, NameCategory, VesselIMONo  FROM dbo.NMCHK_CustInfo A WITH (NOLOCK)   WHERE EXISTS (SELECT 1 FROM dbo.NMCHK_BULK_Data B WITH (NOLOCK) WHERE A.uid = B.UID AND B.BatchId = @BatchID)    --Filteration (Gender, EntityType)  BEGIN    --Name Category    IF EXISTS(SELECT NULL FROM #NMCHK_CustInfo WHERE NameCategory <> 0)   BEGIN     DELETE A     FROM dbo.NMCHK_OtherListDetectionResults_Temp A     WHERE NOT EXISTS(SELECT NULL FROM #NMCHK_CustInfo X          WHERE A.NameKey = X.new_acct_key         AND X.NameCategory & A.name_cat <> 0 AND A.Uid = X.UID)      AND EXISTS(SELECT NULL FROM #NMCHK_CustInfo X             WHERE A.NameKey = X.new_acct_key          AND ISNULL(X.NameCategory,0) <> 0 AND A.Uid = X.UID)        --VesselIMONumber    IF EXISTS(SELECT NULL FROM #NMCHK_CustInfo WHERE NameCategory & 4 <> 0 AND ISNULL(VesselIMONo,'') <> '')    BEGIN      ;WITH CTE_DJ AS      (      SELECT D.SdnName, D.SubListGroupNumber, D.UpdatedDate, C.EntityId, C.IdentificationNumber       FROM BSADB..DJ_IdentificationTypeInfo C WITH (NOLOCK)       JOIN BSADB..DJ_List_Data_A D WITH (NOLOCK) ON C.EntityId = D.EntNum AND D.SubList = 'DJ' AND D.AltNum = 0      WHERE C.IdentificationType = 'International Maritime Organization (IMO) Ship No.' AND C.Deleted = 0      ),     CTE_WC AS      (      SELECT C.EntityId, C.IdentificationValue       FROM BSADB..WC_Identification C WITH (NOLOCK)       JOIN BSADB..WC_ListData D WITH (NOLOCK) ON C.EntityId = D.EntNum AND D.SubList = 'WC' AND D.AltNum = 0      WHERE C.IdentificationType = 'INT-IMO' AND C.IsDeleted = 0      )     DELETE A      FROM dbo.NMCHK_OtherListDetectionResults_Temp A       INNER JOIN #NMCHK_CustInfo B ON A.NameKey = B.new_acct_key AND A.[Uid] = B.[UID]     WHERE B.NameCategory & 4 = 4      AND ISNULL(B.VesselIMONo, '') <>''      --OFAC, EU, UKHMT       AND NOT EXISTS(SELECT NULL FROM dbo.OFAC_SDN_IMO X INNER JOIN dbo.BlackListData Y ON X.Ent_Num = Y.ent_num AND X.List = Y.list            WHERE A.ent_num = X.Ent_Num AND B.VesselIMONo = X.IMO_No AND X.Deleted = 'N')      --DJ      AND NOT EXISTS(SELECT NULL FROM CTE_DJ X             WHERE A.sdn_type IN ('DJ','DJ ALT') AND A.ent_num = X.EntityId AND B.VesselIMONo = X.IdentificationNumber)      --UN      AND NOT EXISTS(SELECT NULL FROM dbo.UN_Vessel_List X             WHERE A.sdn_type IN ('UN','UN ALT') AND A.ent_num = X.EntNum AND B.VesselIMONo = X.IMONumber AND X.IsDeleted = 0)      --WC      AND NOT EXISTS(SELECT NULL FROM CTE_WC X             WHERE A.sdn_type IN ('WC','WC ALT') AND A.ent_num = X.EntityId AND B.VesselIMONo = X.IdentificationValue)    END    END      --Gender    IF EXISTS (SELECT 1 FROM dbo.PO_DefaultData WITH (NOLOCK) WHERE Module = 'NMCHK' AND CtrlKey = 'GenderFilter' AND CtrlVal = 'Y')   BEGIN    IF EXISTS(SELECT NULL FROM #NMCHK_CustInfo WHERE ISNULL(Gender,'') <> '')    BEGIN      ;WITH CTE_GENDER AS      (      --EU      SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode      FROM dbo.NMCHK_OtherListDetectionResults_Temp A        INNER JOIN dbo.EU_SANCTIONS_NAME B ON A.ent_num = B.NAME_ID       INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode      WHERE A.sdn_type = 'EU'      UNION       SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, D.GenderCode      FROM dbo.NMCHK_OtherListDetectionResults_Temp A        INNER JOIN dbo.EU_SANCTIONS_NAME B ON A.ent_num = B.NAME_ID       INNER JOIN dbo.EU_SANCTIONS_ALT C ON B.ENTITY_ID = C.ENTITY_ID       INNER JOIN dbo.Gender_Dim D ON ISNULL(LTRIM(RTRIM(C.GENDER)),'') = D.GenderCode