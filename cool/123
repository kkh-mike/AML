ame_cat, updated_date, section, NamePropertyBitCode, SourceColumn   FROM CTE_EliminateDuplicate WITH(NOLOCK) WHERE CTE_EliminateDuplicate.RowIndex = 1     --RC Reduction   DECLARE    @COUNTRY_RC INT = 0,   @DOB_RC INT = 0,   @LowRiskList_RC INT = 0,   @Gender_RC INT = 0 ,   @NativeName_RC INT = 0,    @IdentificationNumber_RC INT = 0     SELECT TOP 1 @COUNTRY_RC = COUNTRY, @DOB_RC = DOB, @LowRiskList_RC = LowRiskList, @Gender_RC = Gender, @NativeName_RC = NativeName,      @IdentificationNumber_RC = IdentificationNumber   FROM dbo.OFACTDBSettings WITH(NOLOCK)      -- Insert / update RC reduction log    ;WITH CTE_UID AS (    SELECT DISTINCT UID FROM #NMCHK_CustInfo WITH(NOLOCK)   )   MERGE OFACTDBSettings_LOG AS T   USING CTE_UID AS S   ON T.UID = S.UID AND T.Module = 'NMCHK'   WHEN MATCHED THEN    UPDATE SET Country = @COUNTRY_RC, DOB = @DOB_RC, LowRiskList = @LowRiskList_RC, Gender = @Gender_RC, T.NativeName = @NativeName_RC,          IdentificationNumber = @IdentificationNumber_RC   WHEN NOT MATCHED BY TARGET THEN    INSERT (UID, Country, DOB, LowRiskList, Module, Gender, NativeName, IdentificationNumber)     VALUES (S.UID, @COUNTRY_RC, @DOB_RC, @LowRiskList_RC, 'NMCHK', @Gender_RC, @NativeName_RC, @IdentificationNumber_RC);     --RC Reduction  IF @NMCHK_RC_Reduction <> 0  BEGIN   DECLARE @tempOfacConsolidateList AS TABLE (List NVARCHAR(50))   INSERT INTO @tempOfacConsolidateList ( List )   SELECT DISTINCT List FROM BSADB.dbo.Blacklist_MainName WITH(NOLOCK)    UNION ALL   SELECT DISTINCT List + ' ALT' FROM BSADB.dbo.Blacklist_MainName WITH(NOLOCK)       /*    Reduction_IND    1 - Country    2 - DOB    3 - Low Risk    4 - Nationality (CTBC)    5 - Gender (CTBC)    6 - Customer Type (CTBC)    7 - Native Name (Standard)    8 - Identification Number (Standard)   */     -- country reduction (1)   IF (@NMCHK_RC_Reduction & 1) <> 0 AND @COUNTRY_RC > 0   BEGIN    --OFAC    UPDATE a     SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table a    INNER JOIN #NMCHK_CustInfo B ON A.UID = B.uid AND A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('OFAC', 'OFAC ALT') AND a.SECTION = '1'     --Check input name country/nationality is not empty     AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')    --Check SDN name country have country code     AND EXISTS(SELECT 1 FROM dbo.OFAC_ADDR y WITH(NOLOCK) WHERE a.ent_num = y.ENT_NUM        AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WITH(NOLOCK) WHERE C.CountryDescription = Y.COUNTRY           AND C.List = 'OFAC' AND C.ISO2_CountryCode IS NOT NULL))    --Check is not exists input name country/nationality = SDN name country; means all also not same, then can deduct RC     AND NOT EXISTS(SELECT 1 FROM dbo.OFAC_ADDR x WITH(NOLOCK) WHERE a.ent_num = x.ENT_NUM         AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WITH(NOLOCK) WHERE C.CountryDescription = X.COUNTRY            AND C.List = 'OFAC' AND C.ISO2_CountryCode IS NOT NULL            AND (C.ISO2_CountryCode = B.country OR C.ISO2_CountryCode = B.Nationality))        )            --SSI, FSE, OFAC Non-SDN    UPDATE a     SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table a    INNER JOIN #NMCHK_CustInfo B ON A.UID = B.uid AND A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN (SELECT List FROM @tempOfacConsolidateList) AND a.SECTION = '1'     --Check input name country/nationality is not empty     AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')    --Check SDN name country have country code     AND EXISTS(SELECT 1 FROM BSADB.dbo.Blacklist_Address y WITH(NOLOCK) WHERE a.ent_num = y.EntNum AND y.IsDeleted = 0       AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WITH(NOLOCK) WHERE C.CountryDescription = Y.COUNTRY           AND C.List = y.List AND C.ISO2_CountryCode IS NOT NULL))    --Check is not exist