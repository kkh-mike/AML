DBCHK_UpdateReviewMain	SQL_STORED_PROCEDURE	2025-03-10 14:07:47.020	CREATE PROC [dbo].[DBCHK_UpdateReviewMain]      @UID NVARCHAR(20),      @CIF_KEY uniqueidentifier,    @MODE CHAR(1),      @USERID NVARCHAR(40),      @ASSIGN_USERID NVARCHAR(40),    @QUEUEID NVARCHAR(10),    @ROLE VARCHAR(10),    @REMARK NVARCHAR(MAX),    @UPDATED_PERSON NVARCHAR(40),      @UPDATED_PERSONROLE NVARCHAR(10),  @ExtendedReviewDate DATETIME = NULL        AS      DECLARE       @CUR_DATE DATETIME,    @CUR_UTCDATE DATETIME  DECLARE @UpdateTemplate CHAR(1) = NULL;  SELECT @UpdateTemplate = CtrlVal FROM dbo.PO_DefaultData WHERE CtrlKey = 'EnableUpdateTemplateAnswer'  AND Module = 'CDD'    /*  Mode 1 = Return  Mode 2 = Release / Accept  Mode 3 = Reject   Mode 4 = Escalate   Mode 5 = Uncomplete case Save Remark   Mode 6 = Cancel  Mode 7 = Completed case Save Remark  Mode 8 = Extend Case Review Date  */    /* Override uncomplete case save remark to completed case save remark based on settings */  IF @MODE = '5'   IF EXISTS(SELECT * FROM dbo.PO_DefaultData WHERE Module = '' AND CtrlKey = 'DirectlyLogRemarkForUncompletedCase' AND CtrlVal = 'Y')    SET @MODE = '7'      CREATE TABLE #DBCHK_ResultGroups_Buffer_Temp  (   [UID] [nvarchar](20) NULL,   [SourceKey] [uniqueidentifier] NULL,   [SourceTable] [nvarchar](100) NULL,   [SourceRefNo] [nvarchar](100) NULL,   [SdnType] [nvarchar](15) NULL,   [IsFalsePositive] [varchar](1) NULL,   [NamePropertyBitCode] [int] NULL  )    CREATE TABLE #DBCHK_CustomerPreviousBlacklistFlag_Buffer_Temp  (   [BatchID] [bigint] NULL,   [SourceKey] [uniqueidentifier] NULL,   [SourceRefNo] [nvarchar](100) NULL,   [TableName] [nvarchar](100) NULL,   [IsPEPHit] [char](1) NULL,   [IsNegativeNews] [char](1) NULL,   [IsOtherListHit] [char](1) NULL,   [IsForeignPEP] [char](1) NULL,   [IsLocalPEP] [char](1) NULL,   [IsForeignOrgPEP] [char](1) NULL,   [IsExPEP] [char](1) NULL,   [isCalculated] [char](1) NULL,   [IsUpdated] [bit] NULL  )    CREATE TABLE #DBCHK_CustomerAfterBlacklistFlag_Buffer_Temp  (   [BatchID] [bigint] NULL,   [SourceKey] [uniqueidentifier] NULL,   [SourceRefNo] [nvarchar](100) NULL,   [TableName] [nvarchar](100) NULL,   [IsPEPHit] [char](1) NULL,   [IsNegativeNews] [char](1) NULL,   [IsOtherListHit] [char](1) NULL,   [IsForeignPEP] [char](1) NULL,   [IsLocalPEP] [char](1) NULL,   [IsForeignOrgPEP] [char](1) NULL,   [IsExPEP] [char](1) NULL,   [InsertSequence] [int] NULL  )    CREATE TABLE #DBCHK_PendingCaseSuspect_Buffer_Temp  (   [SourceTable] [nvarchar](100) NULL,   [SourceKey] [uniqueidentifier] NULL,   [SourceRefNo] [nvarchar](100) NULL  )    CREATE TABLE #ResultHistory_RemarkLog  (   Id INT NULL,   UID NVARCHAR(80) NULL,   SOURCEKEY UNIQUEIDENTIFIER NULL  )    IF OBJECT_ID('tempdb..#DBCHK_CIP_CUST_SUB_RISK_MGMT') IS NOT NULL   DROP TABLE #DBCHK_CIP_CUST_SUB_RISK_MGMT    IF OBJECT_ID('tempdb..#DBCHK_HRS_CUST_RISK_MGMT') IS NOT NULL   DROP TABLE #DBCHK_HRS_CUST_RISK_MGMT    IF OBJECT_ID('tempdb..#DBCHK_CIP_CUST_RISK_MGMT') IS NOT NULL   DROP TABLE #DBCHK_CIP_CUST_RISK_MGMT    IF OBJECT_ID('tempdb..#DBCHK_ResultGroups_Buffer_Temp_Filtered') IS NOT NULL   DROP TABLE #DBCHK_ResultGroups_Buffer_Temp_Filtered    IF OBJECT_ID('tempdb..#DBCHK_ResultGroups_Buffer_Temp_Filtered_NotExists') IS NOT NULL   DROP TABLE #DBCHK_ResultGroups_Buffer_Temp_Filtered_NotExists    CREATE TABLE #DBCHK_CIP_CUST_SUB_RISK_MGMT  (   PEPBitwiseCode INT NULL,   LegalAgentRefNo VARCHAR(100) NULL,   AppointerRefNo VARCHAR(100) NULL,   BoardOfDirectorRefNo VARCHAR(100) NULL,   MainClientRefNo VARCHAR(100) NULL,   MainShareHolderRefNo VARCHAR(100) NULL   )    CREATE TABLE #DBCHK_HRS_CUST_RISK_MGMT (BatchId BIGINT NOT NULL, IsCalculated CHAR(1) NULL)  CREATE TABLE #DBCHK_CIP_CUST_RISK_MGMT (CIF_KEY UNIQUEIDENTIFIER, IsCalculated CHAR(1) NULL)    CREATE TABLE #DBCHK_ResultGroups_Buffer_Temp_Filtered  (   SourceKey UNIQUEIDENTIFIER NULL,   SourceTable VARCHAR(200) NULL,   SourceRefNo NVARCHAR(100) NULL,   IsOtherListHit VARCHAR(1) NULL,   IsPEPHit VARCHAR(1) 