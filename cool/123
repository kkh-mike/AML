 = ISNULL(Y.GROUPID, 0) AND Y.DInd = 'N'        AND DATEPART(YEAR, dbo.TryParseDate(Y.DOB)) IS NOT NULL)    --Check is not exists input name DOB year = SDN name DOB year; means all also not same year, then can deduct RC     AND NOT EXISTS(SELECT 1 FROM BSADB.dbo.OFAC_GLSPEC B WITH(NOLOCK)         WHERE A.ent_num = B.ENT_NUM AND ISNULL(A.sdn_grp_num, 0) = ISNULL(B.GROUPID, 0) AND B.DInd = 'N'         AND DATEPART(YEAR, dbo.TryParseDate(B.DOB)) IS NOT NULL        AND DATEPART(YEAR, dbo.TryParseDate(B.DOB)) = YEAR(C.DOB)        AND (@CheckMonthLevel = 0          OR (@CheckMonthLevel = 1           AND ( --Check if CheckMonth is turned on, month value is not null and input name DOB month = SDN name DOB month             (CASE WHEN LEN(B.DOB) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DOB) = 1 THEN MONTH(B.DOB) ELSE NULL END END IS NOT NULL             AND CASE WHEN LEN(B.DOB) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DOB) = 1 THEN MONTH(B.DOB) ELSE NULL END END = MONTH(C.DOB)            ) --Or month value is null             OR CASE WHEN LEN(B.DOB) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DOB) = 1 THEN MONTH(B.DOB) ELSE NULL END END IS NULL           )          )         )        )       --EU    UPDATE A    SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @DOB_RC , Reduction_IND = STUFF(Reduction_IND, 2, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table A     INNER JOIN #NMCHK_CustInfo C ON A.UID = C.uid AND A.new_acct_key = C.new_acct_key     WHERE A.SDN_TYPE IN ('EU', 'EU ALT') AND A.SECTION = '1'     --Check input name DOB year is not null    AND ISNULL(C.DOB, '') <> ''    --Check is exists SDN name DOB year is not null    AND EXISTS(SELECT 1 FROM dbo.EU_SANCTIONS_BIRTH Y WITH(NOLOCK)        JOIN dbo.EU_SANCTIONS_NAME Z WITH(NOLOCK) ON Y.ENTITY_ID = Z.ENTITY_ID        WHERE A.ent_num = Z.NAME_ID AND Y.DEL_FLAG = 'N'       AND DATEPART(YEAR, dbo.TryParseDate(Y.DATE)) IS NOT NULL)    --Check is not exists input name DOB year = SDN name DOB year; means all also not same year, then can deduct RC     AND NOT EXISTS(SELECT 1 FROM dbo.EU_SANCTIONS_BIRTH B WITH(NOLOCK)         JOIN dbo.EU_SANCTIONS_NAME Z WITH(NOLOCK) ON B.ENTITY_ID = Z.ENTITY_ID         WHERE A.ent_num = Z.NAME_ID AND B.DEL_FLAG = 'N'        AND DATEPART(YEAR, dbo.TryParseDate(B.DATE)) IS NOT NULL        AND DATEPART(YEAR, dbo.TryParseDate(B.DATE)) = YEAR(C.DOB)        AND (@CheckMonthLevel = 0          OR (@CheckMonthLevel = 1           AND ( --Check if CheckMonth is turned on, month value is not null and input name DOB month = SDN name DOB month             (CASE WHEN LEN(B.DATE) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DATE) = 1 THEN MONTH(B.DATE) ELSE NULL END END IS NOT NULL             AND CASE WHEN LEN(B.DATE) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DATE) = 1 THEN MONTH(B.DATE) ELSE NULL END END = MONTH(C.DOB)            ) --Or month value is null             OR CASE WHEN LEN(B.DATE) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DATE) = 1 THEN MONTH(B.DATE) ELSE NULL END END IS NULL           )          )         )        )    END      -- low risk list reduction (4)   IF (@NMCHK_RC_Reduction & 4) <> 0 AND @LowRiskList_RC > 0   BEGIN    UPDATE a    SET a.RELATIVE_CORRELATION = a.RELATIVE_CORRELATION - @LowRiskList_RC, a.Reduction_IND = STUFF(a.Reduction_IND, 3, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table a, dbo.OFAC_SubList_DIM b WITH(NOLOCK), #NMCHK_CustInfo c,     dbo.LowRiskList_LowRiskListEntries x WITH(NOLOCK), dbo.LowRiskListEntries y WITH(NOLOCK)    WHERE dbo.fn_CLR_GetRawFormattedName(c.new_acct_name) = y.FormattedName AND b.sdn_list = x.ListName     AND (a.sdn_type IN ('DJ', 'DJ ALT', 'WC', 'WC ALT', 'AC', 'AC ALT') OR ISNULL(a.sdn_grp_num, 0) = ISNULL(x.GroupID, 0))    AND a.sdn_type = b.sdn_type AND a.uid = c.uid AND a.new_acct_key = c.new_acct_key    AND x.EntryID = y.ID AND a.SECTION = '1'    AND x.Deleted = 0 AND y.Deleted = 0   END      --Gender reduction (16)    IF (@NMCHK_RC_Reduction & 16) <> 0 AND @Gender_RC <> 0    BEGIN     --DJ     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key      WHERE a.sdn_type IN ('DJ', 'DJ ALT') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM BSADB.dbo.DJ_Entity Y WITH(NOLOCK) WHERE A.ent_num = Y.EntityId AND Y.Deleted = 0         AND Y.Gender IN ('Male', 'Female')         AND CASE WHEN Y.Gender = 'Male' THEN 'M' WHEN Y.Gender = 'Female' THEN 'F' END <> B.Gender         )            --EU     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('EU') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM dbo.EU_SANCTIONS_NAME Y WITH(NOLOCK) WHERE A.ent_num = Y.NAME_ID          AND Y.DEL_FLAG = 'N'         AND ISNULL(Y.GENDER, '') <> ''         AND Y.Gender <> B.Gender         )       --EU ALT      UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('EU ALT') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM dbo.EU_SANCTIONS_NAME Y WITH(NOLOCK) INNER JOIN dbo.EU_SANCTIONS_ALT X WITH(NOLOCK) ON Y.ENTITY_ID = X.ENTITY_ID         WHERE A.ent_num = Y.NAME_ID          AND X.DEL_FLAG = 'N'         AND ISNULL(X.GENDER, '') <> ''         AND X.Gender <> B.Gender         )       --OFAC     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key      WHERE a.sdn_type IN ('OFAC', 'OFAC ALT', 'SDN ADV', 'SDN ADV ALT') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM dbo.OFAC_SDN_SanitizedRemark Y WITH(NOLOCK)          WHERE A.ent_num = Y.ENT_NUM          AND Y.DEL_IND = 'N'         AND ISNULL(Y.GENDER, '') <> ''         AND Y.Gender <> B.Gender         )       --UKHMT     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('UKHMT', 'UKHMT ALT') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM BSADB.dbo.UKHMT_MainName Y WITH(NOLOCK)          WHERE A.ent_num = Y.EntNum          AND Y.IsDeleted = 0         AND ISNULL(Y.GENDER, '') <> ''         AND Y.Gender <> B.Gender         )       --UN     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('UN', 'UN ALT') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM dbo.UN_SANCTIONS_LIST Y WITH(NOLOCK)          WHERE A.ent_num = Y.ENT_NUM          AND Y.DEL_IND = 'N'         AND ISNULL(Y.GENDER, '') <> ''         AND Y.Gender <> B.Gender         )    END          -- Native Name   /*    Only Reduce RC for Native Name not matched when     - Setting for Native Name reduction is on    - Non-English Name is fed in    - First character of Non-English Name is chinese character   */   IF (@NMCHK_RC_Reduction & 32) <> 0 AND @NativeName_RC > 0    IF EXISTS(SELECT TOP 1 1 FROM #NMCHK_CustInfo WITH(NOLOCK) WHERE new_acct_key = 2 -- Non English Name                AND dbo.fn_IsChinese(new_acct_name) = 1) -- First Character Is Chinese    BEGIN     /* List out all the chinese name into temp table */     SELECT A.UID     INTO #ChineseNamesInBatch     FROM #NMCHK_CustInfo A WITH(NOLOCK)     WHERE A.new_acct_key = 2 AND dbo.fn_IsChinese(A.new_acct_name) = 1        CREATE CLUSTERED INDEX idx_ChineseNameWithNoSpaceName ON #ChineseNamesInBatch(UID)       -- List out all the hit entities into temp table     SELECT DISTINCT b.sdn_list, A.ent_num, A.sdn_grp_num     INTO #EnglishNameHitEntities     FROM #Temp_New_Acct_Matches_Table A WITH(NOLOCK)     JOIN dbo.OFAC_SubList_DIM B WITH(NOLOCK) ON A.sdn_type = B.sdn_type     WHERE new_acct_key = 1 AND dbo.fn_IsChinese(sdn_name) = 0 -- Not Chinese Name     AND A.section = '1'      AND EXISTS(SELECT 1 FROM #ChineseNamesInBatch Z WITH(NOLOCK) WHERE A.UID = Z.UID) -- for only who has chinese name       CREATE CLUSTERED INDEX idx_EnglishNameHitEntities ON #EnglishNameHitEntities(sdn_list, sdn_grp_num, ent_num)       -- Prepare hit entities that has chinese name     CREATE TABLE #HitEntities_HasNativeName(      list NVARCHAR(50),      ent_num INT,      sdn_grp_num INT     )          -- GVS List     INSERT INTO #HitEntities_HasNativeName(list, ent_num, sdn_grp_num)     SELECT DISTINCT A.list, A.ent_num, A.sdn_grp_num     FROM dbo.BlackListData A WITH(NOLOCK)     JOIN #EnglishNameHitEntities B WITH(NOLOCK) ON A.list = B.sdn_list AND A.ent_num = B.ent_num AND A.sdn_grp_num =  B.sdn_grp_num AND B.sdn_list NOT IN ('AC', 'DJ', 'WC')     WHERE dbo.fn_IsChinese(A.sdn_name) = 1        -- DJ     IF EXISTS(SELECT 1 FROM #EnglishNameHitEntities WITH(NOLOCK) WHERE sdn_list = 'DJ')     BEGIN       INSERT INTO #HitEntities_HasNativeName (list, ent_num, sdn_grp_num)      SELECT A.sdn_list, A.ent_num, A.sdn_grp_num      FROM #EnglishNameHitEntities A WITH(NOLOCK)      WHERE EXISTS(SELECT 1 FROM BSADB..DJ_AltName B WITH(NOLOCK) WHERE A.ent_num = B.EntityId AND dbo.fn_IsChinese(B.FullName) = 1 AND B.Deleted = 0)      AND A.sdn_list = 'DJ'     END       --WC     IF EXISTS(SELECT 1 FROM #EnglishNameHitEntities WITH(NOLOCK) WHERE sdn_list = 'WC')     BEGIN       INSERT INTO #HitEntities_HasNativeName (list, ent_num, sdn_grp_num)      SELECT A.sdn_list, A.ent_num, A.sdn_grp_num      FROM #EnglishNameHitEntities A WITH(NOLOCK)      WHERE EXISTS(SELECT 1 FROM BSADB..WC_AltName B WITH(NOLOCK) WHERE A.ent_num = B.EntityId AND dbo.fn_IsChinese(B.AltName) = 1 AND B.IsDeleted = 0)      AND A.sdn_list = 'WC'     END       --AC     IF EXISTS(SELECT 1 FROM #EnglishNameHitEntities WITH(NOLOCK) WHERE sdn_list = 'AC')     BEGIN       INSERT INTO #HitEntities_HasNativeName (list, ent_num, sdn_grp_num)      SELECT A.sdn_list, A.ent_num, A.sdn_grp_num      FROM #EnglishNameHitEntities A WITH(NOLOCK)      WHERE EXISTS(SELECT 1 FROM BSADB..AC_AltName B WITH(NOLOCK) WHERE A.ent_num = B.EntityId AND dbo.fn_IsChinese(B.AltName) = 1 AND B.IsDeleted = 0)      AND A.sdn_list = 'AC'     END          CREATE CLUSTERED INDEX idx_EnglishNameHitEntities_HasNativeName ON #HitEntities_HasNativeName(list, sdn_grp_num, ent_num)       /* Compare and deduct RC */     ;WITH EnglishNameHitEntityHasChineseNames AS (      SELECT A.UID, A.relative_correlation, A.Reduction_IND, B.sdn_list, A.ent_num, A.sdn_grp_num      FROM #Temp_New_Acct_Matches_Table A WITH(NOLOCK)      JOIN OFAC_SubList_DIM B WITH(NOLOCK) ON A.sdn_type = B.sdn_type      WHERE A.new_acct_key = 1 AND dbo.fn_IsChinese(A.sdn_name) = 0 AND A.section = '1'      AND EXISTS(SELECT 1 FROM #ChineseNamesInBatch Y WITH(NOLOCK) WHERE A.UID = Y.UID) -- the english has alt chinese name      AND EXISTS(SELECT 1 FROM #HitEntities_HasNativeName Z WITH(NOLOCK) WHERE B.sdn_list = Z.list AND A.ent_num = Z.ent_num AND A.sdn_grp_num = Z.sdn_grp_num)  -- hit entity has alt chinese name     ), ChineseNameExactMatchResult AS (      SELECT A.UID, B.sdn_list, A.ent_num, A.sdn_grp_num      FROM #Temp_New_Acct_Matches_Table A WITH(NOLOCK)      JOIN OFAC_SubList_DIM B WITH(NOLOCK) ON A.sdn_type = B.sdn_type      WHERE A.new_acct_key = 2 AND dbo.fn_IsChinese(A.sdn_name) = 1  -- Chinese Name      AND EXISTS(SELECT 1 FROM #HitEntities_HasNativeName Z WITH(NOLOCK) WHERE B.sdn_list = Z.list AND A.ent_num = Z.ent_num AND A.sdn_grp_num = Z.sdn_grp_num)  -- hit entity has alt chinese name      AND A.section = '1'      AND A.Ori_RC = 100 -- Exact Match     )     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @NativeName_RC, Reduction_IND = STUFF(Reduction_IND, 7, 1, 'Y')     FROM EnglishNameHitEntityHasChineseNames A     WHERE NOT EXISTS(SELECT 1 FROM ChineseNameExactMatchResult B WITH(NOLOCK) WHERE A.UID = B.UID AND A.sdn_list = B.sdn_list AND A.ent_num = B.ent_num AND A.sdn_grp_num = B.sdn_grp_num)    END       --Identification Number reduction   IF (@NMCHK_RC_Reduction & 128) <> 0 AND @IdentificationNumber_RC > 0   BEGIN     --UN    UPDATE a     SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @IdentificationNumber_RC, Reduction_IND = STUFF(Reduction_IND, 8, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table a    INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('UN', 'UN ALT') AND a.SECTION = '1'     --Check input name identification number is not empty     AND (ISNULL(B.IdentificationNumber, '') <> '' OR ISNULL(B.IdentificationNumber, '') <> '')    --Check SDN name identification number have data    AND EXISTS(SELECT NULL FROM dbo.UN_SANCTIO