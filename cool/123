   AND NOT EXISTS(SELECT NULL FROM dbo.UN_SANCTIONS_IDENT X WITH(NOLOCK) WHERE A.ent_num = X.ENT_NUM   
       AND X.DEL_IND = 'N'  
       AND X.NUMBER = B.IdentificationNumber)  
  
   --EU  
   ;WITH CTE_EU_SANCTONS_PASSPORT AS   
   (  
    SELECT ENTITY_ID, LEFT(NUMBER, charindex('(', NUMBER) - 1) AS NUMBER   
