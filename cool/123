ALTER PROC [dbo].[NMCHK_GetNMCHKAttachment]
@UID NVARCHAR(80),
@NAMEKEY NVARCHAR(20),
@BANKNO VARCHAR(10)
AS
DECLARE
@LowRiskListGroup BIGINT,
@SOURCE_IND CHAR(1)

	SELECT @SOURCE_IND = Source_IND FROM dbo.NMCHK_CustInfo WITH(NOLOCK) WHERE uid = @UID AND new_acct_key = @NAMEKEY
	
	IF @SOURCE_IND IN ('W','O','B')
		SELECT @NAMEKEY = '1'

BEGIN
	EXEC(N'SELECT DESCR, FILENAME, MODIFIED_FILENAME, PATH, 
		UPLOADEDBY, (SELECT ISNULL(FirstName,'''') + '' '' +  ISNULL(LastName,'''') FROM UserLicense' + @BANKNO + '.dbo.UserAccounts WHERE USERID = UPLOADEDBY AND Deleted <> ''1'') UPLOADEDBY_UserName, UPLOADED_DATE
		FROM dbo.NMCHK_ATTACH A WITH (NOLOCK)
		WHERE A.BANKNO = ' + '''' + @BANKNO + ''' AND FLAG = ''N''  AND UID = ' + '''' + @UID + ''' AND NAME_KEY = ''' + @NAMEKEY + ''' ORDER BY UPLOADED_DATE DESC')
END


