這份 View（[dbo].[AML_RIGHTS_VW]）主要負責整併與計算 AML（反洗錢系統）使用者的權限代碼（PERMCODE）與所屬分行代號（ACCT_DEPT_CD）。整理後的完整程式碼改善了排版縮排、統整了規則分組，並針對各邏輯區塊補齊詳細註解。
USE [BatchJobDB]
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

/*==================================================================================
 物件名稱: [dbo].[AML_RIGHTS_VW]
 功能說明: AML 系統權限與使用者所屬分行代號 (ACCT_DEPT_CD) 對應檢視表
 組成架構:
   1. 主要邏輯 (Main Case)：針對非特殊維護清單的人員，依其權限碼與功能組織動態衍生所屬代號。
   2. 特殊維護群組 (UNION ALL)：
      - TYP '01': 集中指派 (透過 AML_RIGHTS_GROUP 展開群組代號)
      - TYP '02': 兼任指派 (依 AML_EMP_DEPT_MAP 直接指派)
      - TYP '03': 員編自訂指派 (依 AML_EMP_DEPT_MAP 直接指派)
      - TYP '04': 權限字尾比對指派
==================================================================================*/
ALTER VIEW [dbo].[AML_RIGHTS_VW] 
AS

-- =================================================================================
-- 1. 主規則查詢：依 PERMCODE 與 DEPT_CD_FUNC 動態推導分行代碼
-- =================================================================================
SELECT 
    A.EMPCODE,
    A.EMPNAME,
    A.APPCODE,
    
    -- 【PERMCODE 解析】若含底線（如消金/金作人員規格），僅取底線前前3碼，其餘保留原值
    CASE 
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 THEN SUBSTRING(A.PERMCODE, 1, 3) 
        ELSE A.PERMCODE 
    END AS PERMCODE,
    
    B.EMAL_ADDR,
    B.DEPT_CD_FUNC,
    B.DEPT_NM_FUNC,

    -- 【ACCT_DEPT_CD 衍生邏輯】
    CASE 
        -- -------------------------------------------------------------
        -- 規則 A: 金融交易作業部特別替換 (由關聯 D 提供新權限代碼)
        -- -------------------------------------------------------------
        WHEN D.NEW_PERMCODE IS NOT NULL AND CHARINDEX('_', RTRIM(D.NEW_PERMCODE)) <> 0 
            THEN RTRIM(SUBSTRING(RTRIM(D.NEW_PERMCODE), CHARINDEX('_', RTRIM(D.NEW_PERMCODE)) + 1, 4))

        -- -------------------------------------------------------------
        -- 規則 B: 含底線的特定部門/業務分派邏輯
        -- -------------------------------------------------------------
        -- 金融市場事業總處 (KD)
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 2) = 'KD' 
            THEN '0999AKD'

        -- 法金產品行銷處 (CQ, CQ1)
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN ('CQ', 'CQ1') 
            THEN '0068' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 法金案件分派 (CS4, CW6, CS8) -> 0105
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN ('CS4', 'CW6', 'CS8') 
            THEN '0105' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 法金案件分派 (CS1, CS2, CS3, CS6) -> 0068
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN ('CS1', 'CS2', 'CS3', 'CS6') 
            THEN '0068' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 法金案件分派 (CS5, CW7) -> 0010
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN ('CS5', 'CW7') 
            THEN '0010' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 法金案件分派 (CV1~CV3, CW~CW4, CX~CX5, CZ, CR) -> 0002
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN (
                 'CV1','CV2','CV3','CW','CW1','CW2','CW3','CW4','CX','CX1','CX2','CX3','CX4','CX5','CZ','CR'
             ) 
            THEN '0002' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 法金案件分派 (CW5) -> 0100
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN ('CW5') 
            THEN '0100' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 法金案件分派 (CW8, CS7) -> 0015
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) IN ('CW8', 'CS7') 
            THEN '0015' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 4))

        -- 支付處 (PS9) -> 0999PS9
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) = 'PS9' 
            THEN '0999' + SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3)

        -- 客服部 (AFH) -> 0999AFH
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3) = 'AFH' 
            THEN '0999' + SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3)

        -- 消金放款及金作部人員邏輯 (排除底線後兩碼為 PB/OP/BD/WM/HR 者)
        WHEN CHARINDEX('_', RTRIM(A.PERMCODE)) <> 0 
             AND SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 2) NOT IN ('PB', 'OP', 'BD', 'WM', 'HR') 
            THEN '0' + SUBSTRING(RTRIM(A.PERMCODE), CHARINDEX('_', RTRIM(A.PERMCODE)) + 1, 3)

        -- -------------------------------------------------------------
        -- 規則 C: 法金固定權限代碼 (B12, B22, B32) 依組織代碼指派
        -- -------------------------------------------------------------
        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACVD','ACVE','ACVI','ACVS','ACW','ACW01','ACW02','ACW03','ACW04','ACR06',
                 'ACX','ACX01','ACX02','ACX03','ACX04','ACX05','ACX06','ACY','ACYA','ACYB',
                 'ACZ','ACZA01','ACZA02','AFJW0505','AFJW0506','ACZA'
             ) THEN '0002A'

        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACSK','ACSK01','ACSK02','ACW07','ACZB02','AFJP2904'
             ) THEN '0010A'

        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACSK03','ACW08','AFJQ2703','AFJQ2705'
             ) THEN '0015A'

        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACSE10','ACW05','AFJN2403'
             ) THEN '0100A'

        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACSJ','ACSJ01','ACSJ02','ACSJ03','ACZB','ACZB01','AFJO4003','AFJO4005','AFJO4006'
             ) THEN '0105A'

        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACK','ACK01','ACK02','ACKA','ACKA01','ACKA07','ACKA09','ACKC','ACKC05',
                 'ACKI','ACKZ01','ACKZ01B','ACKZ01C','ACKZ01D','ACKZ01E','ACKZ01F','ACK_V',
                 'ACN','ACQ','ACQA','ACQA01','ACQA02','ACQA03','ACQA04','ACQB','ACQB02',
                 'ACQB03','ACQB04','ACQB05','ACQC','ACQC01','ACQC02','ACQC03','ACS','ACSD',
                 'ACSD02','ACSD03','ACSD10','ACSD11','ACSE','ACSE02','ACSE07','ACSE11',
                 'ACSE12','ACSE13','ACSF','ACSL','ACSL01','ACSL02','ACSL03','AFJM1904',
                 'ACKZ01G','ACKZ01J','ACKZ01H'
             ) THEN '0068A'

        WHEN RTRIM(A.PERMCODE) IN ('B12', 'B22', 'B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
                 'ACNA','ACNA01','ACNA02'
             ) THEN '0068B'

        -- -------------------------------------------------------------
        -- 規則 D: 海外分行特殊指派 (香港 HK: 0900、馬來西亞 MY: 0925、日本 JP: 0923、澳洲 AU: 0922)
        -- -------------------------------------------------------------
        -- 香港分行 (HK): 總行單位 0999/0900 且為 ACVC 開頭組織
        WHEN (B.ACCT_DEPT_CD IN ('0999', '0900')) AND B.DEPT_CD_FUNC LIKE 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%BD' THEN '0900BD'
        WHEN (B.ACCT_DEPT_CD IN ('0999', '0900')) AND B.DEPT_CD_FUNC LIKE 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%WM' THEN '0900WM'
        WHEN (B.ACCT_DEPT_CD IN ('0999', '0900')) AND B.DEPT_CD_FUNC LIKE 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%HR' THEN '0900HR'
        WHEN (B.ACCT_DEPT_CD IN ('0999', '0900')) AND B.DEPT_CD_FUNC LIKE 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%PB' THEN '0900PB'  
        WHEN (B.ACCT_DEPT_CD IN ('0999', '0900')) AND B.DEPT_CD_FUNC LIKE 'ACVC%' THEN '0900'

        -- 馬來西亞 (MY)
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC LIKE 'ACVN%' THEN '0925'
        -- 日本 (JP)
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC LIKE 'ACVK%' THEN '0923'
        -- 澳洲 (AU)
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC LIKE 'ACVJ%' THEN '0922'   

        -- -------------------------------------------------------------
        -- 規則 E: 總行 0999 依特定功能組織直映
        -- -------------------------------------------------------------
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJW0506' THEN '0002'
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJN2403' THEN '0100'
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJO4003' THEN '0105'
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJP2904' THEN '0010'
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJQ2703' THEN '0015'
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'ACKZ01D'  THEN '0068'

        -- 作業服務處集中作業部 (資料輸入組 AFFG08、文書處理二組 AFFG07)
        WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC IN ('AFFG07', 'AFFG08') THEN '0628'

        -- 總行 0999 依 C 表 (AFJ% 對應) 或功能組織前3碼後綴
        WHEN B.ACCT_DEPT_CD = '0999' AND C.DEPT_CD_FUNC IS NULL THEN RTRIM(B.ACCT_DEPT_CD) + LEFT(B.DEPT_CD_FUNC, 3)
        WHEN B.ACCT_DEPT_CD = '0999' AND C.ACCT_DEPT_CD <> '0999' THEN RTRIM(C.ACCT_DEPT_CD)

        -- -------------------------------------------------------------
        -- 規則 F: 特殊單位組織碼對應
        -- -------------------------------------------------------------
        -- 通路營運事業處保險規劃行銷區 (AFJ05)
        WHEN B.DEPT_CD_FUNC LIKE 'AFJ05%' THEN '0001A'
        -- 理財商品處投資產品部 (AFYI)
        WHEN B.DEPT_CD_FUNC LIKE 'AFYI%'  THEN '0013A'
        -- 客群經營處 (AFL) & 個金資產管理處 (AFS)
        WHEN B.ACCT_DEPT_CD = '0998' AND B.DEPT_CD_FUNC LIKE 'AFL%' THEN '0998AFL'
        WHEN B.ACCT_DEPT_CD = '0998' AND B.DEPT_CD_FUNC LIKE 'AFS%' THEN '0998AFS'

        -- 其餘預設直接採用 HR 系統中的 ACCT_DEPT_CD
        ELSE RTRIM(B.ACCT_DEPT_CD) 
    END AS ACCT_DEPT_CD

FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] A WITH(NOLOCK)
LEFT JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N] B WITH(NOLOCK) 
    ON A.EMPCODE = B.EMP_ID

-- 子查詢 C: 針對 AFJ 系列組織找尋非 0999/0068 的最小帳務分行
LEFT JOIN (
    SELECT DEPT_CD_FUNC, MIN(ACCT_DEPT_CD) AS ACCT_DEPT_CD 
    FROM (
        SELECT DISTINCT DEPT_CD_FUNC, ACCT_DEPT_CD 
        FROM [TAS9-T].[TSAAS].[dbo].[HREMPM_N] WITH(NOLOCK) 
        WHERE DEPT_CD_FUNC LIKE 'AFJ%' 
          AND ISNULL(QUIT_DT, '') = '' 
          AND ACCT_DEPT_CD NOT IN ('0999', '0068') 
    ) A1 
    GROUP BY DEPT_CD_FUNC
) C ON B.DEPT_CD_FUNC = C.DEPT_CD_FUNC

-- 子查詢 D: 台灣金融交易作業部舊新權限碼轉換表 (會由 1 筆展開為 2 筆)
LEFT JOIN (
    SELECT 'B10_852' AS OLD_PERMCODE, NULL AS NEW_PERMCODE 
    UNION 
    SELECT 'B10_852' AS OLD_PERMCODE, 'B10_0900' AS NEW_PERMCODE 
    UNION
    SELECT 'B20_852' AS OLD_PERMCODE, NULL AS NEW_PERMCODE 
    UNION 
    SELECT 'B20_852' AS OLD_PERMCODE, 'B20_0900' AS NEW_PERMCODE
) D ON D.OLD_PERMCODE = A.PERMCODE

WHERE A.COMP_CD IN ('TSIB', 'TO') 
  AND A.APPCODE = 'AML' 
  AND LEFT(A.PERMCODE, 2) NOT IN ('SG', 'AU') 
  AND ISNULL(B.QUIT_DT, '') = ''
  AND B.DEPT_CD_FUNC NOT LIKE 'ACVH%'
  -- 排除在特殊維護表中已有 01(集中) 與 03(員編) 設定之人員，避免重複
  AND A.EMPCODE NOT IN (SELECT EMPCODE FROM BatchJobDB..AML_EMP_DEPT_MAP WHERE TYP IN ('01', '03'))


-- =================================================================================
-- 2. 特殊維護設定 (UNION ALL AML_EMP_DEPT_MAP)
-- =================================================================================

-- 【TYP '01': 集中設定】經由 AML_RIGHTS_GROUP 群組展開分行代碼
UNION ALL 
SELECT 
    H.EMP_ID, 
    H.CH_NM, 
    T.APPCODE, 
    CASE WHEN CHARINDEX('_', RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE, 1, 3) ELSE T.PERMCODE END AS PERMCODE, 
    H.EMAL_ADDR, 
    H.DEPT_CD_FUNC, 
    H.DEPT_NM_FUNC, 
    RTRIM(N.ACCT_DEPT_CD) AS ACCT_DEPT_CD
FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE = H.EMP_ID 
JOIN BatchJobDB..AML_EMP_DEPT_MAP           M ON T.EMPCODE = M.EMPCODE AND M.TYP = '01'
JOIN BatchJobDB..AML_RIGHTS_GROUP           N ON M.ACCT_DEPT_CD = N.GRP
WHERE H.COMP_CD = 'TSIB' 
  AND T.APPCODE = 'AML'

-- 【TYP '02': 兼任指派】
UNION ALL 
SELECT 
    H.EMP_ID, 
    H.CH_NM, 
    T.APPCODE, 
    CASE WHEN CHARINDEX('_', RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE, 1, 3) ELSE T.PERMCODE END AS PERMCODE, 
    H.EMAL_ADDR, 
    H.DEPT_CD_FUNC, 
    H.DEPT_NM_FUNC, 
    RTRIM(M.ACCT_DEPT_CD) AS ACCT_DEPT_CD
FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE = H.EMP_ID 
JOIN BatchJobDB..AML_EMP_DEPT_MAP           M ON T.EMPCODE = M.EMPCODE AND M.TYP = '02'
WHERE H.COMP_CD = 'TSIB' 
  AND T.APPCODE = 'AML'

-- 【TYP '03': 員編指定指派】
UNION ALL 
SELECT 
    H.EMP_ID, 
    H.CH_NM, 
    T.APPCODE, 
    CASE WHEN CHARINDEX('_', RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE, 1, 3) ELSE T.PERMCODE END AS PERMCODE, 
    H.EMAL_ADDR, 
    H.DEPT_CD_FUNC, 
    H.DEPT_NM_FUNC, 
    RTRIM(M.ACCT_DEPT_CD) AS ACCT_DEPT_CD
FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE = H.EMP_ID 
JOIN BatchJobDB..AML_EMP_DEPT_MAP           M ON T.EMPCODE = M.EMPCODE AND M.TYP = '03'
WHERE H.COMP_CD = 'TSIB' 
  AND T.APPCODE = 'AML'

-- 【TYP '04': 權限字尾指派】以 PERMCODE LIKE 方式關聯
UNION ALL 
SELECT 
    H.EMP_ID, 
    H.CH_NM, 
    T.APPCODE, 
    CASE WHEN CHARINDEX('_', RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE, 1, 3) ELSE T.PERMCODE END AS PERMCODE, 
    H.EMAL_ADDR, 
    H.DEPT_CD_FUNC, 
    H.DEPT_NM_FUNC, 
    RTRIM(M.ACCT_DEPT_CD) AS ACCT_DEPT_CD
FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE = H.EMP_ID 
JOIN BatchJobDB..AML_EMP_DEPT_MAP           M ON RTRIM(T.PERMCODE) LIKE '%' + M.PERMCODE AND M.TYP = '04'
WHERE H.COMP_CD = 'TSIB' 
  AND T.APPCODE = 'AML';
GO

