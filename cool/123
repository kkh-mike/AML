,      dbo.LowRiskList_LowRiskListEntries x WITH(NOLOCK), dbo.LowRiskListEntries y WITH(NOLOCK)     WHERE dbo.fn_CLR_GetRawFormattedName(c.new_acct_name) = y.FormattedName AND b.sdn_list = x.ListName      AND (a.sdn_type IN ('DJ', 'DJ ALT', 'WC', 'WC ALT', 'AC', 'AC ALT') OR ISNULL(a.sdn_grp_num, 0) = ISNULL(x.GroupID, 0))     AND a.sdn_type = b.sdn_type AND a.new_acct_key = c.new_acct_key     AND x.EntryID = y.ID AND a.SECTION = '1'     AND x.Deleted = 0 AND y.Deleted = 0    END        -- Gender reduction (16)     IF (@NMCHK_RC_Reduction & 16) <> 0 AND @Gender_RC <> 0    BEGIN     --DJ     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key      WHERE a.sdn_type IN ('DJ', 'DJ ALT') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM BSADB.dbo.DJ_Entity Y WITH(NOLOCK) WHERE A.ent_num = Y.EntityId AND Y.Deleted = 0         AND Y.Gender IN ('Male', 'Female')         AND CASE WHEN Y.Gender = 'Male' THEN 'M' WHEN Y.Gender = 'Female' THEN 'F' END <> B.Gender         )            --EU     UPDATE a      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @Gender_RC, Reduction_IND = STUFF(Reduction_IND, 5, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table a     INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key     WHERE a.sdn_type IN ('EU') AND a.SECTION = '1'      --Check Gender is not null     AND ISNULL(B.Gender, '') <> ''      --Check is SDN list Gender different with customer Gender; then can deduct RC      AND EXISTS(SELECT 1 FROM dbo.EU_SANCTIONS_NAME Y WITH(NOLOCK) WHERE A.ent_num = Y.NAME_ID          AND Y.DEL_FLAG = 'N'         AND ISNULL(Y.GENDER, '') <> ''         AND Y.Gender <> B.Gender         )       --EU ALT      UPDATE a      