        SELECT *
        FROM BSADBJP..OFAC_SPEC
        WHERE GROUPID = 11
    )
    MERGE TargetTable AS T
    USING (SELECT Num, EntNum, SdnName, UpdatedDate, Address, City, Country, IdentType, IdentNumber, DOB 
           FROM #tempDJBlacklistDetailsJP) AS S
