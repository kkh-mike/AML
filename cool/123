# ============================================
# Input Path
# ============================================
$folderPath = "D:\AML_Source\20251114_新光資轉\EXE\DTLBK"

# Baseline
$baselineFile = Join-Path $folderPath "AML_CHECK_SUM.csv"

# ============================================
# Output / Log
# ============================================
$basePath = Get-Location

$resultFile = Join-Path $basePath "CHECK_RESULT_DTLBK.txt"
$logFile    = Join-Path $basePath "SKcheck_CHECK_SUM_DTLBK.log"

# ============================================
# 刪除舊檔
# ============================================
if (Test-Path $resultFile) {
    Remove-Item $resultFile -Force
}

if (Test-Path $logFile) {
    Remove-Item $logFile -Force
}

# ============================================
# Log Function
# ============================================
function Write-Log {
    param(
        [string]$msg
    )

    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    Add-Content `
        -Path $logFile `
        -Value "[$time] $msg"
}

# ============================================
# 預設結果
# 1 = SUCCESS
# 0 = FAILED
# ============================================
$hasError = $false

# ============================================
# 檢查資料夾
# ============================================
if (!(Test-Path $folderPath)) {

    Write-Log "ERROR: Input folder not found"
    Write-Log "Path: $folderPath"

    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 檢查 AML_CHECK_SUM.csv
# ============================================
if (!(Test-Path $baselineFile)) {

    Write-Log "ERROR: AML_CHECK_SUM.csv not found"
    Write-Log "Path: $baselineFile"

    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 讀取 AML_CHECK_SUM.csv
#
# 格式：
# FileName;Count;MD5
# ============================================
$baseline = @{}

try {

    $lines = Get-Content `
        -Path $baselineFile `
        -Encoding utf8

    foreach ($line in $lines) {

        # 忽略空白行
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        $parts = $line.Split(";")

        # 格式錯誤
        if ($parts.Count -lt 3) {

            Write-Log "ERROR: Invalid AML_CHECK_SUM.csv format"
            Write-Log "LINE: $line"

            $hasError = $true

            continue
        }

        $fileName = $parts[0].Trim()
        $expectedCountText = $parts[1].Trim()
        $expectedMD5 = $parts[2].Trim().ToLowerInvariant()

        # ========================================
        # 檢查檔名
        # ========================================
        if ([string]::IsNullOrWhiteSpace($fileName)) {

            Write-Log "ERROR: Empty filename in AML_CHECK_SUM.csv"
            $hasError = $true

            continue
        }

        # ========================================
        # 檢查 Count 格式
        # ========================================
        $expectedCount = 0

        if (-not [int64]::TryParse(
            $expectedCountText,
            [ref]$expectedCount
        )) {

            Write-Log "ERROR: Invalid COUNT"
            Write-Log "File: $fileName"
            Write-Log "COUNT: $expectedCountText"

            $hasError = $true

            continue
        }

        # ========================================
        # 檢查 MD5 格式
        # ========================================
        if ($expectedMD5 -notmatch '^[0-9a-f]{32}$') {

            Write-Log "ERROR: Invalid MD5"
            Write-Log "File: $fileName"
            Write-Log "MD5 : $expectedMD5"

            $hasError = $true

            continue
        }

        # ========================================
        # 存入 Baseline
        # ========================================
        $key = $fileName.ToLowerInvariant()

        $baseline[$key] = @{
            FileName = $fileName
            Count    = $expectedCount
            MD5      = $expectedMD5
        }
    }

}
catch {

    Write-Log "ERROR: Cannot read AML_CHECK_SUM.csv"
    Write-Log $_.Exception.Message

    $hasError = $true
}

# ============================================
# 如果 Baseline 本身有錯
# ============================================
if ($hasError) {

    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 開始檢查每個檔案
# ============================================
foreach ($key in $baseline.Keys) {

    $expectedFileName = $baseline[$key].FileName
    $expectedCount    = $baseline[$key].Count
    $expectedMD5      = $baseline[$key].MD5

    $actualFile = Join-Path `
        $folderPath `
        $expectedFileName

    # ========================================
    # 1. 檢查檔案是否存在
    # ========================================
    if (!(Test-Path $actualFile)) {

        Write-Log "ERROR: FILE NOT FOUND"
        Write-Log "File: $expectedFileName"
        Write-Log "Path: $actualFile"

        $hasError = $true

        continue
    }

    try {

        # ====================================
        # 2. 計算實際行數
        # ====================================
        $actualCount = 0

        $reader = New-Object System.IO.StreamReader(
            $actualFile
        )

        try {

            while ($reader.ReadLine() -ne $null) {
                $actualCount++
            }

        }
        finally {

            $reader.Close()
            $reader.Dispose()
        }

        # ====================================
        # 3. 計算實際 MD5
        # ====================================
        $actualMD5 = (
            Get-FileHash `
                -Path $actualFile `
                -Algorithm MD5
        ).Hash.ToLowerInvariant()

        # ====================================
        # 4. Count 比對
        # ====================================
        if ($actualCount -ne $expectedCount) {

            Write-Log "ERROR: COUNT MISMATCH"
            Write-Log "File    : $expectedFileName"
            Write-Log "Expected: $expectedCount"
            Write-Log "Actual  : $actualCount"

            $hasError = $true
        }

        # ====================================
        # 5. MD5 比對
        # ====================================
        if ($actualMD5 -ne $expectedMD5) {

            Write-Log "ERROR: MD5 MISMATCH"
            Write-Log "File    : $expectedFileName"
            Write-Log "Expected: $expectedMD5"
            Write-Log "Actual  : $actualMD5"

            $hasError = $true
        }

    }
    catch {

        Write-Log "ERROR: PROCESS FILE FAILED"
        Write-Log "File: $expectedFileName"
        Write-Log $_.Exception.Message

        $hasError = $true
    }
}

# ============================================
# Final Result
# ============================================
if ($hasError) {

    # 有任何錯誤
    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Log "============================================"
    Write-Log "FINAL RESULT: 0"
    Write-Log "STATUS: FAILED"
    Write-Log "============================================"

    Write-Host "0"

    exit 1
}
else {

    # 全部一致
    "1" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "1"

    exit 0
}