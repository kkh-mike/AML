# ============================================
# Input Path
# ============================================
$folderPath = "D:\AML_Source\20251114_新光資轉\EXE\DTLBK"

# Baseline
$baselineFile = Join-Path $folderPath "AML_CHECK_SUM.csv"

# ============================================
# Output / Log
# ============================================
$basePath = Get-Location

$resultDetailFile = Join-Path $basePath "result_CHECK_SUM_DTLBK.csv"
$resultFile       = Join-Path $basePath "CHECK_RESULT_DTLBK.txt"
$logFile          = Join-Path $basePath "SKcheck_CHECK_SUM_DTLBK.log"

# ============================================
# 刪除舊檔
# ============================================
foreach ($file in @(
    $resultDetailFile,
    $resultFile,
    $logFile
)) {
    if (Test-Path $file) {
        Remove-Item $file -Force
    }
}

# ============================================
# Log Function
# ============================================
function Write-Log {
    param(
        [string]$msg
    )

    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    Add-Content `
        -Path $logFile `
        -Value "[$time] $msg"
}

# ============================================
# Start
# ============================================
Write-Log "============================================"
Write-Log "===== JOB START ====="
Write-Log "Input Path   : $folderPath"
Write-Log "Baseline File: $baselineFile"
Write-Log "============================================"

# ============================================
# 預設結果 = 0
# 只有全部成功才會改成 1
# ============================================
$finalResult = 0

# ============================================
# 檢查資料夾
# ============================================
if (!(Test-Path $folderPath)) {

    Write-Log "ERROR: Input folder not found"

    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 檢查 Baseline
# ============================================
if (!(Test-Path $baselineFile)) {

    Write-Log "ERROR: AML_CHECK_SUM.csv not found"

    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 讀取 Baseline
# ============================================
Write-Log "===== Reading AML_CHECK_SUM.csv ====="

$baseline = @{}

try {

    $lines = Get-Content `
        -Path $baselineFile `
        -Encoding utf8

    foreach ($line in $lines) {

        # 忽略空白行
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        $parts = $line.Split(";")

        if ($parts.Count -lt 3) {

            Write-Log "ERROR: Invalid baseline format"
            Write-Log "LINE: $line"

            "0" | Out-File `
                -FilePath $resultFile `
                -Encoding utf8

            Write-Host "0"

            exit 1
        }

        $fileName = $parts[0].Trim()
        $count    = $parts[1].Trim()
        $md5      = $parts[2].Trim().ToLowerInvariant()

        $countNumber = 0

        if (-not [int64]::TryParse(
            $count,
            [ref]$countNumber
        )) {

            Write-Log "ERROR: Invalid Count"
            Write-Log "FileName: $fileName"
            Write-Log "Count   : $count"

            "0" | Out-File `
                -FilePath $resultFile `
                -Encoding utf8

            Write-Host "0"

            exit 1
        }

        $key = $fileName.ToLowerInvariant()

        $baseline[$key] = @{
            FileName = $fileName
            Count    = $countNumber
            MD5      = $md5
        }

    }

}
catch {

    Write-Log "ERROR reading AML_CHECK_SUM.csv"
    Write-Log $_.Exception.Message

    "0" | Out-File `
        -FilePath $resultFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

Write-Log "Baseline Count: $($baseline.Count)"

# ============================================
# 建立詳細結果 CSV
# ============================================
"FileName;ExpectedCount;ActualCount;CountResult;ExpectedMD5;ActualMD5;MD5Result;Result" |
    Out-File `
        -FilePath $resultDetailFile `
        -Encoding utf8

# ============================================
# 開始逐檔比對
# ============================================
Write-Log "============================================"
Write-Log "===== START CHECK ====="
Write-Log "============================================"

$hasError = $false

foreach ($key in $baseline.Keys) {

    $expectedFileName = $baseline[$key].FileName
    $expectedCount    = $baseline[$key].Count
    $expectedMD5      = $baseline[$key].MD5

    $actualFile = Join-Path `
        $folderPath `
        $expectedFileName

    Write-Log "--------------------------------------------"
    Write-Log "CHECK FILE: $expectedFileName"

    # ========================================
    # 預設
    # ========================================
    $actualCount = ""
    $actualMD5   = ""

    $countResult = "FAIL"
    $md5Result   = "FAIL"
    $fileResult  = "FAIL"

    # ========================================
    # 檔案不存在
    # ========================================
    if (!(Test-Path $actualFile)) {

        Write-Log "ERROR: FILE NOT FOUND"
        Write-Log "Path: $actualFile"

        $hasError = $true

        $resultLine = "$expectedFileName;$expectedCount;;FAIL;$expectedMD5;;FAIL;FILE_NOT_FOUND"

        Add-Content `
            -Path $resultDetailFile `
            -Value $resultLine

        continue
    }

    try {

        # ====================================
        # 計算行數
        # ====================================
        $actualCount = 0

        $reader = New-Object System.IO.StreamReader(
            $actualFile
        )

        try {

            while ($reader.ReadLine() -ne $null) {
                $actualCount++
            }

        }
        finally {

            $reader.Close()
            $reader.Dispose()
        }

        # ====================================
        # 計算 MD5
        # ====================================
        $actualMD5 = (
            Get-FileHash `
                -Path $actualFile `
                -Algorithm MD5
        ).Hash.ToLowerInvariant()

        # ====================================
        # Count 比對
        # ====================================
        if ($actualCount -eq $expectedCount) {

            $countResult = "OK"

            Write-Log "COUNT : OK"
            Write-Log "  EXPECTED = $expectedCount"
            Write-Log "  ACTUAL   = $actualCount"

        }
        else {

            $countResult = "FAIL"

            Write-Log "COUNT : FAIL"
            Write-Log "  EXPECTED = $expectedCount"
            Write-Log "  ACTUAL   = $actualCount"

            $hasError = $true
        }

        # ====================================
        # MD5 比對
        # ====================================
        if ($actualMD5 -eq $expectedMD5) {

            $md5Result = "OK"

            Write-Log "MD5   : OK"
            Write-Log "  EXPECTED = $expectedMD5"
            Write-Log "  ACTUAL   = $actualMD5"

        }
        else {

            $md5Result = "FAIL"

            Write-Log "MD5   : FAIL"
            Write-Log "  EXPECTED = $expectedMD5"
            Write-Log "  ACTUAL   = $actualMD5"

            $hasError = $true
        }

        # ====================================
        # 最終檔案結果
        # ====================================
        if (
            ($countResult -eq "OK") -and
            ($md5Result -eq "OK")
        ) {

            $fileResult = "MATCH"

            Write-Log "RESULT: MATCH"

        }
        else {

            $fileResult = "MISMATCH"

            Write-Log "RESULT: MISMATCH"
        }

        # ====================================
        # 寫入詳細結果
        # ====================================
        $resultLine = @(
            $expectedFileName
            $expectedCount
            $actualCount
            $countResult
            $expectedMD5
            $actualMD5
            $md5Result
            $fileResult
        ) -join ";"

        Add-Content `
            -Path $resultDetailFile `
            -Value $resultLine

    }
    catch {

        $hasError = $true

        Write-Log "ERROR PROCESSING FILE"
        Write-Log $_.Exception.Message

        $resultLine = @(
            $expectedFileName
            $expectedCount
            ""
            "ERROR"
            $expectedMD5
            ""
            "ERROR"
            "ERROR"
        ) -join ";"

        Add-Content `
            -Path $resultDetailFile `
            -Value $resultLine
    }
}

# ============================================
# 最終結果
# ============================================
Write-Log "============================================"
Write-Log "===== FINAL RESULT ====="
Write-Log "============================================"

if ($hasError) {

    $finalResult = 0

    Write-Log "FINAL RESULT: 0"
    Write-Log "STATUS: FAILED"

}
else {

    $finalResult = 1

    Write-Log "FINAL RESULT: 1"
    Write-Log "STATUS: SUCCESS"
}

# ============================================
# 輸出 1 / 0
# ============================================
$finalResult |
    Out-File `
        -FilePath $resultFile `
        -Encoding utf8

Write-Log "Result File: $resultFile"
Write-Log "Detail File: $resultDetailFile"
Write-Log "Log File   : $logFile"

Write-Log "===== JOB END ====="

# ============================================
# Console
# ============================================
Write-Host ""
Write-Host "============================================"
Write-Host "FINAL RESULT: $finalResult"
Write-Host "============================================"
Write-Host ""
Write-Host "Detail : $resultDetailFile"
Write-Host "Result : $resultFile"
Write-Host "Log    : $logFile"
Write-Host ""

if ($finalResult -eq 1) {
    exit 0
}
else {
    exit 1
}