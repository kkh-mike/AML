ALTER View [dbo].[AML_RIGHTS_VW] AS 

 SELECT A.EMPCODE,A.EMPNAME,A.APPCODE

  --消金放款及金作部人員邏輯
  ,CASE WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 THEN SUBSTRING(A.PERMCODE,1,3) ELSE A.PERMCODE END PERMCODE
  ,B.EMAL_ADDR,B.DEPT_CD_FUNC,B.DEPT_NM_FUNC

  ,CASE 
   WHEN D.NEW_PERMCODE IS NOT NULL AND CHARINDEX('_',RTRIM(D.NEW_PERMCODE)) <> 0 
    THEN RTRIM(SUBSTRING(RTRIM(D.NEW_PERMCODE),CHARINDEX('_',RTRIM(D.NEW_PERMCODE))+1,4))
   --金融市場事業總處(KD)
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,2) ='KD' THEN '0999AKD'
   --法金產品行銷處(CQ)
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN ('CQ','CQ1') 
    THEN '0068' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   --法金客戶案件分派邏輯 
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN ('CS4','CW6','CS8') 
    THEN '0105' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN ('CS1','CS2','CS3','CS6') 
    THEN '0068' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN ('CS5','CW7') 
    THEN '0010' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN (
     'CV1','CV2','CV3','CW','CW1','CW2','CW3','CW4','CX','CX1','CX2','CX3','CX4','CX5','CZ','CR') 
    THEN '0002' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN ('CW5') 
    THEN '0100' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   --增加 CS7 20190108
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) IN ('CW8','CS7') 
    THEN '0015' + RTRIM(SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,4))
   --支付處
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) ='PS9' 
    THEN '0999' + SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3)
   --20250226客服部
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3) ='AFH' 
    THEN '0999' + SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3)
   --消金放款及金作部人員邏輯，排除HK
   --WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 THEN '0' + SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3)
   WHEN CHARINDEX('_',RTRIM(A.PERMCODE)) <> 0 AND SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,2) NOT IN ('PB','OP','BD','WM','HR') 
    THEN '0' + SUBSTRING(RTRIM(A.PERMCODE),CHARINDEX('_',RTRIM(A.PERMCODE))+1,3)
   --法金人員邏輯
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
    'ACVD','ACVE','ACVI','ACVS','ACW','ACW01','ACW02','ACW03','ACW04',
    'ACR06',
    'ACX','ACX01','ACX02','ACX03','ACX04','ACX05','ACX06','ACY',
    'ACYA','ACYB','ACZ','ACZA01','ACZA02','AFJW0505','AFJW0506',
    'ACZA'
   ) THEN '0002A'
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN ('ACSK','ACSK01','ACSK02','ACW07','ACZB02','AFJP2904') THEN '0010A'
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN ('ACSK03','ACW08','AFJQ2703','AFJQ2705') THEN '0015A'
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN ('ACSE10','ACW05','AFJN2403') THEN '0100A'
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
    'ACSJ','ACSJ01','ACSJ02','ACSJ03','ACZB','ACZB01','AFJO4003','AFJO4005','AFJO4006'
   ) THEN '0105A'
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN (
    'ACK','ACK01','ACK02',
    'ACKA','ACKA01','ACKA07','ACKA09',
    'ACKC','ACKC05',
    'ACKI', 
    'ACKZ01','ACKZ01B','ACKZ01C','ACKZ01D','ACKZ01E','ACKZ01F',
    'ACK_V',
    'ACN',
    'ACQ','ACQA','ACQA01','ACQA02','ACQA03','ACQA04',       
    'ACQB','ACQB02','ACQB03','ACQB04','ACQB05',       
    'ACQC','ACQC01','ACQC02','ACQC03',       
    'ACS','ACSD','ACSD02','ACSD03','ACSD10','ACSD11',       
    'ACSE','ACSE02','ACSE07','ACSE11','ACSE12','ACSE13',       
    'ACSF',
    'ACSL','ACSL01','ACSL02','ACSL03',
    'AFJM1904',
    'ACKZ01G','ACKZ01J','ACKZ01H'
   ) THEN '0068A'
   WHEN RTRIM(A.PERMCODE) IN ('B12','B22','B32') AND RTRIM(B.DEPT_CD_FUNC) IN ('ACNA','ACNA01','ACNA02') THEN '0068B'

   --新增HK人員所屬分行 
   --因應HK分行部份人員HR所屬分行為0900,0999，調整撈取邏輯  
   WHEN (B.ACCT_DEPT_CD = '0999' OR B.ACCT_DEPT_CD = '0900') AND B.DEPT_CD_FUNC like 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%BD' THEN '0900BD'
   WHEN (B.ACCT_DEPT_CD = '0999' OR B.ACCT_DEPT_CD = '0900') AND B.DEPT_CD_FUNC like 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%WM' THEN '0900WM'
   WHEN (B.ACCT_DEPT_CD = '0999' OR B.ACCT_DEPT_CD = '0900') AND B.DEPT_CD_FUNC like 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%HR' THEN '0900HR'
   --新增0900PB 權限值 20190118
   WHEN (B.ACCT_DEPT_CD = '0999' OR B.ACCT_DEPT_CD = '0900') AND B.DEPT_CD_FUNC like 'ACVC%' AND RTRIM(A.PERMCODE) LIKE '%PB' THEN '0900PB'  
   WHEN (B.ACCT_DEPT_CD = '0999' OR B.ACCT_DEPT_CD = '0900') AND B.DEPT_CD_FUNC like 'ACVC%' THEN '0900'
   --提案單：IT20201704261006 WHEN A.EMPCODE = '950048' THEN '0900'

   --新增MY人員所屬分行
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC like 'ACVN%' THEN '0925'
   --新增JP人員所屬分行
   --WHEN A.EMPCODE = '891098' THEN '0923'
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC like 'ACVK%' THEN '0923'
   --新增AU人員所屬分行
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC like 'ACVJ%' THEN '0922'   

   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJW0506' THEN '0002'
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJN2403' THEN '0100'
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJO4003' THEN '0105'
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJP2904' THEN '0010'
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'AFJQ2703' THEN '0015'
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC = 'ACKZ01D' THEN '0068'
   --作業服務處集中作業部資料輸入組(AFFG08)作業服務處集中作業部文書處理二組(AFFG07) 
   WHEN B.ACCT_DEPT_CD = '0999' AND B.DEPT_CD_FUNC in ('AFFG07','AFFG08') THEN '0628'
   WHEN B.ACCT_DEPT_CD = '0999' AND C.DEPT_CD_FUNC IS NULL THEN RTRIM(B.ACCT_DEPT_CD) + LEFT(B.DEPT_CD_FUNC,3)
   WHEN B.ACCT_DEPT_CD = '0999' AND C.ACCT_DEPT_CD <> '0999' THEN RTRIM(C.ACCT_DEPT_CD)
   --新增0001A通路營運事業處保險規劃行銷區(AFJ05)、0013A理財商品處投資產品部(AFYI)
   WHEN B.DEPT_CD_FUNC LIKE 'AFJ05%' THEN '0001A'
   WHEN B.DEPT_CD_FUNC LIKE 'AFYI%' THEN '0013A'
   --新增客群經營處0998AFL&個金資產管理處0998AFS
   WHEN B.ACCT_DEPT_CD = '0998' AND B.DEPT_CD_FUNC like 'AFL%' THEN '0998AFL'
   WHEN B.ACCT_DEPT_CD = '0998' AND B.DEPT_CD_FUNC like 'AFS%' THEN '0998AFS'
   ELSE RTRIM(B.ACCT_DEPT_CD) 
  END ACCT_DEPT_CD

 FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] A WITH(NOLOCK) 
 LEFT JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N] B WITH(NOLOCK) ON A.EMPCODE = B.EMP_ID
 LEFT JOIN (
  SELECT DEPT_CD_FUNC,MIN(ACCT_DEPT_CD) AS ACCT_DEPT_CD 
  FROM (
   SELECT DISTINCT DEPT_CD_FUNC,ACCT_DEPT_CD FROM [TAS9-T].[TSAAS].[dbo].[HREMPM_N] WITH(NOLOCK) 
   WHERE DEPT_CD_FUNC LIKE 'AFJ%' AND ISNULL(QUIT_DT,'') = '' AND ACCT_DEPT_CD NOT IN ('0999','0068') 
  ) A1 
  GROUP BY DEPT_CD_FUNC
 ) C ON B.DEPT_CD_FUNC = C.DEPT_CD_FUNC
 LEFT JOIN ( --TW金融交易作業部
  SELECT 'B10_852' AS OLD_PERMCODE ,NULL AS NEW_PERMCODE UNION SELECT 'B10_852' AS OLD_PERMCODE ,'B10_0900' AS NEW_PERMCODE UNION
  SELECT 'B20_852' AS OLD_PERMCODE ,NULL AS NEW_PERMCODE UNION SELECT 'B20_852' AS OLD_PERMCODE ,'B20_0900' AS NEW_PERMCODE
 ) D ON D.OLD_PERMCODE=A.PERMCODE
 WHERE COMP_CD in('TSIB','TO') AND APPCODE ='AML' AND LEFT(PERMCODE,2) NOT IN ('SG','AU') AND ISNULL(QUIT_DT,'') = ''
 AND B.DEPT_CD_FUNC NOT LIKE 'ACVH%'
 AND A.EMPCODE NOT IN(SELECT EMPCODE FROM BatchJobDB..AML_EMP_DEPT_MAP WHERE TYP IN ('01','03'))

--01 集中
UNION ALL 
SELECT H.EMP_ID, H.CH_NM, T.APPCODE, CASE WHEN CHARINDEX('_',RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE,1,3) ELSE T.PERMCODE END PERMCODE, H.EMAL_ADDR, H.DEPT_CD_FUNC, H.DEPT_NM_FUNC, RTRIM(N.ACCT_DEPT_CD) ACCT_DEPT_CD
FROM   [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
  JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE=H.EMP_ID 
  JOIN (SELECT * FROM BatchJobDB..AML_EMP_DEPT_MAP WHERE TYP = '01') M ON T.EMPCODE=M.EMPCODE
  JOIN BatchJobDB..AML_RIGHTS_GROUP N ON M.ACCT_DEPT_CD = N.GRP
WHERE  H.COMP_CD='TSIB' AND T.APPCODE='AML'

--02 兼任
UNION ALL 
SELECT H.EMP_ID, H.CH_NM, T.APPCODE, CASE WHEN CHARINDEX('_',RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE,1,3) ELSE T.PERMCODE END PERMCODE, H.EMAL_ADDR, H.DEPT_CD_FUNC, H.DEPT_NM_FUNC, RTRIM(M.ACCT_DEPT_CD) ACCT_DEPT_CD
FROM   [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
  JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE=H.EMP_ID 
  JOIN (SELECT * FROM BatchJobDB..AML_EMP_DEPT_MAP WHERE TYP = '02') M ON T.EMPCODE=M.EMPCODE
WHERE  H.COMP_CD='TSIB' AND T.APPCODE='AML'

--03 員編
UNION ALL 
SELECT H.EMP_ID, H.CH_NM, T.APPCODE, CASE WHEN CHARINDEX('_',RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE,1,3) ELSE T.PERMCODE END PERMCODE, H.EMAL_ADDR, H.DEPT_CD_FUNC, H.DEPT_NM_FUNC, RTRIM(M.ACCT_DEPT_CD) ACCT_DEPT_CD
FROM   [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
  JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE=H.EMP_ID 
  JOIN (SELECT * FROM BatchJobDB..AML_EMP_DEPT_MAP WHERE TYP = '03') M ON T.EMPCODE=M.EMPCODE
WHERE  H.COMP_CD='TSIB' AND T.APPCODE='AML'

--04 權限
UNION ALL 
SELECT H.EMP_ID, H.CH_NM, T.APPCODE, CASE WHEN CHARINDEX('_',RTRIM(T.PERMCODE)) <> 0 THEN SUBSTRING(T.PERMCODE,1,3) ELSE T.PERMCODE END PERMCODE, H.EMAL_ADDR, H.DEPT_CD_FUNC, H.DEPT_NM_FUNC, RTRIM(M.ACCT_DEPT_CD) ACCT_DEPT_CD
FROM   [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP] T 
  JOIN [TAS9-T].[TSAAS].[dbo].[HREMPM_N]      H ON T.EMPCODE=H.EMP_ID 
  JOIN (SELECT * FROM BatchJobDB..AML_EMP_DEPT_MAP WHERE TYP = '04') M ON RTRIM(T.PERMCODE) LIKE '%' + M.PERMCODE
WHERE  H.COMP_CD='TSIB' AND T.APPCODE='AML'	




