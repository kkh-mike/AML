  -- Native Name  
  /*  
   Only Reduce RC for Native Name not matched when   
   - Setting for Native Name reduction is on  
   - From Web Service  
   - Non-English Name is fed in  
   - First character of Non-English Name is chinese character  
  */  
  IF (@NMCHK_RC_Reduction & 32) <> 0 AND @NativeName_RC > 0  
  BEGIN   
   IF EXISTS(SELECT 1 FROM dbo.NMCHK_CustInfo WHERE uid = @uid   
               AND Source_IND = 'O' -- From Web Service  
               AND dbo.fn_IsChinese(new_acct_name) = 1) -- First Character Is Chinese  
   BEGIN  
    -- List out all the hit entities into temp table  
    SELECT DISTINCT b.sdn_list, A.ent_num, A.sdn_grp_num  
    INTO #EnglishNameHitEntities  
    FROM #Temp_New_Acct_Matches_Table A  
    JOIN dbo.OFAC_SubList_DIM B ON A.sdn_type = B.sdn_type  
    WHERE dbo.fn_IsChinese(sdn_name) = 0 -- Not Chinese Name  
    AND A.section = '1'   
  
    -- Prepare hit entities that has chinese name  
    CREATE TABLE #EnglishNameHitEntities_HasNativeName(  
     list NVARCHAR(50),  
     ent_num INT,  
     sdn_grp_num INT  
    )  
  
    -- GVS List  
    INSERT INTO #EnglishNameHitEntities_HasNativeName (list, ent_num, sdn_grp_num)  
    SELECT DISTINCT A.list, A.ent_num, A.sdn_grp_num  
    FROM dbo.BlackListData A  
    JOIN #EnglishNameHitEntities B ON A.list = B.sdn_list AND A.ent_num = B.ent_num AND A.sdn_grp_num =  B.sdn_grp_num AND B.sdn_list NOT IN ('AC', 'DJ', 'WC')  
    WHERE dbo.fn_IsChinese(A.sdn_name) = 1   
  
    -- DJ  
    IF EXISTS(SELECT 1 FROM #EnglishNameHitEntities WHERE sdn_list = 'DJ')  
    BEGIN   
     INSERT INTO #EnglishNameHitEntities_HasNativeName (list, ent_num, sdn_grp_num)  
     SELECT A.sdn_list, A.ent_num, A.sdn_grp_num  
     FROM #EnglishNameHitEntities A  
     WHERE EXISTS(SELECT 1 FROM BSADB..DJ_AltName B WHERE A.ent_num = B.EntityId AND dbo.fn_IsChinese(B.FullName) = 1 AND B.Deleted = 0)  
     AND A.sdn_list = 'DJ'  
    END  
  
    --WC  
    IF EXISTS(SELECT 1 FROM #EnglishNameHitEntities WHERE sdn_list = 'WC')  
    BEGIN   
     INSERT INTO #EnglishNameHitEntities_HasNativeName (list, ent_num, sdn_grp_num)  
     SELECT A.sdn_list, A.ent_num, A.sdn_grp_num  
     FROM #EnglishNameHitEntities A  
     WHERE EXISTS(SELECT 1 FROM BSADB..WC_AltName B WHERE A.ent_num = B.EntityId AND dbo.fn_IsChinese(B.AltName) = 1 AND B.IsDeleted = 0)  
     AND A.sdn_list = 'WC'  
    END  
  
    --AC  
    IF EXISTS(SELECT 1 FROM #EnglishNameHitEntities WHERE sdn_list = 'AC')  
    BEGIN   
     INSERT INTO #EnglishNameHitEntities_HasNativeName (list, ent_num, sdn_grp_num)  
     SELECT A.sdn_list, A.ent_num, A.sdn_grp_num  
     FROM #EnglishNameHitEntities A  
     WHERE EXISTS(SELECT 1 FROM BSADB..AC_AltName B WHERE A.ent_num = B.EntityId AND dbo.fn_IsChinese(B.AltName) = 1 AND B.IsDeleted = 0)  
     AND A.sdn_list = 'AC'  
    END  
  
    CREATE CLUSTERED INDEX idx_CIFKey_With_CustName ON #EnglishNameHitEntities_HasNativeName(list, ent_num, sdn_grp_num)  
  
    /* Compare and deduct RC */  
    ;WITH EnglishNameHitEntityHasChineseNames AS (  
     SELECT A.relative_correlation, A.Reduction_IND, B.sdn_list, A.ent_num, A.sdn_grp_num, A.CombineKey  
     FROM #Temp_New_Acct_Matches_Table A  
     JOIN OFAC_SubList_DIM B ON A.sdn_type = B.sdn_type  
     WHERE dbo.fn_IsChinese(A.sdn_name) = 0 -- Not Chinese Name  
     AND A.section = '1'  
     AND EXISTS(SELECT 1 FROM #EnglishNameHitEntities_HasNativeName Z WHERE B.sdn_list = Z.list AND A.ent_num = Z.ent_num AND A.sdn_grp_num = Z.sdn_grp_num)   
    ), ChineseNameExactMatchResult AS (  
     SELECT B.sdn_list, A.ent_num, A.sdn_grp_num, A.CombineKey  
     FROM #Temp_New_Acct_Matches_Table A  
     JOIN OFAC_SubList_DIM B ON A.sdn_type = B.sdn_type  
     WHERE dbo.fn_IsChinese(A.sdn_name) = 1  -- Chinese Name  
     AND A.section = '1'  
     AND A.OriRC = 100 -- Exact Match  
    )  
    UPDATE a   
    SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @NativeName_RC, Reduction_IND = STUFF(Reduction_IND, 7, 1, 'Y')  
    FROM EnglishNameHitEntityHasChineseNames A  
    WHERE NOT EXISTS(SELECT 1 FROM ChineseNameExactMatchResult B WHERE A.sdn_list = B.sdn_list AND A.ent_num = B.ent_num AND A.sdn_grp_num = B.sdn_grp_num AND A.CombineKey = B.CombineKey)  
   END  
  END   
  
