ALTER PROC [dbo].[NMCHK_GetNMCHKRemarkLog] 
    @UID NVARCHAR(80),             -- 案件/比對記錄的唯一識別碼
    @Name_Key NVARCHAR(20),        -- 姓名鍵值 (注意：下方 WHERE 條件目前寫死為 1)
    @CultureName VARCHAR(5) = NULL -- 語系代碼 (例如 'zh-TW'，預設 NULL)
AS

SELECT 
    A.UID, 
    
    -- 1. 轉換角色名稱：若語系為繁中則取 ROLE_DESC_zh_TW，否則取預設 ROLE_DESC
    (SELECT CASE 
                WHEN @CultureName = 'zh-TW' THEN ROLE_DESC_zh_TW 
                ELSE ROLE_DESC 
            END 
     FROM WORKFLOW_MGMT_ROLE 
     WHERE A.[ROLE] = ID) AS [ROLE],
    
    -- 2. 轉換動作名稱：
    --    - Action = 1: 取得 'FalseMatch' (誤辨/非名單) 多語系字串
    --    - Action = 2: 取得 'TrueMatch' (命中/確定為名單) 多語系字串
    --    - 其他 Action: 從工作流程動作表查詢對應描述
    (SELECT CASE 
                WHEN A.Action = 1 THEN dbo.GetResourceString('FalseMatch')
                WHEN A.Action = 2 THEN dbo.GetResourceString('TrueMatch')
                ELSE (
                    SELECT CASE 
                               WHEN @CultureName = 'zh-TW' THEN ACTION_DESC 
                               ELSE ACTION_DESC 
                           END 
                    FROM dbo.WORKFLOW_MGMT_ACTION 
                    WHERE A.[ACTION] = ID
                ) 
            END) AS [ACTION],
            
    A.UPDATEDBY, 
    
    -- 3. 取得更新人員全名：串接未刪除使用者的 FirstName 與 LastName
    (SELECT ISNULL(FirstName, '') + ' ' + ISNULL(LastName, '') 
     FROM UserAccounts 
     WHERE USERID = A.UPDATEDBY AND Deleted = 0) AS UpdatedBy_UserName, 
    
    A.UPDATED_DATE,          -- 紀錄更新時間
    A.REMARK,                -- 審核備註內容
    A.Id AS RemarkLogId,     -- 備註紀錄的主鍵 ID
    A.[ACTION] AS ActionId,  -- 動作原始代碼
    A.ExtendedReviewDate     -- 展延審查日期
FROM dbo.NMCHK_REMARKLOG A WITH (NOLOCK)
WHERE A.UID = @UID 
  AND A.Name_Key = 1         -- 篩選 Name_Key 為 1 的紀錄
ORDER BY UPDATED_DATE DESC   -- 依更新時間由新到舊排序

程式碼潛在問題提醒
 * 參數未被使用：傳入的 @Name_Key 參數在查詢條件中被寫死為 AND A.Name_Key = 1，這會導致傳入其他 @Name_Key 值時無法生效。若需動態過濾，應改為 AND A.Name_Key = @Name_Key。
 * 多語系動作欄位疑點：在 WORKFLOW_MGMT_ACTION 的子查詢中，WHEN @CultureName = 'zh-TW' 與 ELSE 都是回傳 ACTION_DESC，繁中分支疑似少寫了 _zh_TW 欄位（例如 ACTION_DESC_zh_TW）。
