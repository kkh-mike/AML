CREATE PROCEDURE [dbo].[NMCHK_Detection_CombineResults]  
@uid NVARCHAR(20),  
@isDetected VARCHAR(1) = NULL OUTPUT,  
@HighestDetectedRC INT = NULL OUTPUT  
AS  
DECLARE   
@CHOOSEN_RC INT = 75,   
@NMCHK_RC_Reduction INT = 0,   
/*  
 @NMCHK_RC_Reduction Bitwise  
 1 - Country  
 2 - DOB  
 4 - Low Risk List  
 8 - Nationality (CTBC)  
 16 - Gender (CTBC)  
 32 - Customer Type (CTBC)  
 64 - Native Name (Standard)  
 128 - Identification Number (Standard)  
*/  
@NMCHK_CTRY_CHECK CHAR(1) = 'Y' -- Y to enable country checking  
  
SELECT TOP 1 @NMCHK_CTRY_CHECK = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'NMCHK_CTRY_CHECK' AND Module = 'NMCHK';  
  
 IF OBJECT_ID('tempdb..#NMCHK','U') IS NOT NULL  
 BEGIN  
  DROP TABLE #NMCHK  
 END  
 CREATE TABLE #NMCHK_CustInfo (  
 new_acct_key INT NOT NULL,   
 new_acct_name NVARCHAR(350) NULL,   
 country NVARCHAR(50) NULL,   
 Nationality NVARCHAR(50) NULL,   
 DOB NVARCHAR(10) NULL,   
 AMLRefNo NVARCHAR(20) NULL,   
 NameSource NVARCHAR(20) NULL,   
 PRIMARY KEY (new_acct_key),  
 CombineKey INT,   
 Gender NVARCHAR(2),  
 IdentificationNumber NVARCHAR(MAX),   
 NameCategory INT,   
 VesselIMONo NVARCHAR(MAX)  
)  
  
 IF OBJECT_ID('tempdb..#Temp_New_Acct_Matches_Table','U') IS NOT NULL  
 BEGIN  
  DROP TABLE #Temp_New_Acct_Matches_Table  
 END  
 CREATE TABLE #Temp_New_Acct_Matches_Table (  
 new_acct_key int NOT NULL,   
 ent_num int NOT NULL,   
 alt_num INT NOT NULL,   
 relative_correlation int NULL,   
 sdn_name NVARCHAR (350) NULL,  
 sdn_type NVARCHAR (50) NOT NULL,   
 sdn_grp_num int NOT NULL,  
 name_cat int NULL,  
 updated_date NVARCHAR (10) NULL,  
 section NVARCHAR (3) NULL,  
 NamePropertyBitCode int NULL,  
 SourceColumn VARCHAR(20) NULL,   
 Reduction_IND CHAR(10) NULL,   
 OriRC INT NULL,   
 CombineKey INT  
 --PRIMARY KEY (new_acct_key, sdn_type, sdn_grp_num, ent_num, alt_num, section)  
)  
  
BEGIN  
SET NOCOUNT ON  
  
--set default output value  
SET @isDetected = 'N'  
SET @HighestDetectedRC = 0  
  
SELECT TOP 1 @NMCHK_RC_Reduction = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'NMCHK_RC_Reduction' AND Module = 'NMCHK'  
  
IF EXISTS (SELECT 1 FROM dbo.NMCHK_OnlineService WITH(NOLOCK) WHERE UID = @uid)  
 SELECT TOP 1 @CHOOSEN_RC = CtrlVal FROM dbo.POCTRL A WITH(NOLOCK) WHERE CtrlKey = 'NMCHK_RC' AND EXISTS(SELECT 1 FROM dbo.NMCHK_OnlineService B WITH(NOLOCK) WHERE B.UID = @uid AND A.Module = B.Module)  
ELSE   
 SELECT TOP 1 @CHOOSEN_RC = CtrlVal FROM dbo.POCTRL WITH(NOLOCK) WHERE CtrlKey = 'NMCHK_RC' AND Module = 'NMCHK'  
  
INSERT INTO #NMCHK_CustInfo (new_acct_key, new_acct_name, country, Nationality, DOB, AMLRefNo, NameSource, CombineKey, Gender, IdentificationNumber, NameCategory, VesselIMONo)  
SELECT new_acct_key, new_acct_name, country, Nationality, DOB, REFNO, NameSource, CombineKey, Gender, IDNUM, NameCategory, VesselIMONo  
FROM dbo.NMCHK_CustInfo WITH (NOLOCK) WHERE uid = @uid  
  
--Filteration (Gender, EntityType)  
BEGIN   
 --Name Category   
 IF EXISTS(SELECT NULL FROM #NMCHK_CustInfo WHERE NameCategory <> 0)  
 BEGIN   
  DELETE A   
  FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
  WHERE NOT EXISTS(SELECT NULL FROM #NMCHK_CustInfo X   
       WHERE A.NameKey = X.new_acct_key  
       AND X.NameCategory & A.name_cat <> 0  
       AND X.NameCategory & A.name_cat <> 0)  
    AND EXISTS(SELECT NULL FROM #NMCHK_CustInfo X   
          WHERE A.NameKey = X.new_acct_key  
        AND ISNULL(X.NameCategory,0) <> 0)  
  
  --VesselIMONumber  
  IF EXISTS(SELECT NULL FROM #NMCHK_CustInfo WHERE NameCategory & 4 <> 0 AND ISNULL(VesselIMONo,'') <> '')  
  BEGIN   
   ;WITH CTE_DJ AS   
   (  
    SELECT D.SdnName, D.SubListGroupNumber, D.UpdatedDate, C.EntityId, C.IdentificationNumber   
    FROM BSADB..DJ_IdentificationTypeInfo C WITH (NOLOCK)   
    JOIN BSADB..DJ_List_Data_A D WITH (NOLOCK) ON C.EntityId = D.EntNum AND D.SubList = 'DJ' AND D.AltNum = 0  
    WHERE C.IdentificationType = 'International Maritime Organization (IMO) Ship No.' AND C.Deleted = 0   
   ),  
   CTE_WC AS   
   (  
    SELECT C.EntityId, C.IdentificationValue   
    FROM BSADB..WC_Identification C WITH (NOLOCK)   
    JOIN BSADB..WC_ListData D WITH (NOLOCK) ON C.EntityId = D.EntNum AND D.SubList = 'WC' AND D.AltNum = 0  
    WHERE C.IdentificationType = 'INT-IMO' AND C.IsDeleted = 0   
   )  
   DELETE A   
   FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
    INNER JOIN #NMCHK_CustInfo B ON A.NameKey = B.new_acct_key  
   WHERE B.NameCategory & 4 = 4  
    AND ISNULL(B.VesselIMONo, '') <>''  
    --OFAC, EU, UKHMT   
    AND NOT EXISTS(SELECT NULL FROM dbo.OFAC_SDN_IMO X INNER JOIN dbo.BlackListData Y ON X.Ent_Num = Y.ent_num AND X.List = Y.list  
          WHERE A.ent_num = X.Ent_Num AND B.VesselIMONo = X.IMO_No AND X.Deleted = 'N')  
    --DJ  
    AND NOT EXISTS(SELECT NULL FROM CTE_DJ X   
          WHERE A.sdn_type IN ('DJ','DJ ALT') AND A.ent_num = X.EntityId AND B.VesselIMONo = X.IdentificationNumber)  
    --UN  
    AND NOT EXISTS(SELECT NULL FROM dbo.UN_Vessel_List X   
          WHERE A.sdn_type IN ('UN','UN ALT') AND A.ent_num = X.EntNum AND B.VesselIMONo = X.IMONumber AND X.IsDeleted = 0)  
    --WC  
    AND NOT EXISTS(SELECT NULL FROM CTE_WC X   
          WHERE A.sdn_type IN ('WC','WC ALT') AND A.ent_num = X.EntityId AND B.VesselIMONo = X.IdentificationValue)  
  END   
 END   
  
 --Gender   
 IF EXISTS (SELECT 1 FROM dbo.PO_DefaultData WHERE Module = 'NMCHK' AND CtrlKey = 'GenderFilter' AND CtrlVal = 'Y')  
 BEGIN  
  IF EXISTS(SELECT NULL FROM #NMCHK_CustInfo WHERE ISNULL(Gender,'') <> '')  
   BEGIN   
   ;WITH CTE_GENDER AS   
   (  
    --EU  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN dbo.EU_SANCTIONS_NAME B ON A.ent_num = B.NAME_ID  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type = 'EU'  
    UNION   
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, D.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN dbo.EU_SANCTIONS_NAME B ON A.ent_num = B.NAME_ID  
     INNER JOIN dbo.EU_SANCTIONS_ALT C ON B.ENTITY_ID = C.ENTITY_ID  
     INNER JOIN dbo.Gender_Dim D ON ISNULL(LTRIM(RTRIM(C.GENDER)),'') = D.GenderCode  
    WHERE A.sdn_type = 'EU ALT'  
    UNION   
    --OFAC  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN dbo.OFAC_SDN_SanitizedRemark B ON A.ent_num = B.ENT_NUM  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('OFAC', 'OFAC ALT')  
    UNION  
    --UKHMT  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN BSADB.dbo.UKHMT_MainName B ON A.ent_num = B.EntNum  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('UKHMT', 'UKHMT ALT')  
    UNION   
    --UN  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN dbo.UN_SANCTIONS_LIST B ON A.ent_num = B.ENT_NUM  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('UN', 'UN ALT')  
    UNION  
    --DJ  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN BSADB.dbo.DJ_Entity B ON A.ent_num = B.EntityId  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderDescription  
    WHERE A.sdn_type IN ('DJ', 'DJ ALT')  
    UNION  
    --WC  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN BSADB.dbo.WC_MainName B ON A.ent_num = B.EntityId  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.EntityType)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('WC', 'WC ALT')  
    UNION  
    --AC  
    SELECT A.NameKey, A.ent_num, A.alt_num, A.sdn_type, D.GenderCode  
    FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
     INNER JOIN BSADB.dbo.AC_MainName B ON A.ent_num = B.EntityId  
     INNER JOIN BSADB.dbo.AC_SupplementalData C ON B.EntityId = C.EntityId  
     INNER JOIN dbo.Gender_Dim D ON ISNULL(LTRIM(RTRIM(C.DataValue)),'') = D.GenderCode OR ISNULL(LTRIM(RTRIM(C.DataValue)),'') = D.GenderDescription  
    WHERE A.sdn_type IN ('AC', 'AC ALT')  
   )  
   DELETE A   
   FROM dbo.NMCHK_OtherListDetectionResults_Temp A   
    INNER JOIN CTE_GENDER B   
     ON A.NameKey = B.NameKey AND A.ent_num = B.ent_num   
      AND A.alt_num = B.alt_num  
      AND A.sdn_type = B.sdn_type  
    INNER JOIN #NMCHK_CustInfo C   
     ON B.NameKey = C.new_acct_key  
   WHERE B.GenderCode <> C.Gender  
  END  
 END   
END   
  
--Country check  
IF @NMCHK_CTRY_CHECK = 'Y'  
BEGIN  
 DECLARE @NMCHK_Country TABLE (  
  new_acct_key INT,   
  CountryCode VARCHAR(10),   
  Type VARCHAR(20)  
 )  
   
 INSERT INTO @NMCHK_Country ( new_acct_key, CountryCode, Type)  
 SELECT new_acct_key, country, 'Country' FROM #NMCHK_CustInfo WHERE ISNULL(country, '') <> ''  
 UNION ALL   
 SELECT new_acct_key, Nationality, 'Nationality' FROM #NMCHK_CustInfo WHERE  ISNULL(Nationality, '') <> ''  
  
 INSERT INTO #Temp_New_Acct_Matches_Table([new_acct_key], [ent_num], [alt_num], [relative_correlation], [sdn_name], [sdn_type], [sdn_grp_num], [name_cat], [updated_date], [section], [NamePropertyBitCode], [SourceColumn])  
 SELECT DISTINCT A.new_acct_key, X.ent_num, 0 AS alt_num, '100', X.country AS sdn_name, X.sdn_type, 0 AS sdn_grp_num, 16 AS name_cat, X.updated_date, '2', 1, A.Type  
 FROM @NMCHK_Country A, dbo.OFAC_COUNTRY X WITH(NOLOCK)  
 WHERE A.CountryCode = X.ISO_2CTRY_CDE AND X.DEL_IND = 'N'  
 AND EXISTS (SELECT Z.LIST FROM dbo.NMCHK_Setting_Log Z WITH(NOLOCK) WHERE Z.uid = @uid AND Z.FLAG = 'Y' AND x.sdn_type = z.LIST)  
   
 INSERT INTO #Temp_New_Acct_Matches_Table([new_acct_key], [ent_num], [alt_num], [relative_correlation], [sdn_name], [sdn_type], [sdn_grp_num], [name_cat], [updated_date], [section], [NamePropertyBitCode], [SourceColumn])  
 SELECT DISTINCT A.new_acct_key, X.ent_num, 0 AS alt_num, '100', X.[CountryDescription] AS sdn_name, 'SPEC', X.[GroupID] AS sdn_grp_num, 16 AS name_cat, X.[UpdatedDate], '2', 1, A.Type  
 FROM @NMCHK_Country A, dbo.[OFAC_SPEC_RestrictedCountry] X WITH(NOLOCK)  
 WHERE A.CountryCode = X.CountryCode  
 AND ((X.[ApprovedDate] IS NOT NULL AND X.[DInd] = 'N')   
  OR (X.[ApproveDeletedRecordDate] IS NULL AND X.[DInd] = 'P'))  
 AND EXISTS(SELECT 1 FROM dbo.NMCHK_Setting_Log Z WITH(NOLOCK) WHERE Z.uid = @uid AND Z.FLAG = 'Y' AND Z.[LIST] = 'SPEC' AND Z.[LIST_ID] = X.[GroupID])  
END  
  
  
;WITH CTE_Results AS (  
 --third party list (DJ, WC, AC) results  
 SELECT A.NameKey AS new_acct_key, A.ent_num, A.alt_num, A.RelativeCorrelation AS relative_correlation, A.sdn_name, A.sdn_type, a.sdn_grp_num, a.name_cat, CONVERT(VARCHAR(10), A.UpdatedDate_UTC, 112) AS updated_date,   
 '1' AS section, A.NamePropertyBitCode, b.NameSource AS SourceColumn, REPLICATE('N', 10) AS Reduction_IND, A.RelativeCorrelation, B.CombineKey  
 FROM dbo.NMCHK_OtherListDetectionResults_Temp A WITH(NOLOCK) JOIN #NMCHK_CustInfo B ON a.NameKey = b.new_acct_key  
 WHERE A.Uid = @uid  
)  
, CTE_EliminateDuplicate AS (  
 SELECT *, ROW_NUMBER()OVER(PARTITION BY new_acct_key, ent_num, alt_num, sdn_name, sdn_type, sdn_grp_num, updated_date, section, NamePropertyBitCode, CombineKey  
 ORDER BY relative_correlation DESC) AS RowIndex  
 FROM CTE_Results   
)  
INSERT INTO #Temp_New_Acct_Matches_Table (new_acct_key, ent_num, alt_num, relative_correlation, sdn_name, sdn_type, sdn_grp_num, name_cat, updated_date, section, NamePropertyBitCode, SourceColumn, Reduction_IND, OriRC, CombineKey)  
SELECT new_acct_key, ent_num, alt_num, relative_correlation, sdn_name, sdn_type, sdn_grp_num, name_cat, updated_date, section, NamePropertyBitCode, SourceColumn, Reduction_IND, relative_correlation, CombineKey  
FROM CTE_EliminateDuplicate WHERE CTE_EliminateDuplicate.RowIndex = 1   
      
  
DECLARE   
@COUNTRY_RC INT = 0,  
@DOB_RC INT = 0,  
@LowRiskList_RC INT = 0,  
@Gender_RC INT = 0,  
@NativeName_RC INT = 0,   
@IdentificationNumber_RC INT = 0  
  
SELECT TOP 1 @COUNTRY_RC = COUNTRY, @DOB_RC = DOB, @LowRiskList_RC = LowRiskList, @Gender_RC = Gender, @NativeName_RC = NativeName,   
    @IdentificationNumber_RC = IdentificationNumber  
FROM dbo.OFACTDBSettings WITH(NOLOCK)  
  
-- Insert rc reduction log   
IF EXISTS(SELECT 1 FROM dbo.OFACTDBSettings_LOG WITH(NOLOCK) WHERE UID = @uid AND Module = 'NMCHK')  
 UPDATE dbo.OFACTDBSettings_LOG  
 SET Country = @COUNTRY_RC, DOB= @DOB_RC, LowRiskList = @LowRiskList_RC, Gender = @Gender_RC, NativeName = @NativeName_RC, IdentificationNumber = @IdentificationNumber_RC  
 WHERE UID = @uid AND Module = 'NMCHK'  
ELSE  
 INSERT INTO dbo.OFACTDBSettings_LOG (UID, Country, DOB, LowRiskList, Module, Gender, NativeName, IdentificationNumber)   
 VALUES (@uid, @COUNTRY_RC, @DOB_RC, @LowRiskList_RC, 'NMCHK', @Gender_RC, @NativeName_RC, @IdentificationNumber_RC);  
  
/*RC REDUCTION*/  
IF EXISTS (SELECT 1 FROM #Temp_New_Acct_Matches_Table WHERE section = '1')  
BEGIN  
 /*  
  Reduction_IND  
  1 - Country  
  2 - DOB  
  3 - Low Risk  
  4 - Nationality (CTBC)  
  5 - Gender (CTBC)  
  6 - Customer Type (CTBC)  
  7 - Native Name (Standard)  
  8 - Identification Number (Standard)  
 */  
   
 IF @NMCHK_RC_Reduction <> 0  
 BEGIN  
    
  DECLARE @tempOfacConsolidateList AS TABLE (List NVARCHAR(50))  
  INSERT INTO @tempOfacConsolidateList ( List )  
  SELECT DISTINCT List FROM BSADB.dbo.Blacklist_MainName WITH(NOLOCK)   
  UNION ALL  
  SELECT DISTINCT List + ' ALT' FROM BSADB.dbo.Blacklist_MainName WITH(NOLOCK)   
  
  -- country reduction (1)  
  IF (@NMCHK_RC_Reduction & 1) <> 0 AND @COUNTRY_RC > 0  
  BEGIN  
   --OFAC  
   UPDATE a   
   SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')  
   FROM #Temp_New_Acct_Matches_Table a  
   INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key   
   WHERE a.sdn_type IN ('OFAC', 'OFAC ALT') AND a.SECTION = '1'   
   --Check input name country/nationality is not empty   
   AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')  
   --Check SDN name country have country code   
   AND EXISTS(SELECT 1 FROM dbo.OFAC_ADDR y WITH(NOLOCK) WHERE a.ent_num = y.ENT_NUM   
      AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = Y.COUNTRY   
         AND C.List = 'OFAC' AND C.ISO2_CountryCode IS NOT NULL))  
   --Check is not exists input name country/nationality = SDN name country; means all also not same, then can deduct RC   
   AND NOT EXISTS(SELECT 1 FROM dbo.OFAC_ADDR x WITH(NOLOCK) WHERE a.ent_num = x.ENT_NUM   
       AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = X.COUNTRY   
          AND C.List = 'OFAC' AND C.ISO2_CountryCode IS NOT NULL   
          AND (C.ISO2_CountryCode = B.country OR C.ISO2_CountryCode = B.Nationality))  
        )  
        
   --SSI, FSE, OFAC Non-SDN  
   UPDATE a   
   SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')  
   FROM #Temp_New_Acct_Matches_Table a  
   INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key   
   WHERE a.sdn_type IN (SELECT List FROM @tempOfacConsolidateList) AND a.SECTION = '1'   
   --Check input name country/nationality is not empty   
   AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')  
   --Check SDN name country have country code   
   AND EXISTS(SELECT 1 FROM BSADB.dbo.Blacklist_Address y WITH(NOLOCK) WHERE a.ent_num = y.EntNum AND y.IsDeleted = 0  
      AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = Y.COUNTRY   
         AND C.List = y.List AND C.ISO2_CountryCode IS NOT NULL))  
   --Check is not exists input name country/nationality = SDN name country; means all also not same, then can deduct RC   
   AND NOT EXISTS(SELECT 1 FROM BSADB.dbo.Blacklist_Address x WITH(NOLOCK) WHERE a.ent_num = x.EntNum AND x.IsDeleted = 0  
       AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = X.COUNTRY   
          AND C.List = x.List AND C.ISO2_CountryCode IS NOT NULL   
          AND (C.ISO2_CountryCode = B.country OR C.ISO2_CountryCode = B.Nationality))  
        )  
  
   --UKHMT  
   UPDATE a   
   SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')  
   FROM #Temp_New_Acct_Matches_Table a  
   INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key   
   WHERE a.sdn_type IN ('UKHMT', 'UKHMT ALT') AND a.SECTION = '1'   
   --Check input name country/nationality is not empty   
   AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')  
   --Check SDN name country have country code   
   AND EXISTS(SELECT 1 FROM BSADB.dbo.UKHMT_Address y WITH(NOLOCK)   
      WHERE a.ent_num = y.EntNum AND y.IsDeleted = 0  
      AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = Y.COUNTRY   
         AND C.List = 'UKHMT' AND C.ISO2_CountryCode IS NOT NULL))  
   --Check is not exists input name country/nationality = SDN name country; means all also not same, then can deduct RC   
   AND NOT EXISTS(SELECT 1 FROM BSADB.dbo.UKHMT_Address x WITH(NOLOCK)   
       WHERE a.ent_num = x.EntNum AND x.IsDeleted = 0  
       AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = X.COUNTRY   
          AND C.List = 'UKHMT' AND C.ISO2_CountryCode IS NOT NULL   
          AND (C.ISO2_CountryCode = B.country OR C.ISO2_CountryCode = B.Nationality))  
        )  
  
   --EU    
   UPDATE a   
   SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')  
   FROM #Temp_New_Acct_Matches_Table a  
   INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key   
   WHERE a.sdn_type IN ('EU', 'EU ALT') AND a.SECTION = '1'   
   --Check input name country/nationality is not empty   
   AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')  
   --Check SDN name country have country code   
   AND EXISTS(SELECT 1 FROM EU_SANCTIONS_ADDRESS y WITH(NOLOCK)   
      JOIN dbo.EU_SANCTIONS_NAME z WITH(NOLOCK) ON y.ENTITY_ID = z.ENTITY_ID   
      WHERE a.ent_num = z.NAME_ID AND y.DEL_FLAG = 'N'  
      AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = Y.COUNTRY   
         AND C.List = 'EU' AND C.ISO2_CountryCode IS NOT NULL))  
   --Check is not exists input name country/nationality = SDN name country; means all also not same, then can deduct RC   
   AND NOT EXISTS(SELECT 1 FROM EU_SANCTIONS_ADDRESS x WITH(NOLOCK)   
       JOIN dbo.EU_SANCTIONS_NAME z WITH(NOLOCK) ON x.ENTITY_ID = z.ENTITY_ID   
       WHERE a.ent_num = z.NAME_ID AND x.DEL_FLAG = 'N'  
       AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = X.COUNTRY   
          AND C.List = 'EU' AND C.ISO2_CountryCode IS NOT NULL   
          AND (C.ISO2_CountryCode = B.country OR C.ISO2_CountryCode = B.Nationality))  
        )  
  
   --UN  
   UPDATE a   
   SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @COUNTRY_RC, Reduction_IND = STUFF(Reduction_IND, 1, 1, 'Y')  
   FROM #Temp_New_Acct_Matches_Table a  
   INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key   
   WHERE a.sdn_type IN ('UN', 'UN ALT') AND a.SECTION = '1'   
   --Check input name country/nationality is not empty   
   AND (ISNULL(B.country, '') <> '' OR ISNULL(B.Nationality, '') <> '')  
   --Check SDN name country have country code   
   AND (EXISTS(SELECT 1 FROM UN_SANCTIONS_ADDR y WITH(NOLOCK)   
      WHERE a.ent_num = y.ENT_NUM AND y.DEL_IND = 'N'  
      AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = Y.COUNTRY   
         AND C.List = N'UN' AND C.ISO2_CountryCode IS NOT NULL))  
    OR EXISTS(SELECT 1 FROM dbo.UN_SANCTIONS_LIST y WITH(NOLOCK)  
      WHERE a.ent_num = y.ENT_NUM AND y.DEL_IND = 'N'  
      AND EXISTS (SELECT 1 FROM dbo.CountryMapping_Dim C WHERE C.CountryDescription = Y.Nationality  
         AND C.List = N'UN' AND C.ISO2_CountryCode IS NOT NULL)))  
   --Check is not exists input name country/nationality = SDN name country; means all also not same, then can deduct RC   
   AND NOT EXISTS(SELECT 1 FROM UN_SANCTIONS_ADDR x WITH(NOLOCK)   
