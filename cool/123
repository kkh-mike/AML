   AND EXISTS(SELECT NULL FROM CTE_EU_SANCTONS_PASSPORT X  JOIN dbo.EU_SANCTIONS_NAME z WITH(NOLOCK) ON X.ENTITY_ID = Z.ENTITY_ID   
      WHERE A.ent_num = Z.NAME_ID   
      AND NUMBER IS NOT NULL)  
   --Check is not exists input name identification number = SDN name identification number; means all also not same, then can deduct RC   
   AND NOT EXISTS(SELECT NULL FROM CTE_EU_SANCTONS_PASSPORT X JOIN dbo.EU_SANCTIONS_NAME z WITH(NOLOCK) ON X.ENTITY_ID = Z.ENTITY_ID   
       WHERE A.ent_num = Z.NAME_ID  
       AND X.NUMBER = B.IdentificationNumber)  
  
   --UKHMT  
   UPDATE a   
   SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @IdentificationNumber_RC, Reduction_IND = STUFF(Reduction_IND, 8, 1, 'Y')  
   FROM #Temp_New_Acct_Matches_Table a  
   INNER JOIN #NMCHK_CustInfo B ON A.new_acct_key = b.new_acct_key   
   WHERE a.sdn_type IN ('UKHMT', 'UKHMT ALT') AND a.SECTION = '1'   
   --Check input name identification number is not empty   
   AND (ISNULL(B.IdentificationNumber, '') <> '' OR ISNULL(B.IdentificationNumber, '') <> '')  
