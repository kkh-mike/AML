D.DateOfBirth) <= 4 THEN NULL ELSE CASE WHEN ISDATE(D.DateOfBirth) = 1 THEN MONTH(D.DateOfBirth) ELSE NULL END END = MONTH(C.DOB)            ) --Or month value is null             OR CASE WHEN LEN(D.DateOfBirth) <= 4 THEN NULL ELSE CASE WHEN ISDATE(D.DateOfBirth) = 1 THEN MONTH(D.DateOfBirth) ELSE NULL END END IS NULL           )          )         )        )               --AC    UPDATE A    SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @DOB_RC , Reduction_IND = STUFF(Reduction_IND, 2, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table A     INNER JOIN #NMCHK_CustInfo C ON A.UID = C.uid AND A.new_acct_key = C.new_acct_key     WHERE A.sdn_type IN ('AC', 'AC ALT') AND A.SECTION = '1'     --Check input name DOB year is not null    AND ISNULL(C.DOB, '') <> ''    --Check is exists SDN name DOB year is not null    AND EXISTS(SELECT 1 FROM BSADB.dbo.AC_DateOfBirth Y WITH(NOLOCK) WHERE A.ent_num = Y.EntityId AND Y.IsDeleted = 0        AND ISNULL(Y.YearValue,'') <> '')    --Check is not exists input name DOB year = SDN name DOB year; means all also not same year, then can deduct RC     AND NOT EXISTS (SELECT 1 FROM BSADB.dbo.AC_DateOfBirth D WITH(NOLOCK) WHERE D.EntityId = A.ent_num AND D.IsDeleted = 0         AND ISNULL(D.YearValue,'') <> ''        AND D.YearValue = YEAR(C.DOB)         AND (@CheckMonthLevel = 0          OR (@CheckMonthLevel = 1           AND ( --Check if CheckMonth is turned on, month value is not null and input name DOB month = SDN name DOB month             (ISNULL(D.MonthValue,'') <> ''             AND D.MonthValue = MONTH(C.DOB)            ) --Or month value is null             OR ISNULL(D.MonthValue,'') = ''           )          )         )        )      --SPEC    UPDATE a     SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @DOB_RC , Reduction_IND = STUFF(Reduction_IND, 2, 1, 'Y')    FROM #Temp_New_Acct_Matches_Table a    INNER JOIN #NMCHK_CustInfo C ON A.UID = C.uid AND A.new_acct_key = C.new_acct_key     WHERE a.sdn_type IN ('SPEC', 'SPEC_CN') AND a