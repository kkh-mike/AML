ALTER PROC [dbo].[NMCHK_GetAssignSupervisor]
	@USERID NVARCHAR(60),
	@ROLE INT,
	@TYPE CHAR(1),
	@CultureName VARCHAR(5) = NULL,
	@QueueID VARCHAR(MAX) = NULL,
	@UserNMCHKRole INT = NULL
AS
BEGIN
	SET NOCOUNT ON;
	
	IF @QueueID <> '' OR @QueueID IS NOT NULL 
	BEGIN 
		DECLARE @TempQueueId TABLE(QueueId INT NOT NULL PRIMARY KEY)
		INSERT INTO @TempQueueId ( QueueId )
		SELECT DISTINCT Value FROM dbo.fnStringSplitter(@QueueID,'|') WHERE ISNULL(Value,'') <> '' AND ISNUMERIC(Value) = 1;

		DECLARE @QueueCount INT = 0 ;
		SELECT @QueueCount = COUNT(1) FROM @TempQueueId;
		
		DECLARE @Settings TABLE(ROLE_DESC NVARCHAR(100), UserRole INT, [Return] BIT, Escalate BIT, FalseMatch BIT, TrueMatch BIT, Accept BIT, 
			ApproveToFile BIT, DoNoFile BIT, FileSAR BIT, ReadOnlyQuestionnaire BIT, AssignQueue BIT, DoNotFileBulk BIT, EscalateBulk BIT,
			CaseReporter BIT)
		DECLARE @CursorQueueID INT 

		DECLARE TARGETTABLE_CUR CURSOR LOCAL FORWARD_ONLY READ_ONLY FOR
		SELECT QueueId FROM @TempQueueId

		OPEN TARGETTABLE_CUR
		FETCH TARGETTABLE_CUR
		INTO @CursorQueueID

		IF (@@FETCH_STATUS <> 0)
		BEGIN
			CLOSE TARGETTABLE_CUR
			DEALLOCATE TARGETTABLE_CUR
			RETURN
		END

		WHILE (@@FETCH_STATUS = 0)
		BEGIN	
			INSERT INTO @Settings EXEC dbo.GetQueueAndActionSettings @USERID,@CursorQueueID,@UserNMCHKRole,'NAME';
			FETCH TARGETTABLE_CUR
			INTO @CursorQueueID
		END	

		CLOSE TARGETTABLE_CUR
		DEALLOCATE TARGETTABLE_CUR
	END
	
	IF ISNULL(@QueueID,'') = '' AND ISNULL(@UserNMCHKRole,'') = ''
	BEGIN
		IF @TYPE = 'A' OR @TYPE = 'B'
		BEGIN
			;WITH CTE_QueueId AS(
				SELECT [A].[QUEUEID]
				FROM [dbo].[WORKFLOW_MGMT_USERS] A
				JOIN [dbo].[WORKFLOW_MGMT_QUEUE] B
				ON A.[QUEUEID] = B.[QUEUEID]
				WHERE B.[SRC] = 'NAME' AND 
					A.[USERID] = @USERID AND A.[ROLE] = @ROLE
			)
			SELECT DISTINCT /*user may have same role on different queue, so we remove the duplicate user id for diff queue*/
				A.[USERID], A.[ROLE], 
				A.[USERID] + ' [' + ISNULL(B.[FirstName],'') + ' ' + ISNULL(B.[LastName],'')  + '] ' +  
				' - (' + C.[ROLE_DESC] + ')' ROLE_DESC,  
				A.[USERID] + NCHAR(196) +  CONVERT(NVARCHAR(8),A.[ROLE]) ROLE_VALUE  
			FROM [dbo].[WORKFLOW_MGMT_USERS] A
			JOIN [dbo].[UserAccounts] B
			ON A.[USERID] = B.[UserID]
			JOIN [dbo].[WORKFLOW_MGMT_ROLE] C
			ON A.[ROLE] = C.[ID]
			JOIN [CTE_QueueId] D
			ON A.[QUEUEID] = D.[QUEUEID]
			WHERE B.[Deleted] = 'FALSE' AND
				A.[ROLE] <= @ROLE
		END
		ELSE IF @TYPE = 'C'
		BEGIN
			;WITH CTE_QueueId AS(
				SELECT [A].[QUEUEID]
				FROM [dbo].[WORKFLOW_MGMT_USERS] A
				JOIN [dbo].[WORKFLOW_MGMT_QUEUE] B
				ON A.[QUEUEID] = B.[QUEUEID]
				WHERE B.[SRC] = 'NAME' AND 
					A.[USERID] = @USERID AND A.[ROLE] = @ROLE
			)
			SELECT DISTINCT
				A.[USERID], A.[ROLE], 
				A.[USERID] + ' [' + ISNULL(B.[FirstName],'') + ' ' + ISNULL(B.[LastName],'')  + '] ' +  
				' - (' + C.[ROLE_DESC] + ')' ROLE_DESC,  
				A.[USERID] + NCHAR(196) +  CONVERT(NVARCHAR(8),A.[ROLE]) ROLE_VALUE  
			FROM [dbo].[WORKFLOW_MGMT_USERS] A
			JOIN [dbo].[UserAccounts] B
			ON A.[USERID] = B.[UserID]
			JOIN [dbo].[WORKFLOW_MGMT_ROLE] C
			ON A.[ROLE] = C.[ID]
			JOIN [CTE_QueueId] D
			ON A.[QUEUEID] = D.[QUEUEID]
			WHERE B.[Deleted] = 'FALSE' AND
				A.[ROLE] = @ROLE AND
				A.[USERID] <> @USERID AND
				B.Disabled = 0
		END
		ELSE IF @TYPE = 'D'
		BEGIN
			;WITH CTE_QueueId AS(
				SELECT [A].[QUEUEID]
				FROM [dbo].[WORKFLOW_MGMT_USERS] A
				JOIN [dbo].[WORKFLOW_MGMT_QUEUE] B
				ON A.[QUEUEID] = B.[QUEUEID]
				WHERE B.[SRC] = 'NAME' AND 
					A.[USERID] = @USERID
			)
			SELECT DISTINCT
				A.[USERID], A.[ROLE], 
				A.[USERID] + ' [' + ISNULL(B.[FirstName],'') + ' ' + ISNULL(B.[LastName],'')  + '] ' +  
				' - (' + C.[ROLE_DESC] + ')' ROLE_DESC,  
				A.[USERID] + NCHAR(196) +  CONVERT(NVARCHAR(8),A.[ROLE]) ROLE_VALUE  
			FROM [dbo].[WORKFLOW_MGMT_USERS] A
			JOIN [dbo].[UserAccounts] B
			ON A.[USERID] = B.[UserID]
			JOIN [dbo].[WORKFLOW_MGMT_ROLE] C
			ON A.[ROLE] = C.[ID]
			JOIN [CTE_QueueId] D
			ON A.[QUEUEID] = D.[QUEUEID]
			WHERE B.[Deleted] = 'FALSE'
		END
	END
	ELSE
	BEGIN
		IF @TYPE = 'A' OR @TYPE = 'B'
		BEGIN
			IF NOT EXISTS (SELECT 1 FROM @Settings WHERE AssignQueue IS NULL OR AssignQueue = 0)
			BEGIN 
				WITH CTE_USER AS (
				SELECT 
					A.[USERID], A.[ROLE], 
					A.[USERID] + ' [' + ISNULL(B.[FirstName],'') + ' ' + ISNULL(B.[LastName],'')  + '] ' +  
					' - (' + (CASE WHEN @CultureName='en-US' THEN C.[ROLE_DESC] ELSE C.[ROLE_DESC_zh_TW] END) + ')' ROLE_DESC,  
					A.[USERID] + '@@$$@' +  CONVERT(NVARCHAR(8),A.[ROLE]) ROLE_VALUE  
				FROM [dbo].[WORKFLOW_MGMT_USERS] A
				JOIN [dbo].[UserAccounts] B ON A.[USERID] = B.[UserID]
				JOIN [dbo].[WORKFLOW_MGMT_ROLE] C ON A.[ROLE] = C.[ID]
				JOIN @TempQueueId D ON D.QueueId = A.QUEUEID
				WHERE B.[Deleted] = 'FALSE' AND
					A.[ROLE] = @ROLE	
				)
				/*SELECT ONLY USERS WITH CERTAIN ROLES THAT EXISTS IN ALL SELECTED QUEUE*/
				SELECT * FROM CTE_USER A GROUP BY A.USERID,A.ROLE,A.ROLE_DESC,A.ROLE_VALUE HAVING COUNT(A.ROLE_DESC) = @QueueCount
			END 
		END
		ELSE IF @TYPE = 'C'
		BEGIN
			IF NOT EXISTS (SELECT 1 FROM @Settings WHERE AssignQueue IS NULL OR AssignQueue = 0)
			BEGIN 
				WITH CTE_User AS (
				SELECT 
					A.[USERID], A.[ROLE], 
					A.[USERID] + ' [' + ISNULL(B.[FirstName],'') + ' ' + ISNULL(B.[LastName],'')  + '] ' +  
					' - (' + (CASE WHEN @CultureName='en-US' THEN C.[ROLE_DESC] ELSE C.[ROLE_DESC_zh_TW] END) + ')' ROLE_DESC,  
					A.[USERID] + '@@$$@' +  CONVERT(NVARCHAR(8),A.[ROLE]) ROLE_VALUE  
				FROM [dbo].[WORKFLOW_MGMT_USERS] A
				JOIN [dbo].[UserAccounts] B ON A.[USERID] = B.[UserID]
				JOIN [dbo].[WORKFLOW_MGMT_ROLE] C ON A.[ROLE] = C.[ID]
				JOIN @TempQueueId D ON D.QueueId = A.QUEUEID
				WHERE B.[Deleted] = 'FALSE' AND
					A.[ROLE] = @ROLE AND
					A.[USERID] <> @USERID AND
					B.Disabled = 0
				)
				/*SELECT ONLY USERS WITH CERTAIN ROLES THAT EXISTS IN ALL SELECTED QUEUE*/
				SELECT * FROM CTE_USER A GROUP BY A.USERID,A.ROLE,A.ROLE_DESC,A.ROLE_VALUE HAVING COUNT(A.ROLE_DESC) = @QueueCount
			END 
		END
		ELSE IF @TYPE = 'D'
		BEGIN
			;WITH CTE_QueueId AS(
				SELECT [A].[QUEUEID]
				FROM [dbo].[WORKFLOW_MGMT_USERS] A
				JOIN [dbo].[WORKFLOW_MGMT_QUEUE] B
				ON A.[QUEUEID] = B.[QUEUEID]
				WHERE B.[SRC] = 'NAME' AND 
					A.[USERID] = @USERID
			)
			SELECT DISTINCT
				A.[USERID], A.[ROLE], 
				A.[USERID] + ' [' + ISNULL(B.[FirstName],'') + ' ' + ISNULL(B.[LastName],'')  + '] ' +  
				' - (' + C.[ROLE_DESC] + ')' ROLE_DESC,  
				A.[USERID] + NCHAR(196) +  CONVERT(NVARCHAR(8),A.[ROLE]) ROLE_VALUE  
			FROM [dbo].[WORKFLOW_MGMT_USERS] A
			JOIN [dbo].[UserAccounts] B
			ON A.[USERID] = B.[UserID]
			JOIN [dbo].[WORKFLOW_MGMT_ROLE] C
			ON A.[ROLE] = C.[ID]
			JOIN [CTE_QueueId] D
			ON A.[QUEUEID] = D.[QUEUEID]
			WHERE B.[Deleted] = 'FALSE'
		END
	END 
END



