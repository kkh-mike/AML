.dbo.AC_SupplementalData C ON B.EntityId = C.EntityId       INNER JOIN dbo.Gender_Dim D ON ISNULL(LTRIM(RTRIM(C.DataValue)),'') = D.GenderCode OR ISNULL(LTRIM(RTRIM(C.DataValue)),'') = D.GenderDescription      WHERE A.sdn_type IN ('AC', 'AC ALT')     )     DELETE A      FROM dbo.NMCHK_OtherListDetectionResults_Temp A       INNER JOIN CTE_GENDER B        ON A.NameKey = B.NameKey AND A.ent_num = B.ent_num         AND A.alt_num = B.alt_num        AND A.sdn_type = B.sdn_type      INNER JOIN #NMCHK_CustInfo C        ON B.NameKey = C.new_acct_key        AND A.Uid = C.UID     WHERE B.GenderCode <> C.Gender    END   END  END     --Country check  IF @NMCHK_CTRY_CHECK = 'Y'  BEGIN  IF OBJECT_ID('tempdb..#NMCHK_Country', 'U') IS NOT NULL   DROP TABLE #NMCHK_Country     CREATE TABLE #NMCHK_Country (    uid NVARCHAR(20) NOT NULL,     new_acct_key INT,     CountryCode VARCHAR(10),     Type VARCHAR(20)   )      INSERT INTO #NMCHK_Country ( uid, new_acct_key, CountryCode, Type)   SELECT uid, new_acct_key, country, 'Country' FROM #NMCHK_CustInfo WITH(NOLOCK) WHERE ISNULL(country, '') <> ''   UNION ALL    SELECT uid, new_acct_key, Nationality, 'Nationality' FROM #NMCHK_CustInfo WITH(NOLOCK) WHERE  ISNULL(Nationality, '') <> ''     INSERT INTO #Temp_New_Acct_Matches_Table(uid, [new_acct_key], [ent_num], [alt_num], [relative_correlation], [sdn_name], [sdn_type], [sdn_grp_num], [name_cat], [updated_date], [section], [NamePropertyBitCode], [SourceColumn])   SELECT DISTINCT A.uid, A.new_acct_key, X.ent_num, 0 AS alt_num, '100', X.country AS sdn_name, X.sdn_type, 0 AS sdn_grp_num, 16 AS name_cat, X.updated_date, '2', 1, A.Type   FROM #NMCHK_Country A, dbo.OFAC_COUNTRY X WITH(NOLOCK)   WHERE A.CountryCode = X.ISO_2CTRY_CDE AND X.DEL_IND = 'N'   AND EXISTS (SELECT Z.LIST FROM dbo.NMCHK_Setting_Log Z WITH(NOLOCK) WHERE Z.uid = a.uid AND Z.FLAG = 'Y' AND x.sdn_type = z.LIST)      INSERT INTO #Temp_New_Acct_Matches_Table(uid, [new_acct_key], [ent_num], [alt_num], [relative_correlation], [sdn_na