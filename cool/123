# ============================================
# Input Path（固定寫死）
# ============================================
$folderPath = "D:\AML_Source\20251114_新光資轉\EXE\DTLBK"

# Baseline
$baselineFile = Join-Path $folderPath "AML_CHECK_SUM.csv"

# ============================================
# Output / Log
# ============================================
$basePath = Get-Location

$outputFile = Join-Path $basePath "result_CHECK_SUM_DTLBK.txt"
$logFile    = Join-Path $basePath "SKcheck_CHECK_SUM_DTLBK.log"

# ============================================
# 刪除舊檔
# ============================================
if (Test-Path $outputFile) {
    Remove-Item $outputFile -Force
}

if (Test-Path $logFile) {
    Remove-Item $logFile -Force
}

# ============================================
# Log Function
# ============================================
function Write-Log {
    param(
        [string]$msg
    )

    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    Add-Content `
        -Path $logFile `
        -Value "[$time] $msg"
}

# ============================================
# Start
# ============================================
Write-Log "============================================"
Write-Log "===== JOB START ====="
Write-Log "Input Path   : $folderPath"
Write-Log "Baseline File: $baselineFile"
Write-Log "============================================"

# ============================================
# 檢查資料夾
# ============================================
if (!(Test-Path $folderPath)) {

    Write-Log "ERROR: Input folder not found"
    
    "0" | Out-File `
        -FilePath $outputFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 檢查 AML_CHECK_SUM.csv
# ============================================
if (!(Test-Path $baselineFile)) {

    Write-Log "ERROR: AML_CHECK_SUM.csv not found"

    "0" | Out-File `
        -FilePath $outputFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 讀取 Baseline
#
# 格式：
# FileName;Count;MD5
#
# 例如：
# RM_OPEN_CASE.csv;7506;958ac26a737b44a3fb8192a42fb6e6b5
# ============================================
Write-Log "===== Reading AML_CHECK_SUM.csv ====="

$baseline = @{}

try {

    $lines = Get-Content `
        -Path $baselineFile `
        -Encoding utf8

    foreach ($line in $lines) {

        # 忽略空白行
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        # 依照 ; 分割
        $parts = $line.Split(";")

        # 必須剛好至少有三個欄位
        if ($parts.Count -lt 3) {

            Write-Log "ERROR: Invalid baseline format:"
            Write-Log "       $line"

            "0" | Out-File `
                -FilePath $outputFile `
                -Encoding utf8

            Write-Host "0"

            exit 1
        }

        $fileName = $parts[0].Trim()
        $count    = $parts[1].Trim()
        $md5      = $parts[2].Trim().ToLowerInvariant()

        # 檢查檔名
        if ([string]::IsNullOrWhiteSpace($fileName)) {

            Write-Log "ERROR: Empty filename in baseline"

            "0" | Out-File `
                -FilePath $outputFile `
                -Encoding utf8

            Write-Host "0"

            exit 1
        }

        # 檢查 Count 是否為數字
        $countNumber = 0

        if (-not [int64]::TryParse($count, [ref]$countNumber)) {

            Write-Log "ERROR: Invalid count"
            Write-Log "       FileName: $fileName"
            Write-Log "       Count   : $count"

            "0" | Out-File `
                -FilePath $outputFile `
                -Encoding utf8

            Write-Host "0"

            exit 1
        }

        # 檢查 MD5 格式
        if ($md5 -notmatch '^[0-9a-f]{32}$') {

            Write-Log "ERROR: Invalid MD5"
            Write-Log "       FileName: $fileName"
            Write-Log "       MD5     : $md5"

            "0" | Out-File `
                -FilePath $outputFile `
                -Encoding utf8

            Write-Host "0"

            exit 1
        }

        $key = $fileName.ToLowerInvariant()

        $baseline[$key] = @{
            FileName = $fileName
            Count    = $countNumber
            MD5      = $md5
        }

        Write-Log "Baseline Loaded: $fileName"
    }

}
catch {

    Write-Log "ERROR reading AML_CHECK_SUM.csv"
    Write-Log $_.Exception.Message

    "0" | Out-File `
        -FilePath $outputFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

Write-Log "Baseline File Count: $($baseline.Count)"

# ============================================
# 如果 Baseline 沒有任何資料
# ============================================
if ($baseline.Count -eq 0) {

    Write-Log "ERROR: No records found in AML_CHECK_SUM.csv"

    "0" | Out-File `
        -FilePath $outputFile `
        -Encoding utf8

    Write-Host "0"

    exit 1
}

# ============================================
# 開始比對
# ============================================
Write-Log "============================================"
Write-Log "===== START CHECK ====="
Write-Log "============================================"

$hasError = $false

foreach ($key in $baseline.Keys) {

    $expectedFileName = $baseline[$key].FileName
    $expectedCount    = $baseline[$key].Count
    $expectedMD5      = $baseline[$key].MD5

    $actualFile = Join-Path $folderPath $expectedFileName

    Write-Log "--------------------------------------------"
    Write-Log "Checking: $expectedFileName"

    # ========================================
    # 檢查檔案是否存在
    # ========================================
    if (!(Test-Path $actualFile)) {

        Write-Log "ERROR: File not found"
        Write-Log "       Path: $actualFile"

        $hasError = $true

        continue
    }

    try {

        # ====================================
        # 計算實際行數
        # ====================================
        $lineCount = 0

        $reader = New-Object System.IO.StreamReader($actualFile)

        try {

            while ($reader.ReadLine() -ne $null) {
                $lineCount++
            }

        }
        finally {

            $reader.Close()
            $reader.Dispose()
        }

        # ====================================
        # 計算 MD5
        # ====================================
        $actualMD5 = (
            Get-FileHash `
                -Path $actualFile `
                -Algorithm MD5
        ).Hash.ToLowerInvariant()

        # ====================================
        # 比對 Count
        # ====================================
        $countMatch = ($lineCount -eq $expectedCount)

        # ====================================
        # 比對 MD5
        # ====================================
        $md5Match = ($actualMD5 -eq $expectedMD5)

        # ====================================
        # 判斷結果
        # ====================================
        if ($countMatch -and $md5Match) {

            Write-Log "MATCH"
            Write-Log "  Count: $lineCount"
            Write-Log "  MD5  : $actualMD5"

        }
        else {

            $hasError = $true

            Write-Log "MISMATCH"

            if (-not $countMatch) {

                Write-Log "  COUNT MISMATCH"
                Write-Log "    EXPECTED: $expectedCount"
                Write-Log "    ACTUAL  : $lineCount"

            }
            else {

                Write-Log "  COUNT MATCH: $lineCount"
            }

            if (-not $md5Match) {

                Write-Log "  MD5 MISMATCH"
                Write-Log "    EXPECTED: $expectedMD5"
                Write-Log "    ACTUAL  : $actualMD5"

            }
            else {

                Write-Log "  MD5 MATCH: $actualMD5"
            }
        }

    }
    catch {

        $hasError = $true

        Write-Log "ERROR processing file"
        Write-Log $_.Exception.Message
    }
}

# ============================================
# Final Result
# ============================================
Write-Log "============================================"
Write-Log "===== FINAL RESULT ====="
Write-Log "============================================"

if ($hasError) {

    # 有任何錯誤
    "0" | Out-File `
        -FilePath $outputFile `
        -Encoding utf8

    Write-Log "FINAL RESULT: 0"
    Write-Log "STATUS: FAILED"

    Write-Host "0"

    exit 1
}
else {

    # 全部一致
    "1" | Out-File `
        -FilePath $outputFile `
        -Encoding utf8

    Write-Log "FINAL RESULT: 1"
    Write-Log "STATUS: SUCCESS"

    Write-Host "1"

    exit 0
}