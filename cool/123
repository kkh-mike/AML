

# ==========================================
# 1. 基本設定
# ==========================================

$SourceFile = "D:\AML_Source\20251114_新光資轉\SKBStagingData\新增資料夾\TSEST\SAR_Trxn_Detail_All.sql"

$BaseFolder   = Split-Path $SourceFile -Parent
$OutputFolder = Join-Path $BaseFolder "Split"
$LogFolder    = Join-Path $BaseFolder "Log"



# 每個檔案 50,000 個 SQL 指令
$RowsPerFile = 50000


# ==========================================
# 2. 檢查來源 SQL
# ==========================================

if (!(Test-Path $SourceFile)) {

    Write-Host ""
    Write-Host "找不到來源 SQL：" -ForegroundColor Red
    Write-Host $SourceFile
    Write-Host ""

    Read-Host "按 Enter 結束"
    exit
}


# ==========================================
# 3. 建立資料夾
# ==========================================

if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}

if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}


# ==========================================
# 4. 清除舊的 SQL / Log
# ==========================================

Write-Host ""
Write-Host "========================================="
Write-Host "清除舊的 SQL / Log"
Write-Host "========================================="

Get-ChildItem `
    -Path $OutputFolder `
    -Filter "SAR_Trxn_Detail_All_*.sql" `
    -ErrorAction SilentlyContinue |
    Remove-Item -Force

Get-ChildItem `
    -Path $LogFolder `
    -Filter "SAR_Trxn_Detail_All_*.log" `
    -ErrorAction SilentlyContinue |
    Remove-Item -Force

Write-Host "清除完成。"
Write-Host ""


# ==========================================
# 5. 開始分割 SQL
# ==========================================

Write-Host "========================================="
Write-Host "開始分割 SQL"
Write-Host "========================================="
Write-Host ""
Write-Host "來源：$SourceFile"
Write-Host "每個檔案：$RowsPerFile 個 SQL 指令"
Write-Host ""


# 使用 StreamReader
# 不會一次把整個 SQL 載入記憶體
$Reader = New-Object System.IO.StreamReader(
    $SourceFile,
    [System.Text.Encoding]::Default,
    $true
)

$FileIndex = 1
$RowCount  = 0
$TotalRows = 0
$Writer    = $null


try {

    while (($Line = $Reader.ReadLine()) -ne $null) {


        # ==========================================
        # 建立新的 SQL 檔案
        # ==========================================

        if ($RowCount -eq 0) {

            if ($Writer -ne $null) {

                $Writer.Close()
                $Writer.Dispose()

                $Writer = $null
            }


            $OutputFile = Join-Path `
                $OutputFolder `
                "SAR_Trxn_Detail_All_$FileIndex.sql"


            $Writer = New-Object System.IO.StreamWriter(
                $OutputFile,
                $false,
                [System.Text.Encoding]::UTF8
            )


            # 每個檔案指定 Database
            $Writer.WriteLine("USE SARCaseWarehouse;")
            $Writer.WriteLine("")


            Write-Host "建立：SAR_Trxn_Detail_All_$FileIndex.sql"


            $FileIndex++
        }


        # ==========================================
        # 原始 SQL 原封不動寫入
        # ==========================================

        $Writer.WriteLine($Line)

        $RowCount++
        $TotalRows++


        # ==========================================
        # 每 50,000 個 SQL 指令切一份
        # ==========================================

        if ($RowCount -eq $RowsPerFile) {

            $Writer.Close()
            $Writer.Dispose()

            $Writer = $null

            Write-Host "  → 完成 $RowsPerFile 個 SQL"

            $RowCount = 0
        }
    }


    # ==========================================
    # 處理最後一個檔案
    # ==========================================

    if ($Writer -ne $null) {

        $Writer.Close()
        $Writer.Dispose()

        $Writer = $null

        Write-Host "  → 完成最後 $RowCount 個 SQL"
    }

}
finally {

    if ($Reader -ne $null) {

        $Reader.Close()
        $Reader.Dispose()
    }

    if ($Writer -ne $null) {

        $Writer.Close()
        $Writer.Dispose()
    }
}


# ==========================================
# 6. 計算總檔案數
# ==========================================

$TotalFiles = $FileIndex - 1


Write-Host ""
Write-Host "========================================="
Write-Host "SQL 分割完成"
Write-Host "========================================="

Write-Host "總 SQL 指令：$TotalRows"
Write-Host "每檔 SQL 指令：$RowsPerFile"
Write-Host "總檔案數：$TotalFiles"

Write-Host ""
Write-Host "SQL 輸出位置："
Write-Host $OutputFolder
Write-Host ""


# ==========================================
# 8. 最終結果
# ==========================================

Write-Host ""
Write-Host ""
Write-Host "========================================="
Write-Host "全部處理完成"
Write-Host "========================================="

Write-Host ""
Write-Host "總 SQL 指令：$TotalRows"
Write-Host "總 SQL 檔案：$TotalFiles"
Write-Host "成功：$Success"
Write-Host "失敗：$Failed"

Write-Host ""
Write-Host "SQL 檔案位置："
Write-Host $OutputFolder

Write-Host ""
Write-Host "Log 檔案位置："
Write-Host $LogFolder


if ($Failed -eq 0) {

    Write-Host ""
    Write-Host "========================================="
    Write-Host "全部 SQL 執行成功！"
    Write-Host "=========================================" `
        -ForegroundColor Green

}
else {

    Write-Host ""
    Write-Host "========================================="
    Write-Host "有 SQL 執行失敗！"
    Write-Host "請檢查對應 Log。"
    Write-Host "=========================================" `
        -ForegroundColor Red
}


Write-Host ""
Read-Host "按 Enter 結束"




