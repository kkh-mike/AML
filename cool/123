rned on, month value is not null and input name DOB month = SDN name DOB month              (ISNULL(D.MonthValue,'') <> ''              AND D.MonthValue = MONTH(C.DOB)             ) --Or month value is null              OR ISNULL(D.MonthValue,'') = ''            )           )          )         )       --SPEC     UPDATE A      SET RELATIVE_CORRELATION = RELATIVE_CORRELATION - @DOB_RC, Reduction_IND = STUFF(Reduction_IND, 2, 1, 'Y')     FROM #Temp_New_Acct_Matches_Table A     INNER JOIN #NMCHK_CustInfo C ON A.new_acct_key = C.new_acct_key     WHERE a.sdn_type IN ('SPEC', 'SPEC_CN') AND A.SECTION = '1'      --Check input name DOB year is not null     AND ISNULL(C.DOB, '') <> ''     --Check is exists SDN name DOB year is not null     AND EXISTS(SELECT 1 FROM dbo.OFAC_SPEC Y WITH(NOLOCK) WHERE A.ent_num = Y.ENT_NUM AND ISNULL(A.sdn_grp_num, 0) = ISNULL(Y.GROUPID, 0) AND Y.DInd = 'N'        AND DATEPART(YEAR, dbo.TryParseDate(Y.DOB)) IS NOT NULL)     --Check is not exists input name DOB year = SDN name DOB year; means all also not same year, then can deduct RC      AND NOT EXISTS(SELECT 1 FROM dbo.OFAC_SPEC B WITH(NOLOCK) WHERE A.ent_num = B.ENT_NUM AND ISNULL(A.sdn_grp_num, 0) = ISNULL(B.GROUPID, 0) AND B.DInd = 'N'         AND DATEPART(YEAR, dbo.TryParseDate(B.DOB)) IS NOT NULL         AND DATEPART(YEAR, dbo.TryParseDate(B.DOB)) = YEAR(C.DOB)         AND (@CheckMonthLevel = 0           OR (@CheckMonthLevel = 1            AND ( --Check if CheckMonth is turned on, month value is not null and input name DOB month = SDN name DOB month              (CASE WHEN LEN(B.DOB) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DOB) = 1 THEN MONTH(B.DOB) ELSE NULL END END IS NOT NULL              AND CASE WHEN LEN(B.DOB) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DOB) = 1 THEN MONTH(B.DOB) ELSE NULL END END = MONTH(C.DOB)             ) --Or month value is null              OR CASE WHEN LEN(B.DOB) <= 4 THEN NULL ELSE CASE WHEN ISDATE(B.DOB) = 1 THEN MONTH(B.DOB) ELSE NULL END END IS NULL           