# ==========================================
# 1. 基本設定
# ==========================================

$SourceFiles = @(
    "D:\AML\SK\EXE\DTLBK\SAR_Trxn_Detail_All.sql",
    "D:\AML\SK\EXE\DTLBK\SAR_Trxn_Detail.sql"
)

$RowsPerFile = 50000
$HasError = $false


# ==========================================
# 2. 事前建立並清空資料夾
# ==========================================

try {
    # 取得共用目錄（以清單第一個檔案所在目錄為主）
    $BaseFolder   = Split-Path $SourceFiles[0] -Parent
    $OutputFolder = Join-Path $BaseFolder "Split"
    $LogFolder    = Join-Path $BaseFolder "Log"

    # 確保資料夾存在
    if (!(Test-Path $OutputFolder)) { New-Item -ItemType Directory -Path $OutputFolder | Out-Null }
    if (!(Test-Path $LogFolder))    { New-Item -ItemType Directory -Path $LogFolder | Out-Null }

    # 清空資料夾所有內容
    Get-ChildItem -Path $OutputFolder -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force
    Get-ChildItem -Path $LogFolder -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force
}
catch {
    $HasError = $true
}


# ==========================================
# 3. 迴圈處理各個 SQL 檔案
# ==========================================

if (-not $HasError) {
    foreach ($SourceFile in $SourceFiles) {

        # 檢查來源 SQL 是否存在
        if (!(Test-Path $SourceFile)) {
            $HasError = $true
            break
        }

        $FileNameWithoutExt = [System.IO.Path]::GetFileNameWithoutExtension($SourceFile)

        $Reader = $null
        $Writer = $null

        try {
            $Reader = New-Object System.IO.StreamReader(
                $SourceFile,
                [System.Text.Encoding]::Default,
                $true
            )

            $FileIndex = 1
            $RowCount  = 0

            while (($Line = $Reader.ReadLine()) -ne $null) {

                # 建立新的分割檔案
                if ($RowCount -eq 0) {
                    if ($Writer -ne $null) {
                        $Writer.Close()
                        $Writer.Dispose()
                        $Writer = $null
                    }

                    $OutputFileName = "${FileNameWithoutExt}_$FileIndex.sql"
                    $OutputFile     = Join-Path $OutputFolder $OutputFileName

                    $Writer = New-Object System.IO.StreamWriter(
                        $OutputFile,
                        $false,
                        [System.Text.Encoding]::UTF8
                    )

                    # 指定 Database
                    $Writer.WriteLine("USE SARCaseWarehouse;")
                    $Writer.WriteLine("")

                    $FileIndex++
                }

                $Writer.WriteLine($Line)
                $RowCount++

                # 達到每檔行數上限時關閉檔案
                if ($RowCount -eq $RowsPerFile) {
                    $Writer.Close()
                    $Writer.Dispose()
                    $Writer = $null
                    $RowCount = 0
                }
            }
        }
        catch {
            $HasError = $true
            break
        }
        finally {
            if ($Writer -ne $null) {
                $Writer.Close()
                $Writer.Dispose()
            }
            if ($Reader -ne $null) {
                $Reader.Close()
                $Reader.Dispose()
            }
        }
    }
}


# ==========================================
# 4. 輸出執行狀態
# ==========================================

if ($HasError) {
    Write-Output 0
    exit 0
} else {
    Write-Output 1
    exit 1
}
