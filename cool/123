ALTER PROC [dbo].[NMCHK_GetNMCHKRemarkLog] 
@UID NVARCHAR(80),
@Name_Key NVARCHAR(20),
@CultureName VARCHAR(5) = NULL
AS

SELECT A.UID, 
(SELECT CASE WHEN @CultureName = 'zh-TW' THEN ROLE_DESC_zh_TW ELSE ROLE_DESC END FROM WORKFLOW_MGMT_ROLE WHERE A.[ROLE] = ID) ROLE,
(SELECT CASE WHEN A.Action = 1 THEN dbo.GetResourceString('FalseMatch')
			WHEN A.Action = 2 THEN dbo.GetResourceString('TrueMatch')
			ELSE (SELECT CASE WHEN @CultureName = 'zh-TW' THEN ACTION_DESC ELSE ACTION_DESC END FROM dbo.WORKFLOW_MGMT_ACTION WHERE A.[ACTION] = ID) END) [ACTION],
UPDATEDBY, (SELECT ISNULL(FirstName,'') + ' ' +  ISNULL(LastName,'') FROM UserAccounts WHERE USERID = UPDATEDBY AND Deleted = 0) UpdatedBy_UserName, 
UPDATED_DATE, REMARK, Id AS RemarkLogId, A.[ACTION] AS ActionId, A.ExtendedReviewDate
FROM dbo.NMCHK_REMARKLOG A WITH (NOLOCK)
WHERE A.UID = @UID AND A.Name_Key = 1
ORDER BY UPDATED_DATE DESC


