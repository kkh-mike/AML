可以使用以下 SQL 語法來執行刪除與更新操作：
-- 1. 刪除 GROUPID = 11 的資料
DELETE FROM BSADBJP..lowrisklistgroups
WHERE BANKNO = 'JP' AND GROUPID = 11;

-- 2. 將 GROUPID = 5 的名稱 (GROUPDESCR) 改為 'Japanese Finance'
UPDATE BSADBJP..lowrisklistgroups
SET GROUPDESCR = 'Japanese Finance'
WHERE BANKNO = 'JP' AND GROUPID = 5;

注意事項：
 * 建議在正式環境執行前先包裹 Transaction（交易機制），確認異動筆數正確後再進行 COMMIT：
BEGIN TRAN;

DELETE FROM BSADBJP..lowrisklistgroups
WHERE BANKNO = 'JP' AND GROUPID = 11;

UPDATE BSADBJP..lowrisklistgroups
SET GROUPDESCR = 'Japanese Finance'
WHERE BANKNO = 'JP' AND GROUPID = 5;

-- 檢查結果無誤後提交：
-- COMMIT TRAN;

-- 若有問題則還原：
-- ROLLBACK TRAN;

