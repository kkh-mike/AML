le, SourceRefNo, NamePropertyBitCode    )   INSERT INTO #DBCHK_ResultGroups_Buffer_Temp_Filtered     (SourceKey, SourceTable, SourceRefNo, IsOtherListHit, IsPEPHit, IsNegativeHit, IsForeignPEP, IsLocalPEP, IsForeignOrgPEP, IsExPEP)   SELECT DISTINCT SourceKey, SourceTable, SourceRefNo,     CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 1 = 1 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END,    CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 2 = 2 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END,    CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 4 = 4 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END,    CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 8 = 8 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END,    CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 16 = 16 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END,    CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 32 = 32 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END,    CASE WHEN EXISTS (SELECT 1 FROM CDCTempResult B WHERE B.NamePropertyBitCode & 64 = 64 AND B.SourceTable = A.SourceTable      AND ISNULL(B.SourceRefNo,'') = CASE WHEN B.SourceTable <> 'OFAC_CUSTOMER_FACT' THEN A.SourceRefNo ELSE '' END) THEN 'Y' END   FROM CDCTempResult A      /*Insert #DBCHK_CustomerPreviousBlacklistFlag_Buffer_Temp for case cif key*/     --OFAC_CUSTOMER_FACT   IF EXISTS(SELECT 1 FROM #DBCHK_ResultGroups_Buffer_Temp WHERE SourceTable = 'OFAC_CUSTOMER_FACT')     BEGIN      INSERT INTO #DBCHK_CustomerPreviousBlacklistFlag_Buffer_Temp (SourceKey,SourceRefNo,TableName,IsPEPHit,IsNegativeNews,IsOtherListHit,IsForeignPEP,IsLocalPEP,IsForeignOrgPEP,IsExPEP)      SELECT CIF_KEY,'','BSA_SUB_CUST_FACT',     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'PEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'NegativeNews') ,     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'BlackList'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'ForeignPEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'LocalPEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'ForeignOrgPEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'ExPEP')    FROM dbo.BSA_SUB_CUST_FACT_Extension A WITH(NOLOCK)    WHERE CIF_KEY = @CIF_KEY                    INSERT INTO #DBCHK_CustomerPreviousBlacklistFlag_Buffer_Temp (SourceKey,SourceRefNo,TableName,IsPEPHit,IsNegativeNews,IsOtherListHit,IsForeignPEP,IsLocalPEP,IsForeignOrgPEP,IsExPEP,isCalculated)      SELECT A.CIF_KEY,'','CIP_CUST_RISK_MGMT',     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'PEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'NegativeNews') ,     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'BlackList'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'ForeignPEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'LocalPEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'ForeignOrgPEP'),     dbo.GM_ParsePEPBitwiseCode(PEPBitwiseCode, 'ExPEP'),     isCalculated      FROM #DBCHK_CIP_CUST_RISK_MGMT A WITH(NOLOCK)    JOIN dbo.CIP_CUST_RISK_MGMT_Extension B WITH(NOLOCK) ON A.CIF_KEY = B.CIF_KEY             INSERT INTO #DBCHK_CustomerPreviousBlacklistFlag_Buffer_Temp (BatchId,SourceKey,SourceRefNo,TableName,IsPEPHit,IsNegativeNews