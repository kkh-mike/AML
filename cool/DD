Sub CSVFile()

Dim SrcRg As Range
Dim CurrRow As Range
Dim CurrCell As Range
Dim CurrTextStr As String
Dim ListSep As String
Dim FName As Variant
Dim fsT As Object

dYear = Year(Now())
dMonth = Month(Now())
dDay = Day(Now())
Sheets("TransferredFile").Select

'FName = Application.GetSaveAsFilename("", "CSV File (*.csv), *.csv")
FName = SaveName + "_" + Filename + "_" & dYear & dMonth & dDay & ".csv"
Set fsT = CreateObject("ADODB.Stream")
fsT.Type = 2 'Specify stream type - we want To save text/string data.
fsT.Charset = "unicode" '"utf-8" 'Specify charset For the source text data.

fsT.Open 'Open the stream And write binary data To the object
ListSep = Application.International(xlListSeparator)
  If Selection.Cells.Count > 1 Then
    Set SrcRg = Selection
  Else
    Set SrcRg = ActiveSheet.UsedRange
  End If
  
For Each CurrRow In SrcRg.Rows
    CurrTextStr = ""
    For Each CurrCell In CurrRow.Cells
        CurrTextStr = CurrTextStr & """" & Replace(CurrCell.Value, """", """""") & """" & ListSep
    Next
    While Right(CurrTextStr, 1) = ListSep
        CurrTextStr = Left(CurrTextStr, Len(CurrTextStr) - 1)
    Wend

    fsT.WriteText CurrTextStr, adWriteLine
    fsT.WriteText vbNewLine, adWriteLine
Next
fsT.SaveToFile pathName & FName, 2 'Save binary data To disk
Sheets("TEMP").Delete
End Sub

Sub ClearTransferredSheet()
    Sheets("TransferredFile").Select
    finalrow = Cells(Rows.Count, 1).End(xlUp).Row
    For x = 2 To finalrow
        Range("A" & x & ": O" & x & "").Clear
    Next x
End Sub

