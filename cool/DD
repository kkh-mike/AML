
# -------------------- 4. 強制指定資料庫 BSADBTW --------------------

if ([string]::IsNullOrWhiteSpace($ConnStr)) {
    throw 'LDAP 沒有回傳有效的 SQL Server 連線字串'
}

# 先記錄遮罩後的原始連線字串，方便確認格式
$MaskedConn = [regex]::Replace(
    $ConnStr,
    '(?i)(Password|Pwd)\s*=\s*[^;]*',
    '$1=******'
)

Write-Log "LDAP 原始連線字串：$MaskedConn" DarkGray

try {
    $Builder = New-Object System.Data.SqlClient.SqlConnectionStringBuilder

    $Builder.ConnectionString = $ConnStr
    $Builder['Initial Catalog'] = $Database

    $ConnStr = $Builder.ConnectionString

    Write-Log "已透過 SqlConnectionStringBuilder 指定資料庫：$Database" Green
}
catch {
    Write-Log "標準連線字串解析失敗，改用手動處理：$($_.Exception.Message)" Yellow

    # 僅處理標準的 key=value;key=value 格式
    if ($ConnStr -match '(?i)(Initial Catalog|Database)\s*=') {

        $ConnStr = [regex]::Replace(
            $ConnStr,
            '(?i)(Initial Catalog|Database)\s*=\s*[^;]*',
            "Initial Catalog=$Database"
        )
    }
    else {
        $ConnStr = $ConnStr.TrimEnd(';') + ";Initial Catalog=$Database;"
    }

    # 再次驗證
    try {
        $Builder = New-Object System.Data.SqlClient.SqlConnectionStringBuilder
        $Builder.ConnectionString = $ConnStr
        $ConnStr = $Builder.ConnectionString

        Write-Log "已指定資料庫：$Database" Green
    }
    catch {
        throw "無法解析 LDAP 回傳的連線字串。請確認連線字串格式；錯誤：$($_.Exception.Message)"
    }
}
