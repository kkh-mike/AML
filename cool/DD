$binDir = "D:\tfs\...\bin"  # 請換成圖片中的完整資料夾路徑
$encryptedStr = ""

# 依序搜尋目錄下的 DLL 與 EXE
Get-ChildItem -Path $binDir -Include "*.dll", "*.exe" -File | ForEach-Object {
    try {
        $asm = [System.Reflection.Assembly]::LoadFrom($_.FullName)
        foreach ($type in $asm.GetExportedTypes()) {
            # 尋找名稱包含 Decrypt 的靜態方法
            $methods = $type.GetMethods([System.Reflection.BindingFlags]'Public,Static') | Where-Object { 
                $_.Name -like "*Decrypt*" -and $_.GetParameters().Count -eq 1 
            }
            
            foreach ($m in $methods) {
                try {
                    $result = $m.Invoke($null, @($encryptedStr))
                    if ($result -like "*Data Source=*") {
                        Write-Host "==========================================" -ForegroundColor Green
                        Write-Host "[成功找到解密方法！]" -ForegroundColor Green
                        Write-Host "檔案: $($_.FullName)"
                        Write-Host "類別 (Type): [$($type.FullName)]" -ForegroundColor Cyan
                        Write-Host "方法 (Method): $($m.Name)" -ForegroundColor Cyan
                        Write-Host "解密結果: $result" -ForegroundColor Yellow
                        Write-Host "==========================================" -ForegroundColor Green
                        return
                    }
                } catch {}
            }
        }
    } catch {}
}
