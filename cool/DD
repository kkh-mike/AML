
#requires -Version 5.1

# ============================================================
# Send-SwiftByDate.ps1
# SQL Server -> RawMessage -> SOAP API
# ============================================================

$ErrorActionPreference = 'Stop'

# -------------------- 1. 基本設定 --------------------

$QueryDate = '2026-10-27'
$Database = 'BSADBTW'
$TableName = 'MESSAGEDATABASE..SWIFT_MTRAW'

$Url = 'http://localhost:8082/SwiftProcessor.svc?wsdl'

$LdapHost = '10.13.60.66'
$SearchBase = 'o=tsbank'
$LdapApp = 'AML'
$LdapIndex = 7

$DllPath = Join-Path $PSScriptRoot 'Tsbldapdbc.dll'
$LogFolder = Join-Path $PSScriptRoot 'Log'

# 請先維持 1，確認測試結果後再調整
$RequestTimeoutSeconds = 120

# -------------------- 2. Log 初始化 --------------------

if (-not (Test-Path $LogFolder)) {
    New-Item -Path $LogFolder -ItemType Directory -Force |
        Out-Null
}

$Timestamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$MainLogFile = Join-Path $LogFolder "Execution_$Timestamp.log"

function Write-Log {
    param(
        [string]$Message,
        [ConsoleColor]$Color = [ConsoleColor]::White
    )

    $Line = '[{0}] {1}' -f (
        Get-Date -Format 'yyyy-MM-dd HH:mm:ss.fff'
    ), $Message

    Write-Host $Line -ForegroundColor $Color
    Add-Content -Path $MainLogFile -Value $Line -Encoding UTF8
}

Write-Log '========== 開始執行 ==========' Cyan
Write-Log "查詢日期：$QueryDate"
Write-Log "目標資料庫：$Database"
Write-Log "Log：$MainLogFile"

# -------------------- 3. 日期驗證 --------------------

try {
    $StartDate = [datetime]::ParseExact(
        $QueryDate,
        'yyyy-MM-dd',
        [Globalization.CultureInfo]::InvariantCulture
    )

    $EndDate = $StartDate.AddDays(1)
}
catch {
    throw "QueryDate 格式錯誤，請使用 yyyy-MM-dd，例如 2026-10-27"
}

# -------------------- 4. 取得 LDAP 連線字串 --------------------

if (-not (Test-Path $DllPath)) {
    throw "找不到 DLL：$DllPath"
}

if (-not ([System.Management.Automation.PSTypeName]'Tsbldapdbc.RunBat').Type) {
    Add-Type -Path $DllPath
}

$App = New-Object Tsbldapdbc.RunBat
$App.SSL = $false
$App.ldapHost = $LdapHost
$App.searchBase = $SearchBase

$ConnStr = $App.GetRunBat($LdapApp, $LdapIndex)

if ([string]::IsNullOrWhiteSpace($ConnStr)) {
    throw 'LDAP 沒有回傳有效的 SQL Server 連線字串'
}

$Builder = New-Object System.Data.SqlClient.SqlConnectionStringBuilder($ConnStr)

# 強制指定資料庫
$Builder.InitialCatalog = $Database
$ConnStr = $Builder.ConnectionString

$MaskedConn = [regex]::Replace(
    $ConnStr,
    '(?i)(Password|Pwd)\s*=\s*[^;]*',
    '$1=******'
)

Write-Log "SQL 連線設定：$MaskedConn" DarkGray

# -------------------- 5. 查詢指定日期的 RawMessage --------------------

$Sql = @'
SELECT RawMessage
FROM [MESSAGEDATABASE]..[SWIFT_MTRAW]
WHERE CreatedDate >= @StartDate
  AND CreatedDate <  @EndDate
ORDER BY CreatedDate
'@

$Messages = [System.Collections.Generic.List[string]]::new()

$Connection = New-Object System.Data.SqlClient.SqlConnection($ConnStr)

try {
    $Connection.Open()
    Write-Log 'SQL Server 連線成功' Green

    $Command = $Connection.CreateCommand()
    $Command.CommandText = $Sql
    $Command.CommandTimeout = 120

    $P1 = $Command.Parameters.Add(
        '@StartDate',
        [System.Data.SqlDbType]::DateTime2
    )
    $P1.Value = $StartDate

    $P2 = $Command.Parameters.Add(
        '@EndDate',
        [System.Data.SqlDbType]::DateTime2
    )
    $P2.Value = $EndDate

    $Reader = $Command.ExecuteReader()

    try {
        while ($Reader.Read()) {
            if ($Reader.IsDBNull(0)) {
                Write-Log '略過 NULL RawMessage' Yellow
                continue
            }

            $Message = [string]$Reader['RawMessage']

            if ([string]::IsNullOrWhiteSpace($Message)) {
                Write-Log '略過空白 RawMessage' Yellow
                continue
            }

            $Messages.Add($Message)
        }
    }
    finally {
        $Reader.Close()
        $Reader.Dispose()
        $Command.Dispose()
    }
}
finally {
    $Connection.Close()
    $Connection.Dispose()
}

$Total = $Messages.Count

Write-Log "查詢完成，有效電文筆數：$Total" Cyan

if ($Total -eq 0) {
    Write-Log '沒有可發送的電文，作業結束' Yellow
    return
}

# -------------------- 6. 建立 SOAP XML --------------------

function New-SwiftSoapXml {
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [Parameter(Mandatory)]
        [string]$ReferenceNumber
    )

    $Doc = New-Object System.Xml.XmlDocument
    $Doc.PreserveWhitespace = $true

    $SoapNs = 'http://schemas.xmlsoap.org/soap/envelope/'
    $ServiceNs = 'http://patriotofficer.net/SwiftService'

    $Declaration = $Doc.CreateXmlDeclaration('1.0', 'utf-8', $null)
    [void]$Doc.AppendChild($Declaration)

    $Envelope = $Doc.CreateElement('soap', 'Envelope', $SoapNs)

    $SoapAttr = $Doc.CreateAttribute(
        'xmlns',
        'soap',
        'http://www.w3.org/2000/xmlns/'
    )
    $SoapAttr.Value = $SoapNs
    [void]$Envelope.Attributes.Append($SoapAttr)

    [void]$Doc.AppendChild($Envelope)

    $Body = $Doc.CreateElement('soap', 'Body', $SoapNs)
    [void]$Envelope.AppendChild($Body)

    $Submit = $Doc.CreateElement('SubmitRequest', $ServiceNs)
    [void]$Body.AppendChild($Submit)

    $Params = $Doc.CreateElement('Params', $ServiceNs)
    [void]$Submit.AppendChild($Params)

    $FieldsBeforeMessage = [ordered]@{
        ActionCode = 'SCAN_SWIFT'
        BankNo     = 'TW'
        BranchNo   = '0001'
        Channel    = 'SWIFT'
    }

    foreach ($Item in $FieldsBeforeMessage.GetEnumerator()) {
        $Node = $Doc.CreateElement($Item.Key, $ServiceNs)
        $Node.InnerText = [string]$Item.Value
        [void]$Params.AppendChild($Node)
    }

    # InnerText 會自動處理 XML 特殊字元
    $MessageNode = $Doc.CreateElement('Message', $ServiceNs)
    $MessageNode.InnerText = $Message
    [void]$Params.AppendChild($MessageNode)

    $FieldsAfterMessage = [ordered]@{
        MessageTypeCode = 'MT'
        ReferenceNumber = $ReferenceNumber
        SourceID        = 'TSID'
    }

    foreach ($Item in $FieldsAfterMessage.GetEnumerator()) {
        $Node = $Doc.CreateElement($Item.Key, $ServiceNs)
        $Node.InnerText = [string]$Item.Value
        [void]$Params.AppendChild($Node)
    }

    return $Doc
}

# -------------------- 7. SOAP 呼叫函式 --------------------

function Execute-SOAPRequest {
    param(
        [Parameter(Mandatory)]
        [System.Xml.XmlDocument]$SOAPRequest,

        [Parameter(Mandatory)]
        [string]$URL
    )

    $Request = [System.Net.WebRequest]::Create($URL)
    $Request.Method = 'POST'
    $Request.ContentType = 'text/xml; charset=utf-8'
    $Request.Accept = 'text/xml'
    $Request.Headers.Add('SOAPAction', 'SubmitRequest')
    $Request.Timeout = $RequestTimeoutSeconds * 1000
    $Request.ReadWriteTimeout = $RequestTimeoutSeconds * 1000

    $RequestStream = $Request.GetRequestStream()

    try {
        $Settings = New-Object System.Xml.XmlWriterSettings
        $Settings.Encoding = New-Object System.Text.UTF8Encoding($false)
        $Settings.Indent = $false
        $Settings.OmitXmlDeclaration = $false

        $Writer = [System.Xml.XmlWriter]::Create(
            $RequestStream,
            $Settings
        )

        try {
            $SOAPRequest.Save($Writer)
            $Writer.Flush()
        }
        finally {
            $Writer.Close()
        }
    }
    finally {
        $RequestStream.Close()
    }

    try {
        $Response = $Request.GetResponse()

        try {
            $ResponseStream = $Response.GetResponseStream()
            $ResponseReader = New-Object System.IO.StreamReader($ResponseStream)

            try {
                return $ResponseReader.ReadToEnd()
            }
            finally {
                $ResponseReader.Close()
            }
        }
        finally {
            $Response.Close()
        }
    }
    catch [System.Net.WebException] {
        $WebError = $_
        $ErrorResponse = $WebError.Exception.Response

        if ($null -ne $ErrorResponse) {
            try {
                $ErrorStream = $ErrorResponse.GetResponseStream()

                if ($null -ne $ErrorStream) {
                    $ErrorReader = New-Object System.IO.StreamReader($ErrorStream)

                    try {
                        $ErrorBody = $ErrorReader.ReadToEnd()
                    }
                    finally {
                        $ErrorReader.Close()
                    }

                    throw "HTTP/SOAP 錯誤：$($WebError.Exception.Message); Response=$ErrorBody"
                }
            }
            finally {
                $ErrorResponse.Close()
            }
        }

        throw
    }
}

# -------------------- 8. 逐筆發送 --------------------

$Results = [System.Collections.Generic.List[object]]::new()
$SuccessCount = 0
$FailedCount = 0

for ($i = 0; $i -lt $Total; $i++) {

    $No = $i + 1
    $Message = $Messages[$i]

    # 每筆產生獨立的 ReferenceNumber
    $ReferenceNumber = (
        (Get-Date -Format 'yyyyMMddHHmmssfff') +
        $No.ToString('D4')
    )

    $Stopwatch = [System.Diagnostics.Stopwatch]::StartNew()

    $Status = 'Failed'
    $ResponseText = ''
    $ErrorText = ''

    Write-Log "[$No/$Total] 開始發送，ReferenceNumber=$ReferenceNumber" Cyan

    try {
        $SoapDoc = New-SwiftSoapXml `
            -Message $Message `
            -ReferenceNumber $ReferenceNumber

        $ResponseText = Execute-SOAPRequest `
            -SOAPRequest $SoapDoc `
            -URL $Url

        $Status = 'Success'
        $SuccessCount++

        Write-Log "[$No/$Total] SOAP 呼叫完成" Green
    }
    catch {
        $ErrorText = $_.Exception.Message
        $FailedCount++

        Write-Log "[$No/$Total] 發送失敗：$ErrorText" Red
    }
    finally {
        $Stopwatch.Stop()
    }

    Write-Log "[$No/$Total] Status=$Status; Elapsed=$($Stopwatch.ElapsedMilliseconds) ms"

    $Results.Add([PSCustomObject]@{
        No              = $No
        ReferenceNumber = $ReferenceNumber
        Status          = $Status
        ElapsedMs       = $Stopwatch.ElapsedMilliseconds
        Response        = $ResponseText
        Error           = $ErrorText
    })
}

# -------------------- 9. 結果摘要與 CSV --------------------

Write-Log '========== 執行摘要 ==========' Cyan
Write-Log "查詢日期：$QueryDate"
Write-Log "查詢筆數：$Total"
Write-Log "SOAP 呼叫成功：$SuccessCount" Green
Write-Log "SOAP 呼叫失敗：$FailedCount" $(if ($FailedCount -gt 0) { 'Red' } else { 'Green' })

$Results |
    Select-Object No, ReferenceNumber, Status, ElapsedMs, Error |
    Format-Table -AutoSize |
    Out-String |
    ForEach-Object {
        Write-Host $_
        Add-Content -Path $MainLogFile -Value $_ -Encoding UTF8
    }

$CsvFile = Join-Path $LogFolder "Results_$Timestamp.csv"

$Results |
    Select-Object No, ReferenceNumber, Status, ElapsedMs, Error |
    Export-Csv -Path $CsvFile -NoTypeInformation -Encoding UTF8

Write-Log "結果 CSV：$CsvFile" Cyan
Write-Log '========== 作業結束 ==========' Cyan
