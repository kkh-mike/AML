Sub RowItem(Num, s, Adr, Remk, birth, Arr() As Variant)
    Sheets("TransferredFile").Select
    For x = 1 To UBound(Arr)
        If Arr(x) <> "" Then
            nextrow = Cells(Rows.Count, 1).End(xlUp).Row + 1
            Cells(nextrow, 1).Value = s
            Cells(nextrow, 2).Value = Arr(x)
            Cells(nextrow, 3).Value = Arr(x)
            Cells(nextrow, 4).Value = Num
            Cells(nextrow, 6).Value = Adr
            Cells(nextrow, 8).Value = "JP"
            Cells(nextrow, 11).Value = "JP"
            Cells(nextrow, 12).Value = Remk
            Cells(nextrow, 14).Value = birth
            Cells(nextrow, 15).Value = "NEW"
        End If
    Next x
End Sub
