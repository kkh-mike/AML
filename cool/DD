$cipherBase64 = ""

# 1. 填入該系統使用的 Key 與 IV（通常為 16/24/32 字節）
$keyString = "請替換為你的金鑰KEY"
$ivString  = "請替換為你的向量IV"

# 2. 轉換為 Byte 陣列
$cipherBytes = [System.Convert]::FromBase64String($cipherBase64)
$keyBytes    = [System.Text.Encoding]::UTF8.GetBytes($keyString)
$ivBytes     = [System.Text.Encoding]::UTF8.GetBytes($ivString)

# 3. 初始化 AES 解密器
$aes = [System.Security.Cryptography.Aes]::Create()
$aes.Key = $keyBytes
$aes.IV  = $ivBytes
$aes.Mode = [System.Security.Cryptography.CipherMode]::CBC
$aes.Padding = [System.Security.Cryptography.PaddingMode]::PKCS7

# 4. 執行解密
$decryptor = $aes.CreateDecryptor()
$plainBytes = $decryptor.TransformFinalBlock($cipherBytes, 0, $cipherBytes.Length)
$plainText  = [System.Text.Encoding]::UTF8.GetString($plainBytes)

Write-Output $plainText
