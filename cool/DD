Dim SaveName As String
Dim pathName As String
Dim Filename As String

Sub start()
    Call ClearTransferredSheet
    Sheets("Action").Select
    pathName = Range("D1").Value
    Filename = Range("D2").Value
    SaveName = Range("D3").Value
    TabName = "TEMP"
    If Dir(pathName & Filename) = "" Then
        MsgBox "File" & Filename & " doesn 't exist in the path " & pathName & ". Please check it again!!"
    Else
        ControlFile = ActiveWorkbook.Name
        Workbooks.Open Filename:=pathName & Filename
        ActiveSheet.Name = TabName
        Sheets(TabName).Copy After:=Workbooks(ControlFile).Sheets(1)
        Windows(Filename).Activate
        ActiveWorkbook.Close SaveChanges:=False
        Windows(ControlFile).Activate
        splitX = Split(Filename, ".")
        Filename = splitX(0)
        Filename = UCase(Filename)
        Select Case Filename
            Case "HOUJIN"
                Call TransferHoujin
            Case "KOJIN"
                Call TransferKojin
            Case "SEIHO"
                Call TransferSeiho
            Case "SONGHO"
                Call TransferSongho
        End Select
        
        Call CSVFile
    End If
End Sub
