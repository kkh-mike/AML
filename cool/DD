報錯是因為暫存表 #tempDJBlacklistDetailsJP 已經在原查詢視窗結束時被清除了。
以下是最核心、不依賴任何暫存表的 2 大關鍵反向驗證：直接用「實體來源表」對比「目標表」，回傳 0 筆 即代表驗證通過。
驗證 1：有沒有漏掉名單？（來源有的，目標表必須存在且 DInd = 'N'）
-- 預期筆數：0 筆（若有查出代表同步失敗、有漏抓或未生效的名單）
;WITH SourceEntities AS
(
    -- 1. 正常名單
    SELECT A.EntNum AS EntityId, A.SdnName
    FROM BSADB.dbo.DJ_List_Data_A A
    JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntNum = B.EntityId
    WHERE (A.NamePropertyBitCode & 1) > 0
      AND B.SanctionListReference LIKE '%Japanese Finance%'

    UNION

    -- 2. 死亡名單
    SELECT A.EntityId, A.FullName AS SdnName
    FROM BSADB.dbo.DJ_Entity A
    JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
    WHERE A.Deceased = 1
      AND B.SanctionListReference LIKE '%Japanese Finance%'
)
SELECT S.EntityId, S.SdnName
FROM SourceEntities S
LEFT JOIN BSADBJP..OFAC_SPEC T 
       ON T.GROUPID = 5 
      AND T.spec_name = S.SdnName 
      AND T.remark = CAST(S.EntityId AS VARCHAR(100))
WHERE T.ent_num IS NULL 
   OR T.DInd <> 'N';

驗證 2：有沒有該刪除卻沒刪的？（目前目標表 DInd = 'N' 的，必須在來源內）
-- 預期筆數：0 筆（若有查出代表已經從來源消失，卻沒有被軟刪除 DInd = 'Y'）
;WITH SourceEntities AS
(
    SELECT A.EntNum AS EntityId, A.SdnName
    FROM BSADB.dbo.DJ_List_Data_A A
    JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntNum = B.EntityId
    WHERE (A.NamePropertyBitCode & 1) > 0
      AND B.SanctionListReference LIKE '%Japanese Finance%'

    UNION

    SELECT A.EntityId, A.FullName AS SdnName
    FROM BSADB.dbo.DJ_Entity A
    JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
    WHERE A.Deceased = 1
      AND B.SanctionListReference LIKE '%Japanese Finance%'
)
SELECT T.ent_num, T.spec_name, T.remark, T.DInd
FROM BSADBJP..OFAC_SPEC T
LEFT JOIN SourceEntities S 
       ON T.spec_name = S.SdnName 
      AND T.remark = CAST(S.EntityId AS VARCHAR(100))
WHERE T.GROUPID = 5 
  AND T.DInd = 'N'
  AND S.EntityId IS NULL;

