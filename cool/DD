DECLARE @ID UNIQUEIDENTIFIER,
        @CreatedDate DATETIME2(7),
        @CreatedDateUTC DATETIME2(7),
        @POBankNo NVARCHAR(10),
        @IsMaintenance BIT;

BEGIN TRY
    EXEC [dbo].[SWIFT_InsertRawMessage]
        @BankNo = N'TW',
        @BranchNo = N'0001',
        @Message = N'{1:F01TSIBTWTPAXXX5356135117}{2:O1030831210315TSIBTWTPXXXX12341234560510170831N}{4:
:20:E-T115-082_5
:23B:CRED
:32A:210315USD0,
:33B:USD0,
:50K:/21031592170
Huntsman Investments Company Lim\ited
:53A:HSBCGB2L
:54A:CRESCHZZ
:56A:CHASUS33
:57A:SWHQBEBB
:59A:DEUTDEFF
:70:Marieil
:71A:SHA
-}',
        @ClientReferenceNo = N'E-T115-082_5',
        @ClientMessageTypeCode = N'MT',
        @SourceID = N'TSID',
        @Channel = N'SWIFT',
        @ID = @ID OUTPUT,
        @CreatedDate = @CreatedDate OUTPUT,
        @CreatedDateUTC = @CreatedDateUTC OUTPUT,
        @POBankNo = @POBankNo OUTPUT,
        @IsMaintenance = @IsMaintenance OUTPUT;

    SELECT 
        @ID AS Inserted_ID,
        @POBankNo AS Mapped_POBankNo,
        @IsMaintenance AS Is_Maintenance_Mode,
        @CreatedDate AS BankLocalTime,
        @CreatedDateUTC AS CreatedDateUTC;
END TRY
BEGIN CATCH
    SELECT 
        ERROR_NUMBER() AS ErrorNumber,
        ERROR_LINE() AS ErrorLine,
        ERROR_MESSAGE() AS ErrorMessage;
END CATCH
