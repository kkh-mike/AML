
function Execute-SOAPRequest {
    param (
        [xml]    $SOAPRequest,
        [string] $URL
    )

    $soapWebRequest = [System.Net.WebRequest]::Create($URL)
    $soapWebRequest.Headers.Add("SOAPAction", "SubmitRequest")
    $soapWebRequest.ContentType = 'text/xml; charset=utf-8'
    $soapWebRequest.Accept = "text/xml"
    $soapWebRequest.Method = "POST"

    $requestStream = $soapWebRequest.GetRequestStream()

    try {
        $SOAPRequest.Save($requestStream)
    }
    finally {
        $requestStream.Close()
    }

    $resp = $soapWebRequest.GetResponse()

    try {
        $responseStream = $resp.GetResponseStream()
        $soapReader = [System.IO.StreamReader]::new($responseStream)

        try {
            return $soapReader.ReadToEnd()
        }
        finally {
            $soapReader.Close()
        }
    }
    finally {
        $resp.Close()
    }
}


# ============================================================
# 1. SOAP Service 設定
# ============================================================

$url = 'http://localhost:8082/SwiftProcessor.svc?wsdl'


# ============================================================
# 2. 自動產生 ReferenceNumber
#    格式：yyyyMMddHHmmssfff
#    範例：20261027130325123
# ============================================================

$referenceNumber = Get-Date -Format 'yyyyMMddHHmmssfff'


# ============================================================
# 3. SWIFT 電文
# ============================================================

$swiftMessage = @'
{1:F01TSIBTWTPAXXX5356135117}{2:O1030831210315TSIBTWTPXXXX12341234560510170831N}{4:
:20:E-T130-066_2
:23B:CRED
:32A:210315USD0,
:33B:USD0,
:50K:/21031592170
TARTOUS
:53A:HSBCGB2L
:54A:CRESCHZZ
:56A:CHASUS33
:57A:SWHQBEBB
:59A:DEUTDEFF
:71A:SHA
-}
'@


# ============================================================
# 4. 建立 SOAP Request
# ============================================================

$soapXml = @"
<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope
    xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <soap:Body>
        <SubmitRequest xmlns="http://patriotofficer.net/SwiftService">
            <Params>
                <ActionCode>SCAN_SWIFT</ActionCode>
                <BankNo>TW</BankNo>
                <BranchNo>0001</BranchNo>
                <Channel>SWIFT</Channel>
                <Message><![CDATA[$swiftMessage]]></Message>
                <MessageTypeCode>MT</MessageTypeCode>
                <ReferenceNumber>$referenceNumber</ReferenceNumber>
                <SourceID>TSID</SourceID>
            </Params>
        </SubmitRequest>
    </soap:Body>
</soap:Envelope>
"@

$soap1 = [xml]$soapXml


# ============================================================
# 5. 執行 SOAP Request 並計算耗時
# ============================================================

$sw = [System.Diagnostics.Stopwatch]::StartNew()

try {
    $response = Execute-SOAPRequest -SOAPRequest $soap1 -URL $url

    $sw.Stop()

    Write-Host "ReferenceNumber : $referenceNumber"
    Write-Host "Elapsed Time    : $($sw.Elapsed.TotalMilliseconds) ms"
    Write-Host "`nSOAP Response:"
    Write-Output $response
}
catch {
    $sw.Stop()

    Write-Host "SOAP Request Failed" -ForegroundColor Red
    Write-Host "ReferenceNumber : $referenceNumber"
    Write-Host "Elapsed Time    : $($sw.Elapsed.TotalMilliseconds) ms"
    Write-Host "Error           : $($_.Exception.Message)" -ForegroundColor Red
}
