為符合你的需求，主要修改重點如下：
 * CSV 讀取方式：改用 Import-Csv 解析表頭（包含 EXTN_REF_NO 與 INTN_REF_NO）。
 * 資料表對應與結構：目標資料表改為 XREF，移除動態 CREATE TABLE，保留 TRUNCATE TABLE 清空舊資料。
 * 欄位對應（Column Mappings）：精準將 DataTable 的兩個欄位對應至資料庫的 EXTN_REF_NO 與 INTN_REF_NO，其餘允許為 NULL 的欄位（INST_NO, TYPE, STATUS, LST_MTN_DT）會自動填入 NULL。
完整的 PowerShell 腳本如下：
# ==========================================
# 自動抓取 LDAP 連線資訊 + 切換至 BSADBTW + 透過 SqlBulkCopy 匯入 XREF.csv
# ==========================================

$hasError = $false
$TargetDB = "BSADBTW"  # 指定目標資料庫

# 1. 資料夾準備與全域 Log 初始化
$LogFolder = Join-Path -Path $PSScriptRoot -ChildPath "Log"
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}

$Timestamp   = Get-Date -Format "yyyyMMdd_HHmmss"
$MainLogFile = Join-Path -Path $LogFolder -ChildPath "Execution_$Timestamp.log"

function Write-Log {
    param (
        [string]$Message,
        [ConsoleColor]$ForegroundColor = [ConsoleColor]::White,
        [switch]$IsError
    )
    $timePrefix = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $formattedMsg = "[$timePrefix] $Message"
    
    Write-Host $Message -ForegroundColor $ForegroundColor
    Add-Content -Path $MainLogFile -Value $formattedMsg -Encoding UTF8
    
    if ($IsError) {
        $global:hasError = $true
    }
}

Write-Log "=== 開始執行 CSV 讀取與 SQL 匯入作業 ===" -ForegroundColor Cyan
Write-Log "主執行紀錄檔: $MainLogFile" -ForegroundColor DarkGray

# ==========================================
# 2. 載入 LDAP DLL 並取得連線字串
# ==========================================
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (-not (Test-Path -Path $dllPath)) {
    Write-Log "錯誤：找不到 DLL 檔案: $dllPath" -ForegroundColor Red -IsError
    exit 1
}

try {
    if (-not ([System.Management.Automation.PSTypeName]'Tsbldapdbc.RunBat').Type) {
        Add-Type -Path $dllPath
    }

    $App = New-Object Tsbldapdbc.RunBat
    $App.SSL = $false
    $App.ldapHost = "10.6.95.91"
    $App.searchBase = "o=tsbank"
    $sApp = "AML"
    $iCStr = 7

    $connStr = $App.GetRunBat($sApp, $iCStr)
}
catch {
    Write-Log "錯誤：讀取 LDAP 連線資訊時發生例外: $($_.Exception.Message)" -ForegroundColor Red -IsError
    exit 1
}

# 3. 自動解析連線字串參數
$Server   = if ($connStr -match '(?:Data Source|Server)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Database = if ($connStr -match '(?:Initial Catalog|Database)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$User     = if ($connStr -match '(?:User ID|UID)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Password = if ($connStr -match '(?:Password|PWD)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }

Write-Log "解析連線資訊 -> Server: $Server | 預設 DB: $Database | User: $User" -ForegroundColor DarkCyan

if ([string]::IsNullOrWhiteSpace($Server)) {
    Write-Log "錯誤：無法正確解析 Server 連線資訊！" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 4. 定義 CSV 檔案路徑與對應 Table
# ==========================================
$tasks = @(
    @{
        TableName = "XREF"
        FilePath  = Join-Path -Path $PSScriptRoot -ChildPath "XREF.csv"
    }
)

# ==========================================
# 5. 連線資料庫、切換至 BSADBTW 並執行寫入
# ==========================================
$sqlConn = New-Object System.Data.SqlClient.SqlConnection($connStr)

try {
    $sqlConn.Open()
    Write-Log "成功連線至伺服器: $Server" -ForegroundColor Green

    # 切換至 BSADBTW 資料庫
    $sqlConn.ChangeDatabase($TargetDB)
    Write-Log "已切換資料庫至: $TargetDB" -ForegroundColor Cyan

    foreach ($task in $tasks) {
        $table   = $task.TableName
        $csvPath = $task.FilePath

        Write-Log "--- 開始處理: $TargetDB.dbo.$table ---" -ForegroundColor Yellow

        if (-not (Test-Path -Path $csvPath)) {
            Write-Log "錯誤：找不到檔案 $csvPath" -ForegroundColor Red -IsError
            continue
        }

        # 清空舊資料
        $initTableSql = @"
USE [$TargetDB];
TRUNCATE TABLE [dbo].[$table];
"@
        $initCmd = $sqlConn.CreateCommand()
        $initCmd.CommandText = $initTableSql
        $initCmd.ExecuteNonQuery() | Out-Null

        # 建立存放待寫入資料的 DataTable
        $dt = New-Object System.Data.DataTable
        $null = $dt.Columns.Add("EXTN_REF_NO", [string])
        $null = $dt.Columns.Add("INTN_REF_NO", [string])

        # 讀取 CSV（自動解析表頭，編碼若為 UTF-8 可將 Default 改為 UTF8）
        $csvData = Import-Csv -Path $csvPath -Encoding Default
        foreach ($row in $csvData) {
            $extn = if ($row.EXTN_REF_NO) { $row.EXTN_REF_NO.Trim() } else { $null }
            $intn = if ($row.INTN_REF_NO) { $row.INTN_REF_NO.Trim() } else { $null }

            # 只要有任一欄位不為空值即加入寫入清單
            if (-not [string]::IsNullOrEmpty($extn) -or -not [string]::IsNullOrEmpty($intn)) {
                $newRow = $dt.NewRow()
                $newRow["EXTN_REF_NO"] = if ([string]::IsNullOrEmpty($extn)) { [DBNull]::Value } else { $extn }
                $newRow["INTN_REF_NO"] = if ([string]::IsNullOrEmpty($intn)) { [DBNull]::Value } else { $intn }
                $dt.Rows.Add($newRow)
            }
        }

        # 寫入 BSADBTW 資料庫
        $bulkCopy = New-Object System.Data.SqlClient.SqlBulkCopy($sqlConn)
        $bulkCopy.DestinationTableName = "[$TargetDB].[dbo].[$table]"
        $bulkCopy.BulkCopyTimeout = 300
        $bulkCopy.BatchSize = 10000

        # 明確設定欄位映射
        $bulkCopy.ColumnMappings.Add("EXTN_REF_NO", "EXTN_REF_NO") | Out-Null
        $bulkCopy.ColumnMappings.Add("INTN_REF_NO", "INTN_REF_NO") | Out-Null

        $bulkCopy.WriteToServer($dt)
        $bulkCopy.Close()

        Write-Log "[$table] 匯入成功！共寫入 $($dt.Rows.Count) 筆資料至 $TargetDB。" -ForegroundColor Green
    }
}
catch {
    Write-Log "執行作業時發生錯誤: $($_.Exception.Message)" -ForegroundColor Red -IsError
}
finally {
    if ($sqlConn.State -eq [System.Data.ConnectionState]::Open) {
        $sqlConn.Close()
        Write-Log "已關閉資料庫連線。" -ForegroundColor DarkGray
    }
}

# ==========================================
# 6. 狀態判定與 Exit Code 回傳
# ==========================================
if ($hasError) {
    Write-Log "=== 作業失敗，退出代碼: 1 ===" -ForegroundColor Red
    exit 1
} else {
    Write-Log "=== 作業成功完成，退出代碼: 0 ===" -ForegroundColor Green
    exit 0
}

