# ============================================
# 1. 路徑與基本設定
# ============================================

$folderPath   = "D:\UATR3\AMLDataMigrator"
$baselineFile = Join-Path $folderPath "AML_CHECK_SUM_1.csv"
$logFolder    = Join-Path $folderPath "Log"

# 確保 Log 目錄存在
if (!(Test-Path $logFolder)) {
    New-Item -ItemType Directory -Path $logFolder -Force | Out-Null
}

# 帶有時間戳記的 Log 檔案
$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$logFile   = Join-Path $logFolder "SKcheck_CHECK_SUM_CIF_$timestamp.log"

$hasError = $false


# ============================================
# 2. Log 輸出函式
# 同時記錄到 Control-M Console 與實體 Log
# ============================================

function Write-Log {
    param(
        [string]$msg,
        [string]$level = "INFO"
    )

    $time    = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logLine = "[$time] [$level] $msg"

    # 輸出到 Control-M Console
    Write-Output $logLine

    # 寫入實體 Log
    Add-Content -Path $logFile -Value $logLine -Encoding UTF8
}


# ============================================
# 3. 計算 Physical Line Count
#
# 注意：
# ReadLine() 計算的是「實際換行數」
# 不代表真正 CSV 筆數
# ============================================

function Get-PhysicalLineCount {
    param(
        [string]$filePath
    )

    $count = 0

    $reader = New-Object System.IO.StreamReader(
        $filePath,
        [System.Text.Encoding]::UTF8,
        $true
    )

    try {
        while ($reader.ReadLine() -ne $null) {
            $count++
        }
    }
    finally {
        $reader.Close()
        $reader.Dispose()
    }

    return $count
}


# ============================================
# 4. 計算真正 CSV Record Count
#
# 使用 TextFieldParser
#
# 可以處理：
#
# "AAA
# BBB
# CCC",123,456
#
# 這種欄位內容包含換行的 CSV
# ============================================

function Get-CsvRecordCount {
    param(
        [string]$filePath
    )

    Add-Type -AssemblyName Microsoft.VisualBasic

    $count = 0

    $parser = New-Object Microsoft.VisualBasic.FileIO.TextFieldParser($filePath)

    try {

        # CSV 使用逗號分隔
        $parser.TextFieldType =
            [Microsoft.VisualBasic.FileIO.FieldType]::Delimited

        $parser.SetDelimiters(",")

        # 支援雙引號包住的欄位
        $parser.HasFieldsEnclosedInQuotes = $true

        # 不自動移除空白
        $parser.TrimWhiteSpace = $false

        while (-not $parser.EndOfData) {

            # 讀取一整筆 CSV Record
            # 即使欄位內有換行，也會視為同一筆
            $null = $parser.ReadFields()

            $count++
        }

    }
    finally {
        $parser.Close()
        $parser.Dispose()
    }

    return $count
}


# ============================================
# 5. 作業開始
# ============================================

Write-Log "============================================"
Write-Log "JOB START: Checksum & CSV Record Count Verification"
Write-Log "Input Path   : $folderPath"
Write-Log "Baseline File: $baselineFile"
Write-Log "Log File     : $logFile"
Write-Log "============================================"


# ============================================
# 6. 檢查 Input Folder
# ============================================

if (!(Test-Path $folderPath)) {

    Write-Log `
        "ERROR TYPE : INPUT FOLDER NOT FOUND (Path: $folderPath)" `
        "ERROR"

    $hasError = $true
}


# ============================================
# 7. 檢查 Baseline File
# ============================================

if (!$hasError -and !(Test-Path $baselineFile)) {

    Write-Log `
        "ERROR TYPE : BASELINE FILE NOT FOUND (File: $baselineFile)" `
        "ERROR"

    $hasError = $true
}


# ============================================
# 8. 基本環境檢核失敗
# ============================================

if ($hasError) {

    Write-Log "============================================"
    Write-Log "JOB STATUS : FAILED (Exit Code: 1)" "ERROR"
    Write-Log "============================================"

    exit 1
}


# ============================================
# 9. 讀取與解析 AML_CHECK_SUM_1.csv
#
# 格式：
#
# AML_SPEC_OFAC_SPEC.csv;1933;MD5
# ============================================

$baseline = @{}

try {

    $lines = Get-Content `
        -Path $baselineFile `
        -Encoding UTF8

    foreach ($line in $lines) {

        # 忽略空白行
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        $parts = $line.Split(";")

        # 至少需要：
        # FileName ; Count ; MD5
        if ($parts.Count -lt 3) {

            Write-Log `
                "ERROR TYPE : BASELINE FORMAT ERROR -> Line: $line" `
                "ERROR"

            $hasError = $true
            continue
        }


        # --------------------------------------------
        # File Name
        # --------------------------------------------

        $fileName = $parts[0].Trim()


        # --------------------------------------------
        # Count
        # --------------------------------------------

        $countText = $parts[1].Trim()


        # --------------------------------------------
        # MD5
        # --------------------------------------------

        $md5 = $parts[2].Trim().ToLowerInvariant()


        # --------------------------------------------
        # 檢查 File Name
        # --------------------------------------------

        if ([string]::IsNullOrWhiteSpace($fileName)) {

            Write-Log `
                "ERROR TYPE : EMPTY FILE NAME -> Line: $line" `
                "ERROR"

            $hasError = $true
            continue
        }


        # --------------------------------------------
        # 檢查 Count
        # --------------------------------------------

        $expectedCount = 0

        if (-not [int64]::TryParse(
            $countText,
            [ref]$expectedCount
        )) {

            Write-Log `
                "ERROR TYPE : INVALID COUNT -> File: $fileName, Count: $countText" `
                "ERROR"

            $hasError = $true
            continue
        }


        # --------------------------------------------
        # 檢查 MD5 Format
        # --------------------------------------------

        if ($md5 -notmatch '^[0-9a-f]{32}$') {

            Write-Log `
                "ERROR TYPE : INVALID MD5 FORMAT -> File: $fileName, MD5: $md5" `
                "ERROR"

            $hasError = $true
            continue
        }


        # --------------------------------------------
        # 儲存 Baseline
        # --------------------------------------------

        $key = $fileName.ToLowerInvariant()

        $baseline[$key] = @{
            FileName = $fileName
            Count    = $expectedCount
            MD5      = $md5
        }
    }
}
catch {

    Write-Log `
        "ERROR TYPE : BASELINE READ ERROR -> $($_.Exception.Message)" `
        "ERROR"

    $hasError = $true
}


# ============================================
# 10. Baseline 解析失敗
# ============================================

if ($hasError) {

    Write-Log "============================================"
    Write-Log "JOB STATUS : FAILED (Exit Code: 1)" "ERROR"
    Write-Log "============================================"

    exit 1
}


# ============================================
# 11. 逐檔比對
#
# 比對：
#
# 1. CSV Record Count
# 2. MD5
#
# 同時記錄：
#
# Physical Line Count
# ============================================

foreach ($key in $baseline.Keys) {

    $expectedFileName = $baseline[$key].FileName
    $expectedCount    = $baseline[$key].Count
    $expectedMD5      = $baseline[$key].MD5

    $targetFile = $null
    $matchedLeaf = $null


    # ============================================
    # 11-1. 直接比對檔名
    # ============================================

    $directPath = Join-Path `
        $folderPath `
        $expectedFileName


    if (Test-Path $directPath) {

        $targetFile = $directPath
        $matchedLeaf = Split-Path $targetFile -Leaf

    }
    else {

        # ============================================
        # 11-2. 自動嘗試副檔名變體
        # ============================================

        $baseStem = $expectedFileName `
            -replace '(\.Table)?\.(sql|csv)$', ''


        $candidateFiles = @(
            (Join-Path $folderPath "$baseStem.sql"),
            (Join-Path $folderPath "$baseStem.Table.sql"),
            (Join-Path $folderPath "$baseStem.csv")
        )


        foreach ($candidate in $candidateFiles) {

            if (Test-Path $candidate) {

                $targetFile = $candidate
                $matchedLeaf = Split-Path $targetFile -Leaf

                Write-Log `
                    "Matched '$expectedFileName' -> local file '$matchedLeaf'"

                break
            }
        }
    }


    # ============================================
    # 11-3. 檢查檔案是否存在
    # ============================================

    if ($null -eq $targetFile) {

        Write-Log `
            "ERROR TYPE : FILE NOT FOUND -> Expected: $expectedFileName" `
            "ERROR"

        $hasError = $true

        continue
    }


    # ============================================
    # 11-4. 計算 Count 與 MD5
    # ============================================

    try {

        Write-Log "Checking File: $expectedFileName"


        # --------------------------------------------
        # Physical Line Count
        #
        # 實際換行數
        # --------------------------------------------

        $physicalLineCount =
            Get-PhysicalLineCount -filePath $targetFile


        # --------------------------------------------
        # CSV Record Count
        #
        # 真正 CSV 筆數
        # --------------------------------------------

        $actualCount =
            Get-CsvRecordCount -filePath $targetFile


        # --------------------------------------------
        # MD5
        # --------------------------------------------

        $actualMD5 =
            (Get-FileHash `
                -Path $targetFile `
                -Algorithm MD5
            ).Hash.ToLowerInvariant()


        # ============================================
        # 11-5. Log Count Information
        # ============================================

        Write-Log `
            "CSV RECORD COUNT -> File: $expectedFileName (Expected: $expectedCount, Actual: $actualCount)"

        Write-Log `
            "PHYSICAL LINE COUNT -> File: $expectedFileName (Actual: $physicalLineCount)"


        # ============================================
        # 11-6. 檢驗 CSV Record Count
        # ============================================

        if ($actualCount -ne $expectedCount) {

            Write-Log `
                "COUNT MISMATCH -> File: $expectedFileName (Expected: $expectedCount, Actual: $actualCount)" `
                "ERROR"

            $hasError = $true
        }


        # ============================================
        # 11-7. 檢驗 MD5
        # ============================================

        if ($actualMD5 -ne $expectedMD5) {

            Write-Log `
                "MD5 MISMATCH -> File: $expectedFileName (Expected: $expectedMD5, Actual: $actualMD5)" `
                "ERROR"

            $hasError = $true
        }


        # ============================================
        # 11-8. Count + MD5 都正確
        # ============================================

        if (
            $actualCount -eq $expectedCount -and
            $actualMD5 -eq $expectedMD5
        ) {

            Write-Log `
                "PASSED -> File: $expectedFileName (CSV Records: $actualCount, Physical Lines: $physicalLineCount, MD5: OK)"
        }

    }
    catch {

        Write-Log `
            "ERROR TYPE : FILE PROCESS ERROR -> File: $expectedFileName, Message: $($_.Exception.Message)" `
            "ERROR"

        $hasError = $true
    }
}


# ============================================
# 12. 最終結果與 Exit Code
# ============================================

Write-Log "============================================"


if ($hasError) {

    Write-Log `
        "JOB STATUS : FAILED (Exit Code: 1)" `
        "ERROR"

    Write-Log "============================================"

    exit 1
}
else {

    Write-Log `
        "JOB STATUS : SUCCESS (Exit Code: 0)" `
        "INFO"

    Write-Log "============================================"

    exit 0
}


