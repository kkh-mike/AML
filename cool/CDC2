/* 1. 建立並收集需要測試比對的清單（包含一般清單與死亡清單） */
IF OBJECT_ID('tempdb..#tempTestCleanupJP') IS NOT NULL
    DROP TABLE #tempTestCleanupJP;

CREATE TABLE #tempTestCleanupJP
(
    EntNum  INT NOT NULL,
    SdnName NVARCHAR(350) NOT NULL
);

-- (1) 一般日本金融制裁名單
INSERT INTO #tempTestCleanupJP (EntNum, SdnName)
SELECT 
    A.EntNum, 
    A.SdnName
FROM BSADB.dbo.DJ_List_Data_A A
JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntNum = B.EntityId
WHERE A.NamePropertyBitCode & 1 > 0
  AND B.SanctionListReference LIKE '%Japanese Finance%'
GROUP BY A.EntNum, A.SdnName;

-- (2) 死亡名單（排除已在上述清單的資料）
INSERT INTO #tempTestCleanupJP (EntNum, SdnName)
SELECT 
    A.EntityId, 
    A.FullName
FROM BSADB.dbo.DJ_Entity A
JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
WHERE A.Deceased = 1
  AND B.SanctionListReference LIKE '%Japanese Finance%'
  AND NOT EXISTS (SELECT 1 FROM #tempTestCleanupJP X WHERE X.EntNum = A.EntityId)
GROUP BY A.EntityId, A.FullName;


/* 2. 刪除 BSADBJP.dbo.OFAC_SPEC 中符合條件的資料 (限定 GROUPID = '11') */
DELETE T
FROM BSADBJP.dbo.OFAC_SPEC T
JOIN #tempTestCleanupJP S 
  ON T.spec_name = S.SdnName 
 AND T.remark = CAST(S.EntNum AS VARCHAR(100))
WHERE T.GROUPID = '11';

/* 3. 清理暫存表 */
DROP TABLE #tempTestCleanupJP;
