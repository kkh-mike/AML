 OUTPUT INSERTED.FLRS_KEY,INSERTED.BatchID,INSERTED.CLIENT_MSG_TYPE_CODE,INSERTED.BNK_NBR,INSERTED.UserReference,INSERTED.EmpNo,INSERTED.Remittance,INSERTED.FWorker_FName,INSERTED.  
  FWorker_LName,INSERTED.FWorker_FullName,INSERTED.Ben_FName,INSERTED.Ben_LName,INSERTED.Ben_FullName,INSERTED.Ben_Bank,INSERTED.Ben_Addr,INSERTED.FORMAT,INSERTED.DIRECTION,INSERTED.Created_Date,INSERTED.  
  Created_UserId,INSERTED.Last_Upd_Date,INSERTED.Last_Upd_UserId,INSERTED.HandledBy,INSERTED.Status,INSERTED.Action,INSERTED.Role,INSERTED.QueueID,INSERTED.EmailID,INSERTED.LastEmailDate,INSERTED.Detected,INSERTED.  
  AssignBy,INSERTED.AssignDate,INSERTED.ReleaseBy,INSERTED.ReleaseDate,INSERTED.ReleaseBy_2,INSERTED.ReleaseDate_2,INSERTED.ReleaseBy_3,INSERTED.ReleaseDate_3,INSERTED.ReleaseBy_4,INSERTED.ReleaseDate_4,INSERTED.  
