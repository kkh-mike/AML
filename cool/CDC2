
#requires -Version 5.1

# ============================================================
# Send-SwiftFromTxt.ps1
# TXT 多筆 SWIFT 電文 -> SOAP API
#
# TXT 格式：一行一筆 SWIFT 電文
# 功能：逐筆送出、記錄耗時、錯誤處理、輸出 CSV
# ============================================================

$ErrorActionPreference = 'Stop'

# ============================================================
# 1. 基本設定
# ============================================================

$url = 'http://localhost:8082/SwiftProcessor.svc?wsdl'

# TXT 電文檔案路徑：請依實際位置修改
$InputFile = 'D:\AML_Source\Source\1141923\SWIFTMT\swift_messages_long.txt'

# 批次結果 CSV 路徑
$OutputCsv = 'D:\AML_Source\Source\1141923\SWIFTMT\swift_results.csv'

# SOAP 固定參數
$ActionCode     = 'SCAN_SWIFT'
$BankNo         = 'TW'
$BranchNo       = '0001'
$Channel        = 'SWIFT'
$MessageTypeCode = 'MT'
$SourceID       = 'TSID'

# HTTP Timeout（毫秒）
$TimeoutMs = 60000

# ============================================================
# 2. SOAP Request 函式
# ============================================================

function Execute-SOAPRequest {
    param (
        [Parameter(Mandatory = $true)]
        [xml] $SOAPRequest,

        [Parameter(Mandatory = $true)]
        [string] $URL
    )

    $soapWebRequest = [System.Net.WebRequest]::Create($URL)

    $soapWebRequest.Headers.Add('SOAPAction', 'SubmitRequest')
    $soapWebRequest.ContentType = 'text/xml; charset=utf-8'
    $soapWebRequest.Accept = 'text/xml'
    $soapWebRequest.Method = 'POST'
    $soapWebRequest.Timeout = $TimeoutMs
    $soapWebRequest.ReadWriteTimeout = $TimeoutMs

    # 送出 Request
    $requestStream = $soapWebRequest.GetRequestStream()

    try {
        # 使用 UTF-8 編碼送出 XML
        $settings = New-Object System.Xml.XmlWriterSettings
        $settings.Encoding = New-Object System.Text.UTF8Encoding($false)
        $settings.Indent = $false
        $settings.CloseOutput = $false

        $writer = [System.Xml.XmlWriter]::Create(
            $requestStream,
            $settings
        )

        try {
            $SOAPRequest.Save($writer)
            $writer.Flush()
        }
        finally {
            $writer.Close()
        }
    }
    finally {
        $requestStream.Close()
    }

    # 接收 Response
    $resp = $soapWebRequest.GetResponse()

    try {
        $responseStream = $resp.GetResponseStream()

        try {
            $reader = New-Object System.IO.StreamReader(
                $responseStream,
                [System.Text.Encoding]::UTF8
            )

            try {
                return $reader.ReadToEnd()
            }
            finally {
                $reader.Close()
            }
        }
        finally {
            $responseStream.Close()
        }
    }
    finally {
        $resp.Close()
    }
}

# ============================================================
# 3. 建立 SOAP XML
# ============================================================

function New-SOAPRequest {
    param (
        [Parameter(Mandatory = $true)]
        [string] $SwiftMessage,

        [Parameter(Mandatory = $true)]
        [string] $ReferenceNumber
    )

    $soapNs = 'http://schemas.xmlsoap.org/soap/envelope/'
    $serviceNs = 'http://patriotofficer.net/SwiftService'

    $xml = New-Object System.Xml.XmlDocument
    $xml.PreserveWhitespace = $true

    # XML Declaration
    $declaration = $xml.CreateXmlDeclaration(
        '1.0',
        'utf-8',
        $null
    )
    [void] $xml.AppendChild($declaration)

    # Envelope
    $envelope = $xml.CreateElement(
        'soap',
        'Envelope',
        $soapNs
    )
    [void] $xml.AppendChild($envelope)

    # Body
    $body = $xml.CreateElement(
        'soap',
        'Body',
        $soapNs
    )
    [void] $envelope.AppendChild($body)

    # SubmitRequest
    $submit = $xml.CreateElement(
        '',
        'SubmitRequest',
        $serviceNs
    )
    [void] $body.AppendChild($submit)

    # Params
    $params = $xml.CreateElement(
        '',
        'Params',
        $serviceNs
    )
    [void] $submit.AppendChild($params)

    # 固定欄位
    $fields = [ordered]@{
        ActionCode      = $ActionCode
        BankNo          = $BankNo
        BranchNo        = $BranchNo
        Channel         = $Channel
    }

    foreach ($field in $fields.GetEnumerator()) {
        $element = $xml.CreateElement(
            '',
            $field.Key,
            $serviceNs
        )
        $element.InnerText = [string]$field.Value
        [void] $params.AppendChild($element)
    }

    # Message 使用 CDATA，保留 SWIFT 電文內容
    $messageElement = $xml.CreateElement(
        '',
        'Message',
        $serviceNs
    )

    # CDATA 不能直接包含 ]]>；遇到時改成一般文字節點，
    # 由 XML 自動處理特殊字元
    if ($SwiftMessage.Contains(']]>')) {
        $messageElement.InnerText = $SwiftMessage
    }
    else {
        $cdata = $xml.CreateCDataSection($SwiftMessage)
        [void] $messageElement.AppendChild($cdata)
    }

    [void] $params.AppendChild($messageElement)

    # 剩餘欄位
    $remainingFields = [ordered]@{
        MessageTypeCode = $MessageTypeCode
        ReferenceNumber = $ReferenceNumber
        SourceID        = $SourceID
    }

    foreach ($field in $remainingFields.GetEnumerator()) {
        $element = $xml.CreateElement(
            '',
            $field.Key,
            $serviceNs
        )
        $element.InnerText = [string]$field.Value
        [void] $params.AppendChild($element)
    }

    return $xml
}

# ============================================================
# 4. 檢查輸入檔案
# ============================================================

if (-not (Test-Path -LiteralPath $InputFile -PathType Leaf)) {
    throw "找不到 TXT 檔案：$InputFile"
}

$outputDirectory = Split-Path -Parent $OutputCsv

if ($outputDirectory -and
    -not (Test-Path -LiteralPath $outputDirectory)) {

    New-Item -ItemType Directory -Path $outputDirectory -Force |
        Out-Null
}

# UTF-8 讀取，每一行視為一筆電文
$allLines = @(
    Get-Content -LiteralPath $InputFile -Encoding UTF8
)

$messages = @(
    foreach ($line in $allLines) {
        $message = $line.Trim()

        if ([string]::IsNullOrWhiteSpace($message)) {
            continue
        }

        $message
    }
)

$total = $messages.Count

if ($total -eq 0) {
    throw "TXT 沒有可處理的 SWIFT 電文：$InputFile"
}

Write-Host ''
Write-Host '============================================================'
Write-Host 'SWIFT SOAP Batch Processing'
Write-Host '============================================================'
Write-Host "Input File : $InputFile"
Write-Host "SOAP URL   : $url"
Write-Host "Total      : $total"
Write-Host "Output CSV : $OutputCsv"
Write-Host '============================================================'
Write-Host ''

# ============================================================
# 5. 逐筆送出 SOAP Request
# ============================================================

$results = New-Object System.Collections.Generic.List[object]
$batchWatch = [System.Diagnostics.Stopwatch]::StartNew()

$referenceNumbers = @{}

for ($i = 0; $i -lt $total; $i++) {

    $seq = $i + 1
    $swiftMessage = $messages[$i]

    # ReferenceNumber 格式：yyyyMMddHHmmssfff
    # 避免同一毫秒產生重複編號
    do {
        $referenceNumber = Get-Date -Format 'yyyyMMddHHmmssfff'

        if ($referenceNumbers.ContainsKey($referenceNumber)) {
            Start-Sleep -Milliseconds 2
        }
    }
    while ($referenceNumbers.ContainsKey($referenceNumber))

    $referenceNumbers[$referenceNumber] = $true

    $status = 'SUCCESS'
    $responseText = ''
    $errorMessage = ''
    $elapsedMs = 0

    $sw = [System.Diagnostics.Stopwatch]::StartNew()

    Write-Host "[$seq/$total] Sending..." -ForegroundColor Cyan
    Write-Host "ReferenceNumber : $referenceNumber"

    try {
        # 建立 XML
        $soapRequest = New-SOAPRequest `
            -SwiftMessage $swiftMessage `
            -ReferenceNumber $referenceNumber

        # 送出 SOAP
        $responseText = Execute-SOAPRequest `
            -SOAPRequest $soapRequest `
            -URL $url

        $sw.Stop()
        $elapsedMs = [math]::Round(
            $sw.Elapsed.TotalMilliseconds, 2
        )

        Write-Host "Status          : SUCCESS" -ForegroundColor Green
        Write-Host "Elapsed Time    : $elapsedMs ms"
    }
    catch {
        $sw.Stop()
        $elapsedMs = [math]::Round(
            $sw.Elapsed.TotalMilliseconds, 2
        )

        $status = 'FAILED'
        $errorMessage = $_.Exception.Message

        # 嘗試取得 HTTP 錯誤 Response 內容
        if ($_.Exception.Response) {
            try {
                $errorStream = $_.Exception.Response.GetResponseStream()

                if ($errorStream) {
                    try {
                        $errorReader = New-Object System.IO.StreamReader(
                            $errorStream,
                            [System.Text.Encoding]::UTF8
                        )

                        try {
                            $responseText = $errorReader.ReadToEnd()
                        }
                        finally {
                            $errorReader.Close()
                        }
                    }
                    finally {
                        $errorStream.Close()
                    }
                }
            }
            catch {
                # 保留原始錯誤，不中斷後續電文
            }
        }

        Write-Host "Status          : FAILED" -ForegroundColor Red
        Write-Host "Elapsed Time    : $elapsedMs ms"
        Write-Host "Error           : $errorMessage" -ForegroundColor Red
    }

    # 每筆結果
    $results.Add([PSCustomObject]@{
        Sequence        = $seq
        ReferenceNumber = $referenceNumber
        Status          = $status
        ElapsedMs       = $elapsedMs
        ErrorMessage    = $errorMessage
        Response        = $responseText
        Message         = $swiftMessage
    })

    Write-Host '------------------------------------------------------------'
}

$batchWatch.Stop()

# ============================================================
# 6. 輸出 CSV 結果報表
# ============================================================

$results |
    Export-Csv -LiteralPath $OutputCsv `
        -NoTypeInformation `
        -Encoding UTF8

$successCount = @(
    $results | Where-Object { $_.Status -eq 'SUCCESS' }
).Count

$failedCount = @(
    $results | Where-Object { $_.Status -eq 'FAILED' }
).Count

# ============================================================
# 7. 批次執行摘要
# ============================================================

Write-Host ''
Write-Host '============================================================'
Write-Host 'Batch Summary'
Write-Host '============================================================'
Write-Host "Total Messages : $total"
Write-Host "Success        : $successCount" -ForegroundColor Green
Write-Host "Failed         : $failedCount" -ForegroundColor Red
Write-Host "Total Time     : $([math]::Round($batchWatch.Elapsed.TotalSeconds, 2)) sec"
Write-Host "Average Time   : $([math]::Round($batchWatch.Elapsed.TotalMilliseconds / $total, 2)) ms/message"
Write-Host "Result CSV     : $OutputCsv"
Write-Host '============================================================'


