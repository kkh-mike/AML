CREATE PROCEDURE [dbo].[WORKFLOW_AutomatedUSERS]   
AS  
BEGIN  
 DECLARE @MemberName NVARCHAR(100),  
   @BankNo VARCHAR(10)  
   
 DECLARE @UtcNow DATETIME = GETUTCDATE();  
 DECLARE @BankLocalTime DATETIME = dbo.ConvertToBankLocalTime(@UtcNow);  
 DECLARE @SystemuserID VARCHAR(100) = 'System Admin'  
     
 SELECT @BankNo = REPLACE(DB_NAME(),'BSADB','')  
   
 IF OBJECT_ID ('WORKFLOW_MGMT_USERS_temp', 'U') IS NULL  
  SELECT TOP 1 * INTO WORKFLOW_MGMT_USERS_temp FROM dbo.WORKFLOW_MGMT_USERS   
 TRUNCATE TABLE WORKFLOW_MGMT_USERS_temp  
   
 IF OBJECT_ID ('WORKFLOW_AutomatedDeletedUsers_temp', 'U') IS NULL  
  CREATE TABLE WORKFLOW_AutomatedDeletedUsers_temp ( QueueId INT, UserId NVARCHAR(60))  
 TRUNCATE TABLE WORKFLOW_AutomatedDeletedUsers_temp  
   
 /*Insert into temp table - active users times the QueueID of current module id*/  
 INSERT INTO dbo.WORKFLOW_MGMT_USERS_temp  
   ( QUEUEID ,USERID ,ROLE ,ALERTMAIN , ALERTPERSONAL)  
 SELECT DISTINCT B.QUEUEID, A.CN, A.ROLE, 'Y', 'Y'  
 FROM GCMAINDB.dbo.AutomatedEmployees A   
  JOIN dbo.WORKFLOW_MGMT_QUEUE B ON B.QUEUENAME = A.WORKGROUP AND B.IsAutomated = 'TRUE' AND A.MODULE = B.SRC  
 WHERE A.BANKNO = @BankNo AND ISNULL(A.BRANCH, '') <> '' AND B.DEL_FLAG = 'N' AND  
  EXISTS (SELECT 1 FROM dbo.WORKFLOW_MGMT_ROLE D WHERE A.ROLE = D.ID AND D.FLAG = 'N')  
   
 DECLARE @TableWorkflowMgmtUsersHistory TABLE (  
  QUEUEID int NOT NULL,  
  USERID nvarchar(60) NOT NULL,  
  ROLE int NOT NULL,  
  BUFFER nvarchar(5) NULL,  
  HOLIDAYFROM nvarchar(10) NULL,  
  HOLIDAYTO nvarchar(10) NULL,  
  ALERTMAIN nvarchar(1) NULL,  
  ALERTPERSONAL nvarchar(1) NULL,  
  ALERTMAIN_FROM datetime NULL,  
  ALERTMAIN_TO datetime NULL,  
  ALERTPERSONAL_FROM datetime NULL,  
  ALERTPERSONAL_TO datetime NULL,  
  CREATEDBY nvarchar(40) NULL,  
  CREATEDDT datetime NULL,  
  CREATEDDT_UTC datetime NULL,  
  ACTION_CODE varchar(2) NULL   
 )  
   
/*Check whether it is the full user list provide*/  
DECLARE @IsFullUserList AS CHAR(1) = ''  
  
SELECT @IsFullUserList = CTRLVAL FROM dbo.PO_DIMDATA WITH (NOLOCK) WHERE CtrlKey = 'IsFullUserList'   
  
IF @IsFullUserList = 'N' /*PARTIAL LIST*/  
BEGIN  
 ;WITH cte_WORKFLOW_MGMT_USERS AS (  
  SELECT A.QUEUEID, A.USERID, A.ROLE, A.BUFFER, A.HOLIDAYFROM, A.HOLIDAYTO, A.ALERTMAIN, A.ALERTPERSONAL,   
   A.ALERTMAIN_FROM, A.ALERTMAIN_TO, A.ALERTPERSONAL_FROM, A.ALERTPERSONAL_TO, A.IsAutomated  
  FROM dbo.WORKFLOW_MGMT_USERS A   
  WHERE EXISTS (SELECT 1 FROM dbo.WORKFLOW_MGMT_QUEUE B WHERE A.QUEUEID = B.QUEUEID AND B.IsAutomated = 'TRUE'  
    AND EXISTS (SELECT 1 FROM GCMAINDB.dbo.AutomatedEmployees C WHERE B.SRC = C.MODULE)))  
 MERGE cte_WORKFLOW_MGMT_USERS AS MergeTarget  
 USING dbo.WORKFLOW_MGMT_USERS_temp AS MergeSource  
 ON MergeTarget.QUEUEID = MergeSource.QUEUEID AND  
  MergeTarget.USERID = MergeSource.USERID AND  
  MergeTarget.ROLE = MergeSource.ROLE  
 WHEN NOT MATCHED BY TARGET THEN  
  INSERT ( QUEUEID ,  
      USERID ,  
      ROLE ,  
      ALERTMAIN ,  
      ALERTPERSONAL ,  
      IsAutomated  
    )  
  VALUES ( MergeSource.QUEUEID ,  
      MergeSource.USERID ,  
      MergeSource.ROLE ,  
      MergeSource.ALERTMAIN ,  
      MergeSource.ALERTPERSONAL,  
      'TRUE'  
    )  
 WHEN MATCHED AND ISNULL(MergeTarget.IsAutomated, 0) <> 'TRUE' THEN /*update IsAutomated = 1 if the user added screen and exists in ADDataImporter source*/  
  UPDATE SET MergeTarget.IsAutomated = 'TRUE'  
 WHEN NOT MATCHED BY SOURCE AND MergeTarget.IsAutomated = 'TRUE' THEN /*delete only user created through ADDataImporter*/  
  DELETE  
 OUTPUT   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[QUEUEID] ELSE INSERTED.[QUEUEID] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[USERID] ELSE INSERTED.[USERID] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ROLE] ELSE INSERTED.[ROLE] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[BUFFER] ELSE INSERTED.[BUFFER] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[HOLIDAYFROM] ELSE INSERTED.[HOLIDAYFROM] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[HOLIDAYTO] ELSE INSERTED.[HOLIDAYTO] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN] ELSE INSERTED.[ALERTMAIN] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL] ELSE INSERTED.[ALERTPERSONAL] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN_FROM] ELSE INSERTED.[ALERTMAIN_FROM] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN_TO] ELSE INSERTED.[ALERTMAIN_TO] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL_FROM] ELSE INSERTED.[ALERTPERSONAL_FROM] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL_TO] ELSE INSERTED.[ALERTPERSONAL_TO] END,  
  CASE WHEN $ACTION = 'DELETE' THEN '03' ELSE '01' END  
 INTO @TableWorkflowMgmtUsersHistory ([QUEUEID], [USERID], [ROLE],  
  [BUFFER], [HOLIDAYFROM], [HOLIDAYTO],  
  [ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],  
  [ALERTPERSONAL_FROM], [ALERTPERSONAL_TO], [ACTION_CODE]);   
END  
ELSE /*FULL LIST*/  
BEGIN  
 ;WITH cte_WORKFLOW_MGMT_USERS AS (  
  SELECT A.QUEUEID, A.USERID, A.ROLE, A.BUFFER, A.HOLIDAYFROM, A.HOLIDAYTO, A.ALERTMAIN, A.ALERTPERSONAL,   
   A.ALERTMAIN_FROM, A.ALERTMAIN_TO, A.ALERTPERSONAL_FROM, A.ALERTPERSONAL_TO, A.IsAutomated  
  FROM dbo.WORKFLOW_MGMT_USERS A   
 )  
 MERGE cte_WORKFLOW_MGMT_USERS AS MergeTarget  
 USING dbo.WORKFLOW_MGMT_USERS_temp AS MergeSource  
 ON MergeTarget.QUEUEID = MergeSource.QUEUEID AND  
  MergeTarget.USERID = MergeSource.USERID AND  
  MergeTarget.ROLE = MergeSource.ROLE  
 WHEN NOT MATCHED BY TARGET THEN  
  INSERT ( QUEUEID ,  
      USERID ,  
      ROLE ,  
      ALERTMAIN ,  
      ALERTPERSONAL ,  
      IsAutomated  
    )  
  VALUES ( MergeSource.QUEUEID ,  
      MergeSource.USERID ,  
      MergeSource.ROLE ,  
      MergeSource.ALERTMAIN ,  
      MergeSource.ALERTPERSONAL,  
      'TRUE'  
    )  
 WHEN MATCHED AND ISNULL(MergeTarget.IsAutomated, 0) <> 'TRUE' THEN /*update IsAutomated = 1 if the user added screen and exists in ADDataImporter source*/  
  UPDATE SET MergeTarget.IsAutomated = 'TRUE'  
 WHEN NOT MATCHED BY SOURCE AND MergeTarget.IsAutomated = 'TRUE' THEN /*delete only user created through ADDataImporter*/  
  DELETE  
 OUTPUT  
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[QUEUEID] ELSE INSERTED.[QUEUEID] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[USERID] ELSE INSERTED.[USERID] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ROLE] ELSE INSERTED.[ROLE] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[BUFFER] ELSE INSERTED.[BUFFER] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[HOLIDAYFROM] ELSE INSERTED.[HOLIDAYFROM] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[HOLIDAYTO] ELSE INSERTED.[HOLIDAYTO] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN] ELSE INSERTED.[ALERTMAIN] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL] ELSE INSERTED.[ALERTPERSONAL] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN_FROM] ELSE INSERTED.[ALERTMAIN_FROM] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN_TO] ELSE INSERTED.[ALERTMAIN_TO] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL_FROM] ELSE INSERTED.[ALERTPERSONAL_FROM] END,   
  CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL_TO] ELSE INSERTED.[ALERTPERSONAL_TO] END,  
  CASE WHEN $ACTION = 'DELETE' THEN '03' ELSE '01' END  
 INTO @TableWorkflowMgmtUsersHistory ([QUEUEID], [USERID], [ROLE],  
  [BUFFER], [HOLIDAYFROM], [HOLIDAYTO],  
  [ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],  
  [ALERTPERSONAL_FROM], [ALERTPERSONAL_TO], [ACTION_CODE]);  
END  
  
BEGIN  
 /*insert deleted users into WORKFLOW_MGMT_USERS_HISTORY*/  
 INSERT INTO dbo.WORKFLOW_MGMT_USERS_HISTORY ([QUEUEID], [USERID], [ROLE],  
  [BUFFER], [HOLIDAYFROM], [HOLIDAYTO],  
  [ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],  
  [ALERTPERSONAL_FROM], [ALERTPERSONAL_TO])  
 SELECT [QUEUEID], [USERID], [ROLE],  
  [BUFFER], [HOLIDAYFROM], [HOLIDAYTO],  
  [ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],  
  [ALERTPERSONAL_FROM], [ALERTPERSONAL_TO]   
 FROM @TableWorkflowMgmtUsersHistory  
 --WHERE ACTION_CODE = '03'  
   
 INSERT INTO dbo.WORKFLOW_AutomatedDeletedUsers_temp (QueueId, UserId)  
 SELECT QUEUEID, USERID  
 FROM @TableWorkflowMgmtUsersHistory  
 WHERE ACTION_CODE = '03'  
   
 /*Clear Queue Access for deleted user*/  
 DELETE A FROM dbo.WORKFLOW_MGMT_QUEUEACCESS A   
 WHERE EXISTS(SELECT 1 FROM dbo.WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.USERID = B.UserId AND A.QUEUEID = B.QueueId)   
   
 /*Grant permission for new BankAdmin for all workflow Queue*/  
 INSERT INTO dbo.WORKFLOW_MGMT_QUEUEACCESS ( QUEUEID, USERID )  
 SELECT B.QUEUEID, A.cn FROM GCMAINDB.dbo.CTCBBankAdmins A, dbo.WORKFLOW_MGMT_QUEUE B   
 WHERE A.IsNew = 1 AND NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_QUEUEACCESS C WHERE C.QUEUEID = B.QUEUEID AND C.USERID = A.cn)  
    
 /*****************RESET CASE****************************/  
   
 ------------------Start SWIFT -----------------  
 INSERT INTO dbo.SWIFT_MT_LOG ( MT_KEY, [ACTION], [ROLE], [STATUS], HANDLEDBY, QUEUEID, DESCR, LSTUPD_DATE, LSTUPD_USERID,   
        LSTUPD_USERROLE, LSTUPD_DATE_UTC )  
 SELECT A.MT_KEY, 11, 1, 1, NULL, A.QueueID, null, @BankLocalTime, @SystemuserID,   
   NULL, @UtcNow  
 from dbo.SWIFT_MTHEADER_MAIN A JOIN dbo.WORKFLOW_AutomatedDeletedUsers_temp B   
  ON A.HandledBy = B.UserId AND A.QueueID = B.QueueId WHERE A.[Status] <> '3'  
   
 INSERT INTO dbo.SWIFT_RemarkLog ( MT_KEY, Role, HandledBy, Action, Remark, CreatedBy, Created_Date, UpdatedBy,  
  Updated_Date, Created_Date_UTC,Updated_Date_UTC )  
 SELECT MT_KEY, 1, NULL, 11, Remark, NULL , Created_Date, @SystemuserID,   
  @BankLocalTime, Created_Date_UTC, @UtcNow   
 FROM dbo.SWIFT_MTHEADER_MAIN A JOIN dbo.WORKFLOW_AutomatedDeletedUsers_temp B   
  ON A.HandledBy = B.UserId AND A.QueueID = B.QueueId WHERE A.[Status] <> '3'  
    
 UPDATE A   
 SET A.HandledBy = NULL, A.[Status] = '1', A.[ROLE] = 1, A.[ACTION] = 11,  
  A.ReleaseBy = NULL,A.ReleaseDate = NULL, A.ReleaseBy_2 = NULL, A.ReleaseDate_2 = NULL, A.ReleaseBy_3 = NULL,  
  A.ReleaseDate_3 = NULL, A.ReleaseBy_4 = NULL, A.ReleaseDate_4 = NULL, A.RejectBy = NULL, A.RejectDate = NULL, A.RejectBy_2 = NULL,  
  A.RejectDate_2 = NULL, A.RejectBy_3 = NULL, A.RejectDate_3 = NULL, A.RejectBy_4 = NULL, A.RejectDate_4 = NULL,  
  A.Last_Upd_Date = @BankLocalTime, A.Last_Upd_Date_UTC = @UtcNow, A.Last_Upd_UserId = @SystemuserID  
 OUTPUT INSERTED.MT_KEY, INSERTED.CLIENT_MSG_TYPE_CODE,INSERTED.BNK_NBR, INSERTED.ApplicationID, INSERTED.ServiceID,INSERTED .BankCode, INSERTED.CountryCode, INSERTED.LocationCode,  
  INSERTED.LogicalTerminalCode, INSERTED.BranchCode,INSERTED.SessionNumber, INSERTED.SequenceNumber,INSERTED.IO_Identifier, INSERTED.MessageType,INSERTED.ReceiverAddress, INSERTED.MessagePriority,  
  INSERTED.DeliveryMonitoring,INSERTED.ObsolescencePeriod, INSERTED.InputTime, INSERTED.MIR,INSERTED.FORMAT, INSERTED.DIRECTION, INSERTED.OutputDate, INSERTED.OutputTime, INSERTED.Created_Date, INSERTED.Created_UserId,   
  INSERTED.Last_Upd_Date,INSERTED.Last_Upd_UserId, INSERTED.HandledBy, INSERTED.Status, INSERTED.Action, INSERTED.Role, INSERTED.QueueID, INSERTED.EmailID,INSERTED.LastEmailDate, INSERTED.Detected, INSERTED.HoldBy,INSERTED.AssignBy, INSERTED.AssignDate, 
INSERTED.ReleaseBy,  
  INSERTED.ReleaseDate, INSERTED.ReleaseBy_2,INSERTED.ReleaseDate_2, INSERTED.ReleaseBy_3,INSERTED.ReleaseDate_3, INSERTED.ReleaseBy_4,INSERTED.ReleaseDate_4, INSERTED.RejectBy, INSERTED.RejectDate, INSERTED.RejectBy_2,   
  INSERTED.RejectDate_2,INSERTED.RejectBy_3, INSERTED.RejectDate_3, INSERTED.RejectBy_4, INSERTED.RejectDate_4, INSERTED.Msg_sender_id, INSERTED.Msg_receiver_id, INSERTED.EmailID_ThirdParty,  
  INSERTED.LastEmailDate_ThirdParty,INSERTED.Receiver_BankCode,INSERTED.Receiver_CountryCode, INSERTED.Receiver_LocationCode, INSERTED.Receiver_BranchCode, @BankLocalTime,  
  @SystemuserID, INSERTED.Block4_UserReference,INSERTED.Block4_Amt, INSERTED.Block4_Beneficiary,INSERTED.Remark, INSERTED.LstUpdate_Remark,INSERTED.LstUpdate_Date, INSERTED.SourceID,  
  INSERTED.ClientReferenceNo, INSERTED.BranchNo,INSERTED.Channel, INSERTED.DNSLFlag, INSERTED.TYPE,INSERTED.Created_Date_UTC, INSERTED.Last_Upd_Date_UTC, INSERTED.LastEmailDate_UTC, INSERTED.AssignDate_UTC,  
  INSERTED.ReleaseDate_UTC, INSERTED.ReleaseDate_2_UTC,INSERTED.ReleaseDate_3_UTC, INSERTED.ReleaseDate_4_UTC, INSERTED.RejectDate_UTC,INSERTED.RejectDate_2_UTC, INSERTED.RejectDate_3_UTC,  
  INSERTED.RejectDate_4_UTC,INSERTED.LastEmailDate_ThirdParty_UTC,@UtcNow, INSERTED.LstUpdate_Date_UTC   
 INTO dbo.SWIFT_MTHeader_Main_Log ( MT_KEY, CLIENT_MSG_TYPE_CODE,BNK_NBR, ApplicationID, ServiceID,BankCode, CountryCode, LocationCode,  
  LogicalTerminalCode, BranchCode,SessionNumber, SequenceNumber,IO_Identifier, MessageType,ReceiverAddress, MessagePriority,  
  DeliveryMonitoring,ObsolescencePeriod, InputTime, MIR,FORMAT, DIRECTION, OutputDate, OutputTime, Created_Date, Created_UserId,   
  Last_Upd_Date,Last_Upd_UserId, HandledBy, Status, Action, Role, QueueID, EmailID,LastEmailDate, Detected, HoldBy,AssignBy, AssignDate, ReleaseBy,  
  ReleaseDate, ReleaseBy_2,ReleaseDate_2, ReleaseBy_3,ReleaseDate_3, ReleaseBy_4,ReleaseDate_4, RejectBy, RejectDate, RejectBy_2,   
  RejectDate_2,RejectBy_3, RejectDate_3, RejectBy_4, RejectDate_4, Msg_sender_id, Msg_receiver_id, EmailID_ThirdParty,  
  LastEmailDate_ThirdParty,Receiver_BankCode,Receiver_CountryCode, Receiver_LocationCode, Receiver_BranchCode, ActionDate,  
  Action_UserID, Block4_UserReference,Block4_Amt, Block4_Beneficiary,Remark, LstUpdate_Remark,LstUpdate_Date, SourceID,  
  ClientReferenceNo, BranchNo,Channel, DNSLFlag, TYPE,Created_Date_UTC, Last_Upd_Date_UTC, LastEmailDate_UTC, AssignDate_UTC,  
  ReleaseDate_UTC, ReleaseDate_2_UTC,ReleaseDate_3_UTC, ReleaseDate_4_UTC, RejectDate_UTC,RejectDate_2_UTC, RejectDate_3_UTC,  
  RejectDate_4_UTC,LastEmailDate_ThirdParty_UTC,ActionDate_UTC, LstUpdate_Date_UTC )  
 FROM dbo.SWIFT_MTHEADER_MAIN A JOIN dbo.WORKFLOW_AutomatedDeletedUsers_temp B   
  ON A.HandledBy = B.UserId AND A.QueueID = B.QueueId  
 WHERE A.[Status] <> '3'  
   
 UPDATE A   
 SET A.QueueID = NULL, A.HandledBy = NULL, A.[Status] = '1', A.[ROLE] = 1, A.[ACTION] = 11,  
  A.ReleaseBy = NULL,A.ReleaseDate = NULL, A.ReleaseBy_2 = NULL, A.ReleaseDate_2 = NULL, A.ReleaseBy_3 = NULL,  
  A.ReleaseDate_3 = NULL, A.ReleaseBy_4 = NULL, A.ReleaseDate_4 = NULL, A.RejectBy = NULL, A.RejectDate = NULL, A.RejectBy_2 = NULL,  
  A.RejectDate_2 = NULL, A.RejectBy_3 = NULL, A.RejectDate_3 = NULL, A.RejectBy_4 = NULL, A.RejectDate_4 = NULL,  
  A.Last_Upd_Date = @BankLocalTime, A.Last_Upd_Date_UTC = @UtcNow, A.Last_Upd_UserId = @SystemuserID  
 OUTPUT INSERTED.MT_KEY, INSERTED.CLIENT_MSG_TYPE_CODE,INSERTED.BNK_NBR, INSERTED.ApplicationID, INSERTED.ServiceID,INSERTED .BankCode, INSERTED.CountryCode, INSERTED.LocationCode,  
  INSERTED.LogicalTerminalCode, INSERTED.BranchCode,INSERTED.SessionNumber, INSERTED.SequenceNumber,INSERTED.IO_Identifier, INSERTED.MessageType,INSERTED.ReceiverAddress, INSERTED.MessagePriority,  
  INSERTED.DeliveryMonitoring,INSERTED.ObsolescencePeriod, INSERTED.InputTime, INSERTED.MIR,INSERTED.FORMAT, INSERTED.DIRECTION, INSERTED.OutputDate, INSERTED.OutputTime, INSERTED.Created_Date, INSERTED.Created_UserId,   
  INSERTED.Last_Upd_Date,INSERTED.Last_Upd_UserId, INSERTED.HandledBy, INSERTED.Status, INSERTED.Action, INSERTED.Role, INSERTED.QueueID, INSERTED.EmailID,INSERTED.LastEmailDate, INSERTED.Detected, INSERTED.HoldBy,INSERTED.AssignBy, INSERTED.AssignDate, I
NSERTED.ReleaseBy,  
  INSERTED.ReleaseDate, INSERTED.ReleaseBy_2,INSERTED.ReleaseDate_2, INSERTED.ReleaseBy_3,INSERTED.ReleaseDate_3, INSERTED.ReleaseBy_4,INSERTED.ReleaseDate_4, INSERTED.RejectBy, INSERTED.RejectDate, INSERTED.RejectBy_2,   
  INSERTED.RejectDate_2,INSERTED.RejectBy_3, INSERTED.RejectDate_3, INSERTED.RejectBy_4, INSERTED.RejectDate_4, INSERTED.Msg_sender_id, INSERTED.Msg_receiver_id, INSERTED.EmailID_ThirdParty,  
  INSERTED.LastEmailDate_ThirdParty,INSERTED.Receiver_BankCode,INSERTED.Receiver_CountryCode, INSERTED.Receiver_LocationCode, INSERTED.Receiver_BranchCode, @BankLocalTime,  
  @SystemuserID, INSERTED.Block4_UserReference,INSERTED.Block4_Amt, INSERTED.Block4_Beneficiary,INSERTED.Remark, INSERTED.LstUpdate_Remark,INSERTED.LstUpdate_Date, INSERTED.SourceID,  
  INSERTED.ClientReferenceNo, INSERTED.BranchNo,INSERTED.Channel, INSERTED.DNSLFlag, INSERTED.TYPE,INSERTED.Created_Date_UTC, INSERTED.Last_Upd_Date_UTC, INSERTED.LastEmailDate_UTC, INSERTED.AssignDate_UTC,  
  INSERTED.ReleaseDate_UTC, INSERTED.ReleaseDate_2_UTC,INSERTED.ReleaseDate_3_UTC, INSERTED.ReleaseDate_4_UTC, INSERTED.RejectDate_UTC,INSERTED.RejectDate_2_UTC, INSERTED.RejectDate_3_UTC,  
  INSERTED.RejectDate_4_UTC,INSERTED.LastEmailDate_ThirdParty_UTC,@UtcNow, INSERTED.LstUpdate_Date_UTC   
 INTO dbo.SWIFT_MTHeader_Main_Log ( MT_KEY, CLIENT_MSG_TYPE_CODE,BNK_NBR, ApplicationID, ServiceID,BankCode, CountryCode, LocationCode,  
  LogicalTerminalCode, BranchCode,SessionNumber, SequenceNumber,IO_Identifier, MessageType,ReceiverAddress, MessagePriority,  
  DeliveryMonitoring,ObsolescencePeriod, InputTime, MIR,FORMAT, DIRECTION, OutputDate, OutputTime, Created_Date, Created_UserId,   
  Last_Upd_Date,Last_Upd_UserId, HandledBy, Status, Action, Role, QueueID, EmailID,LastEmailDate, Detected, HoldBy,AssignBy, AssignDate, ReleaseBy,  
  ReleaseDate, ReleaseBy_2,ReleaseDate_2, ReleaseBy_3,ReleaseDate_3, ReleaseBy_4,ReleaseDate_4, RejectBy, RejectDate, RejectBy_2,   
  RejectDate_2,RejectBy_3, RejectDate_3, RejectBy_4, RejectDate_4, Msg_sender_id, Msg_receiver_id, EmailID_ThirdParty,  
  LastEmailDate_ThirdParty,Receiver_BankCode,Receiver_CountryCode, Receiver_LocationCode, Receiver_BranchCode, ActionDate,  
  Action_UserID, Block4_UserReference,Block4_Amt, Block4_Beneficiary,Remark, LstUpdate_Remark,LstUpdate_Date, SourceID,  
  ClientReferenceNo, BranchNo,Channel, DNSLFlag, TYPE,Created_Date_UTC, Last_Upd_Date_UTC, LastEmailDate_UTC, AssignDate_UTC,  
