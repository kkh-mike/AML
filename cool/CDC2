-- 查最新的 20 筆資料
SELECT TOP 20
    ent_num,
    spec_name          AS IdentificationNumber,
    remark             AS EntNum,
    ADDRESS            AS FullAddress,
    -- 反解出 IdentificationType
    REPLACE(ADDRESS, '; Please go to Dowjones website for more detail', '') AS IdentificationType,
    updated_date,
    DInd,              -- N: 有效, Y: 已停用/軟刪除
    EnterFlag,
    ApprovedBy,
    DelDate,
    creDate
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10
ORDER BY creDate DESC;
