ALTER PROCEDURE [dbo].[SWIFT_InsertRawMessage]
	@BankNo NVARCHAR(10),
	@BranchNo NVARCHAR(30),
	@Message NVARCHAR(MAX),
	@ClientReferenceNo NVARCHAR(40),
	@ClientMessageTypeCode NVARCHAR(30),
	@SourceID NVARCHAR(30),
	@Channel NVARCHAR(30),
	@ID UNIQUEIDENTIFIER OUTPUT,
	@CreatedDate DATETIME2(7) OUTPUT,
	@CreatedDateUTC DATETIME2(7) OUTPUT,
	@POBankNo NVARCHAR(10) OUTPUT,
	@IsMaintenance BIT OUTPUT
AS
BEGIN
	SET NOCOUNT ON;
	SET @ID = NULL;
	/*Bank local time*/
	SET @CreatedDate = NULL;
	SET @CreatedDateUTC = NULL;
	SET @POBankNo = NULL;
	SET @IsMaintenance = 'FALSE';
	
	DECLARE @STARTTIME TIME = NULL;
	DECLARE @ENDTIME TIME = NULL;
	DECLARE @CURRENTTIME TIME = GETDATE();
	DECLARE @TimeZoneId NVARCHAR(50) = NULL;
	DECLARE @HourOffset int = 0;
	DECLARE @MinuteOffset int = 0;
	DECLARE @SecondOffset int = 0;
	
	SELECT @POBankNo = POBankNo, @STARTTIME = MaintenanceStartTime, 
	@ENDTIME = MaintenanceEndTime, @TimeZoneId = TimeZoneName
	FROM dbo.BankNoMappings WITH(NOLOCK)
	WHERE ClientBankNo = @BankNo
	
	--workaround for start time and end time cross day
	SET @HourOffset = DATEPART(hour, @STARTTIME);
	SET @MinuteOffset = DATEPART(minute, @STARTTIME);
	SET @SecondOffset = DATEPART(second, @STARTTIME);
	SET @STARTTIME = DATEADD(second, -@Secondoffset, (DATEADD(minute, -@Minuteoffset, (DATEADD(hour, -@Houroffset, @STARTTIME)))));
	SET @ENDTIME = DATEADD(second, -@Secondoffset, (DATEADD(minute, -@Minuteoffset, (DATEADD(hour, -@Houroffset, @ENDTIME)))));
	SET @CURRENTTIME = DATEADD(second, -@Secondoffset, (DATEADD(minute, -@Minuteoffset, (DATEADD(hour, -@Houroffset, @CURRENTTIME)))));
	
	/*
		Check for maintenance period. Proceed if now 
		is not under maintenance perioud
	*/
	IF @STARTTIME IS NOT NULL AND 
		@ENDTIME IS NOT NULL AND
		@CURRENTTIME BETWEEN @STARTTIME AND @ENDTIME
	BEGIN
		SET @IsMaintenance = 'TRUE';
	END
	
	IF @IsMaintenance = 'FALSE'
	BEGIN
	
		/*
			Temporary table to store the inserted ID and created date
		*/
		DECLARE @TEMP TABLE ( 
			ID UNIQUEIDENTIFIER, 
			CreatedDate DATETIME2(7) 
		);
		
		/*
			@POBankNo should not be null. Exception will occur if the 
			@POBankNo is null. This will happened when XB is sending a message
			with unknown bank no in BankNoMappings table.
		*/
		
		DECLARE @NOW DATETIME = GETUTCDATE();
		DECLARE @BankLocalTime DATETIME = NULL;
		
		/*
			@TimeZoneId IS NULL when @BankNo does not found in dbo.BankNoMappings table
		*/
		IF @TimeZoneId IS NOT NULL
			SELECT @BankLocalTime = dbo.ConvertTimeFromUtc(@NOW, @TimeZoneId)
		
		IF NOT EXISTS(SELECT NULL FROM [dbo].[SWIFT_MTRAW]
		WHERE [ClientReferenceNo] = @ClientReferenceNo AND [Progress] <> 'CANCELED')
		BEGIN
			INSERT INTO dbo.[SWIFT_MTRAW] (BankNo, BranchNo, RawMessage, ClientReferenceNo, 
				ClientMessageTypeCode, SourceID, Channel, Progress, CreatedDate) 
			OUTPUT INSERTED.ID, INSERTED.CreatedDate 
			INTO @TEMP(ID, [CreatedDate])
			VALUES (@POBankNo, @BranchNo, @Message, @ClientReferenceNo, 
				@ClientMessageTypeCode, @SourceID, @Channel, 'NEW', @NOW)
			
			SELECT TOP 1 
				@ID = ID, 
				@CreatedDate = @BankLocalTime, 
				@CreatedDateUTC = CreatedDate
			FROM @TEMP

			/*
				Insert the new SWIFT message into SWIFT Parser Queue.
			*/
			IF	@ID IS NOT NULL
			BEGIN
				IF NOT EXISTS(SELECT NULL FROM dbo.[SwiftParserModelQueue] WITH (NOLOCK) WHERE RawID = @ID)
				BEGIN
					INSERT INTO dbo.[SwiftParserModelQueue] (RawID) VALUES (@ID)
				END
			END
			
		END
	END
END






