
	-- 2. 撈出 4 種測試情境的名單
-- 【情境 A：全新新增 (Insert)】來源有，但 Target (OFAC_GLSpec) 完全沒有
SELECT TOP 3 'Case A: Insert (全新)' AS TestCase, S.*
FROM #SrcList S
LEFT JOIN BSADB.dbo.OFAC_GLSpec T
  ON T.GROUPID = 10
 AND T.spec_name = S.IdentificationNumber
 AND T.remark = CAST(S.EntNum AS VARCHAR(100))
 AND T.ADDRESS = S.TargetAddress
WHERE T.spec_name IS NULL;


