$smtpServer = "10.13.113.110"               # 測試環境專用發信主機
$smtpPort   = 25
$sender     = "AML@tsbtmail.com"            # 專案指定寄件者
$recipient  = "1141923@taishinbank.com.tw"  # 你的收件信箱

$mail = New-Object System.Net.Mail.MailMessage($sender, $recipient)
$mail.Subject = "【連線成功】AMLIS1 系統監控發信測試"
$mail.Body = "透過 10.13.113.110 與 AML@tsbtmail.com 測試寄信成功！"

$smtp = New-Object System.Net.Mail.SmtpClient($smtpServer, $smtpPort)
$smtp.Timeout = 10000

try {
    Write-Host "正在透過 $smtpServer 寄送測試信..." -ForegroundColor Cyan
    $smtp.Send($mail)
    Write-Host "✅ 測試信已成功寄出！請至 Outlook 確認信件。" -ForegroundColor Green
} catch {
    Write-Host "❌ 寄信失敗: $($_.Exception.Message)" -ForegroundColor Red
} finally {
    $mail.Dispose()
    $smtp.Dispose()
}


