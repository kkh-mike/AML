-- 1. 總覽：看有效筆數 (N) 與已刪除筆數 (Y)
SELECT 
    DInd,
    COUNT(1) AS TotalCount,
    MIN(creDate) AS Earliest_CreateDate,
    MAX(updated_date) AS Latest_UpdatedDate
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10
GROUP BY DInd;

-- 2. 明細：隨機抓 10 筆目前有效 (DInd = 'N') 的資料結構與欄位內容
SELECT TOP 10
    ent_num,
    spec_name          AS IdentificationNumber,
    remark             AS EntNum,
    ADDRESS            AS StoredAddress,
    REPLACE(ADDRESS, '; Please go to Dowjones website for more detail', '') AS IdentificationType,
    updated_date,
    DInd,
    EnterFlag,
    SOURCE,
    creUserID,
    creDate
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10
  AND DInd = 'N'
ORDER BY creDate DESC;
