-- 1. 客戶擴充資訊表
DELETE A FROM BSA_SUB_CUST_FACT_Extension A 
JOIN CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
WHERE B.ACTION = 'INSERT'

-- 2. 客戶問卷/自訂答案表 (注意欄位為 CIFKEY)
DELETE A FROM PB_CustomerOptionalAnswers A 
JOIN CIF_Migrate_Mapping_TEMP B ON A.CIFKEY = B.NEW_CIF_KEY
WHERE B.ACTION = 'INSERT'

-- 3. EDD 審查排程表 (注意欄位為 CIFKey)
DELETE A FROM EDD_ReviewSchedule A 
JOIN CIF_Migrate_Mapping_TEMP B ON A.CIFKEY = B.NEW_CIF_KEY
WHERE B.ACTION = 'INSERT'


