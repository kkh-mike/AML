-- 1. 帳戶擴充表資料
DELETE A FROM ACCT_XREF_DIM A 
JOIN CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
WHERE B.ACTION = 'INSERT'

-- 2. 帳戶維度表資料
DELETE A FROM ACCT_XREF_EXT A 
JOIN CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
WHERE B.ACTION = 'INSERT'


