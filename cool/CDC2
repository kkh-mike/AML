 FROM dbo.SWIFT_MTHEADER_MAIN A JOIN dbo.WORKFLOW_MGMT_QUEUE B  
  ON A.QueueID = B.QueueID   
 WHERE A.[Status] <> '3' AND B.DEL_FLAG = 'Y' AND B.SRC = 'SWIFT'  
 ------------------End SWIFT -----------------  
   
 -----------------Start FLRS-----------------  
 INSERT INTO dbo.FLRS_LOG ( FLRS_KEY, ACTION, ROLE, STATUS, HANDLEDBY, QUEUEID, DESCR, LSTUPD_DATE, LSTUPD_USERID, LSTUPD_USERROLE,  
                             LSTUPD_DATE_UTC )  
