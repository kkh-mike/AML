ALTER PROCEDURE [dbo].[usp_Rollback_TRXN_Module]
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    BEGIN TRY
        BEGIN TRANSACTION;

        -- ==========================================
        -- 1. 清理交易明細事實表 (*_TXN_FACT / *_FACT)
        -- ==========================================
        IF OBJECT_ID('dbo.WIRE_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.WIRE_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CTS_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CTS_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ACH_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.ACH_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CASHIERCHK_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CASHIERCHK_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CHK_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CHK_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.OTHER_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.OTHER_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.TRSF_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.TRSF_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CCARD_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CCARD_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.DCARD_TXN_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.DCARD_TXN_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 2. 清理帳戶月彙總表 (*_MTHLY_ACCT_SMRY)
        -- ==========================================
        IF OBJECT_ID('dbo.WIRE_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.WIRE_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.TTL_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.TTL_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CTS_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.CTS_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ACH_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.ACH_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.MOI_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.MOI_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CHK_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.CHK_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ATM_CSH_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.ATM_CSH_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ATM_NCSH_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.ATM_NCSH_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.OTHER_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.OTHER_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.TRSF_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.TRSF_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CCD_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.CCD_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.DCD_MTHLY_ACCT_SMRY', 'U') IS NOT NULL
            DELETE A FROM dbo.DCD_MTHLY_ACCT_SMRY A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 3. 清理客戶月彙總表 (*_MTHLY_FACT)
        -- ==========================================
        IF OBJECT_ID('dbo.WIRE_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.WIRE_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.TTL_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.TTL_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CTS_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CTS_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ACH_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.ACH_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.MOI_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.MOI_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CHK_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CHK_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ATM_CSH_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.ATM_CSH_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.ATM_NCSH_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.ATM_NCSH_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.OTHER_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.OTHER_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.TRSF_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.TRSF_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.CCD_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.CCD_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';

        IF OBJECT_ID('dbo.DCD_MTHLY_FACT', 'U') IS NOT NULL
            DELETE A FROM dbo.DCD_MTHLY_FACT A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- 記錄 Rollback 成功日誌
        IF OBJECT_ID('dbo.Migrator_LOG', 'U') IS NOT NULL
            INSERT INTO dbo.Migrator_LOG (PROC_DATE, MSG_LOG, FLAG)
            SELECT GETDATE(), 'TRXN module rollback completed -------> ', 'N';

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        -- 記錄 Rollback 失敗日誌並拋出錯誤
        IF OBJECT_ID('dbo.Migrator_LOG', 'U') IS NOT NULL
            INSERT INTO dbo.Migrator_LOG (PROC_DATE, MSG_LOG, FLAG)
            SELECT GETDATE(), 'TRXN module rollback FAILED: ' + ERROR_MESSAGE(), 'Y';

        THROW;
    END CATCH;
END
GO
