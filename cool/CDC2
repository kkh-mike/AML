   NULL, @UtcNow  
 FROM dbo.FLRS_HEADER_MAIN A JOIN dbo.WORKFLOW_AutomatedDeletedUsers_temp B   
  ON A.HandledBy = B.UserId AND A.QueueID = B.QueueId  
 WHERE A.[Status] <> '3'  
   
