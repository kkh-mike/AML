-- 1. 檢查寫入總筆數與狀態（預期全為 DInd = 'N'）
SELECT 
    DInd, 
    COUNT(1) AS TotalCount, 
    MIN(creDate) AS Min_CreDate, 
    MAX(creDate) AS Max_CreDate
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10
GROUP BY DInd;

-- 2. 檢查 Log 表是否全數正確寫入 ActionCD = '01' (新增)
SELECT 
    ActionCD, 
    COUNT(1) AS LogCount
FROM BSADB.dbo.OFAC_GLSpec_Log
WHERE GROUPID = 10
GROUP BY ActionCD;
