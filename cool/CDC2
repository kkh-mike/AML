這裡為你提供針對 TC-SAN-01 ～ TC-SAN-04 的測試 SQL 腳本（包含測試前造資料/檢查 Before、執行同步 SP，以及執行後驗證 After）：
TC-SAN-01：全新新增 (INSERT)
-- 【Before 準備與檢查】
-- 1. 確保來源端有符合條件資料 (例: EntityId = 990001)
-- 2. 確保目標表完全無該資料
DELETE FROM BSADB.dbo.OFAC_GLSpec 
WHERE GROUPID = 10 AND remark = '990001';

-- 3. 檢查來源端具備 Active、制裁清單、19類證件且 Deleted = 0
SELECT A.EntityId, A.PersonStatus, B.Description2, D.IdentificationType, D.IdentificationNumber, C.UpdatedDate
FROM BSADB.dbo.DJ_Entity A
JOIN BSADB.dbo.DJ_ListCategory B ON A.EntityId = B.EntityId
JOIN BSADB.dbo.DJ_List_Data_A C ON A.EntityId = C.EntNum
JOIN BSADB.dbo.DJ_IdentificationTypeInfo D ON A.EntityId = D.EntityId
WHERE A.EntityId = 990001 AND A.PersonStatus <> 'Inactive' AND B.Deleted = 0 AND D.Deleted = 0;

-- 【Action: 執行同步作業】
-- EXEC dbo.Your_Sync_StoredProcedure;

-- 【After 結果驗證】
SELECT 
    spec_name       AS [預期=證號],
    remark          AS [預期='990001'],
    GROUPID         AS [預期=10],
    DInd            AS [預期='N'],
    SOURCE          AS [預期='Sanctions IDs'],
    ADDRESS         AS [預期=證件類型+說明後綴],
    updated_date    AS [預期=來源端最新UpdatedDate]
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10 AND remark = '990001';

TC-SAN-02：重新上架 (UPDATE - DInd = 'Y')
-- 【Before 準備與檢查】
-- 1. 手動將目標表該筆資料壓成下架狀態 (DInd = 'Y')
UPDATE BSADB.dbo.OFAC_GLSpec
SET DInd = 'Y', DelDate = GETDATE()
WHERE GROUPID = 10 AND remark = '990001';

-- 2. 確認目標表當前為 DInd = 'Y'
SELECT remark, spec_name, DInd, updated_date 
FROM BSADB.dbo.OFAC_GLSpec 
WHERE GROUPID = 10 AND remark = '990001';

-- 【Action: 執行同步作業】
-- EXEC dbo.Your_Sync_StoredProcedure;

-- 【After 結果驗證】
SELECT 
    remark,
    spec_name,
    DInd            AS [預期='N' (還原上架)],
    DelUserID       AS [預期=NULL],
    DelDate         AS [預期=NULL],
    updated_date    AS [預期=更新為來源最新日期]
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10 AND remark = '990001';

TC-SAN-03：日期更新 (UPDATE - Date)
-- 【Before 準備與檢查】
-- 1. 目標表存在有效資料 (DInd = 'N')，但 updated_date 設為較舊日期
UPDATE BSADB.dbo.OFAC_GLSpec
SET DInd = 'N', updated_date = '20000101'
WHERE GROUPID = 10 AND remark = '990001';

-- 2. 檢查來源端最新日期大於目標表
SELECT A.EntityId, MAX(C.UpdatedDate) AS Source_UpdatedDate, '20000101' AS Target_UpdatedDate
FROM BSADB.dbo.DJ_Entity A
JOIN BSADB.dbo.DJ_List_Data_A C ON A.EntityId = C.EntNum
WHERE A.EntityId = 990001
GROUP BY A.EntityId;

-- 【Action: 執行同步作業】
-- EXEC dbo.Your_Sync_StoredProcedure;

-- 【After 結果驗證】
SELECT 
    remark,
    spec_name,
    updated_date    AS [預期=已被更新為來源最新日期(非20000101)],
    DInd            AS [預期='N']
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10 AND remark = '990001';

TC-SAN-04：反向驗證 (不符合條件不寫入)
-- 【Before: 挑選/模擬各項不符條件的測試 EntityId】
-- 990002: Inactive 人員
-- 990003: 非制裁清單 (例如 PEP)
-- 990004: 證件非 19 類 (例如 Local Tax ID)
-- 990005: 來源證件已刪除 (Deleted = 1)
DELETE FROM BSADB.dbo.OFAC_GLSpec 
WHERE GROUPID = 10 AND remark IN ('990002', '990003', '990004', '990005');

-- 【Action: 執行同步作業】
-- EXEC dbo.Your_Sync_StoredProcedure;

-- 【After 結果驗證】
-- 預期筆數必須為 0 (完全查不到任何一筆)
SELECT 
    remark AS [不應存在的EntityId], 
    spec_name, 
    GROUPID 
FROM BSADB.dbo.OFAC_GLSpec
WHERE GROUPID = 10 
  AND remark IN ('990002', '990003', '990004', '990005');

