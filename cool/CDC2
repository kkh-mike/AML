GO
SET QUOTED_IDENTIFIER ON
GO

ALTER PROCEDURE [dbo].[usp_Rollback_RP_NP_Module]
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    BEGIN TRY
        BEGIN TRANSACTION;

        -- ==========================================
        -- 1. 清理委任人 (Appointer)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_Appointer_Fact', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_Appointer_Fact A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 2. 清理董監事 (Board of Director)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_BoardOfDirector_Fact', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_BoardOfDirector_Fact A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 3. 清理法定代理人 (Legal Agent)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_LegalAgent_Fact', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_LegalAgent_Fact A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 4. 清理主要客戶 (Main Client)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_MainClient_Fact', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_MainClient_Fact A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 5. 清理主要股東 (Main Shareholder)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_MainShareHolder_Fact', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_MainShareHolder_Fact A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 6. 清理其他實質受益人子類別代碼 (建議先刪子表)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_OtherRelatedParty_SubTypeCodes', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_OtherRelatedParty_SubTypeCodes A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- ==========================================
        -- 7. 清理其他實質受益人 (Other Related Party)
        -- ==========================================
        IF OBJECT_ID('dbo.PB_OtherRelatedParty_Fact', 'U') IS NOT NULL
            DELETE A 
            FROM dbo.PB_OtherRelatedParty_Fact A 
            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B 
                ON A.CIFKEY = B.NEW_CIF_KEY
            WHERE B.ACTION = 'INSERT';


        -- 記錄 Rollback 成功日誌
        IF OBJECT_ID('dbo.Migrator_LOG', 'U') IS NOT NULL
            INSERT INTO dbo.Migrator_LOG (PROC_DATE, MSG_LOG, FLAG)
            SELECT GETDATE(), 'RP_NP module rollback completed -------> ', 'N';

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        -- 記錄 Rollback 失敗日誌並拋出錯誤
        IF OBJECT_ID('dbo.Migrator_LOG', 'U') IS NOT NULL
            INSERT INTO dbo.Migrator_LOG (PROC_DATE, MSG_LOG, FLAG)
            SELECT GETDATE(), 'RP_NP module rollback FAILED: ' + ERROR_MESSAGE(), 'Y';

        THROW;
    END CATCH;
END
GO
