/* =============================================================================
   5. SWIFT MX 電文檢測與命中比對 (SWIFT MX Screening & Case Detection)
============================================================================= */

-- MX 參數與維度設定檔
SELECT * FROM SWIFTMX_FormatDim;
SELECT * FROM SwiftMX_Remark_Log;
SELECT * FROM MESSAGEDATABASE..SwiftMX_MessagePrioritySettings;
SELECT * FROM SwiftMX_MessageItemDetectionSettings;

-- 查詢 MX 原始電文 (依案件編號、時間與報文類型)
SELECT * FROM MESSAGEDATABASE..SwiftMX_Raw ORDER BY CreatedDate DESC;

SELECT * FROM MESSAGEDATABASE..SwiftMX_Raw 
WHERE LastUpdatedDate >= '2025-07-25' 
  AND BankNo = 'HK' 
  AND ClientMessageTypeCode = 'pacs.008.001.08';

SELECT * FROM MESSAGEDATABASE..SwiftMX_Raw 
WHERE ClientReferenceNo IN ('X202301100802586872_1', 'SID_202607210002', 'X202507251016427987_1');

-- 查詢 MX 命中結果 (Detection Result)
SELECT * FROM SwiftMX_DetectionResult WHERE CaseId = 'B556D028-7A90-ED11-AE2F-0050568A471B';
SELECT * FROM SwiftMX_DetectionResult WHERE SdnName LIKE '%Tatiana Yaroslavovna Motyl%';

-- 統計最新命中次數前 2 大的 SDN 名稱
SELECT TOP 2 a.SdnName, COUNT(*) AS cnt 
FROM SwiftMX_DetectionResult a
JOIN MESSAGEDATABASE..SwiftMX_Raw b ON a.caseid = b.ID
WHERE a.LastUpdatedDate > '2025-10-20'
GROUP BY a.SdnName
ORDER BY cnt DESC;

-- 關聯 Raw 電文與命中結果
SELECT a.*, b.* 
FROM MESSAGEDATABASE..SwiftMX_Raw a
JOIN SwiftMX_DetectionResult b ON a.ID = b.CaseID
WHERE a.ClientReferenceNo = 'X202301100802586872_1';

-- 清理特定測試區間的 MX 電文
DELETE FROM MESSAGEDATABASE..SwiftMX_Raw
WHERE CreatedDate >= '2026-07-21' AND CreatedDate < '2026-07-22';


/* =============================================================================
   6. Dow Jones (DJ) 數據源與制裁名單關聯比對
============================================================================= */

-- 查詢 DJ 當日更新清單
SELECT A.*, C.GroupID 
FROM DJ_List_Data_A A
JOIN DJ_ListCategory C ON A.ListCategoryID = C.ListCategoryID
WHERE A.UpdatedDate = CONVERT(VARCHAR(10), GETDATE(), 120)
  AND C.GroupID = 10;

-- 完整關聯比對：GLSpec 與 DJ 實體、制裁類別及證件識別號碼
SELECT
    A.spec_name,
    A.ent_num,
    B.Description2,
    B.Description3,
    C.PersonStatus,
    D.IdentificationType,
    D.IdentificationNumber
FROM BSADB.dbo.OFAC_GLSpec A
JOIN BSADB.dbo.DJ_Entity C ON A.ent_num = C.EntityId
JOIN BSADB.dbo.DJ_ListCategory B ON A.ent_num = B.EntityId
LEFT JOIN BSADB.dbo.DJ_IdentificationTypeInfo D ON A.ent_num = D.EntityId
WHERE C.PersonStatus <> 'Inactive'
  AND B.Deleted = 0
  AND D.Deleted = 0
  AND (
        B.Description2 = 'Sanctions Lists'
        OR B.Description3 IN (
            'OFAC Related - Majority Owned',
            'OFAC Related - Control',
            'OFAC - Regional Sanctions Related - Majority Owned',
            'OFAC - Regional Sanctions Related - Control',
            'EU Related - Majority Owned',
            'EU Related - Control',
            'EU - Regional Sanctions Related - Majority Owned',
            'EU - Regional Sanctions Related - Control'
        )
      )
  AND D.IdentificationType IN (
        'Aircraft Construction, Line, Fleet or Serial Number',
        'Aircraft Manufacturer''s Serial Number (MSN)',
        'Bank Identifier Code (BIC)',
        'Central Registration Depository (CRD)',
        'Company Identification No.',
        'Driving Licence No.',
        'DUNS Number',
        'International Maritime Organization (IMO) Ship No.',
        'International Securities Identification Number (ISIN)',
        'Legal Entity Identifier (LEI)',
        'National ID',
        'National Provider Identifier (NPI)',
        'National Tax No.',
        'Others',
        'Passport No.',
        'Social Security No.',
        'Email',
        'Fax',
        'Phone'
      );
