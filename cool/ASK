CREATE PROCEDURE [dbo].[DBCHK_ProcessDetectionResults]  
 @JobId UNIQUEIDENTIFIER  
AS  
BEGIN  
 SET NOCOUNT ON;  
  
 DECLARE @UID NVARCHAR(20),  
   @Today_UTC DATETIME = GETUTCDATE();  
 DECLARE @Today_Local DATETIME = dbo.[ConvertToBankLocalTime](@Today_UTC),  
   @latestBlackListDate VARCHAR(8),  
   @ReductionInd CHAR(10) = REPLICATE('N', 10),  
   @DBCHK_CHOOSEN_RC INT = 80,  
            @DBCHK_EQUNAME INT = 0,  
            @DBCHK_MIN_SOUNDEX_PERCENTAGE INT,  
            @DBCHK_SOUNDEX_RC_CONTRIBUTION INT,  
            @DBCHK_UNICODE CHAR(1) = 'N',  
            @DBCHK_RC_Reduction INT = 0,  
            @DBCHK_BIC_CHECK INT = '0', -- check Header BIC = 1; check Body BIC = 2;  
            @DBCHK_CTRY_CHECK CHAR(1),  
            @NMCHK_PAST_DAYS INT,  
   @DBCHK_NAMECATEGORY_FILTER CHAR(1),   
   @DBCHK_GENDER_FILTER CHAR(1),   
   @NMCHK_TAXID CHAR(1),  
   @DBCHK_RISKRANKING CHAR(1),  
   @EnableWatchlistReviewExemption CHAR(1)  
    
 SELECT @UID = [UID] FROM [dbo].[DBCHK_Sessions] WHERE [JobId] = @JobId  
 SELECT @latestBlackListDate = CONVERT(VARCHAR,MAX([updated_date]),112)  FROM [dbo].[DBCHK_BlackListData_Buffer]  
    SELECT TOP 1 @DBCHK_CHOOSEN_RC = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_RC'  
 SELECT TOP 1 @DBCHK_EQUNAME = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_EQUNAME';   
    SELECT TOP 1 @DBCHK_MIN_SOUNDEX_PERCENTAGE = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_MIN_SOUNDEX_PERCENTAGE';  
    SELECT TOP 1 @DBCHK_SOUNDEX_RC_CONTRIBUTION = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_SOUNDEX_RC_CONTRIBUTION';   
    SELECT TOP 1 @DBCHK_UNICODE = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_UNICODE';  
    SELECT TOP 1 @DBCHK_RC_Reduction = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_RC_Reduction';  
    SELECT TOP 1 @DBCHK_CTRY_CHECK = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_CTRY_CHECK';   
 SELECT TOP 1 @NMCHK_PAST_DAYS = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_INHERIT_NMCHK_CHECK_PAST_DAYS';   
 SELECT TOP 1 @DBCHK_NAMECATEGORY_FILTER = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'NameCategoryFilter';   
 SELECT TOP 1 @DBCHK_GENDER_FILTER = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'GenderFilter';   
 SELECT TOP 1 @NMCHK_TAXID = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_INHERIT_NMCHK_TAXID';   
 SELECT TOP 1 @DBCHK_RISKRANKING = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'DBCHK_INHERIT_RISKRANKING';  
 SELECT TOP 1 @EnableWatchlistReviewExemption = CtrlVal FROM dbo.[DBCHK_DetectionSettings] WHERE [UID] = @UID AND Module = 'DBCHK' AND CtrlKey = 'EnableWatchlistReviewExemption';  
  
    INSERT INTO dbo.[DBCHK_CTRL_LOG] ([UID], [CHOOSEN_RC], [EQUNAME], [MIN_SOUNDEX_PERCENTAGE], [SOUNDEX_RC_CONTRIBUTION], [UNICODE], [RC_Reduction], [BIC_CHECK], [CTRY_CHECK])  
    VALUES (@UID, @DBCHK_CHOOSEN_RC, @DBCHK_EQUNAME, @DBCHK_MIN_SOUNDEX_PERCENTAGE, @DBCHK_SOUNDEX_RC_CONTRIBUTION, @DBCHK_UNICODE, @DBCHK_RC_Reduction, @DBCHK_BIC_CHECK, @DBCHK_CTRY_CHECK)   
   
 --Delete DBCHK_NameDetectionResults duplicate & lower RC results  
 ;WITH HighestRCForEveryList AS(  
        SELECT [source_table], [source_key], [SourceRefNo], [SourceColumn], [sdn_type], [ent_num], [alt_num], [relative_correlation],  
        ROW_NUMBER() OVER (PARTITION BY [source_table], [source_key], [SourceRefNo], [SourceColumn], [sdn_type], [ent_num], [alt_num]  
   ORDER BY [relative_correlation] DESC) AS 'RCRank'  
        FROM [dbo].[DBCHK_NameDetectionResults]  
 )  
 DELETE HighestRCForEveryList WHERE HighestRCForEveryList.RCRank > 1  
  
 UPDATE DBCHK_NameDetectionResults SET OriRC = relative_correlation, ReductionInd = @ReductionInd  
   
 --Filteration (Gender, EntityType)  
 BEGIN   
  IF @DBCHK_NAMECATEGORY_FILTER = 'Y'  
  BEGIN   
   --OFAC_CUSTOMER_FACT  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
    INNER JOIN DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_CUSTOMER_FACT' AND A.source_key = B.CIF_KEY  
   WHERE ((B.CUST_TYPE_CDE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.CUST_TYPE_CDE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  
   --OFAC_Appointer_Fact  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
    INNER JOIN dbo.DBCHK_OFAC_Appointer_Fact_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_Appointer_Fact' AND A.source_key = B.CIF_KEY AND A.SourceRefNo = B.AppointerRefNo   
   WHERE ((B.TYPE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.TYPE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  
   --OFAC_BoardOfDirector_Fact  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
   JOIN dbo.DBCHK_OFAC_BoardOfDirector_Fact_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_BoardOfDirector_Fact' AND A.source_key = B.CIF_KEY AND A.SourceRefNo = B.BoardOfDirectorRefNo  
   WHERE ((B.TYPE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.TYPE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  
   --OFAC_LegalAgent_Fact  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
   JOIN dbo.DBCHK_OFAC_LegalAgent_Fact_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_LegalAgent_Fact' AND A.source_key = B.CIF_KEY AND A.SourceRefNo = B.LegalAgentRefNo  
   WHERE ((B.TYPE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.TYPE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  
   --OFAC_MainClient_Fact  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
   JOIN dbo.DBCHK_OFAC_MainClient_Fact_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_MainClient_Fact' AND A.source_key = B.CIF_KEY AND A.SourceRefNo = B.MainClientRefNo  
   WHERE ((B.TYPE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.TYPE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  
   --OFAC_MainShareHolder_FACT  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
   JOIN dbo.DBCHK_OFAC_MainShareHolder_Fact_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_MainShareHolder_FACT' AND A.source_key = B.CIF_KEY AND A.SourceRefNo = B.MainShareHolderRefNo  
   WHERE ((B.TYPE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.TYPE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  
   --OFAC_OtherRelatedParty_Fact  
   DELETE A   
   FROM DBCHK_NameDetectionResults A  
   JOIN dbo.DBCHK_OFAC_OtherRelatedParty_Fact_Buffer B WITH (NOLOCK) ON A.source_table = 'OFAC_OtherRelatedParty_Fact' AND A.source_key = B.CIF_KEY AND A.SourceRefNo = B.OtherRelatedPartyRefNo  
   WHERE ((B.TYPE = 'P' AND A.NAME_CAT & 1 <> 1  AND A.NAME_CAT & 16 <> 16)  
     OR   
     (B.TYPE = 'N' AND A.NAME_CAT & 2 <> 2  AND A.NAME_CAT & 16 <> 16)  
      )  
  END  
  
  IF @DBCHK_GENDER_FILTER = 'Y' --ONLY FOR OFAC_CUSTOMER_FACT  
  BEGIN   
   ;WITH CTE_FILTER_CUSTOMER AS  
   (  
    SELECT source_key, ent_num, alt_num, sdn_type  
    FROM dbo.DBCHK_NameDetectionResults  
    WHERE source_table = 'OFAC_CUSTOMER_FACT'  
   )  
   ,CTE_GENDER AS   
   (   
    --EU  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
    INNER JOIN dbo.EU_SANCTIONS_NAME B ON A.ent_num = B.NAME_ID  
    INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type = 'EU'  
    UNION   
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, D.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN dbo.EU_SANCTIONS_NAME B ON A.ent_num = B.NAME_ID  
     INNER JOIN dbo.EU_SANCTIONS_ALT C ON B.ENTITY_ID = C.ENTITY_ID  
     INNER JOIN dbo.Gender_Dim D ON ISNULL(LTRIM(RTRIM(C.GENDER)),'') = D.GenderCode  
    WHERE A.sdn_type = 'EU ALT'  
    UNION   
    --OFAC  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN dbo.OFAC_SDN_SanitizedRemark B ON A.ent_num = B.ENT_NUM  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('OFAC', 'OFAC ALT')  
    UNION  
    --UKHMT  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN BSADB.dbo.UKHMT_MainName B ON A.ent_num = B.EntNum  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('UKHMT', 'UKHMT ALT')  
    UNION   
    --UN  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN dbo.UN_SANCTIONS_LIST B ON A.ent_num = B.ENT_NUM  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('UN', 'UN ALT')  
    UNION  
    --DJ  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN BSADB.dbo.DJ_Entity B ON A.ent_num = B.EntityId  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.GENDER)),'') = C.GenderDescription  
    WHERE A.sdn_type IN ('DJ', 'DJ ALT')  
    UNION  
    --WC  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, C.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN BSADB.dbo.WC_MainName B ON A.ent_num = B.EntityId  
     INNER JOIN dbo.Gender_Dim C ON ISNULL(LTRIM(RTRIM(B.EntityType)),'') = C.GenderCode  
    WHERE A.sdn_type IN ('WC', 'WC ALT')  
    UNION  
    --AC  
    SELECT A.source_key, A.ent_num, A.alt_num, A.sdn_type, D.GenderCode  
    FROM CTE_FILTER_CUSTOMER A   
     INNER JOIN BSADB.dbo.AC_MainName B ON A.ent_num = B.EntityId  
     INNER JOIN BSADB.dbo.AC_SupplementalData C ON B.EntityId = C.EntityId  
     INNER JOIN dbo.Gender_Dim D ON ISNULL(LTRIM(RTRIM(C.DataValue)),'') = D.GenderCode OR ISNULL(LTRIM(RTRIM(C.DataValue)),'') = D.GenderDescription  
    WHERE A.sdn_type IN ('AC', 'AC ALT')  
   )  
   DELETE A   
   FROM dbo.DBCHK_NameDetectionResults A   
    INNER JOIN CTE_GENDER B   
     ON A.source_key = B.source_key  
      AND A.ent_num = B.ent_num   
      AND A.alt_num = B.alt_num  
      AND A.sdn_type = B.sdn_type  
    INNER JOIN dbo.DBCHK_OFAC_CUSTOMER_FACT_Buffer C   
     ON B.source_key = C.CIF_KEY  
   WHERE ISNULL(C.Gender,'') <> '' AND B.GenderCode <> C.Gender  
  END  
 END  
  
 IF @DBCHK_RC_Reduction <> 0  
 BEGIN  
  DECLARE @COUNTRY_RC INT = 0, @DOB_RC INT = 0, @LowRiskList_RC INT = 0, @Gender_RC INT = 0, @NativeName_RC INT = 0, @IdentificationNumber_RC INT = 0  
  SELECT TOP 1 @COUNTRY_RC = COUNTRY, @DOB_RC = DOB, @LowRiskList_RC = LowRiskList, @Gender_RC = Gender, @NativeName_RC = NativeName,   
       @IdentificationNumber_RC = IdentificationNumber   
  FROM dbo.OFACTDBSettings  
  
  -- Insert rc reduction log   
  IF EXISTS(SELECT 1 FROM dbo.OFACTDBSettings_LOG WHERE [UID] = @UID AND Module = 'DBCHK')  
   UPDATE dbo.OFACTDBSettings_LOG  
   SET Country = @COUNTRY_RC, DOB = @DOB_RC, LowRiskList = @LowRiskList_RC, Gender = @Gender_RC, NativeName = @NativeName_RC,   
    IdentificationNumber = @IdentificationNumber_RC  
   WHERE [UID] = @UID AND Module = 'DBCHK'  
  ELSE  
   INSERT INTO [dbo].[OFACTDBSettings_Log] ([UID], [Country], [DOB], [LowRiskList], [Module], [Gender], [NativeName], [IdentificationNumber])  
   VALUES (@UID, @COUNTRY_RC, @DOB_RC, @LowRiskList_RC, 'DBCHK', @Gender_RC, @NativeName_RC, @IdentificationNumber_RC)  
  
  EXEC [dbo].[DBCHK_PerformRCReductionForCustomers] @UID = @UID   
  
  EXEC [dbo].[DBCHK_PerformRCReductionForAppointers] @UID = @UID   
    
  EXEC [dbo].[DBCHK_PerformRCReductionForBoardOfDirectors] @UID = @UID   
    
  EXEC [dbo].[DBCHK_PerformRCReductionForLegalAgents] @UID = @UID   
     
  EXEC [dbo].[DBCHK_PerformRCReductionForMainClients] @UID = @UID   
    
  EXEC [dbo].[DBCHK_PerformRCReductionForMainShareHolders] @UID = @UID   
    
  EXEC [dbo].[DBCHK_PerformRCReductionForOtherRelatedParties] @UID = @UID   
    
  --insert not hit name detection results into DBCHK_ResultGroups_Filter_RC  
  INSERT INTO dbo.DBCHK_ResultGroups_Filter_RC   
   (UID, SourceKey, SourceTable, SourceColumn, NameType, DetectionType,  
   RC, AltNum, EntNum, SdnType, SdnGrpNum, SdnName, UpdatedDate, OriRC, ReductionInd, DetectionDT,   
   LastUpdatedBy, LastUpdatedDT, DNSLFlag, LastUpdatedDT_UTC, NameCategory, DetectionDT_UTC, SourceRefNo, BlacklistUpdateTriggerScan)  
  SELECT @UID, source_key, source_table, SourceColumn, '0', detection_type,  
   relative_correlation, alt_num, ent_num, sdn_type, sdn_grp_num,  
   sdn_name, updated_date, OriRC, ReductionInd, @Today_Local,  
   'System Admin', @Today_Local, 'N', @Today_UTC, name_cat, @Today_UTC, SourceRefNo, BlacklistUpdateTriggerScan  
  FROM DBCHK_NameDetectionResults  
  WHERE relative_correlation <= @DBCHK_CHOOSEN_RC   
  
  --insert not hit name detection results into DBCHK_ResultNames_Filter_RC  
  INSERT INTO dbo.DBCHK_ResultNames_Filter_RC (UID, SourceTable, SourceKey, NameType, SourceColumn, DetectionType, FullName,  
   LastUpdatedBy, LastUpdatedDT, LatestBlackListDate, DNSLFlag, LastUpdatedDT_UTC, SourceRefNo)  
  SELECT DISTINCT @UID, source_table, source_key, '0', SourceColumn, detection_type, InputName,   
   'System Admin', @Today_Local, @latestBlackListDate, 'N', @Today_UTC, SourceRefNo  
  FROM dbo.DBCHK_NameDetectionResults  
  WHERE relative_correlation <= @DBCHK_CHOOSEN_RC   
 END  
  
 --insert address detection results into DBCHK_ResultGroups  
 INSERT INTO [dbo].[DBCHK_ResultGroups] ([UID], [SourceKey], [SourceTable],   
  [SourceColumn], [NameType], DetectionType, [RC], [AltNum], [EntNum],  
  [SdnType], [SdnGrpNum], [SdnName], [UpdatedDate], [OriRC],   
  [ReductionInd], [DetectionDT_UTC], [DetectionDT], [LastUpdatedBy],   
  [LastUpdatedDT_UTC], [NameCategory], [LastUpdatedDT], [DNSLFlag], [SourceRefNo], [NamePropertyBitCode])  
 OUTPUT Inserted.ID, Inserted.UID, Inserted.SourceKey, Inserted.SourceTable, Inserted.SourceColumn, Inserted.NameID, Inserted.NameType, Inserted.DetectionType,   
  Inserted.FormattedName, Inserted.RC, Inserted.AltNum, Inserted.EntNum, Inserted.SdnType, Inserted.SdnGrpNum, Inserted.SdnName, Inserted.UpdatedDate, Inserted.OriRC, Inserted.ReductionInd,   
  Inserted.DetectionDT, Inserted.IsFalsePositive, Inserted.Reason, Inserted.LastUpdatedBy, Inserted.LastUpdatedDT, Inserted.DNSLFlag, Inserted.LastUpdatedDT_UTC, Inserted.NameCategory,  
        Inserted.DetectionDT_UTC, Inserted.SourceRefNo, Inserted.NamePropertyBitCode  
 INTO dbo.DBCHK_ResultGroups_Log(ResultGroupsID, UID, SourceKey, SourceTable, SourceColumn, NameID, NameType, DetectionType,   
   FormattedName, RC, AltNum, EntNum, SdnType, SdnGrpNum, SdnName, UpdatedDate, OriRC, ReductionInd,   
   DetectionDT, IsFalsePositive, Reason, LastUpdatedBy, LastUpdatedDT, DNSLFlag, LastUpdatedDT_UTC, NameCategory,  
           DetectionDT_UTC, SourceRefNo, NamePropertyBitCode)  
 SELECT @UID, [SourceKey], [SourceTable],   
  [SourceColumn], [NameType], [detection_type], [RC], [AltNum], [EntNum],   
  [SdnType], [SdnGrpNum], [SdnName], [UpdatedDate], [OriRC],   
  @ReductionInd, @Today_UTC, @Today_Local, 'System Admin',  
  @Today_UTC, [NameCategory], @Today_Local, 'N', [SourceRefNo], [NamePropertyBitCode]  
 FROM [dbo].[DBCHK_AddressDetectionResults]  
  
 --insert address detection results into DBCHK_ResultNames  
 INSERT INTO [dbo].[DBCHK_ResultNames] (UID, SourceTable, SourceKey, NameType, SourceColumn, DetectionType, FullName,  
   LastUpdatedBy, LastUpdatedDT, LatestBlackListDate, DNSLFlag, LastUpdatedDT_UTC, SourceRefNo)  
    SELECT DISTINCT @UID, SourceTable, SourceKey, '0', [SourceColumn], detection_type, FullName,  
  'System Admin', @Today_Local, @latestBlackListDate, 'N', @Today_UTC, [SourceRefNo]  
    FROM [DBCHK_AddressDetectionResults]   
  
 --insert hit name detection results into DBCHK_ResultGroups  
 INSERT INTO [dbo].[DBCHK_ResultGroups] ([UID], [SourceKey], [SourceTable],   
  [SourceColumn], [NameType], DetectionType, [RC], [AltNum], [EntNum],  
  [SdnType], [SdnGrpNum], [SdnName], [UpdatedDate], [OriRC],   
  [ReductionInd], [DetectionDT_UTC], [DetectionDT], [LastUpdatedBy],   
  [LastUpdatedDT_UTC], [NameCategory], [LastUpdatedDT], [DNSLFlag], [SourceRefNo], [NamePropertyBitCode], [BlacklistUpdateTriggerScan])  
 OUTPUT Inserted.ID, Inserted.UID, Inserted.SourceKey, Inserted.SourceTable, Inserted.SourceColumn, Inserted.NameID, Inserted.NameType, Inserted.DetectionType,   
  Inserted.FormattedName, Inserted.RC, Inserted.AltNum, Inserted.EntNum, Inserted.SdnType, Inserted.SdnGrpNum, Inserted.SdnName, Inserted.UpdatedDate, Inserted.OriRC, Inserted.ReductionInd,   
  Inserted.DetectionDT, Inserted.IsFalsePositive, Inserted.Reason, Inserted.LastUpdatedBy, Inserted.LastUpdatedDT, Inserted.DNSLFlag, Inserted.LastUpdatedDT_UTC, Inserted.NameCategory,  
        Inserted.DetectionDT_UTC, Inserted.SourceRefNo, Inserted.NamePropertyBitCode, Inserted.BlacklistUpdateTriggerScan  
 INTO dbo.DBCHK_ResultGroups_Log(ResultGroupsID, UID, SourceKey, SourceTable, SourceColumn, NameID, NameType, DetectionType,   
   FormattedName, RC, AltNum, EntNum, SdnType, SdnGrpNum, SdnName, UpdatedDate, OriRC, ReductionInd,   
   DetectionDT, IsFalsePositive, Reason, LastUpdatedBy, LastUpdatedDT, DNSLFlag, LastUpdatedDT_UTC, NameCategory,  
           DetectionDT_UTC, SourceRefNo, NamePropertyBitCode, [BlacklistUpdateTriggerScan])  
    SELECT @UID, [source_key], [source_table],   
  SourceColumn, '0', [detection_type], [relative_correlation], [alt_num], [ent_num],   
  [sdn_type], [sdn_grp_num], [sdn_name], [updated_date], [OriRC],   
  [ReductionInd], @Today_UTC, @Today_Local, 'System Admin',  
  @Today_UTC, [name_cat], @Today_Local, 'N', SourceRefNo, NamePropertyBitCode, BlacklistUpdateTriggerScan  
    FROM DBCHK_NameDetectionResults   
    WHERE relative_correlation > @DBCHK_CHOOSEN_RC  
  
 --insert hit name detection results into DBCHK_ResultNames  
 INSERT INTO [dbo].[DBCHK_ResultNames] (UID, SourceTable, SourceKey, NameType, SourceColumn, DetectionType, FullName,  
  LastUpdatedBy, LastUpdatedDT, LatestBlackListDate, DNSLFlag, LastUpdatedDT_UTC, SourceRefNo)  
    SELECT DISTINCT @UID, source_table, source_key, '0', [SourceColumn], detection_type, InputName,  
  'System Admin', @Today_Local, @latestBlackListDate, 'N', @Today_UTC, [SourceRefNo]  
    FROM DBCHK_NameDetectionResults   
 WHERE relative_correlation > @DBCHK_CHOOSEN_RC  
   
 --bring over NMCHK reviewed results & watchlsit exemption review results  
 BEGIN   
   
 IF OBJECT_ID('TEMPDB..#Temp_DBCHK_NameCheckPendingMergeResults') IS NOT NULL  
 BEGIN   
  DROP TABLE #Temp_DBCHK_NameCheckPendingMergeResults  
 END  
 CREATE TABLE #Temp_DBCHK_NameCheckPendingMergeResults (  
  [DBCHK_UID] NVARCHAR(20) NOT NULL,  
  [uid] NVARCHAR(20) NULL,  
  [new_acct_key] INT NULL,  
  [sdn_type] NVARCHAR(15) NULL,  
  [sdn_grp_num] INT  NULL,  
  [ent_num] INT  NULL,  
  [alt_num] INT  NULL,  
  [new_acct_name] NVARCHAR(350) NULL,  
  [user_brnch_nbr] NVARCHAR(50) NULL,  
  [OFACMatch] NVARCHAR(10) NULL,  
  [OFACNotMatch] NVARCHAR(10) NULL,  
  [Reason] NVARCHAR(255) NULL,  
  [NamePropertyBitCode] INT  NULL,  
  [TAXID] NVARCHAR(50) NULL,  
  [LstUpdate_Date] DATETIME NULL,  
  [RowIndex] INT NULL  
 )  
  
 IF OBJECT_ID('TEMPDB..#Temp_DBCHK_CUSTOMER_RP_FACT') IS NOT NULL  
 BEGIN  
  DROP TABLE #Temp_DBCHK_CUSTOMER_RP_FACT  
 END  
 CREATE TABLE #Temp_DBCHK_CUSTOMER_RP_FACT(  
  [CIF_KEY] UNIQUEIDENTIFIER,  
  [BRNCH_NBR] VARCHAR(50),  
  [CustomerNo] VARCHAR(MAX),  
  [RiskRanking] VARCHAR(1)  
 )  
   
 ;WITH CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer AS (  
  SELECT A.CIF_KEY, A.BRNCH_NBR, A.CustomerNo, A.RiskRanking FROM dbo.DBCHK_OFAC_CUSTOMER_FACT_Buffer A WITH (NOLOCK) WHERE EXISTS (SELECT 1 FROM dbo.DBCHK_NameDetectionResults B WITH (NOLOCK) WHERE A.CIF_KEY = B.source_key)  
 )  
 INSERT INTO #Temp_DBCHK_CUSTOMER_RP_FACT( CIF_KEY ,BRNCH_NBR ,CustomerNo ,RiskRanking )  
 SELECT CIF_KEY,BRNCH_NBR,CustomerNo,RiskRanking  
 FROM CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer A WITH (NOLOCK)  
 UNION  
 SELECT A.CIF_KEY, B.BRNCH_NBR,A.IdentificationNumber,''  
 FROM dbo.DBCHK_OFAC_Appointer_Fact_Buffer A WITH (NOLOCK) JOIN CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.CIF_KEY = B.Cif_key   
 UNION  
 SELECT A.CIF_KEY, B.BRNCH_NBR,A.IdentificationNumber,''  
 FROM dbo.DBCHK_OFAC_BoardOfDirector_Fact_Buffer A WITH (NOLOCK) JOIN CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.CIF_KEY = B.Cif_key   
 UNION  
 SELECT A.CIF_KEY, B.BRNCH_NBR,A.IdentificationNumber,''  
 FROM dbo.DBCHK_OFAC_LegalAgent_Fact_Buffer A WITH (NOLOCK) JOIN CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.CIF_KEY = B.Cif_key   
 UNION  
 SELECT A.CIF_KEY, B.BRNCH_NBR,A.IdentificationNumber,''  
 FROM dbo.DBCHK_OFAC_MainClient_Fact_Buffer A WITH (NOLOCK) JOIN CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.CIF_KEY = B.Cif_key   
 UNION  
 SELECT A.CIF_KEY, B.BRNCH_NBR,A.IdentificationNumber,''  
 FROM dbo.DBCHK_OFAC_MainShareHolder_Fact_Buffer A WITH (NOLOCK) JOIN CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.CIF_KEY = B.Cif_key   
 UNION  
 SELECT A.CIF_KEY, B.BRNCH_NBR,A.IdentificationNumber,''  
 FROM dbo.DBCHK_OFAC_OtherRelatedParty_Fact_Buffer A WITH (NOLOCK) JOIN CTE_DBCHK_OFAC_CUSTOMER_FACT_Buffer B WITH (NOLOCK) ON A.CIF_KEY = B.Cif_key   
  
  IF ISNULL(@NMCHK_TAXID, 'N') = 'Y'  
  BEGIN   
   INSERT INTO #Temp_DBCHK_NameCheckPendingMergeResults( DBCHK_UID, uid, new_acct_key, sdn_type, sdn_grp_num, ent_num, alt_num, new_acct_name,  
       user_brnch_nbr, OFACMatch, OFACNotMatch, Reason, NamePropertyBitCode, TAXID, LstUpdate_Date, RowIndex )  
   SELECT @UID, A.[uid], A.new_acct_key, A.sdn_type, A.sdn_grp_num,  
    A.ent_num, A.alt_num, B.new_acct_name, B.user_brnch_nbr,  
    A.OFACMatch, A.OFACNotMatch, A.Reason, A.NamePropertyBitCode, B.TAXID, C.LstUpdate_Date,  
    ROW_NUMBER() OVER(PARTITION BY [B].[new_acct_name], [B].[user_brnch_nbr], [B].[TAXID], [A].[sdn_type], [A].[sdn_grp_num], [A].[ent_num], [A].[alt_num]  
         ORDER BY C.[Created_Date_UTC] DESC) AS RowIndex  
   FROM dbo.NMCHK_ResultHistory A  
   INNER JOIN dbo.NMCHK_CustInfo B ON A.[uid] = B.[uid] AND A.new_acct_key = B.new_acct_key  
   INNER JOIN dbo.NMCHK_Review_Main C  
   ON A.[uid] = C.[uid]  
   WHERE B.Source_IND IN ('W', 'O', 'B')   
   AND B.IsSyncWithDBCheck IS NULL   
   AND DATEDIFF(DAY, C.LstUpdate_Date, GETDATE()) <= @NMCHK_PAST_DAYS  
   AND C.[Status] = 3  
  END   
  ELSE   
  BEGIN   
   INSERT INTO #Temp_DBCHK_NameCheckPendingMergeResults( DBCHK_UID, uid, new_acct_key, sdn_type, sdn_grp_num, ent_num, alt_num, new_acct_name,  
       user_brnch_nbr, OFACMatch, OFACNotMatch, Reason, NamePropertyBitCode, TAXID, LstUpdate_Date, RowIndex )  
   SELECT @UID, A.[uid], A.new_acct_key, A.sdn_type, A.sdn_grp_num,  
    A.ent_num, A.alt_num, B.new_acct_name, B.user_brnch_nbr,  
    A.OFACMatch, A.OFACNotMatch, A.Reason, A.NamePropertyBitCode, B.TAXID, C.LstUpdate_Date,  
    ROW_NUMBER() OVER(PARTITION BY [B].[new_acct_name], [B].[user_brnch_nbr], [A].[sdn_type], [A].[sdn_grp_num], [A].[ent_num], [A].[alt_num]  
         ORDER BY C.[Created_Date_UTC] DESC) AS RowIndex  
   FROM dbo.NMCHK_ResultHistory A  
   INNER JOIN dbo.NMCHK_CustInfo B ON A.[uid] = B.[uid] AND A.new_acct_key = B.new_acct_key  
   INNER JOIN dbo.NMCHK_Review_Main C  
   ON A.[uid] = C.[uid]  
   WHERE B.Source_IND IN ('W', 'O', 'B')   
   AND B.IsSyncWithDBCheck IS NULL   
   AND DATEDIFF(DAY, C.LstUpdate_Date, GETDATE()) <= @NMCHK_PAST_DAYS  
   AND C.[Status] = 3  
  END   
          
  TRUNCATE TABLE [dbo].[DBCHK_Filter_NameCheck_Temp]  
      
  /*begin map data to namecheck*/  
  INSERT INTO [dbo].[DBCHK_Filter_NameCheck_Temp] ([DBCHK_UID], [uid],  
   [new_acct_key], [sdn_type], [sdn_grp_num], [ent_num], [alt_num],   
   [new_acct_name], [user_brnch_nbr], [OFACMatch], [OFACNotMatch],  
   [Reason], [NamePropertyBitCode], [LastUpdatedDate])  
  SELECT @UID, A.[uid], A.new_acct_key, A.sdn_type, A.sdn_grp_num,  
   A.ent_num, A.alt_num, A.new_acct_name, A.user_brnch_nbr,  
   A.OFACMatch, A.OFACNotMatch, A.Reason, A.NamePropertyBitCode, A.LstUpdate_Date  
  FROM #Temp_DBCHK_NameCheckPendingMergeResults A  
  JOIN dbo.DBCHK_ResultGroups C ON A.DBCHK_UID = C.UID AND A.sdn_type = C.SdnType AND A.ent_num = C.EntNum AND A.alt_num = C.AltNum AND (A.sdn_type IN ('DJ', 'DJ ALT') OR A.sdn_grp_num = C.SdnGrpNum)  
  JOIN dbo.DBCHK_ResultNames D ON A.DBCHK_UID = D.UID AND A.new_acct_name = D.FullName AND C.SourceTable = D.SourceTable AND C.SourceKey = D.SourceKey AND C.SourceColumn = D.SourceColumn AND ISNULL(C.SourceRefNo, '') = ISNULL(D.SourceRefNo, '')  
  JOIN #Temp_DBCHK_CUSTOMER_RP_FACT E ON A.user_brnch_nbr = E.BRNCH_NBR AND C.SourceKey = E.CIF_KEY  
  WHERE A.DBCHK_UID = @UID AND A.RowIndex = 1  -- Get latest NMCHK results  
   AND (ISNULL(@NMCHK_TAXID, 'N') = 'N'   
     OR (ISNULL(@NMCHK_TAXID, 'N') = 'Y' AND A.TaxID = E.CustomerNo AND ISNULL(A.TaxID, '') <> '' AND ISNULL(E.CustomerNo, '') <> ''))  
   AND (ISNULL(@DBCHK_RISKRANKING, 'N') = 'N'   
     OR (ISNULL(@DBCHK_RISKRANKING, 'N') = 'Y' AND EXISTS (SELECT 1 FROM dbo.DBCHK_AutoDone_Setting Z WHERE E.RiskRanking = Z.RiskRanking AND Z.Flag = 'Y')))  
    
  TRUNCATE TABLE [dbo].[DBCHK_Map_NameCheck_Temp]  
      
  INSERT INTO [dbo].[DBCHK_Map_NameCheck_Temp] ([UID], [NameCheckUID], [new_acct_key], [new_acct_name], [user_brnch_nbr])            
  SELECT DISTINCT [DBCHK_UID], [uid], new_acct_key, new_acct_name, user_brnch_nbr    
  FROM [dbo].[DBCHK_Filter_NameCheck_Temp]  
  WHERE [DBCHK_UID] = @UID;  
   
  UPDATE  A  
  SET A.Reason = D.Reason,  
   A.IsFalsePositive = CASE ISNULL(D.OFACMatch, '') WHEN 'Y' THEN 'Y'   
          ELSE (CASE D.OFACNotMatch WHEN 'Y' THEN 'N' ELSE NULL END)  
        END,  
   A.NamePropertyBitCode = D.NamePropertyBitCode  
  FROM dbo.DBCHK_ResultGroups A  
  LEFT JOIN dbo.DBCHK_ResultNames B  
  ON A.[UID] = B.[UID]   
   AND A.SourceTable = B.SourceTable   
   AND A.SourceKey = B.SourceKey   
   AND A.SourceColumn = B.SourceColumn   
   AND ISNULL(A.SourceRefNo, '') = ISNULL(B.SourceRefNo, '')  
  JOIN [dbo].[DBCHK_OFAC_CUSTOMER_FACT_Buffer] C ON A.SourceKey = C.CIF_KEY  
  JOIN [DBCHK_Filter_NameCheck_Temp] D  
  ON A.[UID] = D.DBCHK_UID   
   AND D.new_acct_name = B.FullName   
   AND D.user_brnch_nbr = C.BRNCH_NBR   
   AND D.sdn_type = A.SdnType   
   AND (D.sdn_type IN ('DJ', 'DJ ALT') OR D.sdn_grp_num = A.SdnGrpNum)   
   AND D.ent_num = A.EntNum   
   AND D.alt_num = A.AltNum  
  WHERE A.[UID] = @UID  
    
  IF OBJECT_ID('TEMPDB..#Temp_DBCHK_Map_NameCheckPendingMergeResults') IS NOT NULL  
  BEGIN  
   DROP TABLE #Temp_DBCHK_Map_NameCheckPendingMergeResults  
  END     
  CREATE TABLE #Temp_DBCHK_Map_NameCheckPendingMergeResults (  
   [UID] NVARCHAR(20) NOT NULL,  
   [NameCheckUID] NVARCHAR(20) NULL,  
   [new_acct_key] INT NULL,  
   [new_acct_name] NVARCHAR(350) NULL,  
   [user_brnch_nbr] NVARCHAR(50) NULL,  
   [DBCHK_Map_UID] NVARCHAR(20) NULL,  
   [DBCHK_Map_CIFKEY] NVARCHAR(350) NULL  
  )  
    
  INSERT INTO #Temp_DBCHK_Map_NameCheckPendingMergeResults (UID, NameCheckUID, new_acct_key, new_acct_name, user_brnch_nbr, DBCHK_Map_UID, DBCHK_Map_CIFKEY)  
  SELECT @UID, D.NameCheckUID, D.new_acct_key,D.new_acct_name, D.user_brnch_nbr, B.UID, B.SourceKey   
  FROM dbo.DBCHK_ResultNames B  
  LEFT JOIN [dbo].[DBCHK_OFAC_CUSTOMER_FACT_Buffer] C ON B.SourceKey = C.CIF_KEY  
  INNER JOIN [dbo].[DBCHK_Map_NameCheck_Temp] D  
  ON B.[UID] = D.[UID] AND D.new_acct_name = B.FullName AND D.user_brnch_nbr = C.BRNCH_NBR  
  WHERE B.[UID] = @UID  
    
  TRUNCATE TABLE [dbo].[DBCHK_Map_NameCheck_Temp]  
  
  INSERT INTO dbo.DBCHK_Map_NameCheck_Temp (UID, NameCheckUID, new_acct_key, new_acct_name, user_brnch_nbr, DBCHK_Map_UID, DBCHK_Map_CIFKEY)  
  SELECT UID, NameCheckUID, new_acct_key, new_acct_name, user_brnch_nbr, DBCHK_Map_UID, DBCHK_Map_CIFKEY   
  FROM #Temp_DBCHK_Map_NameCheckPendingMergeResults   
  WHERE DBCHK_Map_UID = @UID;  
   
  UPDATE  A  
  SET IsSyncWithDBCheck = 1  
  FROM dbo.NMCHK_CustInfo A  
  WHERE EXISTS (SELECT 1 FROM [dbo].[DBCHK_Filter_NameCheck_Temp] B   
       JOIN dbo.DBCHK_ResultGroups C ON B.sdn_type = C.SdnType AND b.ent_num = C.EntNum AND b.alt_num = C.AltNum AND (B.sdn_type IN ('DJ', 'DJ ALT') OR B.sdn_grp_num = C.SdnGrpNum)  
       JOIN dbo.DBCHK_ResultNames D ON B.new_acct_name = D.FullName AND C.SourceTable = D.SourceTable AND C.SourceKey = D.SourceKey AND C.SourceColumn = D.SourceColumn AND ISNULL(C.SourceRefNo, '') = ISNULL(D.SourceRefNo, '')  
       JOIN dbo.DBCHK_OFAC_CUSTOMER_FACT_BUFFER E ON B.user_brnch_nbr = E.BRNCH_NBR AND C.SourceKey = E.CIF_KEY  
       WHERE  B.[DBCHK_UID] = @UID   
       AND A.[uid] = B.[uid]   
       AND A.new_acct_key = new_acct_key  
       )  
  AND A.IsSyncWithDBCheck IS NULL   
  AND A.Source_IND IN ('W', 'O', 'B')  
  
  --Map watchlist exemption review result to dbchk detection results  
  IF ISNULL(@EnableWatchlistReviewExemption, 'N') = 'Y'  
  BEGIN  
   EXEC dbo.MergeWatchlistReviewExemption_ReviewResult @UID = @UID  
  END  
   
  UPDATE  A  
  SET A.IsFalsePositive = CASE WHEN EXISTS (SELECT 1 FROM dbo.DBCHK_ResultGroups B  
             WHERE B.[UID] = A.[UID]   
             AND A.SourceKey = B.SourceKey   
             AND A.SourceColumn = B.SourceColumn   
             AND ISNULL(A.SourceRefNo, '') = ISNULL(B.SourceRefNo, '')   
             AND A.SourceTable = B.SourceTable   
             AND ISNULL(B.IsFalsePositive, '') = 'N')  
        THEN 'N'  
         WHEN NOT EXISTS (SELECT 1 FROM dbo.DBCHK_ResultGroups B  
             WHERE B.[UID] = A.[UID]   
             AND A.SourceKey = B.SourceKey   
             AND A.SourceColumn = B.SourceColumn   
             AND ISNULL(A.SourceRefNo, '') = ISNULL(B.SourceRefNo, '')   
             AND A.SourceTable = B.SourceTable   
             AND ISNULL(B.IsFalsePositive, '') <> 'Y')  
        THEN 'Y' ELSE NULL END  
  FROM dbo.DBCHK_ResultNames A  
  WHERE A.[UID] = @UID   
  AND EXISTS (SELECT 1 FROM dbo.DBCHK_ResultGroups B  
     WHERE  B.[UID] = @UID   
     AND A.SourceKey = B.SourceKey   
     AND A.SourceColumn = B.SourceColumn   
     AND ISNULL(A.SourceRefNo, '') = ISNULL(B.SourceRefNo, '')   
     AND A.SourceTable = B.SourceTable   
     AND ISNULL(B.IsFalsePositive, '') <> '')  
 END   
END  
  
  
  
  
  
  
  
  
  
  
  
