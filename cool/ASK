錯誤訊息 80040154 類別未登錄 (REGDB_E_CLASSNOTREG) 代表當前執行環境（例如伺服器主機或 64/32 位元 PowerShell 差異）沒有註冊 Excel 的 COM 元件，或者該主機未安裝標準桌面版 Microsoft Excel。
改用 .NET 原生 Zip / XML 解析方式，完全不需要安裝 Excel 或任何第三方套件即可直接讀取 .xlsx 資料。
免安裝 Excel 的 PowerShell 檢查腳本
直接將以下內容覆蓋 GO.ps1：
Add-Type -AssemblyName System.IO.Compression.FileSystem

# 1. 取得執行路徑下的第一個 .xlsx 檔案
$currentDir = Get-Location
$excelFile = Get-ChildItem -Path $currentDir -Filter *.xlsx | Select-Object -First 1

if (-not $excelFile) {
    Write-Host "[錯誤] 在目錄中找不到任何 .xlsx 檔案！" -ForegroundColor Red
    Pause
    Exit
}

Write-Host "正在檢查檔案: $($excelFile.Name)" -ForegroundColor Cyan

# 2. 解壓縮讀取 .xlsx 內部 XML 資料
$tempFolder = Join-Path $env:TEMP ([System.Guid]::NewGuid().ToString())

try {
    [System.IO.Compression.ZipFile]::ExtractToDirectory($excelFile.FullName, $tempFolder)
    
    # 讀取共用字串表 (SharedStrings.xml)
    $sharedStrings = @()
    $sstPath = Join-Path $tempFolder "xl\sharedStrings.xml"
    if (Test-Path $sstPath) {
        [xml]$sstXml = Get-Content $sstPath -Encoding UTF8
        foreach ($si in $sstXml.sst.si) {
            if ($si.t) {
                $sharedStrings += $si.t
            } elseif ($si.r) {
                $sharedStrings += ($si.r | ForEach-Object { $_.t }) -join ""
            } else {
                $sharedStrings += ""
            }
        }
    }

    # 讀取 Sheet1
    $sheetPath = Join-Path $tempFolder "xl\worksheets\sheet1.xml"
    if (-not (Test-Path $sheetPath)) {
        Write-Host "[錯誤] 找不到工作表資料 (sheet1.xml)" -ForegroundColor Red
        Pause
        Exit
    }

    [xml]$sheetXml = Get-Content $sheetPath -Encoding UTF8
    $rows = $sheetXml.worksheet.sheetData.row

    # 3. 取得 B 欄規格清單
    $validSpecs = [System.Collections.Generic.HashSet[string]]::new()
    $aDataList = [System.Collections.Generic.List[psobject]]::new()

    foreach ($row in $rows) {
        $rowNum = [int]$row.r
        if ($rowNum -eq 1) { continue } # 跳過標題列

        foreach ($c in $row.c) {
            $cellRef = $c.r
            $val = ""

            if ($c.v) {
                if ($c.t -eq "s") {
                    $val = $sharedStrings[[int]$c.v]
                } else {
                    $val = $c.v
                }
            }
            $val = $val.Trim()

            # 解析 B 欄規格
            if ($cellRef -match "^B\d+$" -and -not [string]::IsNullOrEmpty($val)) {
                $padB = $val.PadLeft(4, '0')
                [void]$validSpecs.Add($padB)
            }

            # 暫存 A 欄資料
            if ($cellRef -match "^A\d+$" -and -not [string]::IsNullOrEmpty($val)) {
                $aDataList.Add([PSCustomObject]@{
                    Row = $rowNum
                    Raw = $val
                })
            }
        }
    }

    Write-Host "已載入 $($validSpecs.Count) 筆 B 欄規格代碼。" -ForegroundColor Green
    Write-Host "--------------------------------------------------------"

    # 4. 檢核 A 欄資料
    $errorCount = 0
    foreach ($item in $aDataList) {
        $raw = $item.Raw
        $code = if ($raw.Length -ge 4) { $raw.Substring(0, 4) } else { $raw }

        if (-not $validSpecs.Contains($code)) {
            $errorCount++
            Write-Host "[列 $($item.Row) 格式錯誤] " -ForegroundColor Red -NoNewline
            Write-Host "原始值: '$raw' | 檢查碼: '$code' (未在 B 欄規格中找到)" -ForegroundColor Yellow
        }
    }

    Write-Host "--------------------------------------------------------"
    if ($errorCount -eq 0) {
        Write-Host "檢查完成：所有 A 欄資料前 4 碼皆符合 B 欄規格！" -ForegroundColor Green
    } else {
        Write-Host "檢查完成：共發現 $errorCount 筆格式不符資料。" -ForegroundColor Red
    }

} catch {
    Write-Host "[執行異常] $($_.Exception.Message)" -ForegroundColor Red
} finally {
    if (Test-Path $tempFolder) {
        Remove-Item -Path $tempFolder -Recurse -Force -ErrorAction SilentlyContinue
    }
}

Write-Host ""
Pause

