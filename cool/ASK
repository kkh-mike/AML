SELECT
    A.EntityId,
    A.FullName,
    F.spec_name
FROM BSADB..DJ_Entity A
JOIN BSADB..DJ_SanctionListReference B
    ON A.EntityId = B.EntityId
LEFT JOIN BSADB..DJ_List_Data_A C
    ON A.EntityId = C.EntNum
LEFT JOIN BSADBJP..OFAC_SPEC F
    ON A.FullName = F.spec_name
WHERE B.SanctionListReference LIKE '%Japanese Finance%'
  AND A.Deceased = 0
  AND F.spec_name IS NULL
  AND C.EntNum IS NULL;