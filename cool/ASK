# ========================================================
# Check_Occup.ps1
# 功能：檢查 Excel A 欄前4碼是否符合 B 欄規格清單
# ========================================================

# 1. 取得當前目錄下的第一個 .xlsx 檔案
$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
if (-not $scriptDir) { $scriptDir = Get-Location }

$excelFile = Get-ChildItem -Path $scriptDir -Filter *.xlsx | Select-Object -First 1

if (-not $excelFile) {
    Write-Host "[錯誤] 在目錄中找不到任何 .xlsx 檔案！" -ForegroundColor Red
    Pause
    Exit
}

Write-Host "正在檢查檔案: $($excelFile.Name)" -ForegroundColor Cyan

# 2. 建立 Excel COM 物件
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$excel.DisplayAlerts = $false

try {
    $workbook = $excel.Workbooks.Open($excelFile.FullName)
    $sheet = $workbook.Sheets.Item(1) # 預設讀取第一個工作表

    # 3. 取得規格清單 (B 欄)
    $validSpecs = [System.Collections.Generic.HashSet[string]]::new()
    $bRow = 2
    while ($true) {
        $bVal = $sheet.Range("B$bRow").Text.Trim()
        if ([string]::IsNullOrEmpty($bVal)) { 
            # 遇到連續空行或到底即結束
            if ([string]::IsNullOrEmpty($sheet.Range("B$($bRow+1)").Text.Trim())) { break }
        } else {
            # 確保代碼為 4 碼純文字字串 (例如 "0817", "0100")
            $padBVal = $bVal.PadLeft(4, '0')
            [void]$validSpecs.Add($padBVal)
        }
        $bRow++
    }

    Write-Host "已載入 $($validSpecs.Count) 筆 B 欄規格代碼。" -ForegroundColor Green
    Write-Host "--------------------------------------------------------"

    # 4. 逐列檢查資料 (A 欄)
    $aRow = 2
    $errorCount = 0

    while ($true) {
        $aRaw = $sheet.Range("A$aRow").Text.Trim()
        if ([string]::IsNullOrEmpty($aRaw)) {
            # 遇到連續兩行空值結束檢查
            if ([string]::IsNullOrEmpty($sheet.Range("A$($aRow+1)").Text.Trim())) { break }
            $aRow++
            continue
        }

        # 擷取前 4 碼
        $code = if ($aRaw.Length -ge 4) { $aRaw.Substring(0, 4) } else { $aRaw }

        # 檢核是否在規格集合中
        if (-not $validSpecs.Contains($code)) {
            $errorCount++
            Write-Host "[列 $aRow 格式錯誤]" -ForegroundColor Red -NoNewline
            Write-Host " 原始值: '$aRaw' | 檢查碼: '$code' (未在 B 欄規格中找到)" -ForegroundColor Yellow
        }

        $aRow++
    }

    Write-Host "--------------------------------------------------------"
    if ($errorCount -eq 0) {
        Write-Host "檢查完成：所有 A 欄資料前 4 碼皆符合 B 欄規格！" -ForegroundColor Green
    } else {
        Write-Host "檢查完成：共發現 $errorCount 筆格式不符資料。" -ForegroundColor Red
    }

} catch {
    Write-Host "[執行異常] $($_.Exception.Message)" -ForegroundColor Red
} finally {
    # 關閉並釋放 Excel 物件
    if ($workbook) { $workbook.Close($false) }
    $excel.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($sheet) | Out-Null
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($workbook) | Out-Null
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()
}

Write-Host ""
Pause
