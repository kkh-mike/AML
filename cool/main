-- STEP 1: 抽樣暫存表（同時記錄新光 ID 與台新 ID）
IF OBJECT_ID('tempdb..#SampleCust') IS NOT NULL DROP TABLE #SampleCust;

WITH RankedData AS (
    SELECT 
        m.CustomerNo    AS SK_CustomerNo,     -- 新光客戶 ID
        bb.CustomerNo   AS TS_CustomerNo,     -- 台新客戶 ID
        cc.CUST_TYPE_CDE,
        v.ACTION,
        a.highrisk,
        CONCAT(
            CASE cc.CUST_TYPE_CDE WHEN 'N' THEN '企業' WHEN 'P' THEN '個人' END, ' ',
            CASE v.ACTION WHEN 'update' THEN '共有戶' WHEN 'INSERT' THEN '純新光' END, ' ',
            CASE a.highrisk WHEN 'H' THEN '高' WHEN 'M' THEN '中' WHEN 'L' THEN '低' END
        ) AS 完整分類標籤,
        ROW_NUMBER() OVER (
            PARTITION BY cc.CUST_TYPE_CDE, v.ACTION, a.highrisk 
            ORDER BY NEWID()                  -- 改用 NEWID() 確保每組隨機抽樣 1 筆
        ) AS rn
    FROM Cust_NP_Migrate_buffer a
    JOIN CIF_Migrate_Mapping_TEMP v   ON v.SOURCE_CIF_KEY = a.CIF_KEY
    JOIN Customer_Migrate_buffer m    ON m.CIF_KEY = v.SOURCE_CIF_KEY
    JOIN BSA_SUB_CUST_FACT bb         ON bb.CIF_KEY = v.NEW_CIF_KEY
    JOIN PB_CUSTOMER_FACT cc          ON cc.CIF_KEY = bb.CIF_KEY
    WHERE cc.CUST_TYPE_CDE IN ('N', 'P')
      AND v.ACTION IN ('update', 'INSERT')
      AND a.highrisk IN ('H', 'M', 'L')
)
SELECT     
    SK_CustomerNo,
    TS_CustomerNo,
    CUST_TYPE_CDE,
    ACTION,
    highrisk,
    完整分類標籤
INTO #SampleCust
FROM RankedData
WHERE rn <= 1;

-- STEP 2: 檢視新光抽樣樣本
SELECT 
    SK_CustomerNo AS [新光客戶ID],
    TS_CustomerNo AS [台新客戶ID],
    CUST_TYPE_CDE,
    ACTION,
    highrisk,
    完整分類標籤
FROM #SampleCust
ORDER BY 完整分類標籤;

-- STEP 3: 台新寫入資料核對（含雙方 ID 與共有戶取高邏輯）
SELECT 
    s.SK_CustomerNo           AS [新光客戶ID],
    s.TS_CustomerNo           AS [台新客戶ID],
    s.完整分類標籤,
    CASE 
        WHEN s.ACTION = 'INSERT' THEN '純新光'
        WHEN s.ACTION = 'update' THEN '共有戶'
        ELSE s.ACTION
    END                       AS [客戶分類],
    
    -- 1. 客戶型態比對
    s.CUST_TYPE_CDE           AS SAMPLE_CUST_TYPE,
    b.CUST_TYPE_CDE           AS FACT_CUST_TYPE,
    CASE 
        WHEN s.CUST_TYPE_CDE = b.CUST_TYPE_CDE THEN 'OK'
        WHEN b.CUST_TYPE_CDE IS NULL THEN 'FACT無資料'
        ELSE 'MISMATCH'
    END                       AS CHECK_CUST_TYPE,

    -- 2. 風險等級比對（共有戶取高邏輯：H > M > L）
    s.highrisk                AS SAMPLE_HIGHRISK,
    a.highrisk                AS FACT_HIGHRISK,
    CASE 
        WHEN s.highrisk = a.highrisk THEN 'OK'
        WHEN a.highrisk IS NULL THEN 'FACT無資料'
        -- 共有戶若台新等級高於新光來源，屬合理覆蓋
        WHEN s.ACTION = 'update' AND (
            (s.highrisk = 'L' AND a.highrisk IN ('M', 'H')) OR
            (s.highrisk = 'M' AND a.highrisk = 'H')
        ) THEN 'OK_取高'
        ELSE 'MISMATCH'
    END                       AS CHECK_HIGHRISK

FROM #SampleCust s
LEFT JOIN BSA_SUB_CUST_FACT a ON a.CustomerNo = s.TS_CustomerNo
LEFT JOIN PB_CUSTOMER_FACT b  ON b.CIF_KEY = a.CIF_KEY
ORDER BY 
    -- 異常列置頂
    CASE 
        WHEN s.CUST_TYPE_CDE <> b.CUST_TYPE_CDE 
          OR (
              s.highrisk <> a.highrisk 
              AND NOT (s.ACTION = 'update' AND ((s.highrisk = 'L' AND a.highrisk IN ('M', 'H')) OR (s.highrisk = 'M' AND a.highrisk = 'H')))
          )
          OR a.CustomerNo IS NULL 
        THEN 0 
        ELSE 1 
    END,
    s.完整分類標籤;
