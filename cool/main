--第 4 步：耐受性測試（驗證防洗機制）
--手動觸發排程同步程序，確保新帳號不會被 MERGE ... DELETE 刪除：
-- 1. 手動觸發同步排程
EXEC dbo.WORKFLOW_AutomatedUSERS;

-- 2. 再次確認新同仁資料是否依然存在
SELECT 
    q.QUEUENAME AS WorkGroup,
    u.USERID,
    r.ROLE_DESC_zh_TW AS RoleName,
    u.IsAutomated
FROM dbo.WORKFLOW_MGMT_USERS u
JOIN dbo.WORKFLOW_MGMT_QUEUE q ON u.QUEUEID = q.QUEUEID
JOIN dbo.WORKFLOW_MGMT_ROLE r ON u.ROLE = r.ID
WHERE u.USERID = '1080898';




-- 個工作群組人員與角色對應表
SELECT 
    q.QUEUENAME AS WorkGroup,      -- 工作群組名稱 (例如: 0900 CIP、Name check、Mt 等)
    u.USERID,                      -- 使用者員工工號/帳號 (對應 A.CN)
    r.ID AS ROLE_ID,               -- 角色代碼 (1: 經辦, 2: 主管/覆核, 3: AML Officer...)
    r.ROLE_DESC,                   -- 角色英文說明 (Operator - Maker / Operator - Checker)
    r.ROLE_DESC_zh_TW              -- 角色中文說明 (經辦 / 主管)
FROM dbo.WORKFLOW_MGMT_USERS u
JOIN dbo.WORKFLOW_MGMT_QUEUE q     ON u.QUEUEID = q.QUEUEID   -- 串接工作群組主表：藉由 QUEUEID 取得工作群組代碼與名稱
JOIN dbo.WORKFLOW_MGMT_ROLE r     ON u.ROLE = r.ID   -- 串接權限角色字典表：藉由 ROLE (ID) 取得角色階層與中英文名稱
WHERE q.DEL_FLAG = 'N'             -- 過濾掉已被軟刪除/停用的工作群組 
AND USERID = '1080898'

  -- AND u.ROLE = 2                -- 若只要查 Checker (主管)，可把前面的註解「--」拿掉
ORDER BY 
    q.QUEUENAME,                   -- 依群組排序
    r.ID,                          -- 同群組內依角色階層排序 (Maker 先、Checker 後)
    u.USERID;                      -- 依工號排序
        




整個流程在幫我整理一下
