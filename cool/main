-- 挑選 2 筆遷移成功的自建名單群組
SELECT TOP 2
    m.OldGroupID  AS [新光名單ID],
    g.GROUPID     AS [自建名單ID],  -- 貼 Excel A 欄 (台新新 ID)
    g.GROUPDESCR  AS [名稱],        -- 貼 Excel B 欄
    g.SpecType    AS [名單類型]
FROM dbo.lowrisklistgroups g
JOIN dbo.lowrisklistgroups_Migrate_Mapping_TEMP m 
    ON m.NewGroupId = g.GROUPID
ORDER BY g.GROUPID;
