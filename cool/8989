DECLARE @OtherIdentMthCode VARCHAR(2);
SELECT @OtherIdentMthCode = IDENTCODE FROM dbo.IDENTMTHD_DIM WHERE OTHIND = 'Y';

;WITH RawBlacklistJP AS (
    -- 條件 A：存活本名
    SELECT 
        A.EntNum, 
        A.SdnName, 
        MAX(A.UpdatedDate) AS UpdatedDate,
        'Y' AS [Cond_Is_Primary_Name],
        'N' AS [Cond_Is_Deceased_Scan],
        '本名符合 (BitCode & 1 > 0)' AS [Trigger_Reason]
    FROM BSADB.dbo.DJ_List_Data_A A WITH (NOLOCK)
    JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) ON A.EntNum = B.EntityId
    WHERE A.NamePropertyBitCode & 1 > 0
      AND B.SanctionListReference LIKE '%Japanese Finance%'
    GROUP BY A.EntNum, A.SdnName

    UNION ALL

    -- 條件 B：已故掃描（本次新增）
    SELECT 
        A.EntityId AS EntNum, 
        A.FullName AS SdnName, 
        MAX(CONVERT(VARCHAR, A.UpdatedDate_UTC, 112)) AS UpdatedDate,
        'N' AS [Cond_Is_Primary_Name],
        'Y' AS [Cond_Is_Deceased_Scan],
        '死亡名單掃描 (Deceased = 1)' AS [Trigger_Reason]
    FROM BSADB.dbo.DJ_Entity A WITH (NOLOCK)
    JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) ON A.EntityId = B.EntityId
    WHERE A.Deceased = 1
      AND B.SanctionListReference LIKE '%Japanese Finance%'
      AND NOT EXISTS (
          SELECT 1 
          FROM BSADB.dbo.DJ_List_Data_A X WITH (NOLOCK)
          JOIN BSADB.dbo.DJ_SanctionListReference Y WITH (NOLOCK) ON X.EntNum = Y.EntityId
          WHERE X.EntNum = A.EntityId 
            AND X.NamePropertyBitCode & 1 > 0
            AND Y.SanctionListReference LIKE '%Japanese Finance%'
      )
    GROUP BY A.EntityId, A.FullName
)
SELECT 
    CASE 
        WHEN T.remark IS NULL THEN '預計 INSERT (全新新增)'
        WHEN T.DInd = 'Y' THEN '預計 UPDATE (重新上架)'
        WHEN A.UpdatedDate <> T.updated_date THEN '預計 UPDATE (日期更新)'
        ELSE '資料一致 (不異動)'
    END AS [Expected_Action],
    A.[Trigger_Reason]                  AS [觸發寫入原因],
    A.[Cond_Is_Deceased_Scan]           AS [條件:死亡掃描(Y/N)],
    A.[Cond_Is_Primary_Name]             AS [條件:存活本名(Y/N)],
    'Y'                                 AS [條件:含Japanese Finance標籤],
    A.EntNum                            AS [remark(EntityId)],
    A.SdnName                           AS [spec_name(姓名)],
    A.UpdatedDate                       AS [updated_date],
    T.DInd                              AS [目前Target表DInd],
    T.ent_num                           AS [既有ent_num]
FROM RawBlacklistJP A
LEFT JOIN BSADBJP..OFAC_SPEC T WITH (NOLOCK) 
       ON T.GROUPID = 11 
      AND T.spec_name = A.SdnName 
      AND T.remark = CAST(A.EntNum AS VARCHAR(100))
ORDER BY A.[Cond_Is_Deceased_Scan] DESC, [Expected_Action] DESC, A.EntNum;

