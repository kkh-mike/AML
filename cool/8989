/*

查詢目的
匯出內部人工維護（手動建立/檔案整批匯入）且仍有效的洗錢防制關注名單，排除外部自動串接的制裁黑名單。
資料表角色
 * OFAC_GLSPEC (A)：名單主檔（人名、統編、身分證、地址、審核紀錄）。
 * OFAC_GLSpec_Source_Dim (b)：來源字典表（K = 畫面散戶、U = 整批匯入、D = 道瓊外部自動名單）。
 * COUNTRY_DIM (c)：國家字典表（將 ISO 2 碼代碼轉為英文全名）。
Code 關鍵邏輯備忘
 * b.DESCR + DESCR_zh_TW：拼出「英文+中文」來源名稱（如：Input from screen散戶名單）。
 * 'N' 黑名單 / PEP / 負面新聞：配合下游介面格式寫死為 N（代表此清單為特殊自建名單，非這三類標準標籤）。
 * convert(char(8), creDate, 112)：建立日期轉為 YYYYMMDD。
 * LEFT JOIN COUNTRY_DIM：避免主檔國家代碼為空值或填錯時整筆資料消失。
 * WHERE A.DInd = 'N'：排除已被軟刪除（Delete Indicator）的無效資料。
 * WHERE a.EnterFlag <> 'D'：核心條件，排除 D（道瓊自動名單），只保留人工維護名單。

*/



SELECT 
    a.enterflag, 
    -- 1. 串接來源英中文：例如 "Input from screen散戶名單"
    b.DESCR + DESCR_zh_TW '內部名單群組名稱',
    
    -- 2. 案件與基本資料
    a.ent_num '名單資料編號',
    convert(char(8), creDate, 112) '建立日期', -- 格式轉換為 YYYYMMDD
    a.spec_name '姓名/名稱',
    
    -- 3. 固定標記欄位（依匯出標準介面需求寫死為 'N'）
    'N' '黑名單',
    'N' PEP,          -- 政治重要人物 (Politically Exposed Persons)
    'N' '負面新聞',
    
    -- 4. 身分證號與地理資訊
    TaxIDCD '稅號代碼',
    a.TaxID '稅號/統一編號',
    a.IDNUM '證件號碼',
    a.IssBy '發照地',
    a.ADDRESS '地址',
    a.STATE '州',
    c.ISO_CountryDescription '國家', -- 關聯 c 表取得的國家英文全名
    a.DOB '出生日期',
    '' GoodsCodes_1,               -- 預留貨品代碼（空值）
    
    -- 5. 稽核與簽核紀錄（使用 isnull 避免 NULL 破壞報表排版）
    a.creUserID '建立人',
    isnull(a.ApprovedBy, '') '核准人',
    isnull(a.ApprovedDate, '') '核准日期',
    isnull(a.remark, '') '備註'

FROM BSADB..OFAC_GLSPEC A
INNER JOIN bsadbtw..OFAC_GLSpec_Source_Dim b   ON a.EnterFlag = b.SOURCE_KEY -- [關聯 b 表]：利用 SOURCE_KEY 對應名單來源類別
LEFT JOIN COUNTRY_DIM c     ON a.COUNTRY = c.ISO_2_CountryCode                -- [關聯 c 表]：利用 2 碼國別代碼換取完整國名；使用 LEFT JOIN 避免國別未填時資料被吃掉

WHERE 
    -- 排除已註銷/邏輯刪除的資料 (Delete Indicator = 'N')
    A.DInd = 'N' 
    -- 排除 D (DJ Blacklist 自動名單)，僅保留 K (散戶) 與 U (整批) 等內部名單
    AND a.EnterFlag <> 'D'

-- 依據名單群組編號及資料序號依序排序
ORDER BY A.GROUPID, a.ent_num;


