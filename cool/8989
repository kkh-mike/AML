使用 DECLARE 宣告資料表變數（Table Variable）來做批次更新與刪除，會讓 SQL 語法簡潔非常多，不用寫一堆重複的 UPDATE。
以下是使用 DECLARE 配合 JOIN 的完整優化版本（包含 USE、WITH (NOLOCK) 以及修改前後的 SELECT）：
--------------------------------------------------------------------------------
-- 第一部分：BSADBJP..FINCEN_NAICS_DIM
--------------------------------------------------------------------------------
USE BSADBJP;
GO

-- 1. 修改前查詢 (Before)
SELECT * 
FROM BSADBJP..FINCEN_NAICS_DIM WITH (NOLOCK);

-- 2. 宣告要刪除的清單並執行刪除
BEGIN
    DECLARE @DelList_BSADBJP TABLE (NAICS_Code VARCHAR(10));
    
    INSERT INTO @DelList_BSADBJP (NAICS_Code) VALUES
    ('013211'), ('013219'), ('013220'), ('014769'), ('015210'), ('015220'), 
    ('015231'), ('015232'), ('015233'), ('015241'), ('018701'), ('018702'), 
    ('018703'), ('018709'), ('019521'), ('019522'), ('019523'), ('019630'), 
    ('025241'), ('029491'), ('029523'), ('029630');

    DELETE t
    FROM BSADBJP..FINCEN_NAICS_DIM AS t WITH (NOLOCK)
    INNER JOIN @DelList_BSADBJP AS d ON t.NAICS_Code = d.NAICS_Code;
END;

-- 3. 宣告要更新的清單並執行批次更新
BEGIN
    DECLARE @UpdList_BSADBJP TABLE (
        NAICS_Code  VARCHAR(10),
        Description NVARCHAR(100)
    );

    INSERT INTO @UpdList_BSADBJP (NAICS_Code, Description) VALUES
    ('015219', N'其他陸上運輸輔助業'),
    ('015229', N'其他水上運輸輔助業'),
    ('015821', N'數位遊戲軟體出版業'),
    ('016110', N'有線、無線及衛星電信業'),
    ('016211', N'數位遊戲、軟體及其工具開發業'),
    ('016219', N'其他電腦程式設計業'),
    ('024769', N'其他文教育樂用品零售業'),
    ('024830', N'資訊及通訊設備零售業'),
    ('025219', N'其他陸上運輸輔助業'),
    ('025229', N'其他水上運輸輔助業'),
    ('025821', N'數位遊戲軟體出版業'),
    ('026110', N'有線、無線及衛星電信業');

    UPDATE t
    SET t.Description = u.Description
    FROM BSADBJP..FINCEN_NAICS_DIM AS t WITH (NOLOCK)
    INNER JOIN @UpdList_BSADBJP AS u ON t.NAICS_Code = u.NAICS_Code;
END;

-- 4. 修改後查詢 (After)
SELECT * 
FROM BSADBJP..FINCEN_NAICS_DIM WITH (NOLOCK);


