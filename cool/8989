

/*
拷貝別人的權限
*/
BEGIN TRAN;

DECLARE @NewUser NVARCHAR(60) = '922798';   -- 新同仁工號
DECLARE @SampleUser NVARCHAR(60) = '1091707'; -- 範本同仁工號

INSERT INTO dbo.WORKFLOW_MGMT_USERS (
    QUEUEID, 
    USERID, 
    ROLE, 
    ALERTMAIN, 
    ALERTPERSONAL, 
    IsAutomated
)
SELECT 
    QUEUEID, 
    @NewUser, 
    ROLE, 
    ALERTMAIN, 
    ALERTPERSONAL, 
    'FALSE' -- 核心關鍵：設為 FALSE，確保排程 MERGE 時永不被自動刪除
FROM dbo.WORKFLOW_MGMT_USERS
WHERE USERID = @SampleUser
  AND NOT EXISTS (
      SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS 
      WHERE USERID = @NewUser 
        AND QUEUEID = dbo.WORKFLOW_MGMT_USERS.QUEUEID 
        AND ROLE = dbo.WORKFLOW_MGMT_USERS.ROLE
  );

-- 檢查新增筆數與內容
SELECT * FROM dbo.WORKFLOW_MGMT_USERS WHERE USERID = @NewUser;

-- 檢查無誤執行 COMMIT 存檔；若有異常反白執行 ROLLBACK 取消
COMMIT TRAN;
-- ROLLBACK TRAN;



