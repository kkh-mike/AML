/* ==========================================================================
 * 1. CIP 規則條件描述範本維度表
 * 說明：
 *   存放反洗錢（AML）中客戶審查 / 身分識別（KYC / CIP）各項檢核條件的文字範本。
 *   主要用於系統介面呈現、規則設定及報表產出時的多語系對照。
 * ========================================================================== */
SELECT 
    QueryId,        -- 條件規則唯一識別碼（Rule / Condition Query ID）
    DESCR,          -- 英文規則描述範本（English Description，含前端排版 HTML tag）
    DESCR_zh_TW     -- 繁體中文規則描述範本（Traditional Chinese Description）
FROM 
    CIP_TEMPLATE_DIM
ORDER BY 
    QueryId;


/* ==========================================================================
 * 2. SAR 可疑交易情境規則範本表
 * 說明：
 *   存放可疑交易申報（SAR）與交易監控情境（Scenario）的警示觸發語法範本。
 *   內容包含帶參數變數（如 {Parameter1}、{Parameter2}）的語句，
 *   在系統觸發警示時會動態代入交易金額、天數、頻率等實際數值。
 * ========================================================================== */
SELECT 
    QueryId,        -- 情境規則識別碼（Scenario Query ID）
    Syntax,         -- 英文情境語法範本（English Scenario Syntax，含參數變數）
    Syntax_zh_TW    -- 繁體中文情境語法範本（Traditional Chinese Scenario Syntax）
FROM 
    SAR_ScenarioTemplates
ORDER BY 
    QueryId;

