# ==========================================
# SAR_Trxn_Detail_All.sql
# 自動分割 + 依序執行 SQL
# 適合超大型 SQL
# ==========================================
$SourceFile = "D:\AML_Source\20251114_新光資轉\SKBStagingData\新增資料夾\TSEST\SAR_Trxn_Detail_All.sql"
$BaseFolder   = Split-Path $SourceFile -Parent
$OutputFolder = Join-Path $BaseFolder "Split"
$LogFolder    = Join-Path $BaseFolder "Log"
$Server   = "amlist"
$User     = "aml"
$Password = "aml1234"
$Database = "SARCaseWarehouse"
# ==========================================
# 1. 檢查來源 SQL
# ==========================================
if (!(Test-Path $SourceFile)) {
    Write-Host "找不到 SQL：" -ForegroundColor Red
    Write-Host $SourceFile
    exit 1
}
# ==========================================
# 2. 建立資料夾
# ==========================================
if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}
# ==========================================
# 3. 清除舊的分割 SQL / Log
# ==========================================
Write-Host ""
Write-Host "清除舊檔案..."
Get-ChildItem $OutputFolder -Filter "SAR_Trxn_Detail_All_*.sql" -ErrorAction SilentlyContinue |
    Remove-Item -Force
Get-ChildItem $LogFolder -Filter "SAR_Trxn_Detail_All_*.log" -ErrorAction SilentlyContinue |
    Remove-Item -Force
# ==========================================
# 4. 開始串流讀取 SQL
# ==========================================
Write-Host ""
Write-Host "開始分割 SQL..."
Write-Host "來源：$SourceFile"
Write-Host ""
$Index = 1
$Writer = $null
$BatchHasContent = $false
# 使用 StreamReader
$Reader = New-Object System.IO.StreamReader(
    $SourceFile,
    [System.Text.Encoding]::Default,
    $true
)
try {
    while (($Line = $Reader.ReadLine()) -ne $null) {
        # 判斷是不是 GO
        if ($Line -match '^\s*GO\s*;?\s*$') {
            # 如果目前有 SQL 內容
            if ($BatchHasContent -and $Writer -ne $null) {
                $Writer.WriteLine("GO")
                $Writer.Close()
                $Writer.Dispose()
                $Writer = $null
                Write-Host "產生：SAR_Trxn_Detail_All_$Index.sql"
                $Index++
                $BatchHasContent = $false
            }
            continue
        }
        # 第一次遇到 SQL 時建立檔案
        if ($Writer -eq $null) {
            $OutputFile = Join-Path `
                $OutputFolder `
                "SAR_Trxn_Detail_All_$Index.sql"
            $Writer = New-Object System.IO.StreamWriter(
                $OutputFile,
                $false,
                [System.Text.Encoding]::UTF8
            )
        }
        # 寫入目前這一行
        $Writer.WriteLine($Line)
        # 判斷是不是有實際 SQL
        if ($Line.Trim().Length -gt 0) {
            $BatchHasContent = $true
        }
    }
    # ==========================================
    # 5. 處理最後一個 Batch
    # ==========================================
    if ($Writer -ne $null) {
        if ($BatchHasContent) {
            $Writer.WriteLine("GO")
            Write-Host "產生：SAR_Trxn_Detail_All_$Index.sql"
            $Index++
        }
        $Writer.Close()
        $Writer.Dispose()
        $Writer = $null
    }
}
finally {
    if ($Reader -ne $null) {
        $Reader.Close()
        $Reader.Dispose()
    }
    if ($Writer -ne $null) {
        $Writer.Close()
        $Writer.Dispose()
    }
}
# ==========================================
# 6. 計算總檔案數
# ==========================================
$Total = $Index - 1
Write-Host ""
Write-Host "========================================="
Write-Host "SQL 分割完成"
Write-Host "========================================="
Write-Host "總共產生：$Total 個 SQL 檔案"
Write-Host "輸出位置：$OutputFolder"
Write-Host ""
# ==========================================
# 7. 開始依序執行 SQL
# ==========================================
$Success = 0
$Failed  = 0
Write-Host "========================================="
Write-Host "開始執行 SQL"
Write-Host "========================================="
Write-Host ""
for ($i = 1; $i -le $Total; $i++) {
    $SqlFile = Join-Path `
        $OutputFolder `
        "SAR_Trxn_Detail_All_$i.sql"
    $LogFile = Join-Path `
        $LogFolder `
        "SAR_Trxn_Detail_All_$i.log"
    Write-Host "-----------------------------------------"
    Write-Host "執行 [$i / $Total]"
    Write-Host "SQL：SAR_Trxn_Detail_All_$i.sql"
    Write-Host "-----------------------------------------"
    sqlcmd `
        -S $Server `
        -U $User `
        -P $Password `
        -d $Database `
        -i $SqlFile `
        -o $LogFile
    $ExitCode = $LASTEXITCODE
    if ($ExitCode -eq 0) {
        Write-Host "SUCCESS：第 $i 份執行成功" `
            -ForegroundColor Green
        $Success++
    }
    else {
        Write-Host "FAILED：第 $i 份執行失敗" `
            -ForegroundColor Red
        Write-Host "請檢查 Log：" `
            -ForegroundColor Yellow
        Write-Host $LogFile
        $Failed++
        # ==========================================
        # 遇到錯誤停止
        # ==========================================
        Write-Host ""
        Write-Host "SQL 執行失敗，停止後續執行。" `
            -ForegroundColor Red
        break
    }
}
# ==========================================
# 8. 最終結果
# ==========================================
Write-Host ""
Write-Host "========================================="
Write-Host "全部處理完成"
Write-Host "========================================="
Write-Host "總 SQL：$Total"
Write-Host "成功：$Success"
Write-Host "失敗：$Failed"
Write-Host ""
Write-Host "SQL 檔案位置："
Write-Host $OutputFolder
Write-Host ""
Write-Host "Log 檔案位置："
Write-Host $LogFolder
if ($Failed -eq 0) {
    Write-Host ""
    Write-Host "========================================="
    Write-Host "全部 SQL 執行成功！"
    Write-Host "=========================================" `
        -ForegroundColor Green
}
else {
    Write-Host ""
    Write-Host "========================================="
    Write-Host "有 SQL 執行失敗！"
    Write-Host "請檢查對應的 Log。"
    Write-Host "=========================================" `
        -ForegroundColor Red
}
Write-Host ""
Read-Host "按 Enter 結束"