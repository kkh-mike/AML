SELECT DISTINCT
    NULL AS sdn_grp_num,
    A.EntityId,
    A.FullName AS SdnName,
    CONVERT(VARCHAR, A.UpdatedDate_UTC, 112) AS UpdatedDate
FROM BSADBJP..OFAC_SPEC F
JOIN BSADB.dbo.DJ_Entity A WITH (NOLOCK)
    ON A.FullName = F.spec_name
JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK)
    ON A.EntityId = B.EntityId
JOIN BSADBJP..BlackListData H
    ON F.spec_name = H.sdn_name
WHERE A.Deceased = 1 
  AND B.SanctionListReference LIKE '%Japanese Finance%';