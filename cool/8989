$SourceFile = "D:\AML_Source\20251114_新光資轉\SKBStagingData\新增資料夾\TSEST\SAR_Trxn_Detail_All.sql"

$BaseFolder   = Split-Path $SourceFile -Parent
$OutputFolder = Join-Path $BaseFolder "Split"
$LogFolder    = Join-Path $BaseFolder "Log"

$Server   = "amlist"
$User     = "aml"
$Password = "aml1234"
$Database = "SARCaseWarehouse"

# 每個檔案 10,000 個 SQL 指令
$RowsPerFile = 10000


# ==========================================
# 建立資料夾
# ==========================================

if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}

if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}


# ==========================================
# 清除舊檔案
# ==========================================

Write-Host "清除舊檔案..."

Get-ChildItem $OutputFolder -Filter "SAR_Trxn_Detail_All_*.sql" `
    -ErrorAction SilentlyContinue |
    Remove-Item -Force

Get-ChildItem $LogFolder -Filter "SAR_Trxn_Detail_All_*.log" `
    -ErrorAction SilentlyContinue |
    Remove-Item -Force


# ==========================================
# 開始分割
# ==========================================

Write-Host ""
Write-Host "開始分割 SQL..."
Write-Host "每 $RowsPerFile 個 SQL 指令一個檔案"
Write-Host ""


$Reader = New-Object System.IO.StreamReader(
    $SourceFile,
    [System.Text.Encoding]::Default,
    $true
)

$FileIndex = 1
$RowCount = 0
$TotalRows = 0
$Writer = $null


try {

    while (($Line = $Reader.ReadLine()) -ne $null) {

        # 每 10,000 行開新檔案
        if ($RowCount -eq 0) {

            if ($Writer -ne $null) {
                $Writer.Close()
                $Writer.Dispose()
            }

            $OutputFile = Join-Path `
                $OutputFolder `
                "SAR_Trxn_Detail_All_$FileIndex.sql"

            $Writer = New-Object System.IO.StreamWriter(
                $OutputFile,
                $false,
                [System.Text.Encoding]::UTF8
            )

            Write-Host "建立：SAR_Trxn_Detail_All_$FileIndex.sql"

            $FileIndex++
        }


        # 完全原封不動寫入
        $Writer.WriteLine($Line)

        $RowCount++
        $TotalRows++


        # 10,000 個 SQL 指令
        if ($RowCount -eq $RowsPerFile) {

            $Writer.Close()
            $Writer.Dispose()
            $Writer = $null

            Write-Host "  完成 $RowsPerFile 個 SQL"

            $RowCount = 0
        }
    }


    # ==========================================
    # 最後一個檔案
    # ==========================================

    if ($Writer -ne $null) {

        $Writer.Close()
        $Writer.Dispose()
        $Writer = $null

        Write-Host "  完成最後 $RowCount 個 SQL"
    }

}
finally {

    if ($Reader -ne $null) {
        $Reader.Close()
        $Reader.Dispose()
    }

    if ($Writer -ne $null) {
        $Writer.Close()
        $Writer.Dispose()
    }
}


$TotalFiles = $FileIndex - 1


# ==========================================
# 分割結果
# ==========================================

Write-Host ""
Write-Host "========================================="
Write-Host "分割完成"
Write-Host "========================================="
Write-Host "總 SQL 指令：$TotalRows"
Write-Host "每檔 SQL：$RowsPerFile"
Write-Host "總檔案數：$TotalFiles"
Write-Host ""


# ==========================================
# 開始執行
# ==========================================

$Success = 0
$Failed = 0

Write-Host "開始執行 SQL..."
Write-Host ""


for ($i = 1; $i -le $TotalFiles; $i++) {

    $SqlFile = Join-Path `
        $OutputFolder `
        "SAR_Trxn_Detail_All_$i.sql"

    $LogFile = Join-Path `
        $LogFolder `
        "SAR_Trxn_Detail_All_$i.log"


    Write-Host "========================================="
    Write-Host "執行 [$i / $TotalFiles]"
    Write-Host "========================================="


    sqlcmd `
        -S $Server `
        -U $User `
        -P $Password `
        -d $Database `
        -i $SqlFile `
        -o $LogFile


    if ($LASTEXITCODE -eq 0) {

        Write-Host "SUCCESS" -ForegroundColor Green
        $Success++

    }
    else {

        Write-Host "FAILED" -ForegroundColor Red
        Write-Host "Log：$LogFile" -ForegroundColor Yellow

        $Failed++

        Write-Host ""
        Write-Host "發生錯誤，停止後續執行。" `
            -ForegroundColor Red

        break
    }
}


# ==========================================
# 最終結果
# ==========================================

Write-Host ""
Write-Host "========================================="
Write-Host "完成"
Write-Host "========================================="
Write-Host "總檔案：$TotalFiles"
Write-Host "成功：$Success"
Write-Host "失敗：$Failed"

Write-Host ""
Write-Host "SQL：$OutputFolder"
Write-Host "Log：$LogFolder"

Read-Host "按 Enter 結束"