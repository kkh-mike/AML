    );

    CREATE TABLE #tempDJBlacklistDetailsJP
    (
        Num         INT,
        EntNum      INT NOT NULL,
        SdnName     NVARCHAR(350) NOT NULL,
        UpdatedDate VARCHAR(8) NOT NULL,
        Address     NVARCHAR(400),
        City        NVARCHAR(200),
        Country     NVARCHAR(100),
        IdentType   VARCHAR(2),
        IdentNumber NVARCHAR(44),
        DOB         VARCHAR(8),
        GroupId     INT NOT NULL,               -- 新增：區分 5 或 6
        SourceName  VARCHAR(50) NOT NULL        -- 新增：對應的 SOURCE 名稱
    );

    /*
        ============================================================
        1. 死亡名單掃描 -> 放入 GROUPID = 6
        （優先撈取死亡名單，或明確標記 Deceased = 1）
        ============================================================
    */
    INSERT INTO #tempDJBlacklistJP (EntNum, SdnName, UpdatedDate, GroupId, SourceName)
    SELECT 
        A.EntityId, 
        A.FullName, 
        MAX(CONVERT(VARCHAR, A.UpdatedDate_UTC, 112)) AS UpdatedDate,
        6 AS GroupId,
        'MOF Sanction List (Decease) ' AS SourceName
    FROM BSADB.dbo.DJ_Entity A
    JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
    WHERE A.Deceased = 1
      AND B.SanctionListReference LIKE '%Japanese Finance%'
    GROUP BY A.EntityId, A.FullName;

    /*
        ============================================================
        2. 一般名單（非死亡）掃描 -> 放入 GROUPID = 5
        ============================================================
    */
    INSERT INTO #tempDJBlacklistJP (EntNum, SdnName, UpdatedDate, GroupId, SourceName)
    SELECT 
        A.EntNum, 
        A.SdnName, 
        MAX(A.UpdatedDate) AS UpdatedDate,
        5 AS GroupId,
        'MOF Sanction List' AS SourceName
    FROM BSADB.dbo.DJ_List_Data_A A
    JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntNum = B.EntityId
    WHERE A.NamePropertyBitCode & 1 > 0
      AND B.SanctionListReference LIKE '%Japanese Finance%'
      -- 排除已經在上方被歸類為死亡名單 (GROUPID = 6) 的人員
      AND NOT EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE X.EntNum = A.EntNum)
    GROUP BY A.EntNum, A.SdnName;

    /*
        ============================================================
        3. 【新增】自動檢查：若 OFAC_SPEC 的 GROUPID = 6 混入活人，先移去 GROUPID = 5
        （判斷依據：在 GROUPID = 6 中，但在 DJ_Entity 為活人，或本次被歸類在 #tempDJBlacklistJP 的 GroupId = 5）
        ============================================================
    */
    UPDATE T
    SET 
        T.GROUPID          = 5,
        T.SOURCE           = 'MOF Sanction List',
        T.EnterFlag        = 'D',
        T.updated_date_UTC = GETUTCDATE()
    OUTPUT 
        Inserted.ent_num, Inserted.spec_name, Inserted.updated_date, Inserted.remark,
        Inserted.TaxID, Inserted.IDENT, Inserted.IDENTO, Inserted.TaxIDCD, Inserted.IDNUM,
        Inserted.IssBy, Inserted.DInd, Inserted.creUserID, 'System Admin', GETUTCDATE(),
        '02', -- ActionCD = '02' (修改群組)
        Inserted.ADDRESS, Inserted.STATE, Inserted.COUNTRY, Inserted.GROUPID, Inserted.SOURCE,
        Inserted.EnterFlag, Inserted.ApprovedBy, Inserted.ApprovedDate, Inserted.DelUserID,
        Inserted.DelDate, Inserted.ApproveDelUserID, Inserted.ApproveDelDate, GETUTCDATE(),
        Inserted.ApprovedDate_UTC, Inserted.DelDate_UTC, Inserted.ApproveDelDate_UTC, Inserted.DOB
    INTO BSADBJP.dbo.OFAC_SPEC_LOG
        (ent_num, spec_name, updated_date, remark, TaxID, IDENT, IDENTO, TaxIDCD, IDNUM,
         IssBy, DInd, creUserID, UserID, ActionDT, ActionCD, Address, State, Country, GROUPID, SOURCE,
         EnterFlag, ApprovedBy, ApprovedDate, DelUserID, DelDate, ApproveDelUserID, ApproveDelDate,
         ActionDT_UTC, ApprovedDate_UTC, DelDate_UTC, ApproveDelDate_UTC, DOB)
    FROM BSADBJP..OFAC_SPEC T
    JOIN BSADB.dbo.DJ_Entity E ON T.remark = CAST(E.EntityId AS VARCHAR(100))
    WHERE T.GROUPID = 6
      AND ISNULL(E.Deceased, 0) = 0  -- 在來源表確認為活人（非死亡）
      -- 防呆：確保 GROUPID = 5 裡面還沒有同一筆紀錄，避免變更後產生重複資料
      AND NOT EXISTS (
          SELECT 1 FROM BSADBJP..OFAC_SPEC G5
          WHERE G5.GROUPID = 5
            AND G5.spec_name = T.spec_name
            AND G5.remark = T.remark
      );


    /*
        ============================================================
        4. 組裝明細與比對現有 ent_num（此時活人已位於 GROUPID = 5）
        ============================================================
    */
    ;WITH TempAddress AS
    (
        SELECT A.EntityId, A.Address, A.City, A.AddressCountry,
               ROW_NUMBER() OVER (PARTITION BY A.EntityId ORDER BY A.Id) AS RowId
        FROM BSADB.dbo.DJ_Address A WITH (NOLOCK)
        WHERE A.Deleted = 0
          AND EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE A.EntityId = X.EntNum)
    ),
    TempIdent AS
    (
        SELECT A.EntityId,
               CASE WHEN ISNULL(A.IdentificationType,'') = '' THEN NULL ELSE @OtherIdentMthCode END AS IdentificationType,
               A.IdentificationNumber,
               ROW_NUMBER() OVER (PARTITION BY A.EntityId ORDER BY A.Id) AS RowId
        FROM BSADB.dbo.DJ_IdentificationTypeInfo A WITH (NOLOCK)
        WHERE A.Deleted = 0
          AND EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE A.EntityId = X.EntNum)
    ),
    TempDOB AS
    (
        SELECT A.EntityId, A.InfoDay, A.InfoMonth, A.InfoYear,
               ROW_NUMBER() OVER (PARTITION BY A.EntityId ORDER BY A.Id) AS RowId
        FROM BSADB.dbo.DJ_DateTypeInfo A WITH (NOLOCK)
        WHERE A.DateType = 'Date of Birth'
          AND A.Deleted = 0
          AND EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE A.EntityId = X.EntNum)
    ),
    TempNUM AS
    (
        -- 同時取 GROUPID 5 與 6 的現有單號
        SELECT A.spec_name, A.updated_date, A.remark, A.ent_num, A.GROUPID
        FROM BSADBJP..OFAC_SPEC A
        WHERE A.GROUPID IN (5, 6) AND A.DInd = 'N'
    )
    INSERT INTO #tempDJBlacklistDetailsJP (Num, EntNum, SdnName, UpdatedDate, Address, City, Country, IdentType, IdentNumber, DOB, GroupId, SourceName)
    SELECT 
        E.ent_num,
        A.EntNum,
        A.SdnName,
        A.UpdatedDate,
        B.Address,
        LEFT(B.City, 100),
        COALESCE(F.ISO_2_CountryCode, LEFT(B.AddressCountry, 100)) AS Country,
        C.IdentificationType,
        LEFT(C.IdentificationNumber, 44),
        CASE WHEN D.InfoDay IS NULL OR D.InfoMonth IS NULL 
             THEN D.InfoYear 
             ELSE CONVERT(VARCHAR(8), dbo.TryParseDate(D.InfoYear + ' ' + D.InfoMonth + ' ' + D.InfoDay), 112) 
        END,
        A.GroupId,
        A.SourceName
    FROM #tempDJBlacklistJP A
    LEFT JOIN TempAddress B ON A.EntNum = B.EntityId AND B.RowId = 1
    LEFT JOIN TempIdent   C ON A.EntNum = C.EntityId AND C.RowId = 1
    LEFT JOIN TempDOB     D ON A.EntNum = D.EntityId AND D.RowId = 1
    -- 比對時加上 GroupId，確保同群組才沿用舊 ent_num
    LEFT JOIN TempNUM     E ON CAST(A.EntNum AS VARCHAR(100)) = E.remark 
                           AND A.SdnName = E.spec_name 
                           AND A.GroupId = E.GROUPID
    OUTER APPLY (
        SELECT TOP 1 CD.ISO_2_CountryCode
        FROM COUNTRY_DIM CD WITH (NOLOCK)
        WHERE B.AddressCountry IS NOT NULL
          AND B.AddressCountry IN (
              CD.ISO_CountryDescription,
              CD.ISO_CountryDescription_zh_TW,
              CD.ISO_CountryDescription_zh_CN,
              CD.ISO_CountryDescription_Default
          )
    ) F;

    DECLARE @MAXNo INT;
    SELECT @MAXNo = ISNULL(MAX(ent_num), 0) FROM BSADBJP..OFAC_SPEC;

    UPDATE #tempDJBlacklistDetailsJP
    SET @MAXNo = @MAXNo + 1,
        Num = @MAXNo
    WHERE Num IS NULL;

    /*
        ============================================================
        5. MERGE 同步至 BSADBJP..OFAC_SPEC
        ============================================================
    */
    ;WITH TargetTable AS
    (
        -- 目標表同時涵蓋 GROUPID 5 與 6
        SELECT *
        FROM BSADBJP..OFAC_SPEC
        WHERE GROUPID IN (5, 6)
    )
    MERGE TargetTable AS T
    USING (SELECT Num, EntNum, SdnName, UpdatedDate, Address, City, Country, IdentType, IdentNumber, DOB, GroupId, SourceName 
           FROM #tempDJBlacklistDetailsJP) AS S
    ON T.spec_name = S.SdnName 
   AND T.remark = CAST(S.EntNum AS VARCHAR(100))
   AND T.GROUPID = S.GroupId  -- 加入 GROUPID 作為比對條件

    WHEN NOT MATCHED BY TARGET THEN
        INSERT (spec_name, updated_date, remark, TaxID, IDENT, IDENTO, TaxIDCD, IDNUM, IssBy, DInd,
                creUserID, STATE, ADDRESS, COUNTRY, GROUPID, SOURCE, EnterFlag, ApprovedBy, ApprovedDate,
                DelUserID, DelDate, ApproveDelUserID, ApproveDelDate, creDate,
                updated_date_UTC, ApprovedDate_UTC, DelDate_UTC, ApproveDelDate_UTC, creDate_UTC, ent_num, DOB)
        VALUES (S.SdnName, S.UpdatedDate, S.EntNum, '', S.IdentType, S.IdentNumber, '', '', 'JP', 'N',
                'System Admin', ISNULL(S.City, ''), S.Address, S.Country, S.GroupId, S.SourceName, NULL,
                'System Admin', GETDATE(), NULL, NULL, NULL, NULL, GETDATE(),
                GETUTCDATE(), GETUTCDATE(), NULL, NULL, GETUTCDATE(), S.Num, S.DOB)

    WHEN NOT MATCHED BY SOURCE AND T.DInd = 'N' THEN
        UPDATE SET 
            T.DInd = 'Y',
            T.DelUserID = 'System Admin',
            T.DelDate = GETDATE(),
            T.ApproveDelUserID = 'System Admin',
            T.ApproveDelDate = GETDATE(),
            T.DelDate_UTC = GETUTCDATE()

    WHEN MATCHED AND (T.DInd = 'Y' OR S.UpdatedDate <> T.updated_date) THEN
        UPDATE SET 
            T.DInd = 'N',
            T.updated_date = S.UpdatedDate,
            T.DelUserID = NULL,
            T.DelDate = NULL,
            T.ApproveDelUserID = NULL,
            T.ApproveDelDate = NULL,
            T.DelDate_UTC = NULL,
            T.EnterFlag = 'D',
            T.updated_date_UTC = GETUTCDATE(),
            T.ADDRESS = S.Address,
            T.STATE = ISNULL(S.City, ''),
            T.COUNTRY = S.Country,
            T.IDENT = S.IdentType,
            T.IDNUM = S.IdentNumber,
            T.DOB = S.DOB

