$header = @{
    Accept = "application/json"
}

function Get-ReferenceNoFromFileName {
    param(
        [Parameter(Mandatory = $true)]
        [string]$MessageFile
    )

    $fileNameWithoutExtension = [System.IO.Path]::GetFileNameWithoutExtension($MessageFile)

    # 前兩段是 BankNo、CompletedDate；最後一段是流水號；
    # 中間部分（包含底線）是 ClientReferenceNo。
    if ($fileNameWithoutExtension -notmatch '^[^_]+_[^_]+_(?<ClientReferenceNo>.+)_[^_]+$') {
        throw "檔名格式不正確，預期格式為 BankNo_CompletedDate_ClientReferenceNo_流水號.txt：$MessageFile"
    }

    $clientReferenceNo = $Matches['ClientReferenceNo']

    if ([string]::IsNullOrWhiteSpace($clientReferenceNo)) {
        throw "檔名中的 ClientReferenceNo 不可為空：$MessageFile"
    }

    return $clientReferenceNo + '0'
}

