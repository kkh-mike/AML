IF @ModuleName = 'TRXN'
                        BEGIN
                                                
						--CREATE CLUSTERED INDEX IX_LoadTrxn_CIF 
						--ON dbo.LoadTrxn_Migrate_buffer (CIF_KEY);
						
						--CREATE INDEX IX_LoadTrxn_YYYYMM
						--ON dbo.LoadTrxn_Migrate_buffer (YYYYMM);	
						
						--CREATE INDEX IX_LoadTrxn_ACCT_KEY 
						--ON dbo.LoadTrxn_Migrate_buffer (ACCT_KEY);	
						
                        IF OBJECT_ID('tempdb..#TrxnAcctFinalMapping') IS NOT NULL
                            DROP TABLE #TrxnAcctFinalMapping;

                        CREATE TABLE #TrxnAcctFinalMapping
                            (
                              SourceAcctKey NVARCHAR(100) ,
                              FinalAcctKey NVARCHAR(100)
                            );
                        
                        IF ISNULL(@AcctMappingTable, '') <> ''
						BEGIN
							SET @sql = '
							WITH MappedAccounts AS (
								SELECT
									A.ACCT_KEY AS SourceAcctKey,
									-- If a match exists in M, use it. Otherwise, apply the prefix.
									COALESCE(M.' + QUOTENAME(@AcctMappingTargetColumn) + ', 
											 ''' + ISNULL(@Prefix, '') + ''' + A.ACCT_KEY) AS FinalAcctKey,
									ROW_NUMBER() OVER (PARTITION BY A.ACCT_KEY ORDER BY (SELECT 1)) as rn
								FROM dbo.LoadTrxn_Migrate_buffer A
								LEFT JOIN ' + QUOTENAME(@AcctMappingTable) + ' M
									ON M.' + QUOTENAME(@AcctMappingSourceColumn) + ' = (
										CASE 
											WHEN LEN(A.ACCT_KEY) < 25 
											THEN RIGHT(REPLICATE(''0'', 25) + A.ACCT_KEY, 25) 
											ELSE A.ACCT_KEY 
										END)
							)
							INSERT INTO #TrxnAcctFinalMapping (SourceAcctKey, FinalAcctKey)
							SELECT
								SourceAcctKey,
								FinalAcctKey
							FROM MappedAccounts
							WHERE rn = 1 
							AND ISNULL(SourceAcctKey, '''') <> '''';';

							EXEC sp_executesql @sql;
						END
						ELSE
						BEGIN
                                WITH    PrefixedAccounts
                                          AS ( SELECT   ACCT_KEY AS SourceAcctKey ,
                                                        ISNULL(@Prefix, '')
                                                        + ACCT_KEY AS FinalAcctKey ,
                                                        ROW_NUMBER() OVER ( PARTITION BY ACCT_KEY ORDER BY ( SELECT
                                                              1
                                                              ) ) AS rn
                                               FROM     dbo.LoadTrxn_Migrate_buffer
                                             )
                                    INSERT  INTO #TrxnAcctFinalMapping
                                            ( SourceAcctKey ,
                                              FinalAcctKey
                                            )
                                            SELECT  SourceAcctKey ,
                                                    FinalAcctKey
                                            FROM    PrefixedAccounts
                                            WHERE   rn = 1 -- Keep only the first unique account
                                                    AND ISNULL(SourceAcctKey,
                                                              '') <> '';                        
						END
						CREATE CLUSTERED INDEX IX_SourceAcctKey ON #TrxnAcctFinalMapping(SourceAcctKey);
              -- WIRE MTHLY FACT
                            INSERT  INTO dbo.WIRE_MTHLY_FACT
                                    ( CIF_KEY ,
                                      YYYYMM ,
                                      WIRETTL ,
                                      WIRECRTTL ,
                                      WIREDRTTL ,
                                      WIRECNT ,
                                      WIRECRCNT ,
                                      WIREDRCNT ,
                                      WIREMIN ,
                                      WIREMAX ,
                                      CRMIN ,
                                      DRMIN ,
                                      CRMAX ,
                                      DRMAX ,
                                      WIRETTL_D ,
                                      WIRECRTTL_D ,
                                      WIREDRTTL_D ,
                                      WIRECNT_D ,
                                      WIRECRCNT_D ,
                                      WIREDRCNT_D ,
                                      WIREMIN_D ,
                                      WIREMAX_D ,
                                      CRMIN_D ,
                                      DRMIN_D ,
                                      CRMAX_D ,
                                      DRMAX_D ,
                                      WIRETTL_F ,
                                      WIRECRTTL_F ,
                                      WIREDRTTL_F ,
                                      WIRECNT_F ,
                                      WIRECRCNT_F ,
                                      WIREDRCNT_F ,
                                      WIREMIN_F ,
                                      WIREMAX_F ,
                                      CRMIN_F ,
                                      DRMIN_F ,
                                      CRMAX_F ,
                                      DRMAX_F
                                      )
                                    SELECT  B.NEW_CIF_KEY ,
                                            YYYYMM ,
                                            TTL ,
                                            CRTTL ,
                                            DRTTL ,
                                            CNT ,
                                            CRCNT ,
                                            DRCNT ,
                                            MIN ,
                                            MAX ,
                                            CRMIN ,
                                            DRMIN ,
                                            CRMAX ,
                                            DRMAX ,
                                            TTL_D ,
                                            CRTTL_D ,
                                            DRTTL_D ,
                                            CNT_D ,
                                            CRCNT_D ,
                                            DRCNT_D ,
                                            MIN_D ,
                                            MAX_D ,
                                            CRMIN_D ,
                                            DRMIN_D ,
                                            CRMAX_D ,
                                            DRMAX_D ,
                                            TTL_F ,
                                            CRTTL_F ,
                                            DRTTL_F ,
                                            CNT_F ,
                                            CRCNT_F ,
                                            DRCNT_F ,
                                            MIN_F ,
                                            MAX_F ,
                                            CRMIN_F ,
                                            DRMIN_F ,
                                            CRMAX_F ,
                                            DRMAX_F
                                    FROM    dbo.LoadTrxn_Migrate_buffer A
                                            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.SOURCE_CIF_KEY
                                    WHERE   TrxnType = 'WIRE MTHLY FACT'
                                            AND NOT EXISTS ( SELECT
                                                              1
                                                             FROM
                                                              dbo.WIRE_MTHLY_FACT Z
                                                             WHERE
                                                              Z.CIF_KEY = B.NEW_CIF_KEY
                                                              AND Z.YYYYMM = A.YYYYMM );


															  -- WIRE FACT
                            INSERT  INTO dbo.WIRE_TXN_FACT
                                    ( TRANDT ,
                                      CIF_KEY ,
                                      APPL ,
                                      ACCT_KEY ,
                                      reference
                                    )
                                    SELECT  A.TRANDT ,
                                            B.NEW_CIF_KEY ,
                                            A.APPL ,
                                            ISNULL(C.FinalAcctKey,ISNULL(@Prefix,'') + A.ACCT_KEY) ,
                                            A.reference
                                    FROM    dbo.LoadTrxn_Migrate_buffer A
											LEFT JOIN #TrxnAcctFinalMapping C ON A.ACCT_KEY = C.SourceAcctKey
                                            INNER JOIN dbo.CIF_Migrate_Mapping_TEMP B ON A.CIF_KEY = B.SOURCE_CIF_KEY
                                    WHERE   TrxnType = 'WIRE FACT'
                                            AND NOT EXISTS ( SELECT
                                                              1
                                                             FROM
                                                              dbo.WIRE_TXN_FACT Z
                                                             WHERE
                                                              Z.CIF_KEY = B.NEW_CIF_KEY 
                                                              AND Z.ACCT_KEY = ISNULL(C.FinalAcctKey, ISNULL(@Prefix,'') + A.ACCT_KEY)
                                                              AND Z.reference = A.reference );



