DECLARE @SearchName NVARCHAR(350) = 'User給的姓名';

SELECT 
    E.EntityId,
    E.FullName,
    E.Deceased AS [是否死亡(1=是)],
    R.SanctionListReference AS [命中制裁清單],
    L.NamePropertyBitCode AS [姓名類型BitCode],
    T.DInd AS [目標表狀態(N有效/Y刪除/NULL未寫入)]
FROM BSADB.dbo.DJ_Entity E
LEFT JOIN BSADB.dbo.DJ_SanctionListReference R 
    ON E.EntityId = R.EntityId AND R.SanctionListReference LIKE '%Japanese Finance%'
LEFT JOIN BSADB.dbo.DJ_List_Data_A L 
    ON E.EntityId = L.EntNum AND L.SdnName = E.FullName
LEFT JOIN BSADBJP..OFAC_SPEC T 
    ON T.remark = CAST(E.EntityId AS VARCHAR(100)) AND T.GROUPID = 5
WHERE E.FullName LIKE '%' + @SearchName + '%';
