SELECT 
    NULL AS sdn_grp_num, -- 或移除此欄位，因不在 BlackListData 內該值為 NULL
    A.EntityId,
    A.FullName AS SdnName,
    CONVERT(VARCHAR, A.UpdatedDate_UTC, 112) AS UpdatedDate
FROM BSADBJP..OFAC_SPEC F
JOIN BSADB.dbo.DJ_Entity A WITH (NOLOCK)     ON A.FullName = F.spec_name
JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK)     ON A.EntityId = B.EntityId
JOIN BSADBJP..BlackListData H     ON F.spec_name = H.sdn_name
WHERE A.Deceased = 1 
  AND B.SanctionListReference LIKE '%Japanese Finance%'


