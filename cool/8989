USE [master]
GO

-- 1. 建立 Server 層級的 Login 帳號與密碼
CREATE LOGIN [你的帳號名稱] 
WITH PASSWORD = N'你的密碼', 
     CHECK_EXPIRATION = OFF, 
     CHECK_POLICY = OFF;
GO

-- 2. 切換到目標資料庫（例如 MYDB）
USE [MYDB]
GO

-- 3. 在該資料庫建立對應的 User
CREATE USER [你的帳號名稱] FOR LOGIN [你的帳號名稱];

-- 4. 賦予 db_owner 權限
ALTER ROLE [db_owner] ADD MEMBER [你的帳號名稱];
GO




