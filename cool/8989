'POB 出生地國家
Case 5
    AtName = "@CUST_PLACE_OF_BIRTH"
    ColNum = 2

    'Check
    For i = 2 To RowCount
        
        Dim originalValue As String
        Dim checkValue As String
        
        originalValue = Trim(CStr(Range("G" & i).Value))
        checkValue = Left(originalValue, 4)
        
        checkData = WorksheetFunction.IfError( _
                        Application.VLookup( _
                            checkValue, _
                            Worksheets("Check").Range("A:A"), _
                            1, _
                            False), _
                        "Error")
        
        If checkData = "Error" Then
            
            '標記錯誤欄位
            Range("G" & i).Interior.Color = RGB(255, 220, 220)
            
            MsgBox _
                "格式錯誤！" & vbNewLine & vbNewLine & _
                "Excel列數：" & i & vbNewLine & _
                "原始資料：" & originalValue & vbNewLine & _
                "檢查值（前4碼）：" & checkValue & vbNewLine & _
                "查找範圍：Check!A:A", _
                vbExclamation, _
                "格式錯誤"
            
            Range("G" & i).Select
            Exit Sub
        End If
        
    Next