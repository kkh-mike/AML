 UPDATE  A
                                SET     A.Status = 'L' ,
                                        A.LastUpdatedBy = @UserId ,
                                        A.LastUpdatedDt = @Date ,
                                        A.LastupdatedUTCDt = @DateUTC ,
                                        A.ReviewDescription = 'Data Migration' --ask what remark they wanted to mark as
                                FROM    dbo.EDD_ReviewSchedule A
                                        INNER JOIN #AffectedNextReview B ON B.CIF_KEY = A.CIFKey
                                WHERE   A.Status = 'P';

                                INSERT  INTO dbo.EDD_ReviewSchedule
                                        ( CIFKey ,
                                          ReviewDt ,
                                          Status ,
                                          CreatedBy ,
                                          CreatedDt ,
                                          CreatedUTCDt ,
                                          ReviewDescription
                                        )
                                        SELECT  CIF_KEY ,
                                                ReviewDt ,
                                                'P' ,
                                                @UserId ,
                                                @Date ,
                                                @DateUTC ,
                                                'Data Migration' --ask what remark they wanted to mark as
                                        FROM    #AffectedNextReview;     


