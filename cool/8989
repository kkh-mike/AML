/*============================================================
  程式名稱 : CIF_撈資料給USER_20260929_優化版.sql
  用途說明 : 挑選移轉客戶樣本、比對 SK 轉 TS 前後資料及驗證風險等級
============================================================*/

-- STEP 1：清除暫存表
IF OBJECT_ID('tempdb..#SampleCust') IS NOT NULL
    DROP TABLE #SampleCust;

-- STEP 2：每種客戶分類抓取 1 筆樣本
WITH RankedCust AS (
    SELECT
        m.CustomerNo AS SK_CustomerNo,
        bb.CustomerNo AS TS_CustomerNo,
        cc.CUST_TYPE_CDE,
        v.ACTION,
        a.highrisk,
        CONCAT(
            CASE cc.CUST_TYPE_CDE WHEN 'N' THEN '企業' WHEN 'P' THEN '個人' END, ' ',
            CASE v.ACTION WHEN 'update' THEN '共有戶' WHEN 'INSERT' THEN '純新光' END, ' ',
            CASE a.highrisk WHEN 'H' THEN '高' WHEN 'M' THEN '中' WHEN 'L' THEN '低' END
        ) AS 完整分類標籤,
        ROW_NUMBER() OVER (
            PARTITION BY cc.CUST_TYPE_CDE, v.ACTION, a.highrisk
            ORDER BY m.CustomerNo
        ) AS rn
    FROM Cust_NP_Migrate_buffer a
    JOIN CIF_Migrate_Mapping_TEMP v ON v.SOURCE_CIF_KEY = a.CIF_KEY
    JOIN Customer_Migrate_buffer m ON m.CIF_KEY = v.SOURCE_CIF_KEY
    JOIN BSA_SUB_CUST_FACT bb ON bb.CIF_KEY = v.NEW_CIF_KEY
    JOIN PB_CUSTOMER_FACT cc ON cc.CIF_KEY = bb.CIF_KEY
    WHERE cc.CUST_TYPE_CDE IN ('P','N')
      AND v.ACTION IN ('update','INSERT')
      AND a.highrisk IN ('H','M','L')
)
SELECT * INTO #SampleCust FROM RankedCust WHERE rn = 1;

-- STEP 3：驗證移轉結果
SELECT
    s.SK_CustomerNo AS [新光客戶ID],
    s.TS_CustomerNo AS [台新客戶ID],
    s.完整分類標籤,
    CASE s.ACTION WHEN 'INSERT' THEN '純新光' WHEN 'update' THEN '共有戶' ELSE s.ACTION END AS [客戶分類],
    
    -- CUST_TYPE驗證
    s.CUST_TYPE_CDE AS [SK_CUST_TYPE],
    b.CUST_TYPE_CDE AS [TS寫入後_CUST_TYPE],
    CASE WHEN s.CUST_TYPE_CDE = b.CUST_TYPE_CDE THEN 'OK' ELSE 'MISMATCH' END AS CHECK_CUST_TYPE,
    
    -- HIGHRISK驗證
    bak.highrisk AS [TS寫入前_HIGHRISK],
    s.highrisk   AS [SK來源_HIGHRISK],
    aft.highrisk AS [TS寫入後_HIGHRISK],
    CASE 
        WHEN aft.highrisk = s.highrisk THEN 'OK'
        WHEN s.ACTION = 'update' AND aft.highrisk = 
            CASE 
                WHEN bak.highrisk = 'H' OR s.highrisk = 'H' THEN 'H'
                WHEN bak.highrisk = 'M' OR s.highrisk = 'M' THEN 'M'
                ELSE 'L' 
            END THEN 'OK_取高'
        ELSE 'MISMATCH'
    END AS CHECK_HIGHRISK
FROM #SampleCust s
LEFT JOIN BSA_SUB_CUST_FACT_BAK_TEST bak ON bak.CustomerNo = s.TS_CustomerNo
LEFT JOIN BSA_SUB_CUST_FACT aft ON aft.CustomerNo = s.TS_CustomerNo
LEFT JOIN PB_CUSTOMER_FACT b ON b.CIF_KEY = aft.CIF_KEY
ORDER BY 
    CASE WHEN s.CUST_TYPE_CDE <> b.CUST_TYPE_CDE 
           OR NOT (aft.highrisk = s.highrisk OR (s.ACTION = 'update' AND aft.highrisk = 
                CASE WHEN bak.highrisk = 'H' OR s.highrisk = 'H' THEN 'H'
                     WHEN bak.highrisk = 'M' OR s.highrisk = 'M' THEN 'M' ELSE 'L' END)) 
         THEN 0 ELSE 1 END,
    s.完整分類標籤;

