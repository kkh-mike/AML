/*
DJ 死亡名單 要跟 自建群組名單數量一致
*/

  SELECT 
    -- 1. DJ 來源端的死亡名單總數
    (
        SELECT COUNT(DISTINCT A.EntityId)
        FROM BSADB.dbo.DJ_Entity A
        JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
        WHERE A.Deceased = 1
          AND B.SanctionListReference LIKE '%Japanese Finance%'
    ) AS [DJ死亡名單總數],

    -- 2. 實際上真的有進到目標表的死亡名單數
    (
        SELECT COUNT(DISTINCT T.remark)
        FROM BSADBJP..OFAC_SPEC T
        JOIN BSADB.dbo.DJ_Entity A ON T.remark = CAST(A.EntityId AS VARCHAR(100))
        JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
        WHERE T.GROUPID = 5
          AND T.DInd = 'N'
          AND A.Deceased = 1
          AND B.SanctionListReference LIKE '%Japanese Finance%'
    ) AS [已在目標表中的死亡名單數],

    -- 3. 兩者相減：若是 0 就代表「全部都在裡面，一個沒漏」
    (
        SELECT COUNT(DISTINCT A.EntityId)
        FROM BSADB.dbo.DJ_Entity A
        JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
        WHERE A.Deceased = 1
          AND B.SanctionListReference LIKE '%Japanese Finance%'
    )
    -
    (
        SELECT COUNT(DISTINCT T.remark)
        FROM BSADBJP..OFAC_SPEC T
        JOIN BSADB.dbo.DJ_Entity A ON T.remark = CAST(A.EntityId AS VARCHAR(100))
        JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
        WHERE T.GROUPID = 5
          AND T.DInd = 'N'
          AND A.Deceased = 1
          AND B.SanctionListReference LIKE '%Japanese Finance%'
    ) AS [差額_漏掉筆數];




