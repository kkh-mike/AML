#requires -Version 7.0

# ============================================================
# Send-SwiftFromTxt-Parallel.ps1
# ============================================================

$ErrorActionPreference = 'Stop'

# ============================================================
# Config
# ============================================================

$url = 'http://localhost:8082/SwiftProcessor.svc'

$MessageFolder = Join-Path $PSScriptRoot 'messages'

$ActionCode      = 'SCAN_SWIFT'
$BankNo          = 'JP'
$BranchNo        = '0923'
$Channel         = 'SWIFT'
$MessageTypeCode = 'MT'
$SourceID        = 'TSID'

$TimeoutMs = 60000

# 同時執行的執行緒數量（對應您的需求：分三個執行緒）
$ThrottleLimit = 3

# ============================================================
# SOAP Request Function (內部共用)
# ============================================================

function Execute-SOAPRequest {
    param (
        [Parameter(Mandatory = $true)]
        [xml]$SOAPRequest,

        [Parameter(Mandatory = $true)]
        [string]$URL
    )

    $soapWebRequest = [System.Net.WebRequest]::Create($URL)
    $soapWebRequest.Headers.Add('SOAPAction', 'SubmitRequest')
    $soapWebRequest.ContentType = 'text/xml; charset=utf-8'
    $soapWebRequest.Accept = 'text/xml'
    $soapWebRequest.Method = 'POST'
    $soapWebRequest.Timeout = $TimeoutMs
    $soapWebRequest.ReadWriteTimeout = $TimeoutMs

    $requestStream = $soapWebRequest.GetRequestStream()
    try {
        $settings = New-Object System.Xml.XmlWriterSettings
        $settings.Encoding = New-Object System.Text.UTF8Encoding($false)
        $settings.Indent = $false
        $settings.CloseOutput = $false

        $writer = [System.Xml.XmlWriter]::Create($requestStream, $settings)
        try {
            $SOAPRequest.Save($writer)
            $writer.Flush()
        }
        finally {
            $writer.Close()
        }
    }
    finally {
        $requestStream.Close()
    }

    $resp = $soapWebRequest.GetResponse()
    try {
        $responseStream = $resp.GetResponseStream()
        try {
            $reader = New-Object System.IO.StreamReader($responseStream, [System.Text.Encoding]::UTF8)
            try {
                return $reader.ReadToEnd()
            }
            finally {
                $reader.Close()
            }
        }
        finally {
            $responseStream.Close()
        }
    }
    finally {
        $resp.Close()
    }
}

# ============================================================
# Build SOAP XML Function
# ============================================================

function New-SOAPRequest {
    param (
        [string]$SwiftMessage,
        [string]$ReferenceNumber
    )

    $soapNs    = 'http://schemas.xmlsoap.org/soap/envelope/'
    $serviceNs = 'http://patriotofficer.net/SwiftService'

    $xml = New-Object System.Xml.XmlDocument
    $xml.PreserveWhitespace = $true

    $declaration = $xml.CreateXmlDeclaration('1.0', 'utf-8', $null)
    [void]$xml.AppendChild($declaration)

    $envelope = $xml.CreateElement('soap', 'Envelope', $soapNs)
    [void]$xml.AppendChild($envelope)

    $body = $xml.CreateElement('soap', 'Body', $soapNs)
    [void]$envelope.AppendChild($body)

    $submit = $xml.CreateElement('', 'SubmitRequest', $serviceNs)
    [void]$body.AppendChild($submit)

    $params = $xml.CreateElement('', 'Params', $serviceNs)
    [void]$submit.AppendChild($params)

    $fields = [ordered]@{
        ActionCode = $ActionCode
        BankNo     = $BankNo
        BranchNo   = $BranchNo
        Channel    = $Channel
    }

    foreach ($field in $fields.GetEnumerator()) {
        $element = $xml.CreateElement('', $field.Key, $serviceNs)
        $element.InnerText = [string]$field.Value
        [void]$params.AppendChild($element)
    }

    $messageElement = $xml.CreateElement('', 'Message', $serviceNs)
    if ($SwiftMessage.Contains(']]>')) {
        $messageElement.InnerText = $SwiftMessage
    }
    else {
        $cdata = $xml.CreateCDataSection($SwiftMessage)
        [void]$messageElement.AppendChild($cdata)
    }
    [void]$params.AppendChild($messageElement)

    $remainingFields = [ordered]@{
        MessageTypeCode = $MessageTypeCode
        ReferenceNumber = $ReferenceNumber
        SourceID        = $SourceID
    }

    foreach ($field in $remainingFields.GetEnumerator()) {
        $element = $xml.CreateElement('', $field.Key, $serviceNs)
        $element.InnerText = [string]$field.Value
        [void]$params.AppendChild($element)
    }

    return $xml
}

# ============================================================
# Input Folder Check & Read Files
# ============================================================

if (-not (Test-Path -LiteralPath $MessageFolder -PathType Container)) {
    throw "找不到電文資料夾：$MessageFolder"
}

$files = @(
    Get-ChildItem -LiteralPath $MessageFolder -Filter 'TW*.txt' -File |
    Sort-Object Name
)

$total = $files.Count

if ($total -eq 0) {
    throw "在資料夾中找不到以 TW 開頭的 TXT 檔案：$MessageFolder"
}

Write-Host ""
Write-Host "================================="
Write-Host "Start SWIFT Batch (Multi-threaded)"
Write-Host "================================="
Write-Host "Input Folder   : $MessageFolder"
Write-Host "Total Files    : $total"
Write-Host "Throttle Limit : $ThrottleLimit threads"
Write-Host ""

# ============================================================
# Pre-check ReferenceNumber Uniqueness
# ============================================================

$fileDataList = [System.Collections.Generic.List[Object]]::new()
$referenceNumbers = @{}

foreach ($file in $files) {
    $fileNameWithoutExt = [System.IO.Path]::GetFileNameWithoutExtension($file.Name)

    if ($fileNameWithoutExt -notmatch '^(?<BankNo>[^_]+)_(?<CreatedDate>[^_]+)_(?<ClientReferenceNo>.+)_(?<Sequence>[^_]+)$') {
        throw "檔名格式不正確，預期格式為 BankNo_CreatedDate_ClientReferenceNo_流水號.txt：$($file.Name)"
    }

    $clientReferenceNo = $Matches['ClientReferenceNo']
    $referenceNumber = $clientReferenceNo + '99'

    if ($referenceNumbers.ContainsKey($referenceNumber)) {
        throw "ReferenceNumber 重複：$referenceNumber（檔案：$($file.Name)）"
    }
    $referenceNumbers[$referenceNumber] = $true

    $fileDataList.Add([PSCustomObject]@{
        File             = $file
        ReferenceNumber  = $referenceNumber
    })
}

# ============================================================
# Process Messages in Parallel
# ============================================================

$batchWatch = [System.Diagnostics.Stopwatch]::StartNew()

# 透過 PowerShell 7 的 ForEach-Object -Parallel 進行多執行緒發送
$results = $fileDataList | ForEach-Object -ThrottleLimit $ThrottleLimit -Parallel {

    # 由於在平行區塊中，需重新宣告或使用傳入的變數 (透過 $using:)
    $file            = $_.File
    $referenceNumber = $_.ReferenceNumber
    $url             = $using:url
    $ActionCode      = $using:ActionCode
    $BankNo          = $using:BankNo
    $BranchNo        = $using:BranchNo
    $Channel         = $using:Channel
    $MessageTypeCode = $using:MessageTypeCode
    $SourceID        = $using:SourceID
    $TimeoutMs       = $using:TimeoutMs

    # 內嵌 SOAP 呼叫函式或直接呼叫（在平行區塊內需要確保函式存在或直接寫入邏輯）
    # 這裡我們將 Execute-SOAPRequest 與 New-SOAPRequest 的邏輯或呼叫帶入
    # 註：PowerShell 7 Parallel 區塊內可以呼叫在 script 範疇定義好的函式

    $status       = 'SUCCESS'
    $responseText = ''
    $errorMessage = ''
    $elapsedMs    = 0

    $sw = [System.Diagnostics.Stopwatch]::StartNew()

    try {
        $swiftMessage = [System.IO.File]::ReadAllText($file.FullName, [System.Text.Encoding]::UTF8).Trim()

        if ([string]::IsNullOrWhiteSpace($swiftMessage)) {
            throw "電文檔案是空的：$($file.FullName)"
        }

        if (-not $swiftMessage.EndsWith('-}')) {
            $swiftMessage = "$swiftMessage-}"
        }

        # 組合 XML (呼叫外部定義的 New-SOAPRequest)
        $soapRequest = New-SOAPRequest -SwiftMessage $swiftMessage -ReferenceNumber $referenceNumber

        # 執行 SOAP 請求 (呼叫外部定義的 Execute-SOAPRequest)
        $responseText = Execute-SOAPRequest -SOAPRequest $soapRequest -URL $url

        $sw.Stop()
        $elapsedMs = [math]::Round($sw.Elapsed.TotalMilliseconds, 2)

        [PSCustomObject]@{
            Status          = 'SUCCESS'
            ReferenceNumber = $referenceNumber
            MessageFile     = $file.Name
            ElapsedMs       = $elapsedMs
            ResponseText    = $responseText
            ErrorMessage    = $null
        }
    }
    catch {
        $sw.Stop()
        $elapsedMs = [math]::Round($sw.Elapsed.TotalMilliseconds, 2)

        [PSCustomObject]@{
            Status          = 'FAILED'
            ReferenceNumber = $referenceNumber
            MessageFile     = $file.Name
            ElapsedMs       = $elapsedMs
            ResponseText    = $null
            ErrorMessage    = $_.Exception.Message
        }
    }
}

$batchWatch.Stop()

# ============================================================
# Summary & Output Processing
# ============================================================

$successCount = 0
$failedCount = 0
$ReferenceList = [System.Collections.Generic.List[Object]]::new()

$seq = 1
foreach ($res in $results) {
    if ($res.Status -eq 'SUCCESS') {
        $successCount++
        Write-Host "[$seq/$total] [SUCCESS] File: $($res.MessageFile) | Ref: $($res.ReferenceNumber) | Time: $($res.ElapsedMs) ms" -ForegroundColor Green
    }
    else {
        $failedCount++
        Write-Host "[$seq/$total] [FAILED ] File: $($res.MessageFile) | Ref: $($res.ReferenceNumber) | Error: $($res.ErrorMessage)" -ForegroundColor Red
    }

    $ReferenceList.Add([PSCustomObject]@{
        ReferenceNumber = $res.ReferenceNumber
        ActionCode      = $ActionCode
        BankNo          = $BankNo
        BranchNo        = $BranchNo
        Channel         = $Channel
        MessageTypeCode = $MessageTypeCode
        SourceID        = $SourceID
        MessageFile     = $res.MessageFile
    })
    $seq++
}

Write-Host ""
Write-Host "================================="
Write-Host "Batch Summary"
Write-Host "================================="
Write-Host "Total      : $total"
Write-Host "Success    : $successCount" -ForegroundColor Green
Write-Host "Failed     : $failedCount" -ForegroundColor Red
Write-Host "Total Time : $([math]::Round($batchWatch.Elapsed.TotalSeconds, 2)) sec"
Write-Host "================================="

# ============================================================
# Reference List
# ============================================================

Write-Host ""
Write-Host "================================="
Write-Host "Reference List"
Write-Host "================================="

foreach ($Ref in $ReferenceList) {
    Write-Host ""
    Write-Host "ReferenceNumber : $($Ref.ReferenceNumber)"
    Write-Host "ActionCode      : $($Ref.ActionCode)"
    Write-Host "BankNo          : $($Ref.BankNo)"
    Write-Host "BranchNo        : $($Ref.BranchNo)"
    Write-Host "Channel         : $($Ref.Channel)"
    Write-Host "MessageTypeCode : $($Ref.MessageTypeCode)"
    Write-Host "SourceID        : $($Ref.SourceID)"
    Write-Host "MessageFile     : $($Ref.MessageFile)"
}

Write-Host ""
Write-Host "Batch Completed." -ForegroundColor Cyan
