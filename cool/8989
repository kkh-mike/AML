-- STEP 3：TS 寫入前 / SK 來源 / TS 寫入後
SELECT
    s.SK_CustomerNo AS [新光客戶ID],
    s.TS_CustomerNo AS [台新客戶ID],
    s.完整分類標籤,
    CASE
        WHEN s.ACTION = 'INSERT' THEN '純新光'
        WHEN s.ACTION = 'update' THEN '共有戶'
        ELSE s.ACTION
    END AS [客戶分類],

    s.CUST_TYPE_CDE AS [SK_CUST_TYPE],
    b.CUST_TYPE_CDE AS [TS寫入後_CUST_TYPE],
    CASE
        WHEN s.CUST_TYPE_CDE = b.CUST_TYPE_CDE THEN 'OK'
        ELSE 'MISMATCH'
    END AS CHECK_CUST_TYPE,

    bak.highrisk AS [TS寫入前_HIGHRISK],   -- BSA_SUB_CUST_FACT_BAK_TEST
    s.highrisk   AS [SK來源_HIGHRISK],     -- Cust_NP_Migrate_buffer
    aft.highrisk AS [TS寫入後_HIGHRISK],   -- BSA_SUB_CUST_FACT

    CASE
        WHEN aft.highrisk = s.highrisk THEN 'OK'
        WHEN s.ACTION = 'update'
         AND aft.highrisk = CASE
                WHEN bak.highrisk = 'H' OR s.highrisk = 'H' THEN 'H'
                WHEN bak.highrisk = 'M' OR s.highrisk = 'M' THEN 'M'
                ELSE 'L'
            END
            THEN 'OK_取高'
        ELSE 'MISMATCH'
    END AS CHECK_HIGHRISK
FROM #SampleCust s
LEFT JOIN BSA_SUB_CUST_FACT_BAK_TEST bak
    ON bak.CustomerNo = s.TS_CustomerNo
LEFT JOIN BSA_SUB_CUST_FACT aft
    ON aft.CustomerNo = s.TS_CustomerNo
LEFT JOIN PB_CUSTOMER_FACT b
    ON b.CIF_KEY = aft.CIF_KEY
ORDER BY
    CASE
        WHEN s.CUST_TYPE_CDE <> b.CUST_TYPE_CDE
          OR NOT (
                aft.highrisk = s.highrisk
             OR (
                    s.ACTION = 'update'
                AND aft.highrisk = CASE
                        WHEN bak.highrisk = 'H' OR s.highrisk = 'H' THEN 'H'
                        WHEN bak.highrisk = 'M' OR s.highrisk = 'M' THEN 'M'
                        ELSE 'L'
                    END
                )
             )
        THEN 0 ELSE 1
    END,
    s.完整分類標籤;



