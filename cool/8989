這是整理後的測試案例（Test Cases）與姓名檢核（NMCHK）驗證腳本，結構統一、排版整齊，並附帶預期結果與查核邏輯，方便直接納入測試報告或交接文件。
/*
================================================================================
【測試報告與驗證腳本】日本金融制裁 (GROUPID = 5) 死亡名單同步與姓名檢核 SOP
================================================================================
內容目錄：
  【單元一】TC-01：新增死亡名單同步測試（Before / After）
  【單元二】TC-03：名單同步完整性驗證（無漏網名單）
  【單元三】TC-04：名單下架與刪除驗證（無幽靈名單）
  【單元四】NMCHK 姓名檢核審核與歷程追蹤查詢
================================================================================
*/


-- =============================================================================
-- 【單元一】TC-01：新增死亡名單同步測試
-- 驗證目的：比對執行排程前後，死亡名單是否正確匯入自建群組 (GROUPID = 5)
-- =============================================================================

--------------------------------------------------------------------------------
-- 1. [Before] 執行同步前狀態確認
--------------------------------------------------------------------------------
-- (1) 確認 OFAC_SPEC (GROUPID=5) 既有筆數（基準：原僅有 1 筆資料）
SELECT COUNT(1) AS [Before_OFAC_SPEC總筆數]
FROM BSADBJP..OFAC_SPEC 
WHERE GROUPID = '5';

-- (2) 確認目前目標表中「Japanese Finance」且「死亡名單」筆數（預期：0 筆）
SELECT COUNT(1) AS [Before_目標表死亡名單筆數 (預期0)]
FROM BSADBJP..OFAC_SPEC F
JOIN BSADB.dbo.DJ_Entity A WITH (NOLOCK) 
    ON A.FullName = F.spec_name
JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
    ON A.EntityId = B.EntityId
JOIN BSADBJP..BlackListData H 
    ON F.spec_name = H.sdn_name
WHERE A.Deceased = 1 
  AND B.SanctionListReference LIKE '%Japanese Finance%' 
  AND F.GROUPID = '5';

-- (3) 來源端抽樣檢驗：確認測試個案在來源端確實為死亡名單 (Deceased = 1)
SELECT 
    A.EntityId,
    A.FullName,
    A.Deceased,
    B.SanctionListReference
FROM BSADB.dbo.DJ_Entity A WITH (NOLOCK)
JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
    ON A.EntityId = B.EntityId
WHERE A.Deceased = 1  
  AND A.FullName = 'Bortsov, Nikolay Ivanovich'   
  AND B.SanctionListReference LIKE '%Japanese Finance%';


--------------------------------------------------------------------------------
-- 2. [After] 執行同步後狀態確認
--------------------------------------------------------------------------------
-- (1) 確認 OFAC_SPEC (GROUPID=5) 總筆數（驗證基準：應更新為 72,086 筆）
SELECT COUNT(1) AS [After_OFAC_SPEC總筆數 (預期72086)]
FROM BSADBJP..OFAC_SPEC 
WHERE GROUPID = '5';

-- (2) 確認目標表中已成功納入之死亡名單筆數（驗證基準：應為 508 筆）
SELECT COUNT(1) AS [After_目標表死亡名單筆數 (預期508)]
FROM BSADBJP..OFAC_SPEC F
JOIN BSADB.dbo.DJ_Entity A WITH (NOLOCK) 
    ON A.FullName = F.spec_name
JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
    ON A.EntityId = B.EntityId
JOIN BSADBJP..BlackListData H 
    ON F.spec_name = H.sdn_name
WHERE A.Deceased = 1   
  AND B.SanctionListReference LIKE '%Japanese Finance%' 
  AND F.GROUPID = '5';



-- =============================================================================
-- 【單元二】TC-03：名單同步完整性驗證（無漏網名單）
-- 驗證目的：來源端（Primary Name + 死亡名單）是否 100% 寫入目標表且有效 (DInd = 'N')
-- 預期結果：[異常漏缺筆數] 必須為 0
-- =============================================================================

;WITH SourceEntities AS
(
    -- 來源條件 1：主要姓名且具備 Japanese Finance 制裁標記
    SELECT A.EntNum AS EntityId, A.SdnName
    FROM BSADB.dbo.DJ_List_Data_A A WITH (NOLOCK)
    JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
        ON A.EntNum = B.EntityId
    WHERE (A.NamePropertyBitCode & 1) > 0
      AND B.SanctionListReference LIKE '%Japanese Finance%'

    UNION

    -- 來源條件 2：死亡名單且具備 Japanese Finance 制裁標記
    SELECT A.EntityId, A.FullName AS SdnName
    FROM BSADB.dbo.DJ_Entity A WITH (NOLOCK)
    JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
        ON A.EntityId = B.EntityId
    WHERE A.Deceased = 1
      AND B.SanctionListReference LIKE '%Japanese Finance%'
)
SELECT 
    COUNT(1) AS [異常漏缺筆數 (預期為 0)]
FROM SourceEntities S
LEFT JOIN BSADBJP..OFAC_SPEC T WITH (NOLOCK)
       ON T.GROUPID = 5 
      AND T.spec_name = S.SdnName 
      AND T.remark = CAST(S.EntityId AS VARCHAR(100))
WHERE T.ent_num IS NULL 
   OR T.DInd <> 'N';



-- =============================================================================
-- 【單元三】TC-04：名單下架與刪除驗證（無幽靈名單）
-- 驗證目的：目標表中標記為有效 (DInd = 'N') 的資料，是否全都存在於來源端
-- 預期結果：[異常幽靈筆數] 必須為 0（若不在來源端，DInd 應被洗為 'Y'）
-- =============================================================================

;WITH SourceEntities AS
(
    -- 來源條件 1：主要姓名
    SELECT A.EntNum AS EntityId, A.SdnName
    FROM BSADB.dbo.DJ_List_Data_A A WITH (NOLOCK)
    JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
        ON A.EntNum = B.EntityId
    WHERE (A.NamePropertyBitCode & 1) > 0
      AND B.SanctionListReference LIKE '%Japanese Finance%'

    UNION

    -- 來源條件 2：死亡名單
    SELECT A.EntityId, A.FullName AS SdnName
    FROM BSADB.dbo.DJ_Entity A WITH (NOLOCK)
    JOIN BSADB.dbo.DJ_SanctionListReference B WITH (NOLOCK) 
        ON A.EntityId = B.EntityId
    WHERE A.Deceased = 1
      AND B.SanctionListReference LIKE '%Japanese Finance%'
)
SELECT 
    COUNT(1) AS [異常幽靈筆數 (預期為 0)]
FROM BSADBJP..OFAC_SPEC T WITH (NOLOCK)
LEFT JOIN SourceEntities S 
       ON T.spec_name = S.SdnName 
      AND T.remark = CAST(S.EntityId AS VARCHAR(100))
WHERE T.GROUPID = 5 
  AND T.DInd = 'N'  
  AND S.EntityId IS NULL;



-- =============================================================================
-- 【單元四】NMCHK 姓名檢核審核與歷程追蹤
-- 驗證目的：追蹤姓名檢核案件狀態、比對命中細節與人員審核歷程
-- =============================================================================

DECLARE @FilterDate VARCHAR(10) = '2026-09-03';
DECLARE @TargetUID   VARCHAR(20) = '2026179';

-- 4-1. 檢核審核主檔：查看案件 UID、狀態、當前關卡 Role、負責人員 HandledBy
SELECT 
    M.uid,
    M.Created_Date,
    M.Role,
    M.HandledBy,
    M.Status,
    M.*
FROM NMCHK_Review_Main M WITH (NOLOCK)
WHERE M.Created_Date >= @FilterDate
ORDER BY M.Created_Date DESC;

-- 4-2. 比對命中結果歷程：依 UID 確認命中規則與 NamePropertyBitCode (Bit 0 = 1 代表命中主要名稱)
SELECT 
    H.uid,
    H.NamePropertyBitCode,
    CASE 
        WHEN H.NamePropertyBitCode & 1 > 0 THEN 'Primary Name (主要名稱命中)' 
        ELSE 'Other / Alias (別名或其他命中)' 
    END AS [命中類型說明],
    H.*
FROM NMCHK_ResultHistory H WITH (NOLOCK)
JOIN NMCHK_Review_Main M WITH (NOLOCK) 
    ON H.uid = M.uid
WHERE M.Created_Date >= @FilterDate 
  AND M.uid = @TargetUID;

-- 4-3. 客戶基本資料與來源指標：核對進件客戶原始資訊 (Source_IND)
SELECT 
    C.uid,
    C.Source_IND,
    C.*
FROM NMCHK_CustInfo C WITH (NOLOCK)
JOIN NMCHK_Review_Main M WITH (NOLOCK) 
    ON C.uid = M.uid
WHERE M.Created_Date >= @FilterDate;

-- 4-4. 審核備註與異動歷程 (Audit Log)：查看審核意見、動作代碼 (ActionCode) 與經辦時間
SELECT 
    L.uid,
    L.Role,
    L.ActionCD,
    L.Remark,
    L.UpdatedDate,
    L.*
FROM NMCHK_REMARKLOG L WITH (NOLOCK)
JOIN NMCHK_Review_Main M WITH (NOLOCK) 
    ON L.uid = M.uid
WHERE M.Created_Date >= @FilterDate
ORDER BY L.UpdatedDate DESC;

