function Submit-SwiftMX {
    param(
        [Parameter(Mandatory = $true)]
        [ValidateSet("HK", "SG", "AU", "JP", "TW")]
        [string]$Country,

        [Parameter(Mandatory = $true)]
        [string]$MessageFile
    )

    $cfg = $countryConfig[$Country]

    if (-not $cfg) {
        throw "Unsupported country: $Country"
    }

    if (-not (Test-Path -LiteralPath $MessageFile -PathType Leaf)) {
        throw "找不到電文檔案：$MessageFile"
    }

    # 從檔名取得 ClientReferenceNo，並在末尾補 0
    $referenceNo = Get-ReferenceNoFromFileName -MessageFile $MessageFile

    $rawMessage = [System.IO.File]::ReadAllText(
        $MessageFile,
        [System.Text.Encoding]::UTF8
    )

    if ([string]::IsNullOrWhiteSpace($rawMessage)) {
        throw "電文檔案是空的：$MessageFile"
    }

    $body = @{
        SourceId        = $cfg.SourceId
        ReferenceNo     = $referenceNo
        BankNo          = $cfg.BankNo
        BranchNo        = $cfg.BranchNo
        Channel         = $cfg.Channel
        MessageTypeCode = $cfg.MessageTypeCode
        RawMessage      = $rawMessage
    } | ConvertTo-Json -Depth 20

    $uri = "http://localhost:8087/SwiftMX/SubmitMessage"

    Invoke-RestMethod `
        -Method Post `
        -Uri $uri `
        -Headers $header `
        -ContentType "application/json; charset=utf-8" `
        -Body $body
}

# 讀取 messages 資料夾中所有檔名以 TW 開頭的 TXT
$country = "TW"
$messageFolder = Join-Path $PSScriptRoot "messages"

if (-not (Test-Path -LiteralPath $messageFolder -PathType Container)) {
    throw "找不到電文資料夾：$messageFolder"
}

$files = @(
    Get-ChildItem `
        -LiteralPath $messageFolder `
        -Filter "TW*.txt" `
        -File |
    Sort-Object Name
)

if ($files.Count -eq 0) {
    throw "在資料夾中找不到以 TW 開頭的 TXT 檔案：$messageFolder"
}

foreach ($file in $files) {
    Write-Host "送出檔案：$($file.Name)"

    try {
        $referenceNo = Get-ReferenceNoFromFileName -MessageFile $file.FullName
        Write-Host "ReferenceNo：$referenceNo"

        $result = Submit-SwiftMX `
            -Country $country `
            -MessageFile $file.FullName

        Write-Host "完成：$($file.Name)"
        $result
    }
    catch {
        Write-Error "送出失敗：$($file.Name)；錯誤：$($_.Exception.Message)"
    }
}



