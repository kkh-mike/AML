可以，而且很適合用 PowerShell 一次完成：

SAR_Trxn_Detail_All.sql → 自動分割 → 依序產生 _1.sql ~ _210.sql → 依序 sqlcmd 執行 → 產生 log

甚至你不需要自己先手動切 210 個檔案。

不過有一個關鍵：不能單純按照「固定幾行」切，最好按照 SQL 的批次邊界（例如 GO）切，否則很容易把一個 SQL statement 切斷。

我建議做成這種流程

SAR_Trxn_Detail_All.sql
        ↓
PowerShell
        ↓
自動依 GO 分割
        ↓
SAR_Trxn_Detail_All_1.sql
SAR_Trxn_Detail_All_2.sql
SAR_Trxn_Detail_All_3.sql
...
        ↓
依序 sqlcmd
        ↓
SAR_Trxn_Detail_All_1.log
SAR_Trxn_Detail_All_2.log
...
        ↓
全部完成

而且可以再加上：

* 某一份 SQL 失敗就停止
* 自動記錄成功 / 失敗
* 自動建立 Split、Log 資料夾
* 執行前先刪除舊檔
* 不需要寫死 210
* 自動算到底有幾份
* 最後顯示總共成功幾份

例如可以直接做成一個 Run_SAR.ps1。

# ==========================================
# SAR_Trxn_Detail_All.sql
# 自動分割 + 依序執行 SQL
# ==========================================
$SourceFile = ".\SAR_Trxn_Detail_All.sql"
$OutputFolder = ".\Split"
$LogFolder    = ".\Log"
$Server   = "amlist"
$User     = "aml"
$Password = "aml1234"
$Database = "SARCaseWarehouse"
# ==========================================
# 1. 檢查來源 SQL
# ==========================================
if (!(Test-Path $SourceFile)) {
    Write-Host "找不到 $SourceFile" -ForegroundColor Red
    exit 1
}
# ==========================================
# 2. 建立資料夾
# ==========================================
if (!(Test-Path $OutputFolder)) {
    New-Item -ItemType Directory -Path $OutputFolder | Out-Null
}
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}
# ==========================================
# 3. 清除舊的分割 SQL / Log
# ==========================================
Write-Host "清除舊檔案..."
Remove-Item "$OutputFolder\SAR_Trxn_Detail_All_*.sql" -Force -ErrorAction SilentlyContinue
Remove-Item "$LogFolder\SAR_Trxn_Detail_All_*.log" -Force -ErrorAction SilentlyContinue
# ==========================================
# 4. 讀取原始 SQL
# ==========================================
Write-Host "讀取 $SourceFile ..."
$Content = Get-Content $SourceFile -Raw
# ==========================================
# 5. 依 GO 分割
# ==========================================
# GO 必須獨立一行
$Batches = [regex]::Split(
    $Content,
    '(?im)^\s*GO\s*;?\s*$'
)
# ==========================================
# 6. 移除空白 Batch
# ==========================================
$Batches = $Batches |
    Where-Object {
        ![string]::IsNullOrWhiteSpace($_)
    }
Write-Host ""
Write-Host "共找到 $($Batches.Count) 個 SQL Batch"
Write-Host ""
# ==========================================
# 7. 產生分割 SQL
# ==========================================
$Index = 1
foreach ($Batch in $Batches) {
    $OutputFile = Join-Path `
        $OutputFolder `
        "SAR_Trxn_Detail_All_$Index.sql"
    # 補回 GO，讓每個檔案可以獨立執行
    $SqlContent = $Batch.Trim() + "`r`nGO`r`n"
    Set-Content `
        -Path $OutputFile `
        -Value $SqlContent `
        -Encoding UTF8
    Write-Host "產生：$OutputFile"
    $Index++
}
# ==========================================
# 8. 開始執行 SQL
# ==========================================
Write-Host ""
Write-Host "========================================="
Write-Host "開始執行 SQL"
Write-Host "========================================="
Write-Host ""
$Total  = $Batches.Count
$Success = 0
$Failed  = 0
for ($i = 1; $i -le $Total; $i++) {
    $SqlFile = Join-Path `
        $OutputFolder `
        "SAR_Trxn_Detail_All_$i.sql"
    $LogFile = Join-Path `
        $LogFolder `
        "SAR_Trxn_Detail_All_$i.log"
    Write-Host "-----------------------------------------"
    Write-Host "執行 [$i / $Total]"
    Write-Host "$SqlFile"
    Write-Host "-----------------------------------------"
    sqlcmd `
        -S $Server `
        -U $User `
        -P $Password `
        -d $Database `
        -i $SqlFile `
        -o $LogFile
    $ExitCode = $LASTEXITCODE
    if ($ExitCode -eq 0) {
        Write-Host "SUCCESS：第 $i 份執行成功" `
            -ForegroundColor Green
        $Success++
    }
    else {
        Write-Host "FAILED：第 $i 份執行失敗" `
            -ForegroundColor Red
        Write-Host "請檢查：$LogFile" `
            -ForegroundColor Yellow
        $Failed++
        # 遇到錯誤就停止
        Write-Host ""
        Write-Host "SQL 執行失敗，停止後續執行。" `
            -ForegroundColor Red
        break
    }
}
# ==========================================
# 9. 執行結果
# ==========================================
Write-Host ""
Write-Host "========================================="
Write-Host "執行完成"
Write-Host "========================================="
Write-Host "總 Batch：$Total"
Write-Host "成功：$Success"
Write-Host "失敗：$Failed"
if ($Failed -eq 0) {
    Write-Host ""
    Write-Host "全部 SQL 執行成功！" `
        -ForegroundColor Green
}
else {
    Write-Host ""
    Write-Host "有 SQL 執行失敗，請檢查 Log。" `
        -ForegroundColor Red
}
Write-Host ""
Read-Host "按 Enter 結束"

