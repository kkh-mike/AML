/*
拷貝別人的權限（差集補齊）
*/
BEGIN TRAN;

DECLARE @TargetUser NVARCHAR(60) = '922798';   -- 目標同仁工號（已存在舊權限）
DECLARE @SampleUser NVARCHAR(60) = '1091707';  -- 範本同仁工號

INSERT INTO dbo.WORKFLOW_MGMT_USERS (
    QUEUEID, 
    USERID, 
    ROLE, 
    ALERTMAIN, 
    ALERTPERSONAL, 
    IsAutomated
)
SELECT 
    src.QUEUEID, 
    @TargetUser, 
    src.ROLE, 
    src.ALERTMAIN, 
    src.ALERTPERSONAL, 
    'FALSE' -- 設為 FALSE，確保排程 MERGE 時不被自動刪除
FROM dbo.WORKFLOW_MGMT_USERS AS src
WHERE src.USERID = @SampleUser
  AND NOT EXISTS (
      -- 檢查目標同仁是否已有相同的 QUEUEID 與 ROLE
      SELECT 1 
      FROM dbo.WORKFLOW_MGMT_USERS AS chk
      WHERE chk.USERID = @TargetUser 
        AND chk.QUEUEID = src.QUEUEID 
        AND chk.ROLE = src.ROLE
  );

-- 檢查最終該員擁有的所有工作群組權限
SELECT * 
FROM dbo.WORKFLOW_MGMT_USERS 
WHERE USERID = @TargetUser;

-- 檢查無誤執行 COMMIT 存檔；若有異常反白執行 ROLLBACK 取消
COMMIT TRAN;
-- ROLLBACK TRAN;
