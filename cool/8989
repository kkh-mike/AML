USE BSADBTW;

select a.enterflag, b.DESCR + DESCR_zh_TW '內部名單群組名稱',a.ent_num '名單資料編號',convert(char(8),creDate,112) '建立日期',a.spec_name '姓名/名稱',
'N' '黑名單',
'N'  PEP,
'N' '負面新聞',
TaxIDCD '稅號代碼',a.TaxID '稅號/統一編號',a.IDNUM '證件號碼',a.IssBy '發照地',a.ADDRESS '地址',a.STATE '州',
c.ISO_CountryDescription '國家',a.DOB '出生日期','' GoodsCodes_1,a.creUserID '建立人',isnull(a.ApprovedBy,'') '核准人',isnull(a.ApprovedDate,'') '核准日期',
isnull(a.remark,'') '備註'
FROM BSADB..OFAC_GLSPEC A
inner join bsadbtw..OFAC_GLSpec_Source_Dim b on a.EnterFlag = b.SOURCE_KEY
LEFT join COUNTRY_DIM c on a.COUNTRY = c.ISO_2_CountryCode
where  A.DInd='N' and a.EnterFlag <> 'D'
ORDER BY A.GROUPID,a.ent_num

