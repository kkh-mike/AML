# 1. 定義 Log 名稱與自訂來源
$logName = "Application"
$sourceName = "MyTestApp"
$eventId = 9999
$errorMessage = "模擬系統異常：資料庫連線超時 (Simulated Error)"

# 2. 若來源不存在則先註冊（需系統管理員權限）
if (-not [System.Diagnostics.EventLog]::SourceExists($sourceName)) {
    New-EventLog -LogName $logName -Source $sourceName
    Write-Host "已建立事件來源: $sourceName" -ForegroundColor Cyan
}

# 3. 寫入 Error 等級事件
Write-EventLog -LogName $logName `
               -Source $sourceName `
               -EntryType Error `
               -EventId $eventId `
               -Message $errorMessage


