;WITH TargetList (FlagOrder, TargetCustNo) AS (
    SELECT *
    FROM (VALUES
        (1, N'F2667974280'),  -- 加強關注客戶
        (2, N'H164340449'),   -- 告誡戶
        (3, N'A2625245400'),  -- 衍生管制帳戶、警示戶
        (4, N'FIXXT01PA'),    -- 無記名股票
        (5, N'GRXXT01VN'),    -- 複雜結構
        (6, N'OCXXN01MH'),    -- 黑名單
        (7, N'P1647954300'),  -- PEP
        (8, N'P1637405480')   -- 負面新聞
    ) AS v(FlagOrder, TargetCustNo)
),
BaseData AS (
    SELECT
        flag.FlagOrder,
        flag.FlagName AS [抽樣項目],

        b.CustomerNo AS [台新客戶ID],
        f.CustomerNo AS [新光客戶ID],

        CASE cc.CUST_TYPE_CDE
            WHEN 'N' THEN N'企業'
            WHEN 'P' THEN N'個人'
            ELSE cc.CUST_TYPE_CDE
        END AS [客戶類型],

        m.IsSARFiled,
        m.SDST2400001,
        m.Warn_Restrict_Account,
        m.IsBearerShares,
        m.IsComplexStructure,
        m.PEPBitwiseCode,

        STUFF(CONCAT(
            CASE WHEN (m.PEPBitwiseCode & 1) = 1 THEN N'、黑名單' ELSE N'' END,
            CASE WHEN (m.PEPBitwiseCode & 2) = 2 THEN N'、PEP' ELSE N'' END,
            CASE WHEN (m.PEPBitwiseCode & 4) = 4 THEN N'、負面新聞' ELSE N'' END
        ), 1, 1, N'') AS [PEP註記]

    FROM dbo.Customer_Migrate_buffer f
    JOIN dbo.Cust_NP_Migrate_buffer m
        ON f.CIF_KEY = m.CIF_KEY
    JOIN dbo.CIF_Migrate_Mapping_TEMP t
        ON t.SOURCE_CIF_KEY = f.CIF_KEY
    LEFT JOIN (
        SELECT DISTINCT CIF_KEY, CustomerNo
        FROM dbo.BSA_SUB_CUST_FACT
    ) b
        ON b.CIF_KEY = t.NEW_CIF_KEY
    LEFT JOIN dbo.PB_CUSTOMER_FACT cc
        ON cc.CIF_KEY = b.CIF_KEY

    CROSS APPLY (
        VALUES
            (1, N'加強關注客戶',
                CASE WHEN m.IsSARFiled = 1 THEN 1 ELSE 0 END),
            (2, N'告誡戶',
                CASE WHEN m.SDST2400001 = 1 THEN 1 ELSE 0 END),
            (3, N'衍生管制帳戶、警示戶',
                CASE WHEN m.Warn_Restrict_Account = 1 THEN 1 ELSE 0 END),
            (4, N'無記名股票',
                CASE WHEN m.IsBearerShares = 1 THEN 1 ELSE 0 END),
            (5, N'複雜結構',
                CASE WHEN m.IsComplexStructure = 1 THEN 1 ELSE 0 END),
            (6, N'黑名單',
                CASE WHEN (m.PEPBitwiseCode & 1) = 1 THEN 1 ELSE 0 END),
            (7, N'PEP',
                CASE WHEN (m.PEPBitwiseCode & 2) = 2 THEN 1 ELSE 0 END),
            (8, N'負面新聞',
                CASE WHEN (m.PEPBitwiseCode & 4) = 4 THEN 1 ELSE 0 END)
    ) flag(FlagOrder, FlagName, IsMatched)

    JOIN TargetList tl
        ON tl.FlagOrder = flag.FlagOrder
       AND (b.CustomerNo = tl.TargetCustNo OR f.CustomerNo = tl.TargetCustNo)

    WHERE flag.IsMatched = 1
)
SELECT
    [抽樣項目],
    [台新客戶ID],
    [新光客戶ID],
    [客戶類型],
    IsSARFiled,
    SDST2400001,
    Warn_Restrict_Account,
    IsBearerShares,
    IsComplexStructure,
    PEPBitwiseCode,
    [PEP註記]
FROM BaseData
ORDER BY FlagOrder;
