WITH QueryA AS (
    SELECT DISTINCT
        LEFT(A.Block4_UserReference, LEN(A.Block4_UserReference) - 1) AS BASE_MESSAGE_ID,
        A.Block4_UserReference AS ORIG_MESSAGE_ID,
        A.MessageType AS TYPE,
        replace(replace(B.FullName,char(10),''),char(13),'') AS DETECTED_NAME,
        B.SdnName,
        B.SdnType,
        B.EntNum,
        B.RC
    FROM SWIFT_MTHeader_Main A
    LEFT JOIN MESSAGEDATABASE..Swift_MTRaw D ON A.MT_KEY = D.ID
    LEFT JOIN SWIFT_ResultGroups C ON A.MT_KEY = C.SourceKey
    LEFT JOIN SWIFT_ResultNames B ON A.MT_KEY = B.SourceKey and C.nameID = B.nameid
    WHERE D.CreatedDate >= '2026-11-19 00:28:48.7270000' AND D.CreatedDate < '2026-11-19 00:30:49.8470000'
),
QueryB AS (
    SELECT DISTINCT
        LEFT(A.Block4_UserReference, LEN(A.Block4_UserReference) - 1) AS BASE_MESSAGE_ID,
        A.Block4_UserReference AS ORIG_MESSAGE_ID,
        A.MessageType AS TYPE,
        replace(replace(B.FullName,char(10),''),char(13),'') AS DETECTED_NAME,
        B.SdnName,
        B.SdnType,
        B.EntNum,
        B.RC
    FROM SWIFT_MTHeader_Main A
    LEFT JOIN MESSAGEDATABASE..Swift_MTRaw D ON A.MT_KEY = D.ID
    LEFT JOIN SWIFT_ResultGroups C ON A.MT_KEY = C.SourceKey
    LEFT JOIN SWIFT_ResultNames B ON A.MT_KEY = B.SourceKey and C.nameID = B.nameid
    WHERE D.CreatedDate >= '2026-11-18 23:57:46.2170000' AND D.CreatedDate < '2026-11-18 23:59:46.2300000'
)
SELECT 
    COALESCE(A.BASE_MESSAGE_ID, B.BASE_MESSAGE_ID) AS BASE_MESSAGE_ID,
    A.ORIG_MESSAGE_ID AS A_MSG_ID,
    B.ORIG_MESSAGE_ID AS B_MSG_ID,
    A.DETECTED_NAME AS A_DETECTED_NAME,
    B.DETECTED_NAME AS B_DETECTED_NAME,
    A.EntNum AS A_EntNum,
    B.EntNum AS B_EntNum,
    CASE 
        WHEN ISNULL(A.DETECTED_NAME, '') = ISNULL(B.DETECTED_NAME, '')
         AND ISNULL(CAST(A.EntNum AS VARCHAR), '') = ISNULL(CAST(B.EntNum AS VARCHAR), '')
        THEN 'SAME'
        ELSE 'DIFF'
    END AS COMPARE_RESULT
FROM QueryA A
FULL OUTER JOIN QueryB B
    ON A.BASE_MESSAGE_ID = B.BASE_MESSAGE_ID
   AND ISNULL(A.DETECTED_NAME, '') = ISNULL(B.DETECTED_NAME, '')
   AND ISNULL(CAST(A.EntNum AS VARCHAR), '') = ISNULL(CAST(B.EntNum AS VARCHAR), '')
WHERE A.BASE_MESSAGE_ID IS NULL OR B.BASE_MESSAGE_ID IS NULL -- 只看有差異的；想看全部就把這行註解掉
ORDER BY BASE_MESSAGE_ID, COMPARE_RESULT;
