# ==========================================
# 自動抓取 LDAP 連線資訊 + 執行各 Table TRUNCATE / DELETE 清理作業
# ==========================================

# 1. 資料夾準備與全域 Log 初始化
$LogFolder = Join-Path -Path $PSScriptRoot -ChildPath "Log"
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}

$Timestamp   = Get-Date -Format "yyyyMMdd_HHmmss"
$MainLogFile = Join-Path -Path $LogFolder -ChildPath "Execution_$Timestamp.log"

function Write-Log {
    param (
        [string]$Message,
        [ConsoleColor]$ForegroundColor = [ConsoleColor]::White,
        [switch]$IsError
    )
    $timePrefix = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $formattedMsg = "[$timePrefix] $Message"
    
    Write-Host $Message -ForegroundColor $ForegroundColor
    Add-Content -Path $MainLogFile -Value $formattedMsg -Encoding UTF8
}

Write-Log "=== 開始執行 SQL 批次處理與更新作業 ===" -ForegroundColor Cyan
Write-Log "主執行紀錄檔: $MainLogFile" -ForegroundColor DarkGray

# ==========================================
# 2. 載入 LDAP DLL 並取得連線字串
# ==========================================
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (-not (Test-Path -Path $dllPath)) {
    Write-Log "錯誤：找不到 DLL 檔案: $dllPath" -ForegroundColor Red -IsError
    exit 1
}

try {
    if (-not ([System.Management.Automation.PSTypeName]'Tsbldapdbc.RunBat').Type) {
        Add-Type -Path $dllPath
    }

    $App = New-Object Tsbldapdbc.RunBat
    $App.SSL = $false
    $App.ldapHost = "10.6.95.91"
    $App.searchBase = "o=tsbank"
    $sApp = "AML"
    $iCStr = 7

    $connStr = $App.GetRunBat($sApp, $iCStr)
}
catch {
    Write-Log "錯誤：讀取 LDAP 連線資訊時發生例外: $($_.Exception.Message)" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 3. 自動解析連線字串參數
# ==========================================
$Server   = if ($connStr -match '(?:Data Source|Server)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Database = if ($connStr -match '(?:Initial Catalog|Database)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$User     = if ($connStr -match '(?:User ID|UID)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Password = if ($connStr -match '(?:Password|PWD)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }

Write-Log "解析連線資訊 -> Server: $Server | DB: $Database | User: $User" -ForegroundColor DarkCyan

if ([string]::IsNullOrWhiteSpace($Server)) {
    Write-Log "錯誤：無法正確解析 Server 連線資訊！" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 4. 執行各 Table TRUNCATE 與 DELETE 語法
# ==========================================
$targetDatabase = "BSADBTW" # SQL 執行的目標資料庫

# 定義要執行的完整 SQL 語句
$sqlScript = @"
SET NOCOUNT ON;

-- 1. Truncate 資料表
TRUNCATE TABLE dbo.lowrisklistgroups;
TRUNCATE TABLE dbo.OFAC_SPEC;
TRUNCATE TABLE dbo.OFAC_SPEC_RestrictedCountry;

-- 2. 刪除名單設定 (list = 'SPEC')
DELETE FROM dbo.BlackList_Setting_Pending         WHERE list = 'SPEC';
DELETE FROM dbo.BlackList_Setting                 WHERE list = 'SPEC';
DELETE FROM dbo.DWire_BlackListSetting             WHERE list = 'SPEC';
DELETE FROM dbo.DWire_BlackListSetting_Pending     WHERE list = 'SPEC';
DELETE FROM dbo.TradeFin_BlackListSetting_Pending  WHERE list = 'SPEC';
DELETE FROM dbo.TradeFin_BlackListSetting          WHERE list = 'SPEC';
DELETE FROM dbo.SWIFTMX_BlackList_Setting_Pending  WHERE list = 'SPEC';
DELETE FROM dbo.SWIFTMX_BlackList_Setting          WHERE list = 'SPEC';
"@

Write-Log "開始連線至資料庫 [$Server].[$targetDatabase] 執行清理作業..." -ForegroundColor Yellow

# 重組連線字串（使用指定 Database: BSADBTW）
$builder = New-Object System.Data.SqlClient.SqlConnectionStringBuilder
$builder["Data Source"] = $Server
$builder["Initial Catalog"] = $targetDatabase

if (-not [string]::IsNullOrWhiteSpace($User)) {
    $builder["User ID"] = $User
    $builder["Password"] = $Password
} else {
    $builder["Integrated Security"] = $true
}

$dbConn = New-Object System.Data.SqlClient.SqlConnection($builder.ConnectionString)
$transaction = $null

try {
    $dbConn.Open()
    Write-Log "資料庫連線成功，啟用 Transaction 執行語法..." -ForegroundColor Green

    # 啟用交易控制，若任一指令失敗即全部 Rollback
    $transaction = $dbConn.BeginTransaction("CleanupTransaction")
    $cmd = $dbConn.CreateCommand()
    $cmd.Transaction = $transaction
    $cmd.CommandText = $sqlScript
    $cmd.CommandTimeout = 120 # 逾時時間 120 秒

    $rowsAffected = $cmd.ExecuteNonQuery()
    
    # 提交交易
    $transaction.Commit()
    Write-Log "語法執行成功！受影響總筆數 (DELETE 部分): $rowsAffected 筆" -ForegroundColor Green
}
catch {
    if ($null -ne $transaction) {
        try { 
            $transaction.Rollback() 
            Write-Log "執行失敗，已觸發 Rollback 回滾所有變更。" -ForegroundColor Yellow
        } 
        catch {}
    }
    Write-Log "錯誤：SQL 執行過程發生例外: $($_.Exception.Message)" -ForegroundColor Red -IsError
    exit 1
}
finally {
    if ($dbConn.State -eq [System.Data.ConnectionState]::Open) {
        $dbConn.Close()
        $dbConn.Dispose()
    }
    Write-Log "=== 批次處理作業完成 ===" -ForegroundColor Cyan
}
