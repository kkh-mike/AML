                                                                COALESCE(s.TS_CUST_ID, B.CustomerNo) AS CustomerNo,
                                                                B.CUST_NME,
                                                                B.NATIVE_CUST_NME,
                                                                B.Alias_Name,
                                                                B.C_CTRYCD,
                                                                B.NATIONALITY_1,
                                                                B.NATIONALITY_2,
