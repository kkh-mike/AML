# ==========================================
# 5. 連線資料庫並在交易中執行
# ==========================================
$sqlConnString = "Server=$Server;Database=$Database;User Id=$User;Password=$Password;Connection Timeout=60;"
$connection = New-Object System.Data.SqlClient.SqlConnection($sqlConnString)

try {
    Write-Log "正在連線至 SQL Server ($Server)..." -ForegroundColor Yellow
    $connection.Open()
    Write-Log "資料庫連線成功。" -ForegroundColor Green

    # 開啟交易機制
    $transaction = $connection.BeginTransaction("CleanupTransaction")
    $cmd = $connection.CreateCommand()
    $cmd.Transaction = $transaction
    $cmd.CommandTimeout = 0  # 設為 0 代表不限逾時時間 (防止大資料量刪除超時)

    # 依分號切分語句依序執行
    $statements = $cleanupSql -split ';' | Where-Object { -not [string]::IsNullOrWhiteSpace($_.Trim()) }

    foreach ($statement in $statements) {
        $trimmedSql = $statement.Trim()
        
        # 擷取操作的 Table 名稱以顯示 Log
        $targetTable = if ($trimmedSql -match '(?i)(?:FROM|TRUNCATE\s+TABLE)\s+([^\s\r\n]+)') { $matches[1] } else { "SQL 語句" }
        
        Write-Log "正在執行: $targetTable ..." -ForegroundColor Gray
        $cmd.CommandText = $trimmedSql
        $affectedRows = $cmd.ExecuteNonQuery()

        if ($trimmedSql -match '(?i)^DELETE') {
            Write-Log "已完成 $targetTable 清除作業 (刪除筆數: $affectedRows)" -ForegroundColor Green
        }
        elseif ($trimmedSql -match '(?i)^TRUNCATE') {
            Write-Log "已完成 $targetTable Truncate 作業" -ForegroundColor Green
        }
    }

    # 全部執行無誤則 Commit
    $transaction.Commit()
    Write-Log "=== 所有清除指令執行完畢並已成功 Commit ===" -ForegroundColor Cyan
}
catch {
    Write-Log "執行 SQL 時發生錯誤: $($_.Exception.Message)" -ForegroundColor Red -IsError
    if ($null -ne $transaction -and $transaction.Connection -ne $null) {
        $transaction.Rollback()
        Write-Log "發生錯誤，交易已全數 Rollback 回滾。" -ForegroundColor Yellow
    }
    exit 1
}
finally {
    if ($connection.State -eq [System.Data.ConnectionState]::Open) {
        $connection.Close()
        Write-Log "資料庫連線已關閉。" -ForegroundColor DarkGray
    }
}
