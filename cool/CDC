# ==========================================
# 自動抓取 LDAP 連線資訊 + 批次執行 Split 資料夾內 SQL + 執行各 Table Update / Delete
# ==========================================

# 1. 資料夾準備與全域 Log 初始化
$LogFolder = Join-Path -Path $PSScriptRoot -ChildPath "Log"
if (!(Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder | Out-Null
}

$Timestamp   = Get-Date -Format "yyyyMMdd_HHmmss"
$MainLogFile = Join-Path -Path $LogFolder -ChildPath "Execution_$Timestamp.log"

function Write-Log {
    param (
        [string]$Message,
        [ConsoleColor]$ForegroundColor = [ConsoleColor]::White,
        [switch]$IsError
    )
    $timePrefix = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $formattedMsg = "[$timePrefix] $Message"
    
    Write-Host $Message -ForegroundColor $ForegroundColor
    Add-Content -Path $MainLogFile -Value $formattedMsg -Encoding UTF8
}

Write-Log "=== 開始執行 SQL 批次處理與更新作業 ===" -ForegroundColor Cyan
Write-Log "主執行紀錄檔: $MainLogFile" -ForegroundColor DarkGray

# ==========================================
# 2. 載入 LDAP DLL 並取得連線字串
# ==========================================
$dllPath = Join-Path -Path $PSScriptRoot -ChildPath "Tsbldapdbc.dll"

if (-not (Test-Path -Path $dllPath)) {
    Write-Log "錯誤：找不到 DLL 檔案: $dllPath" -ForegroundColor Red -IsError
    exit 1
}

try {
    if (-not ([System.Management.Automation.PSTypeName]'Tsbldapdbc.RunBat').Type) {
        Add-Type -Path $dllPath
    }

    $App = New-Object Tsbldapdbc.RunBat
    $App.SSL = $false
    $App.ldapHost = "10.6.95.91"
    $App.searchBase = "o=tsbank"
    $sApp = "AML"
    $iCStr = 7

    $connStr = $App.GetRunBat($sApp, $iCStr)
}
catch {
    Write-Log "錯誤：讀取 LDAP 連線資訊時發生例外: $($_.Exception.Message)" -ForegroundColor Red -IsError
    exit 1
}

# 3. 自動解析連線字串參數
$Server   = if ($connStr -match '(?:Data Source|Server)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Database = if ($connStr -match '(?:Initial Catalog|Database)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$User     = if ($connStr -match '(?:User ID|UID)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }
$Password = if ($connStr -match '(?:Password|PWD)\s*=\s*([^;]+)') { $matches[1].Trim() } else { "" }

Write-Log "解析連線資訊 -> Server: $Server | DB: $Database | User: $User" -ForegroundColor DarkCyan

if ([string]::IsNullOrWhiteSpace($Server) -or [string]::IsNullOrWhiteSpace($Database)) {
    Write-Log "錯誤：無法正確解析 Server 或 Database 連線資訊！" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 6. 解析 BatchControl.sql 取得 BatchID
# ==========================================
Write-Log ""
Write-Log "========================================="
Write-Log "開始讀取 BatchControl.sql 擷取 BatchID..." -ForegroundColor Cyan

$BatchControlPath = Join-Path -Path $PSScriptRoot -ChildPath "BatchControl.sql"
if (-not (Test-Path $BatchControlPath)) {
    $SplitFolder = Join-Path -Path $PSScriptRoot -ChildPath "Split"
    $BatchControlPath = Join-Path -Path $SplitFolder -ChildPath "BatchControl.sql"
}

if (-not (Test-Path $BatchControlPath)) {
    Write-Log "錯誤：找不到 BatchControl.sql 檔案！" -ForegroundColor Red -IsError
    exit 1
}

# 擷取 BatchID
$batchFileContent = Get-Content -Path $BatchControlPath -Raw -Encoding UTF8
if ($batchFileContent -match "VALUES\s*\(\s*N?'([^']+)'") {
    $ExtractedBatchID = $matches[1].Trim()
    Write-Log "成功取得 BatchID: $ExtractedBatchID" -ForegroundColor Green
} else {
    Write-Log "錯誤：無法從 BatchControl.sql 中解析出 BatchID！" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 7. 依 BatchID 刪除各 Table 既有資料 (含交易控制)
# ==========================================
Write-Log ""
Write-Log "========================================="
Write-Log "開始清理各 Table 中 BatchID = '$ExtractedBatchID' 的資料..." -ForegroundColor Cyan

# 欲刪除資料的 Table 清單 (依照外鍵相依性排序，先刪子表再刪主表)
$tablesToDelete = @(
    "SAR_Trxn_Detail",
    "SAR_Trxn_Detail_All",
    "SAR_Trxn_Summary",
    "SAR_Suspect_Info",
    "SAR_Matched_Scenarios",
    "SAR_Conductor_Info",
    "SAR_Case_Trxn_Date_Range",
    "SAR_Case_Trxn_Branch",
    "SAR_Case_Main",
    "SAR_Acct_Info",
    "BatchControl"
)

# 建立 DB 連線
$dbConn = New-Object System.Data.SqlClient.SqlConnection($connStr)

try {
    $dbConn.Open()
    $transaction = $dbConn.BeginTransaction("DeleteBatchData")

    foreach ($tableName in $tablesToDelete) {
        $deleteSql = "DELETE FROM [$tableName] WHERE [BatchID] = @BatchID"
        $cmd = $dbConn.CreateCommand()
        $cmd.Transaction = $transaction
        $cmd.CommandText = $deleteSql
        
        $param = $cmd.Parameters.Add("@BatchID", [System.Data.SqlDbType]::VarChar)
        $param.Value = $ExtractedBatchID

        $rowsAffected = $cmd.ExecuteNonQuery()
        Write-Log "已刪除 [$tableName] 共 $rowsAffected 筆資料" -ForegroundColor Gray
    }

    # 全部成功則提交交易
    $transaction.Commit()
    Write-Log "所有 Table 資料刪除完成並已提交 Transaction。" -ForegroundColor Green
}
catch {
    if ($null -ne $transaction) {
        $transaction.Rollback()
        Write-Log "刪除資料失敗，已執行 Rollback 回滾交易。" -ForegroundColor Yellow
    }
    Write-Log "資料庫執行例外: $($_.Exception.Message)" -ForegroundColor Red -IsError
    if ($dbConn.State -eq [System.Data.ConnectionState]::Open) {
        $dbConn.Close()
    }
    exit 1
}
finally {
    if ($dbConn.State -eq [System.Data.ConnectionState]::Open) {
        $dbConn.Close()
    }
}

# ==========================================
# 8. 最終結果與 Exit Code 回傳
# ==========================================
Write-Log ""
Write-Log "========================================="
Write-Log "批次作業執行完畢！" -ForegroundColor Green
Write-Log "========================================="
exit 0
