# 建立錯誤訊息

$logName = "Application"
$sourceName = "PATRIOT OFFICER SWIFT Database Service"
$eventId = 0

# 1. 檢查並註冊該 Source（需系統管理員身分執行一次）
if (-not [System.Diagnostics.EventLog]::SourceExists($sourceName)) {
    New-EventLog -LogName $logName -Source $sourceName
    Write-Host "已建立事件來源: $sourceName" -ForegroundColor Cyan
}

# 2. 模擬真實的錯誤訊息內容
$mockMessage = @"
Exception Type : SqlException
Source : .Net SqlClient Data Provider
Date : $(Get-Date -Format "yyyy年MM月dd日")
Time : $(Get-Date -Format "tt hh:mm:ss")
Message : 執行逾時到期。在作業完成之前超過逾時等待的時間，或是伺服器未回應。

Custom message :
Message Id :$(New-Guid) does not completed in SWIFT detection

SQL Exception Detail :
Error Code : -2146232060
Server : amldb1
Source : .Net SqlClient Data Provider
"@

# 3. 寫入 Event Log
Write-EventLog -LogName $logName `
               -Source $sourceName `
               -EntryType Error `
               -EventId $eventId `
               -Message $mockMessage

Write-Host "已成功模擬寫入 PATRIOT OFFICER 逾時錯誤！" -ForegroundColor Green







