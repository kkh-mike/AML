
-- 1. 客戶本身的負面新聞
SELECT 
    b.customerno,
    a.CUST_NME,
    a.OPEN_DTE,
    a.CLOSED_DTE,
    a.BRNCH_NBR,
    b.HIGHRISK,
    b.RiskScore,
    'The account holder has negative news' AS NN_Type,
    'Y' AS NN_Flag
FROM PB_Customer_FACT a
INNER JOIN BSA_SUB_CUST_FACT b ON a.CIF_KEY = b.CIF_KEY
INNER JOIN BSA_SUB_CUST_FACT_Extension c ON c.CIF_KEY = b.CIF_KEY
WHERE c.PEPBitwiseCode & 4 = 4

UNION ALL

-- 5. 捐贈者/設立人（DN）的負面新聞
SELECT 
    b.customerno,
    a.CUST_NME,
    a.OPEN_DTE,
    a.CLOSED_DTE,
    a.BRNCH_NBR,
    b.HIGHRISK,
    b.RiskScore,
    'Beneficiary has negative news' AS NN_Type,
    'Y' AS NN_Flag
FROM PB_Customer_FACT a
INNER JOIN BSA_SUB_CUST_FACT b ON a.CIF_KEY = b.CIF_KEY
INNER JOIN PB_OtherRelatedParty_Fact e ON e.CIFKey = b.CIF_KEY
INNER JOIN PB_OtherRelatedParty_SubTypeCodes f ON f.CIFKey = b.CIF_KEY
WHERE e.PEPBitwiseCode & 4 = 4 
AND f.SubTypeCodes = 'BF'

UNION ALL

