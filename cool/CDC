SELECT 
    CASE 
        WHEN T.remark IS NULL THEN '預計 INSERT (全新新增)'
        WHEN T.DInd = 'Y' THEN '預計 UPDATE (重新上架)'
        WHEN MAX(C.UpdatedDate) <> T.updated_date THEN '預計 UPDATE (日期更新)'
        ELSE '資料一致 (不異動)'
    END AS [Expected_Action],
    
    -- 寫入條件檢核欄位
    A.PersonStatus                      AS [條件:人員狀態(Active/Inactive)],
    CASE 
        WHEN B.Description2 = 'Sanctions Lists' THEN 'Sanctions Lists (主清單)'
        ELSE B.Description3 
    END                                 AS [條件:符合制裁分類],
    D.IdentificationType                AS [條件:19類證件類型],
    D.IdentificationNumber              AS [spec_name(證照/通訊碼)],
    A.EntityId                          AS [remark(EntityId)],
    MAX(C.UpdatedDate)                  AS [updated_date],
    
    -- 預計寫入目標表的組合欄位
    D.IdentificationType + '; Please go to Dowjones website for more detail' AS [預計寫入ADDRESS欄位],
    T.DInd                              AS [目前Target表DInd]
FROM BSADB.dbo.DJ_Entity A WITH (NOLOCK)
JOIN BSADB.dbo.DJ_ListCategory B WITH (NOLOCK) ON A.EntityId = B.EntityId
JOIN BSADB.dbo.DJ_List_Data_A C WITH (NOLOCK) ON A.EntityId = C.EntNum
JOIN BSADB.dbo.DJ_IdentificationTypeInfo D WITH (NOLOCK) ON A.EntityId = D.EntityId
LEFT JOIN BSADB.dbo.OFAC_GLSpec T WITH (NOLOCK)
       ON T.GROUPID = 10
      AND T.spec_name = D.IdentificationNumber
      AND T.remark = CAST(A.EntityId AS VARCHAR(100))
      AND REPLACE(T.ADDRESS, '; Please go to Dowjones website for more detail', '') = D.IdentificationType
WHERE A.PersonStatus <> 'Inactive'
  AND (
        B.Description2 = 'Sanctions Lists'
     OR B.Description3 IN (
            'OFAC Related - Majority Owned',
            'OFAC Related - Control',
            'OFAC - Regional Sanctions Related - Majority Owned',
            'OFAC - Regional Sanctions Related - Control',
            'EU Related - Majority Owned',
            'EU Related - Control',
            'EU - Regional Sanctions Related - Majority Owned',
            'EU - Regional Sanctions Related - Control'
        )
      )
  AND B.Deleted = 0
  AND D.IdentificationType IN (
        'Aircraft Construction, Line, Fleet or Serial Number',
        'Aircraft Manufacturer''s Serial Number (MSN)',
        'Bank Identifier Code (BIC)',
        'Central Registration Depository (CRD)',
        'Company Identification No.',
        'Driving Licence No.',
        'DUNS Number',
        'International Maritime Organization (IMO) Ship No.',
        'International Securities Identification Number (ISIN)',
        'Legal Entity Identifier (LEI)',
        'National ID',
        'National Provider Identifier (NPI)',
        'National Tax No.',
        'Others',
        'Passport No.',
        'Social Security No.',
        'Email',
        'Fax',
        'Phone'
      )
  AND D.Deleted = 0
GROUP BY 
    A.EntityId, 
    A.PersonStatus,
    B.Description2,
    B.Description3,
    D.IdentificationType, 
    D.IdentificationNumber,
    T.remark,
    T.DInd,
    T.updated_date
ORDER BY [Expected_Action] DESC, A.EntityId;


