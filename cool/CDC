ALTER PROCEDURE [dbo].[WORKFLOW_AutomatedUSERS_TS] 
AS
BEGIN
	SET NOCOUNT ON;
	
	DECLARE @BankNo VARCHAR(50) = REPLACE(DB_NAME(),'BSADB','');
	DECLARE @Today_UTC DATETIME = GETUTCDATE();
	DECLARE @Today_Local DATETIME = dbo.ConvertToBankLocalTime(@Today_UTC);
	
	DECLARE @TableWorkflowMgmtUsersHistory TABLE (
		QUEUEID int NOT NULL,
		USERID nvarchar(60) NOT NULL,
		ROLE int NOT NULL,
		BUFFER nvarchar(5) NULL,
		HOLIDAYFROM nvarchar(10) NULL,
		HOLIDAYTO nvarchar(10) NULL,
		ALERTMAIN nvarchar(1) NULL,
		ALERTPERSONAL nvarchar(1) NULL,
		ALERTMAIN_FROM datetime NULL,
		ALERTMAIN_TO datetime NULL,
		ALERTPERSONAL_FROM datetime NULL,
		ALERTPERSONAL_TO datetime NULL,
		CREATEDBY nvarchar(40) NULL,
		CREATEDDT datetime NULL,
		CREATEDDT_UTC datetime NULL,
		ACTION_CODE varchar(2) NULL 
	)

	TRUNCATE TABLE [dbo].[WORKFLOW_AutomatedDeletedUsers_temp]
	
	;WITH CTE_TempUsers AS (
		SELECT D.QUEUEID, A.CN AS UserID, C.UserRole
	FROM [GCMAINDB]..[AutomatedEmployees] A 
		JOIN [GCMAINDB]..[CTCBEmployees] B ON A.CN = B.cn
		JOIN WORKFLOW_MGMT_AutomatedUserSetting_Taishin C ON A.BANKNO = C.BankNo AND B.PermCodePattern = C.PermCode
		JOIN [WORKFLOW_MGMT_QUEUE] D ON D.SRC = C.ModuleCode
		JOIN [WORKFLOW_MGMT_MODULE] E ON (C.IsByBranch = 0 OR D.QUEUENAME = A.BRANCH + ' ' + E.MemberName) AND E.MemberCode = D.SRC
		WHERE A.BANKNO = @BankNo
		AND ISNULL(A.BRANCH, '') <> ''
		AND D.DEL_FLAG = 'N'
	), CTE_WORKFLOW_MGMT_USERS AS(
		SELECT A.[QUEUEID], [USERID], [ROLE], [BUFFER], [HOLIDAYFROM], [HOLIDAYTO], [ALERTMAIN], [ALERTPERSONAL],
			[ALERTMAIN_FROM], [ALERTMAIN_TO], [ALERTPERSONAL_FROM], [ALERTPERSONAL_TO], A.[IsAutomated]
		FROM [dbo].[WORKFLOW_MGMT_USERS] A
		WHERE EXISTS (SELECT 1 FROM [dbo].[WORKFLOW_MGMT_QUEUE] B WHERE A.QUEUEID = B.QUEUEID)
	)
	MERGE CTE_WORKFLOW_MGMT_USERS AS T
	USING CTE_TempUsers AS S
	ON S.QUEUEID = T.[QUEUEID] AND
		S.UserID = T.[USERID] AND
		S.UserRole = T.[ROLE] 
	WHEN NOT MATCHED BY TARGET THEN
		INSERT([QUEUEID], [USERID], [ROLE], [ALERTMAIN], [ALERTPERSONAL], [IsAutomated])
		VALUES(S.QUEUEID, S.UserID, S.UserRole, 'Y', 'Y', 'TRUE')
	WHEN MATCHED AND ISNULL(T.IsAutomated, 0) <> 'TRUE' THEN /*update IsAutomated = 1 if the user added screen and exists in ADDataImporter source*/
		UPDATE SET T.IsAutomated = 'TRUE'
	WHEN NOT MATCHED BY SOURCE AND T.IsAutomated = 'TRUE' THEN /*delete only user created through ADDataImporter*/
		DELETE
	OUTPUT
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[QUEUEID] ELSE INSERTED.[QUEUEID] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[USERID] ELSE INSERTED.[USERID] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ROLE] ELSE INSERTED.[ROLE] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[BUFFER] ELSE INSERTED.[BUFFER] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[HOLIDAYFROM] ELSE INSERTED.[HOLIDAYFROM] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[HOLIDAYTO] ELSE INSERTED.[HOLIDAYTO] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN] ELSE INSERTED.[ALERTMAIN] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL] ELSE INSERTED.[ALERTPERSONAL] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN_FROM] ELSE INSERTED.[ALERTMAIN_FROM] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTMAIN_TO] ELSE INSERTED.[ALERTMAIN_TO] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL_FROM] ELSE INSERTED.[ALERTPERSONAL_FROM] END, 
		CASE WHEN $ACTION = 'DELETE' THEN DELETED.[ALERTPERSONAL_TO] ELSE INSERTED.[ALERTPERSONAL_TO] END,
		CASE WHEN $ACTION = 'DELETE' THEN '03' ELSE '01' END 
	INTO @TableWorkflowMgmtUsersHistory([QUEUEID], [USERID], [ROLE],
		[BUFFER], [HOLIDAYFROM], [HOLIDAYTO],
		[ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],
		[ALERTPERSONAL_FROM], [ALERTPERSONAL_TO], [ACTION_CODE]);
	
	/*insert deleted users into WORKFLOW_MGMT_USERS_HISTORY*/
	INSERT INTO WORKFLOW_MGMT_USERS_HISTORY ([QUEUEID], [USERID], [ROLE],
		[BUFFER], [HOLIDAYFROM], [HOLIDAYTO],
		[ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],
		[ALERTPERSONAL_FROM], [ALERTPERSONAL_TO])
	SELECT [QUEUEID], [USERID], [ROLE],
		[BUFFER], [HOLIDAYFROM], [HOLIDAYTO],
		[ALERTMAIN], [ALERTPERSONAL], [ALERTMAIN_FROM], [ALERTMAIN_TO],
		[ALERTPERSONAL_FROM], [ALERTPERSONAL_TO] 
	FROM @TableWorkflowMgmtUsersHistory
	WHERE ACTION_CODE = '03'
	
	;WITH CTE_AllUsers AS(
		SELECT DISTINCT A.[UserID]
		FROM [dbo].[UserAccounts] A
		WHERE [A].[Deleted] = 'TRUE' AND
			NOT EXISTS(SELECT NULL FROM [dbo].[UserAccounts] B
				WHERE A.[UserID] = B.[UserID] AND 
					B.[Deleted] = 'FALSE')
	)
	INSERT INTO [dbo].[WORKFLOW_AutomatedDeletedUsers_temp]([UserId])
	SELECT A.[UserID]
	FROM [CTE_AllUsers] A
	
	/*Clear Queue Access for deleted user*/
	DELETE [dbo].[WORKFLOW_MGMT_QUEUEACCESS]
	WHERE EXISTS(SELECT NULL FROM [dbo].[WORKFLOW_AutomatedDeletedUsers_temp] A
		WHERE A.[UserId] = [WORKFLOW_MGMT_QUEUEACCESS].[USERID])
	
	/*Grant permission for new BankAdmin for all workflow Queue*/
	INSERT INTO dbo.WORKFLOW_MGMT_QUEUEACCESS ( QUEUEID, USERID )
	SELECT B.QUEUEID, A.cn FROM GCMAINDB.dbo.CTCBBankAdmins A, dbo.WORKFLOW_MGMT_QUEUE B 
	WHERE A.IsNew = 1 AND 
			NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_QUEUEACCESS C 
					WHERE C.QUEUEID = B.QUEUEID AND C.USERID = A.cn)
	
	
	/*****************RESET CASE****************************/
	DECLARE @SystemuserID VARCHAR(40) = N'System Admin'
	
	------------------Start SWIFT -----------------
	INSERT INTO dbo.SWIFT_MT_LOG ( MT_KEY, [ACTION], [ROLE], [STATUS], HANDLEDBY, QUEUEID, DESCR, LSTUPD_DATE, LSTUPD_USERID, 
								LSTUPD_USERROLE, LSTUPD_DATE_UTC )
	SELECT A.MT_KEY, 11, 1, 1, NULL, A.QueueID, null, @Today_Local, @SystemuserID, 
			NULL, @Today_UTC
	from SWIFT_MTHEADER_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	
	INSERT INTO dbo.SWIFT_RemarkLog ( MT_KEY, Role, HandledBy, Action, Remark, CreatedBy, Created_Date, UpdatedBy,
		Updated_Date, Created_Date_UTC,Updated_Date_UTC )
	SELECT MT_KEY, 1, NULL, 11, Remark, NULL , Created_Date, @SystemuserID, 
		@Today_Local, Created_Date_UTC, @Today_UTC 
	FROM SWIFT_MTHEADER_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
		
	UPDATE A 
	SET A.HandledBy = NULL, A.[Status] = '1', A.[ROLE] = 1, A.[ACTION] = 11,
		A.ReleaseBy = NULL,A.ReleaseDate = NULL, A.ReleaseBy_2 = NULL, A.ReleaseDate_2 = NULL, A.ReleaseBy_3 = NULL,
		A.ReleaseDate_3 = NULL, A.ReleaseBy_4 = NULL, A.ReleaseDate_4 = NULL, A.RejectBy = NULL, A.RejectDate = NULL, A.RejectBy_2 = NULL,
		A.RejectDate_2 = NULL, A.RejectBy_3 = NULL, A.RejectDate_3 = NULL, A.RejectBy_4 = NULL, A.RejectDate_4 = NULL
	OUTPUT INSERTED.MT_KEY, INSERTED.CLIENT_MSG_TYPE_CODE,INSERTED.BNK_NBR, INSERTED.ApplicationID, INSERTED.ServiceID,INSERTED	.BankCode, INSERTED.CountryCode, INSERTED.LocationCode,
		INSERTED.LogicalTerminalCode, INSERTED.BranchCode,INSERTED.SessionNumber, INSERTED.SequenceNumber,INSERTED.IO_Identifier, INSERTED.MessageType,INSERTED.ReceiverAddress, INSERTED.MessagePriority,
		INSERTED.DeliveryMonitoring,INSERTED.ObsolescencePeriod, INSERTED.InputTime, INSERTED.MIR,INSERTED.FORMAT, INSERTED.DIRECTION, INSERTED.OutputDate, INSERTED.OutputTime, INSERTED.Created_Date, INSERTED.Created_UserId, 
		INSERTED.Last_Upd_Date,INSERTED.Last_Upd_UserId, INSERTED.HandledBy, INSERTED.Status, INSERTED.Action, INSERTED.Role, INSERTED.QueueID, INSERTED.EmailID,INSERTED.LastEmailDate, INSERTED.Detected, INSERTED.HoldBy,INSERTED.AssignBy, INSERTED.AssignDate, INSERTED.ReleaseBy,
		INSERTED.ReleaseDate, INSERTED.ReleaseBy_2,INSERTED.ReleaseDate_2, INSERTED.ReleaseBy_3,INSERTED.ReleaseDate_3, INSERTED.ReleaseBy_4,INSERTED.ReleaseDate_4, INSERTED.RejectBy, INSERTED.RejectDate, INSERTED.RejectBy_2, 
		INSERTED.RejectDate_2,INSERTED.RejectBy_3, INSERTED.RejectDate_3, INSERTED.RejectBy_4, INSERTED.RejectDate_4, INSERTED.Msg_sender_id, INSERTED.Msg_receiver_id, INSERTED.EmailID_ThirdParty,
		INSERTED.LastEmailDate_ThirdParty,INSERTED.Receiver_BankCode,INSERTED.Receiver_CountryCode, INSERTED.Receiver_LocationCode, INSERTED.Receiver_BranchCode, @Today_Local,
		@SystemuserID, INSERTED.Block4_UserReference,INSERTED.Block4_Amt, INSERTED.Block4_Beneficiary,INSERTED.Remark, INSERTED.LstUpdate_Remark,INSERTED.LstUpdate_Date, INSERTED.SourceID,
		INSERTED.ClientReferenceNo, INSERTED.BranchNo,INSERTED.Channel, INSERTED.DNSLFlag, INSERTED.TYPE,INSERTED.Created_Date_UTC, INSERTED.Last_Upd_Date_UTC, INSERTED.LastEmailDate_UTC, INSERTED.AssignDate_UTC,
		INSERTED.ReleaseDate_UTC, INSERTED.ReleaseDate_2_UTC,INSERTED.ReleaseDate_3_UTC, INSERTED.ReleaseDate_4_UTC, INSERTED.RejectDate_UTC,INSERTED.RejectDate_2_UTC, INSERTED.RejectDate_3_UTC,
		INSERTED.RejectDate_4_UTC,INSERTED.LastEmailDate_ThirdParty_UTC,@Today_UTC, INSERTED.LstUpdate_Date_UTC 
	INTO dbo.SWIFT_MTHeader_Main_Log ( MT_KEY, CLIENT_MSG_TYPE_CODE,BNK_NBR, ApplicationID, ServiceID,BankCode, CountryCode, LocationCode,
		LogicalTerminalCode, BranchCode,SessionNumber, SequenceNumber,IO_Identifier, MessageType,ReceiverAddress, MessagePriority,
		DeliveryMonitoring,ObsolescencePeriod, InputTime, MIR,FORMAT, DIRECTION, OutputDate, OutputTime, Created_Date, Created_UserId, 
		Last_Upd_Date,Last_Upd_UserId, HandledBy, Status, Action, Role, QueueID, EmailID,LastEmailDate, Detected, HoldBy,AssignBy, AssignDate, ReleaseBy,
		ReleaseDate, ReleaseBy_2,ReleaseDate_2, ReleaseBy_3,ReleaseDate_3, ReleaseBy_4,ReleaseDate_4, RejectBy, RejectDate, RejectBy_2, 
		RejectDate_2,RejectBy_3, RejectDate_3, RejectBy_4, RejectDate_4, Msg_sender_id, Msg_receiver_id, EmailID_ThirdParty,
		LastEmailDate_ThirdParty,Receiver_BankCode,Receiver_CountryCode, Receiver_LocationCode, Receiver_BranchCode, ActionDate,
		Action_UserID, Block4_UserReference,Block4_Amt, Block4_Beneficiary,Remark, LstUpdate_Remark,LstUpdate_Date, SourceID,
		ClientReferenceNo, BranchNo,Channel, DNSLFlag, TYPE,Created_Date_UTC, Last_Upd_Date_UTC, LastEmailDate_UTC, AssignDate_UTC,
		ReleaseDate_UTC, ReleaseDate_2_UTC,ReleaseDate_3_UTC, ReleaseDate_4_UTC, RejectDate_UTC,RejectDate_2_UTC, RejectDate_3_UTC,
		RejectDate_4_UTC,LastEmailDate_ThirdParty_UTC,ActionDate_UTC, LstUpdate_Date_UTC )
	FROM SWIFT_MTHEADER_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	------------------End SWIFT -----------------
	
	------------------Start NameCheck-----------------
	INSERT INTO dbo.NMCHK_Review_Diagram ( UID, NAME_KEY, ACTION, ROLE, STATUS, HANDLEDBY, QUEUEID, DESCR, LSTUPD_DATE,
	                                        LSTUPD_USERID, LSTUPD_USERROLE, LSTUPD_DATE_UTC )
	SELECT A.uid, A.name_key, 11, 1, 1, NULL, A.QueueID, NULL, @Today_Local,
		@SystemUserId, NULL, @Today_UTC
	FROM NMCHK_REVIEW_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	
	INSERT INTO dbo.NMCHK_RemarkLog ( UID, Name_Key, Role, HandledBy, Action, Remark, CreatedBy, Created_Date, UpdatedBy,
	                                   Updated_Date, Created_Date_UTC, Updated_Date_UTC, ExtendedReviewDate )
	SELECT  A.uid, A.name_key, 1, NULL, 11, A.Remark, A.Created_UserId, A.Created_Date, @SystemUserId,
		@Today_Local, A.Created_Date_UTC, @Today_UTC, A.ExtendedReviewDate
	FROM NMCHK_REVIEW_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	
	UPDATE A 
	SET A.HandledBy = NULL, A.[Status] = '1', A.[ROLE] = 1, A.[ACTION] = 11,
		A.ReleaseBy = NULL,A.ReleaseDate = NULL, A.ReleaseBy_2 = NULL, A.ReleaseDate_2 = NULL, A.ReleaseBy_3 = NULL,
		A.ReleaseDate_3 = NULL, A.ReleaseBy_4 = NULL, A.ReleaseDate_4 = NULL, A.RejectBy = NULL, A.RejectDate = NULL, A.RejectBy_2 = NULL,
		A.RejectDate_2 = NULL, A.RejectBy_3 = NULL, A.RejectDate_3 = NULL, A.RejectBy_4 = NULL, A.RejectDate_4 = NULL
	OUTPUT INSERTED.uid,INSERTED.name_key,INSERTED.BRANCH_NBR,INSERTED.Created_Date,INSERTED.Created_UserId,INSERTED.Last_Upd_Date,
	INSERTED.Last_Upd_UserId,INSERTED.HandledBy,INSERTED.Status,INSERTED.Action,INSERTED.Role,INSERTED.QueueID,INSERTED.EmailID,
	INSERTED.LastEmailDate,INSERTED.Detected,INSERTED.HoldBy,INSERTED.AssignBy,INSERTED.AssignDate,INSERTED.ReleaseBy,
	INSERTED.ReleaseDate,INSERTED.ReleaseBy_2,INSERTED.ReleaseDate_2,INSERTED.ReleaseBy_3,INSERTED.ReleaseDate_3,
	INSERTED.ReleaseBy_4,INSERTED.ReleaseDate_4,INSERTED.RejectBy,INSERTED.RejectDate,INSERTED.RejectBy_2,
	INSERTED.RejectDate_2,INSERTED.RejectBy_3,INSERTED.RejectDate_3,INSERTED.RejectBy_4,INSERTED.RejectDate_4,
	INSERTED.Msg_sender_id,INSERTED.Msg_receiver_id,INSERTED.EmailID_ThirdParty,
	INSERTED.LastEmailDate_ThirdParty,@Today_Local,@SystemUserId,INSERTED.Remark,
	INSERTED.LstUpdate_Remark,INSERTED.LstUpdate_Date,INSERTED.TYPE,INSERTED.Created_Date_UTC,
	INSERTED.Last_Upd_Date_UTC,INSERTED.LastEmailDate_UTC,INSERTED.AssignDate_UTC,INSERTED.ReleaseDate_UTC,
	INSERTED.ReleaseDate_2_UTC,INSERTED.ReleaseDate_3_UTC,INSERTED.ReleaseDate_4_UTC,
	INSERTED.RejectDate_UTC,INSERTED.RejectDate_2_UTC,INSERTED.RejectDate_3_UTC,INSERTED.RejectDate_4_UTC,
	@Today_UTC,INSERTED.LastEmailDate_ThirdParty_UTC,INSERTED.LstUpdate_Date_UTC,
	INSERTED.LstUpdate_Role, INSERTED.ExtendedReviewDate
	INTO dbo.NMCHK_Review_Main_Log (uid, name_key, BRANCH_NBR, Created_Date, Created_UserId, Last_Upd_Date,
	        Last_Upd_UserId, HandledBy, Status, Action, Role, QueueID, EmailID,
	        LastEmailDate, Detected, HoldBy, AssignBy, AssignDate, ReleaseBy,
	        ReleaseDate, ReleaseBy_2, ReleaseDate_2, ReleaseBy_3, ReleaseDate_3,
	        ReleaseBy_4, ReleaseDate_4, RejectBy, RejectDate, RejectBy_2,
	        RejectDate_2, RejectBy_3, RejectDate_3, RejectBy_4, RejectDate_4,
	        Msg_sender_id, Msg_receiver_id, EmailID_ThirdParty,
	        LastEmailDate_ThirdParty, ActionDate, Action_UserID, Remark,
	        LstUpdate_Remark, LstUpdate_Date, TYPE, Created_Date_UTC,
	        Last_Upd_Date_UTC, LastEmailDate_UTC, AssignDate_UTC, ReleaseDate_UTC,
	        ReleaseDate_2_UTC, ReleaseDate_3_UTC, ReleaseDate_4_UTC,
	        RejectDate_UTC, RejectDate_2_UTC, RejectDate_3_UTC, RejectDate_4_UTC,
	        ActionDate_UTC, LastEmailDate_ThirdParty_UTC, LstUpdate_Date_UTC,
	        LstUpdate_Role, ExtendedReviewDate)
	FROM NMCHK_REVIEW_MAIN A
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	------------------End NameCheck-----------------
	
	------------------Start DBCheck-----------------
	INSERT INTO dbo.DBCHK_Review_Diagram ( UID, CIF_KEY, ACTION, ROLE, STATUS, HANDLEDBY, QUEUEID, DESCR, LSTUPD_DATE,
	                                        LSTUPD_USERID, LSTUPD_USERROLE, LSTUPD_DATE_UTC )
	SELECT A.uid, A.CIF_KEY, 11, 1, 1, NULL, A.QueueID, NULL, @Today_Local,
		@SystemUserId, NULL, @Today_UTC
	FROM DBCHK_REVIEW_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	
	INSERT INTO dbo.DBCHK_RemarkLog ( UID, CIF_KEY, Role, HandledBy, Action, Remark, CreatedBy, Created_Date, UpdatedBy,
	                                   Updated_Date, Created_Date_UTC, Updated_Date_UTC, ExtendedReviewDate )
	SELECT A.uid, A.CIF_KEY, 1, NULL, 11, A.Remark, A.Created_UserId, A.Created_Date, @SystemUserId,
		@Today_Local, A.Created_Date_UTC, @Today_UTC, A.ExtendedReviewDate
	FROM DBCHK_REVIEW_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	
	UPDATE A 
	SET A.HandledBy = NULL, A.[Status] = '1', A.[ROLE] = 1, A.[ACTION] = 11,
		A.ReleaseBy = NULL,A.ReleaseDate = NULL, A.ReleaseBy_2 = NULL, A.ReleaseDate_2 = NULL, A.ReleaseBy_3 = NULL,
		A.ReleaseDate_3 = NULL, A.ReleaseBy_4 = NULL, A.ReleaseDate_4 = NULL, A.RejectBy = NULL, A.RejectDate = NULL, A.RejectBy_2 = NULL,
		A.RejectDate_2 = NULL, A.RejectBy_3 = NULL, A.RejectDate_3 = NULL, A.RejectBy_4 = NULL, A.RejectDate_4 = NULL
	OUTPUT INSERTED.uid,INSERTED.CIF_KEY,INSERTED.BRANCH_NBR,INSERTED.Created_Date,INSERTED.Created_UserId,INSERTED.Last_Upd_Date,
	INSERTED.Last_Upd_UserId,INSERTED.HandledBy,INSERTED.Status,INSERTED.Action,INSERTED.Role,INSERTED.QueueID,INSERTED.EmailID,
	INSERTED.LastEmailDate,INSERTED.Detected,INSERTED.HoldBy,INSERTED.AssignBy,INSERTED.AssignDate,INSERTED.ReleaseBy,
	INSERTED.ReleaseDate,INSERTED.ReleaseBy_2,INSERTED.ReleaseDate_2,INSERTED.ReleaseBy_3,INSERTED.ReleaseDate_3,
	INSERTED.ReleaseBy_4,INSERTED.ReleaseDate_4,INSERTED.RejectBy,INSERTED.RejectDate,INSERTED.RejectBy_2,
	INSERTED.RejectDate_2,INSERTED.RejectBy_3,INSERTED.RejectDate_3,INSERTED.RejectBy_4,INSERTED.RejectDate_4,
	INSERTED.Msg_sender_id,INSERTED.Msg_receiver_id,INSERTED.EmailID_ThirdParty,
	INSERTED.LastEmailDate_ThirdParty,INSERTED.Remark,INSERTED.LstUpdate_Remark,INSERTED.LstUpdate_Date,
	INSERTED.TYPE,INSERTED.Created_Date_UTC,INSERTED.Last_Upd_Date_UTC,INSERTED.LastEmailDate_UTC,
	INSERTED.AssignDate_UTC,INSERTED.ReleaseDate_UTC,INSERTED.ReleaseDate_2_UTC,INSERTED.ReleaseDate_3_UTC,
	INSERTED.ReleaseDate_4_UTC,INSERTED.RejectDate_UTC,INSERTED.RejectDate_2_UTC,INSERTED.RejectDate_3_UTC,
	INSERTED.RejectDate_4_UTC,INSERTED.LastEmailDate_ThirdParty_UTC,INSERTED.LstUpdate_Date_UTC,
	INSERTED.REFNO,@Today_Local,@SystemUserId,@Today_UTC,INSERTED.CUST_NME,INSERTED.IsNew,
	INSERTED.LstUpdate_Role,INSERTED.ExtendedReviewDate
	INTO dbo.DBCHK_Review_Main_Log (uid, CIF_KEY, BRANCH_NBR, Created_Date, Created_UserId, Last_Upd_Date,
	        Last_Upd_UserId, HandledBy, Status, Action, Role, QueueID, EmailID,
	        LastEmailDate, Detected, HoldBy, AssignBy, AssignDate, ReleaseBy,
	        ReleaseDate, ReleaseBy_2, ReleaseDate_2, ReleaseBy_3, ReleaseDate_3,
	        ReleaseBy_4, ReleaseDate_4, RejectBy, RejectDate, RejectBy_2,
	        RejectDate_2, RejectBy_3, RejectDate_3, RejectBy_4, RejectDate_4,
	        Msg_sender_id, Msg_receiver_id, EmailID_ThirdParty,
	        LastEmailDate_ThirdParty, Remark, LstUpdate_Remark, LstUpdate_Date,
	        TYPE, Created_Date_UTC, Last_Upd_Date_UTC, LastEmailDate_UTC,
	        AssignDate_UTC, ReleaseDate_UTC, ReleaseDate_2_UTC, ReleaseDate_3_UTC,
	        ReleaseDate_4_UTC, RejectDate_UTC, RejectDate_2_UTC, RejectDate_3_UTC,
	        RejectDate_4_UTC, LastEmailDate_ThirdParty_UTC, LstUpdate_Date_UTC,
	        REFNO, ActionDate, Action_UserID, ActionDate_UTC, CUST_NME, IsNew,
	        LstUpdate_Role, ExtendedReviewDate)
	FROM DBCHK_REVIEW_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	------------------End DBCheck-----------------
	
	------------------Start SAR-----------------
	INSERT INTO dbo.SAR_LOG ( BATID, GROUPID, ACTION, ROLE, STATUS, HANDLEDBY, QUEUEID, DESCR, LSTUPD_DATE, LSTUPD_USERID,
	                           LSTUPD_USERROLE, LSTUPD_DATE_UTC )
	SELECT A.BATID, A.GROUPID, 11, 1, 1, NULL, A.QueueID, NULL, @Today_Local, @SystemUseriD,
		NULL, @Today_UTC
	FROM SAR_HEADER_MAIN A 
	WHERE A.[Status] <> '3' AND
		EXISTS (SELECT 1 FROM WORKFLOW_AutomatedDeletedUsers_temp B WHERE A.HandledBy = B.UserId) OR
		EXISTS (SELECT 1 FROM @TableWorkflowMgmtUsersHistory C WHERE A.HandledBy = C.UserId AND A.QueueID = C.QueueId AND C.ACTION_CODE = '03')
	
