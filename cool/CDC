第二步：完整的正式「逾時錯誤監控 + 自動發信」腳本
當第一步測試信成功後，這就是專門監控 PATRIOT OFFICER SWIFT Database Service 的 -2146232060 錯誤，並自動發信告警的完整腳本：
# ================= 設定區 =================
$minutesBack = 10                            # 每次檢查過去幾分鐘
$smtpServer  = "10.13.113.110"               # 內部發信主機
$smtpPort    = 25
$sender      = "AML@tsbtmail.com"            # 寄件者
$recipients  = @("1141923@taishinbank.com.tw") # 收件者清單（可填多人）
# ==========================================

$startTime = (Get-Date).AddMinutes(-$minutesBack)

# 1. 查詢 Application Event Log
$filter = @{
    LogName      = 'Application'
    ProviderName = 'PATRIOT OFFICER SWIFT Database Service'
    Level        = 2   # 2 = Error
    StartTime    = $startTime
}

$events = Get-WinEvent -FilterHashtable $filter -ErrorAction SilentlyContinue

# 2. 精確過濾 SQL Timeout 錯誤碼 (-2146232060)
$targetErrors = $events | Where-Object { 
    $_.Message -like "*-2146232060*" 
}

# 3. 偵測到異常時組裝 HTML 表格並寄信
if ($targetErrors) {
    Write-Host "⚠️ 偵測到 $($targetErrors.Count) 筆資料庫逾時錯誤，開始發信..." -ForegroundColor Red

    $hostName = $env:COMPUTERNAME
    $subject  = "[系統嚴重告警] $hostName - PATRIOT OFFICER SWIFT 資料庫逾時異常 ($($targetErrors.Count) 筆)"

    $tableRows = ""
    foreach ($evt in $targetErrors) {
        # 抓取錯誤訊息前 5 行精簡顯示
        $summary = ($evt.Message -split "`r`n|`n")[0..4] -join "<br/>"
        $tableRows += @"
        <tr>
            <td style='border:1px solid #ccc; padding:8px;'>$($evt.TimeCreated.ToString("yyyy-MM-dd HH:mm:ss"))</td>
            <td style='border:1px solid #ccc; padding:8px;'>$summary</td>
        </tr>
"@
    }

    $bodyHtml = @"
    <html>
    <body style='font-family: Arial, Microsoft JhengHei;'>
        <h3 style='color: #d9534f;'>PATRIOT OFFICER SWIFT 資料庫逾時告警 (-2146232060)</h3>
        <p><strong>主機名稱:</strong> $hostName</p>
        <p><strong>偵測區間:</strong> 過去 $minutesBack 分鐘內</p>
        <p><strong>異常筆數:</strong> $($targetErrors.Count) 筆</p>
        
        <table style='border-collapse:collapse; width:100%;'>
            <tr style='background-color:#f2f2f2;'>
                <th style='border:1px solid #ccc; padding:8px; text-align:left; width:180px;'>發生時間</th>
                <th style='border:1px solid #ccc; padding:8px; text-align:left;'>錯誤摘要</th>
            </tr>
            $tableRows
        </table>
        <p style='color:#888; font-size:12px; margin-top:15px;'>此郵件由 $hostName 監控排程自動發送，請勿直接回覆。</p>
    </body>
    </html>
"@

    $mail = New-Object System.Net.Mail.MailMessage
    $mail.From = New-Object System.Net.Mail.MailAddress($sender, "AML-Alert")
    foreach ($r in $recipients) { $mail.To.Add($r) }
    $mail.Subject = $subject
    $mail.Body = $bodyHtml
    $mail.IsBodyHtml = $true
    $mail.Priority = [System.Net.Mail.MailPriority]::High

    $smtp = New-Object System.Net.Mail.SmtpClient($smtpServer, $smtpPort)
    $smtp.Timeout = 10000

    try {
        $smtp.Send($mail)
        Write-Host "✅ 告警郵件已成功寄出！" -ForegroundColor Green
    } catch {
        Write-Host "❌ 寄信失敗: $($_.Exception.Message)" -ForegroundColor Red
    } finally {
        $mail.Dispose()
        $smtp.Dispose()
    }
} else {
    Write-Host "過去 $minutesBack 分鐘內無符合的 -2146232060 錯誤。" -ForegroundColor Green
}

