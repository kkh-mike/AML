SELECT DISTINCT
    A.EntityId,
    A.FullName,
    BL.sdn_name,
    O.GROUPID,
    O.spec_name,
    O.DInd
FROM BSADB.dbo.DJ_Entity A
JOIN BSADB.dbo.DJ_SanctionListReference B    ON A.EntityId = B.EntityId
JOIN BSADBJP..BlackListData BL    ON BL.sdn_name = A.FullName
LEFT JOIN BSADBJP..OFAC_SPEC O    ON O.spec_name = BL.sdn_name
WHERE A.Deceased = 1
AND B.SanctionListReference LIKE '%Japanese Finance%' AND O.GROUPID = '7'


