SELECT A.Block4_UserReference MESSAGE_ID,D.Progress, A.MT_KEY REF_NO, A.MessageType TYPE, '' HIT_TAG, replace(replace(B.FullName,char(10),''),char(13),'') DETECTED_NAME, replace(replace(C.SdnName,char(10),''),char(13),'') SdnName, C.SdnType, C.EntNum, C.RC
FROM SWIFT_MTHeader_Main A
LEFT JOIN MESSAGEDATABASE..Swift_MTRaw D ON A.MT_KEY = D.ID
LEFT JOIN SWIFT_ResultGroups C ON A.MT_KEY = C.SourceKey
LEFT JOIN SWIFT_ResultNames B ON A.MT_KEY = B.SourceKey and C.nameID = B.nameid
WHERE A.Block4_UserReference IN (SELECT referno FROM @Refno)
order by A.Created_Date




