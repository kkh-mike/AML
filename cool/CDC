這是一份不抓 Windows 事件檢視器、但會讀取 config.json 的純測試版本。它會直接塞入一筆模擬的逾時錯誤資料，組裝成正式告警的 HTML 表格並寄出，方便你先驗證排版外觀與發信流程。
1. 設定檔：config.json
與主程式放在同一個資料夾底下：
{
  "Monitor": {
    "MinutesBack": 10,
    "LogName": "Application",
    "ProviderName": "PATRIOT OFFICER SWIFT Database Service",
    "EventId": 0,
    "Level": 2,
    "ErrorCodePattern": "*-2146232060*"
  },
  "Mail": {
    "SmtpServer": "relay.taishinbank.com.tw",
    "SmtpPort": 25,
    "Sender": "AML_ALERT@taishinbank.com.tw",
    "Recipients": [
      "1141923@taishinbank.com.tw"
    ],
    "TimeoutMs": 10000
  }
}

2. 測試發信腳本：Test_SendMail.ps1
# 1. 讀取同目錄下的 config.json
$scriptPath = Split-Path -Parent $MyInvocation.MyCommand.Definition
$configPath = Join-Path $scriptPath "config.json"

if (-not (Test-Path $configPath)) {
    Write-Error "找不到設定檔: $configPath"
    exit 1
}

$config = Get-Content -Path $configPath -Raw -Encoding UTF8 | ConvertFrom-Json
Write-Host "成功讀取設定檔: $configPath" -ForegroundColor Green

# 2. 產生一筆「模擬」的逾時錯誤事件資料（不讀取事件檢視器）
$mockErrorMsg = @"
System.Data.SqlClient.SqlException (0x80131904): 執行逾時已過期。在作業完成之前已過了逾時等待期間，或者伺服器未回應。
錯誤代碼: -2146232060
   於 System.Data.SqlClient.SqlConnection.OnError(SqlException exception, Boolean breakConnection)
   於 PATRIOT_OFFICER_SWIFT.DbWorker.ExecuteQuery()
"@

$mockErrors = @(
    [PSCustomObject]@{
        TimeCreated = (Get-Date).ToString("yyyy/MM/dd HH:mm:ss")
        MachineName = $env:COMPUTERNAME
        Id          = if ($config.Monitor.EventId) { $config.Monitor.EventId } else { "0" }
        Message     = $mockErrorMsg
    }
)

# 3. 組合 HTML 表格信件
$tableRows = foreach ($evt in $mockErrors) {
    $cleanMsg = [System.Web.HttpUtility]::HtmlEncode($evt.Message)
    "<tr>
        <td style='padding:8px; border:1px solid #ddd;'>$($evt.TimeCreated)</td>
        <td style='padding:8px; border:1px solid #ddd;'>$($evt.MachineName)</td>
        <td style='padding:8px; border:1px solid #ddd;'>$($evt.Id)</td>
        <td style='padding:8px; border:1px solid #ddd;'><pre style='margin:0; font-family:Consolas, monospace;'>$cleanMsg</pre></td>
    </tr>"
}

$htmlBody = @"
<html>
<body style='font-family:Microsoft JhengHei, Arial, sans-serif; font-size:14px;'>
    <h3 style='color:#D9534F;'>【系統告警】$($config.Monitor.ProviderName) 異常通知 (排版測試)</h3>
    <p>監控機制於 <b>$($env:COMPUTERNAME)</b> 偵測到資料庫錯誤事件，詳情如下：</p>
    <table style='border-collapse:collapse; width:100%; font-size:13px;'>
        <tr style='background-color:#f2f2f2;'>
            <th style='padding:8px; border:1px solid #ddd; width:150px;'>發生時間</th>
            <th style='padding:8px; border:1px solid #ddd; width:100px;'>主機名稱</th>
            <th style='padding:8px; border:1px solid #ddd; width:60px;'>事件 ID</th>
            <th style='padding:8px; border:1px solid #ddd;'>錯誤內容</th>
        </tr>
        $($tableRows -join "`n")
    </table>
    <p style='color:gray; font-size:12px; margin-top:20px;'>本信件為排程發信測試樣本，請勿直接回覆。</p>
</body>
</html>
"@

# 4. 建立郵件物件並送出
$mail = New-Object System.Net.Mail.MailMessage
$mail.From = New-Object System.Net.Mail.MailAddress($config.Mail.Sender, "AML_ALERT")

foreach ($to in $config.Mail.Recipients) {
    $mail.To.Add($to)
}

$mail.Subject = "【測試告警】$($env:COMPUTERNAME) - 偵測到 $($config.Monitor.ProviderName) 逾時異常 (模擬)"
$mail.Body = $htmlBody
$mail.IsBodyHtml = $true
$mail.Priority = [System.Net.Mail.MailPriority]::High

$smtp = New-Object System.Net.Mail.SmtpClient($config.Mail.SmtpServer, [int]$config.Mail.SmtpPort)
$smtp.Timeout = [int]$config.Mail.TimeoutMs

try {
    Write-Host "正在寄送測試告警信至: $($config.Mail.Recipients -join ', ')..." -ForegroundColor Cyan
    $smtp.Send($mail)
    Write-Host "測試信件已成功發送！請至 Outlook 檢查排版效果。" -ForegroundColor Green
} catch {
    Write-Host "測試信件發送失敗: $($_.Exception.Message)" -ForegroundColor Red
} finally {
    $mail.Dispose()
    $smtp.Dispose()
}

