/*
*	20200918 納閩分行
*	20211130 掛帳用虛擬CIF設定CLOSE
*/
ALTER VIEW [dbo].[Preload_Customer] AS

	WITH CIF_TYPE AS (
		SELECT 
			CIF.CIF_CUST_INFO_SEQ
			,CASE WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD='00706' AND CIF.DEP_OR_FAC<>'Y' THEN 'A1'
				WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD='00706' AND CIF.DEP_OR_FAC='Y' THEN 'A2'
				WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD<>'00706' AND CIF.DEP_OR_FAC<>'Y' THEN 
					CASE WHEN CIF.AML_OPENING_DATE BETWEEN CONVERT(VARCHAR,GETDATE()-7,112) AND CONVERT(VARCHAR,GETDATE()-1,112) THEN 'B1_OPEN'
					ELSE 'B1_CLOSE' END
				WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD<>'00706' AND CIF.DEP_OR_FAC='Y' THEN 'B2'
				WHEN CIF.GUR<>'Y' AND CIF.FI='Y' AND CIF.AML_BUZ_SECTOR_CD='00706' AND CIF.DEP_OR_FAC<>'Y' THEN 'C1'
				WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD='00706' AND CIF.DEP_OR_FAC='Y' THEN 'C2'
				WHEN CIF.GUR='Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD<>'00706' AND CIF.DEP_OR_FAC<>'Y' THEN 'D1'
				WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD<>'00706' AND CIF.DEP_OR_FAC='Y' THEN 'D2'
				WHEN CIF.GUR='Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD='00706' AND CIF.DEP_OR_FAC<>'Y' THEN 'E1'
				WHEN CIF.GUR<>'Y' AND CIF.FI<>'Y' AND CIF.AML_BUZ_SECTOR_CD='00706' AND CIF.DEP_OR_FAC='Y' THEN 'E2'
				WHEN CIF.AML_BUZ_SECTOR_CD='00717' THEN 'F1'
				ELSE 'ELSE' END AS CIF_TYPE
			,CIF.AML_BUZ_SECTOR_CD
			,CIF.AML_OPENING_DATE
		FROM (
			SELECT
				CIF.CIF_CUST_INFO_SEQ
				,ISNULL( (CASE WHEN CIF.GUARANTOR='Y' THEN 'Y' ELSE 'N' END) ,'Y') AS GUR
				,ISNULL( (CASE WHEN CIF.FI_CUST='Y' THEN 'Y' ELSE 'N' END) ,'Y') AS FI
				,ISNULL( (CASE WHEN FAC.FAC_COUNT>0 OR DEP.DEP_COUNT>0 THEN 'Y' ELSE 'N' END) ,'N') AS DEP_OR_FAC
				,CIF.BUSINESS_SECTOR_CODE AS AML_BUZ_SECTOR_CD
				,CIF.OPENING_DATE AS AML_OPENING_DATE
			FROM dbo.WBS_CIF_CUST_INFO CIF
			LEFT JOIN (
				SELECT COUNT(*) AS DEP_COUNT ,DEP.CIF_CUST_INFO_SEQ FROM WBS_DEP_ACC DEP 
				WHERE DEP.CASE_STATUS = '01' GROUP BY DEP.CIF_CUST_INFO_SEQ
			) DEP ON DEP.CIF_CUST_INFO_SEQ=CIF.CIF_CUST_INFO_SEQ
			LEFT JOIN (
				SELECT COUNT(*) AS FAC_COUNT ,FA.CIF_CUST_INFO_SEQ FROM WBS_FAC_INFO FA 
				LEFT JOIN (
					SELECT ND.FAC_INFO_SEQ, ND.FAC_NODE_SEQ ,ND.OUTSTANDING_BAL
					FROM WBS_FAC_NODE ND JOIN WBS_FAC_NODE PD ON ND.PARENT_NODE_SEQ = PD.FAC_NODE_SEQ
					WHERE ND.NODE_TYPE = '2' AND ND.STATUS = '1'
					AND (PD.FAC_SUBJECT_CODE NOT IN ('2000','2100','4000','4100')
						OR ND.FAC_SUBJECT_CODE IN (
							'9403','9404','9405','9406','9407','9408','9409','9410','9411','9412','9415'
							,'9416','9417','9419','9420','9421','9422','9423','9424','9425','9426','9427' 
						)
					)
				) NDD ON FA.FAC_INFO_SEQ = NDD.FAC_INFO_SEQ
				WHERE NDD.FAC_NODE_SEQ IS NOT NULL AND ( FA.FAC_STATUS IN ('04','05') OR (FA.FAC_STATUS IN ('20','40') AND NDD.OUTSTANDING_BAL <> 0) )
				GROUP BY FA.CIF_CUST_INFO_SEQ
			) FAC ON FAC.CIF_CUST_INFO_SEQ=CIF.CIF_CUST_INFO_SEQ
		) CIF
	)

	SELECT
		'' AS No ,CIF.CustomerID ,CIF.AML_CUST_TYPE AS CustomerType ,CIF.AML_CUST_NME AS CustomerName
		,CIF.Addr1 ,'' AS Addr2 ,'' AS Addr3 ,'' AS Addr4 ,CIF.CtryCD	,CIF.Nationality ,'0925' AS Branch_nbr 
		,CASE WHEN CIF.AML_CUST_TYPE='P' THEN '5' WHEN CIF.AML_CUST_TYPE='N' THEN '6' END AS Unique_Id_Name 
		,CIF.CustomerID AS Unique_Id_Value
		,'' AS IDENT_OTH
		,CASE WHEN CIF.CustomerID='MY2199999' THEN 'C'
			WHEN CIF_TYPE.CIF_TYPE IN ('A1','A2','B2','C2','D2','E2','F1') THEN CIF.Record_Stat
			WHEN CIF_TYPE.CIF_TYPE IN ('B1_OPEN','C1') THEN 'O'
			WHEN CIF_TYPE.CIF_TYPE IN ('B1_CLOSE','D1','E1') THEN 'C'
			ELSE CIF.Record_Stat
		 END AS Record_Stat 
		,CIF.AML_CUST_CHI_NME AS Customer_Chi_Name 
		,ISNULL(CIF.LOCAL_INDUSTRY_CODE ,'999999') AS SIC_Code
		,CIF.Phone_No ,CIF.OFFICE_PHONE ,CIF.MOBILE ,CIF.Fax_Number 
		,CASE WHEN CIF.AML_CUST_TYPE='P' THEN CONVERT(VARCHAR(8) ,CONVERT(DATETIME ,CIF.EST_DATE ,111) ,112) ELSE '' END AS Date_Of_Birth 
		,CASE WHEN CIF.AML_CUST_TYPE='N' THEN CONVERT(VARCHAR(8) ,CONVERT(datetime ,CIF.EST_DATE ,111) ,112) ELSE '' END AS InCorp_Date 
		,CIF_TYPE.AML_OPENING_DATE AS Creation_date ,'' AS Checker_DT_Stamp 
		,CASE WHEN CIF_TYPE.AML_BUZ_SECTOR_CD = '00102' THEN 'Y' ELSE 'N' END AS IsEmployee 
		,'N' AS IsBelievedSuspicious 
		 ,CASE WHEN CIF_TYPE.CIF_TYPE IN ('A1','F1') THEN 'ID'
			WHEN CIF_TYPE.CIF_TYPE IN ('A2','B1_OPEN','B2','C2','D2','E2') THEN 'CB'
			WHEN CIF_TYPE.CIF_TYPE IN ('B1_CLOSE','C1','D1','E1') THEN 'NCR'				
			ELSE 'CB'
		 END AS Segment_Code 
		,KYC.OCCUPATION AS OccupationCode	,CIF_TYPE.AML_BUZ_SECTOR_CD AS OWNERSHIP_CODE	,'' AS RM_ID 
		,CIF.Reg_Address_line1 ,'' AS Reg_Address_line2 ,'' AS Reg_Address_line3 ,'' AS Reg_Address_line4 ,'' AS PermanentCountryCode 
		,'MYWBS' AS CoreSystem 
		,CONVERT(VARCHAR(8) ,DATEADD(D ,- 1 ,GETDATE()) ,112) AS Processing_Date 
		,'' AS RM_Name ,'' AS Alias_Name ,'' AS Place_Of_Birth ,'' AS Is_Send_Email_Account 
		,'' AS Is_Multi_Acc_With_Diff_Name ,'' AS Is_Complex_Structure  ,'' AS Is_Listed_Com_Director
	
		/*,'' AS Main_Business_Address 
		,'' AS Main_Business_Country 
		,'' AS Cust_Product_Service 
		,'' AS Cust_Method_Of_Opening 
		,'' AS Cust_Account_Purpose 
		,'' AS Source_Of_Fund 
		,'' AS Source_Of_Wealth 
		,'' AS Business_Operation_Stat 
		,'' AS First_Trxn_Amt 
		,'' AS Serving_Entity 
		,'' AS Job_Title 
		,'' AS Cust_With_Bearer_Shares 
		,'' AS Uncooperative_Flag 
		,'' AS Trustee_Flag 
		,'' AS Spec_Product_Risk_Code 
		,'' AS OBU_Flag 
		,'' AS OBU_Type 
		,'' AS Customer_Scale 
		,'' AS Customer_Level 
		,'' AS Annual_Income 
		,'' AS Education 
		,'' AS Corr_Addr_Change_Flag 
		,'' AS Mail_Reject_Code 
		,'' AS SAR_Exclude_Flag 
		,'' AS Is_PEP 
		,'' AS Is_Foreign_PEP 
		,'' AS Is_Domestic_PEP 
		,'' AS Is_Foreign_Org_PEP 
		,'' AS Is_EX_PEP 
		,'' AS Cust_RP_Is_PEP 
		,'' AS Is_NN 
		,'' AS Is_Blacklist 
		,'' AS Is_High_Risk_Remark 
		,'' AS Warn_Restrict_Account 
		,'' AS Gender 
		,'' AS Nationality2 
		,'' AS Unique_ID_Issuing_Ctry */
	
	FROM (
		SELECT
			/*個人*/
			CIF.CIF_CUST_INFO_SEQ ,CIF.CUSTOMER_ID AS CustomerID ,CIF.CIF_KYC_SEQ
			,ISNULL(CIF.CUSTOMER_ENG_NAME ,CIF.CUSTOMER_NAME) AS AML_CUST_NME
			,CIF.CUSTOMER_NAME AS AML_CUST_CHI_NME

			/*電話*/		
			,ISNULL(CIF.CORRESPONDENCE_TEL_COUNTRY,'')+ISNULL(CIF.CORRESPONDENCE_TEL,'') AS Phone_No 
			,ISNULL(CIF.OFFICE_TEL_COUNTRY,'')+ISNULL(CIF.OFFICE_TEL,'') AS OFFICE_PHONE 
			,ISNULL(CIF.MOBILE_PHONE_COUNTRY,'')+ISNULL(CIF.MOBILE_PHONE,'') AS MOBILE
			,ISNULL(CIF.FAX_NO_COUNTRY,'')+ISNULL(CIF.FAX_NO,'') AS Fax_Number

			/*地址*/
			--,CASE CIF.CORRESPONDENCE_SAME_REGISTERED WHEN 'Y' THEN CIF.REGISTERED_ENG_ADDRESS ELSE CIF.CORRESPONDENCE_ENG_ADDRESS END AS ADDR
			,ISNULL(CIF.CORRESPONDENCE_ENG_ADDRESS ,CIF.CORRESPONDENCE_ADDRESS) AS Addr1 ,CIF.CORRESPONDENCE_COUNTRY AS CtryCD
			,ISNULL(CIF.REGISTERED_ENG_ADDRESS ,CIF.REGISTERED_ADDRESS) AS Reg_Address_line1 ,CIF.COUNTRY AS Nationality

			/*身分*/
			,CASE WHEN CIF.CUSTOMER_TYPE IN ('01' ,'03') THEN 'P' WHEN CUSTOMER_TYPE IN ('02' ,'04') THEN 'N' END AS AML_CUST_TYPE
			,CIF.LOCAL_INDUSTRY_CODE
			,CASE WHEN STATUS='1' THEN 'O' ELSE 'C' END AS Record_Stat 

			/*日期*/
			,CASE WHEN ISDATE(CIF.ESTABLISH_DATE) = 1 THEN CONVERT(VARCHAR(10) ,CONVERT(DATETIME ,CIF.ESTABLISH_DATE ,112) ,20) 
			 ELSE NULL END AS EST_DATE

		FROM dbo.WBS_CIF_CUST_INFO CIF
	) AS CIF 
	JOIN CIF_TYPE ON CIF.CIF_CUST_INFO_SEQ=CIF_TYPE.CIF_CUST_INFO_SEQ
	LEFT JOIN (
		SELECT CIF_KYC_SEQ ,OCCUPATION ,CASE WHEN RISK_LEVEL = '01' THEN 'Y' ELSE 'N' END AS IS_HIGH_RISK_IND
		FROM dbo.WBS_CIF_KYC
		WHERE STATUS = '1'
	) AS KYC
	ON CIF.CIF_KYC_SEQ = KYC.CIF_KYC_SEQ

