WITH PURE_TS AS
(
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG = '1'
    
    EXCEPT
    
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG IN ('2','3')
)
SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 寫入前後一致筆數 (2,446,974)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(a.IsSARFiled AS INT), 0) = ISNULL(TRY_CAST(u.IsSARFiled AS INT), 0) 
        THEN 1 
    END) AS MATCH_COUNT,
    -- 總差異筆數 (4,099)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(a.IsSARFiled AS INT), 0) <> ISNULL(TRY_CAST(u.IsSARFiled AS INT), 0) 
        THEN 1 
    END) AS DIFF_COUNT,
    -- 證明差異為「原 BAK=0 經嚴格判定升為 FACT=1」且符合一對多 (應剛好為 4,099)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(u.IsSARFiled AS INT), 0) = 0 
         AND ISNULL(TRY_CAST(a.IsSARFiled AS INT), 0) = 1
         AND b.CUST_RE_NO_FLG = '1'
        THEN 1 
    END) AS DIFF_UPGRADE_FLAG1_COUNT,
    -- 異常差異筆數 (若有非預期方向或無標記情況應為 0)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(a.IsSARFiled AS INT), 0) <> ISNULL(TRY_CAST(u.IsSARFiled AS INT), 0)
         AND NOT (
             ISNULL(TRY_CAST(u.IsSARFiled AS INT), 0) = 0 
             AND ISNULL(TRY_CAST(a.IsSARFiled AS INT), 0) = 1 
             AND b.CUST_RE_NO_FLG = '1'
         )
        THEN 1 
    END) AS DIFF_UNEXPECTED_COUNT
FROM BSA_SUB_CUST_FACT a
JOIN PURE_TS d 
    ON d.TS_CUST_ID = a.CustomerNo
JOIN CIF_Migrate_Mapping_TEMP h 
    ON h.NEW_CIF_KEY = a.CIF_KEY
JOIN Cust_NP_Migrate_buffer t 
    ON t.CIF_KEY = h.SOURCE_CIF_KEY
JOIN BSA_SUB_CUST_FACT_BAK_20260720 u 
    ON u.CIF_KEY = a.CIF_KEY
LEFT JOIN Customer_Migrate_buffer y 
    ON y.CIF_KEY = h.SOURCE_CIF_KEY
LEFT JOIN BANCS_SK_CUST_INFO b 
    ON b.SK_CUST_ID = y.CustomerNo;

