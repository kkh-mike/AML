從執行結果可以看到：
 * TOTAL_COUNT = 2000、KEEP_TS_DATE_COUNT = 2000（所有資料的現行排程日期都等於備份日期）。
 * 但 UNEXPECTED_COUNT = 82，表示有 82 筆明明符合「新光風險較高（NP > TS）且新光日期更近（NP_ReviewDt < r_bak.ReviewDt）」，但系統卻沒有縮短，依然維持台新原日期。
這通常有兩種可能：
 * 日期型態帶有時間（DateTime vs Date）：ReviewDt 含有時分秒（例如 00:00:00.000 vs 23:59:59），造成直接用 < 或 = 比對時失準。
 * SP 執行當下的關聯條件差異：SP 中比對的是 S.ReviewDt < R.ReviewDt，但未將日期截斷為年月日，或該批排程在 SP 執行時有其他狀態判斷。
第一步：抓出這 82 筆明細對照
執行這段 SQL，看這 82 筆的台新原日期、現行日期、新光日期到底是差在哪裡：
WITH PURE_TS AS
(
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG = '1'
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG IN ('2','3')
),
AggNP AS (
    SELECT 
        m.NEW_CIF_KEY,
        MAX(CASE s.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END) AS NP_RISK_SCORE,
        MIN(s.ReviewDt) AS NP_ReviewDt
    FROM CIF_Migrate_Mapping_TEMP m
    JOIN Cust_NP_Migrate_buffer s ON s.CIF_KEY = m.SOURCE_CIF_KEY
    WHERE s.ReviewDt IS NOT NULL
    GROUP BY m.NEW_CIF_KEY
),
TS_Current_Review AS (
    SELECT CIFKey, ReviewDt, Status, CreatedDt, LastUpdatedDt
    FROM EDD_ReviewSchedule
    WHERE Status = 'P'
),
TS_Bak_Review AS (
    SELECT CIFKey, ReviewDt, Status
    FROM EDD_ReviewSchedule_BAK_20260720
    WHERE Status = 'P'
)
SELECT TOP 100
    a.CustomerNo,
    a.CIF_KEY,
    u.HIGHRISK AS TS_BAK_HIGHRISK,
    p.NP_RISK_SCORE,
    r_bak.ReviewDt AS BAK_ReviewDt,
    p.NP_ReviewDt AS NP_ReviewDt,
    r_now.ReviewDt AS NOW_ReviewDt,
    r_now.CreatedDt,
    r_now.LastUpdatedDt
FROM BSA_SUB_CUST_FACT a
JOIN PURE_TS d ON d.TS_CUST_ID = a.CustomerNo
JOIN BSA_SUB_CUST_FACT_BAK_20260720 u ON u.CIF_KEY = a.CIF_KEY
JOIN AggNP p ON p.NEW_CIF_KEY = a.CIF_KEY
JOIN TS_Current_Review r_now ON r_now.CIFKey = a.CIF_KEY
JOIN TS_Bak_Review r_bak ON r_bak.CIFKey = a.CIF_KEY
WHERE p.NP_RISK_SCORE > CASE u.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END
  AND CAST(p.NP_ReviewDt AS DATE) < CAST(r_bak.ReviewDt AS DATE)
  AND r_now.ReviewDt <> p.NP_ReviewDt;

第二步：如果只是日期格式比對失準，統計 SQL 改用 CAST(... AS DATE)
如果在 SP 裡已更新，但因為含有時間戳導致比對出錯，改用 CAST AS DATE 比對：
WITH PURE_TS AS
(
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG = '1'
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG IN ('2','3')
),
AggNP AS (
    SELECT 
        m.NEW_CIF_KEY,
        MAX(CASE s.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END) AS NP_RISK_SCORE,
        MIN(s.ReviewDt) AS NP_ReviewDt
    FROM CIF_Migrate_Mapping_TEMP m
    JOIN Cust_NP_Migrate_buffer s ON s.CIF_KEY = m.SOURCE_CIF_KEY
    WHERE s.ReviewDt IS NOT NULL
    GROUP BY m.NEW_CIF_KEY
),
TS_Current_Review AS (
    SELECT CIFKey, ReviewDt
    FROM EDD_ReviewSchedule
    WHERE Status = 'P'
),
TS_Bak_Review AS (
    SELECT CIFKey, ReviewDt
    FROM EDD_ReviewSchedule_BAK_20260720
    WHERE Status = 'P'
)
SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 1. 下審日維持台新原日期
    COUNT(CASE 
        WHEN CAST(r_now.ReviewDt AS DATE) = CAST(r_bak.ReviewDt AS DATE) 
        THEN 1 
    END) AS KEEP_TS_DATE_COUNT,
    -- 2. 成功縮短下審日至新光較近日期
    COUNT(CASE 
        WHEN p.NP_RISK_SCORE > CASE u.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END
         AND CAST(p.NP_ReviewDt AS DATE) < CAST(r_bak.ReviewDt AS DATE)
         AND CAST(r_now.ReviewDt AS DATE) = CAST(p.NP_ReviewDt AS DATE)
        THEN 1 
    END) AS SHORTENED_NP_DATE_COUNT,
    -- 3. 異常筆數
    COUNT(CASE 
        WHEN (
            p.NP_RISK_SCORE > CASE u.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END
            AND CAST(p.NP_ReviewDt AS DATE) < CAST(r_bak.ReviewDt AS DATE)
            AND CAST(r_now.ReviewDt AS DATE) <> CAST(p.NP_ReviewDt AS DATE)
        ) OR (
            NOT (
                p.NP_RISK_SCORE > CASE u.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END
                AND CAST(p.NP_ReviewDt AS DATE) < CAST(r_bak.ReviewDt AS DATE)
            )
            AND CAST(r_now.ReviewDt AS DATE) <> CAST(r_bak.ReviewDt AS DATE)
        )
        THEN 1 
    END) AS UNEXPECTED_COUNT
FROM BSA_SUB_CUST_FACT a
JOIN PURE_TS d ON d.TS_CUST_ID = a.CustomerNo
JOIN BSA_SUB_CUST_FACT_BAK_20260720 u ON u.CIF_KEY = a.CIF_KEY
JOIN AggNP p ON p.NEW_CIF_KEY = a.CIF_KEY
JOIN TS_Current_Review r_now ON r_now.CIFKey = a.CIF_KEY
JOIN TS_Bak_Review r_bak ON r_bak.CIFKey = a.CIF_KEY;

