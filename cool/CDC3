 INSERT  INTO #AffectedNextReview
                                        ( CIF_KEY ,
                                          ReviewDt
                                        )
                                        SELECT  R.CIFKey ,
                                                S.ReviewDt
                                        FROM    dbo.EDD_ReviewSchedule R
                                                JOIN dbo.CIF_Migrate_Mapping_TEMP M ON R.CIFKey = M.NEW_CIF_KEY
                                                JOIN dbo.Cust_NP_Migrate_buffer S ON S.CIF_KEY = M.SOURCE_CIF_KEY
                                                JOIN dbo.BSA_SUB_CUST_FACT T ON T.CIF_KEY = M.NEW_CIF_KEY
                                        WHERE   R.Status = 'P'
                                                AND CASE S.HIGHRISK
                                                      WHEN 'L' THEN 1
                                                      WHEN 'M' THEN 2
                                                      WHEN 'H' THEN 3
                                                      ELSE 0
                                                    END > CASE T.HIGHRISK
                                                            WHEN 'L' THEN 1
                                                            WHEN 'M' THEN 2
                                                            WHEN 'H' THEN 3
                                                            ELSE 0
                                                          END
                                                AND S.ReviewDt < R.ReviewDt;


