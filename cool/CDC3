WITH PURE_TS AS
(
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG = '1'
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG IN ('2','3')
),
AggNP AS (
    SELECT 
        m.NEW_CIF_KEY,
        MAX(CASE s.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END) AS NP_RISK_SCORE,
        CASE MAX(CASE s.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END)
            WHEN 3 THEN 'H' WHEN 2 THEN 'M' WHEN 1 THEN 'L' ELSE NULL
        END AS NP_HIGHRISK_TEXT,
        MIN(s.ReviewDt) AS NP_ReviewDt
    FROM CIF_Migrate_Mapping_TEMP m
    JOIN Cust_NP_Migrate_buffer s ON s.CIF_KEY = m.SOURCE_CIF_KEY
    WHERE s.ReviewDt IS NOT NULL
    GROUP BY m.NEW_CIF_KEY
),
TS_Current_Review AS (
    SELECT CIFKey, ReviewDt, Status, CreatedDt, LastUpdatedDt
    FROM EDD_ReviewSchedule
    WHERE Status = 'P'
),
TS_Bak_Review AS (
    SELECT CIFKey, ReviewDt, Status
    FROM EDD_ReviewSchedule_20260626
    WHERE Status = 'P'
)
SELECT TOP 100
    a.CustomerNo,
    a.CIF_KEY,
    -- 舊等級 vs 新等級 vs 新光來源等級
    u.HIGHRISK AS [台新舊等級_BAK],
    a.HIGHRISK AS [目前目標表等級_FACT],
    p.NP_HIGHRISK_TEXT AS [新光來源最高等級_NP],
    -- 審查日對照
    r_bak.ReviewDt AS BAK_ReviewDt,
    p.NP_ReviewDt AS NP_ReviewDt,
    r_now.ReviewDt AS NOW_ReviewDt,
    r_now.CreatedDt,
    r_now.LastUpdatedDt
FROM BSA_SUB_CUST_FACT a
JOIN PURE_TS d ON d.TS_CUST_ID = a.CustomerNo
JOIN BSA_SUB_CUST_FACT_BAK_20260720 u ON u.CIF_KEY = a.CIF_KEY
JOIN AggNP p ON p.NEW_CIF_KEY = a.CIF_KEY
JOIN TS_Current_Review r_now ON r_now.CIFKey = a.CIF_KEY
JOIN TS_Bak_Review r_bak ON r_bak.CIFKey = a.CIF_KEY
WHERE p.NP_RISK_SCORE > CASE u.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END
  AND CAST(p.NP_ReviewDt AS DATE) < CAST(r_bak.ReviewDt AS DATE)
  AND r_now.ReviewDt <> p.NP_ReviewDt;
