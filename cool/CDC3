從 SP 邏輯可知，PEPBitwiseCode 存放在 dbo.BSA_SUB_CUST_FACT_Extension，其運算規則為：
 * 新光多筆候選帳號聚合：每個 bit 做逐位元 OR 運算（1, 2, 4, \dots, 256）。
 * 共有戶整併：T.PEPBitwiseCode = ISNULL(T.PEPBitwiseCode, 0) | S.PEPBitwiseCode（台新原值與新光聚合值做 Bitwise OR 聯集，只增不減）。
 * 純台新：未參與本次轉檔 mapping，數值完全不變。
情境 1：純台新客戶（數值維持不變）
非整併對象，數值不得被任何批次更動。
SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 1. 數值維持一致筆數
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) = ISNULL(u.PEPBitwiseCode, 0) 
        THEN 1 
    END) AS MATCH_COUNT,
    -- 2. 異常異動筆數 (預期為 0)
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) <> ISNULL(u.PEPBitwiseCode, 0) 
        THEN 1 
    END) AS DIFF_COUNT
FROM BSA_SUB_CUST_FACT_Extension a
JOIN BSA_SUB_CUST_FACT_Extension_BAK_20260720 u 
    ON u.CIF_KEY = a.CIF_KEY
LEFT JOIN CIF_Migrate_Mapping_TEMP h 
    ON h.NEW_CIF_KEY = a.CIF_KEY
WHERE h.NEW_CIF_KEY IS NULL;

 * 比對規則：純台新既有客戶未參與轉檔，寫入後之 PEPBitwiseCode 必須與備份表 100% 一致。
 * 檢核結果：檢核總數 [X] 筆，一致 [X] 筆，差異 0 筆。
 * 結論：純台新資料未受轉檔影響，驗證通過。
情境 2：純新光客戶（沿用新光聚合值）
新光客戶若有一對多，以 Bitwise OR 聚合後直接寫入目標表。
WITH AggNP AS (
    SELECT 
        m.NEW_CIF_KEY,
        ISNULL(
            MAX(s.PEPBitwiseCode & 1)
          | MAX(s.PEPBitwiseCode & 2)
          | MAX(s.PEPBitwiseCode & 4)
          | MAX(s.PEPBitwiseCode & 8)
          | MAX(s.PEPBitwiseCode & 16)
          | MAX(s.PEPBitwiseCode & 32)
          | MAX(s.PEPBitwiseCode & 64)
          | MAX(s.PEPBitwiseCode & 128)
          | MAX(s.PEPBitwiseCode & 256), 0
        ) AS NP_PEPBitwiseCode
    FROM CIF_Migrate_Mapping_TEMP m
    JOIN Cust_NP_Migrate_buffer s 
        ON s.CIF_KEY = m.SOURCE_CIF_KEY
    GROUP BY m.NEW_CIF_KEY
)
SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 1. 與來源聚合值一致筆數
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) = p.NP_PEPBitwiseCode 
        THEN 1 
    END) AS MATCH_COUNT,
    -- 2. 異常差異筆數 (預期為 0)
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) <> p.NP_PEPBitwiseCode 
        THEN 1 
    END) AS DIFF_COUNT
FROM BSA_SUB_CUST_FACT_Extension a
JOIN AggNP p 
    ON p.NEW_CIF_KEY = a.CIF_KEY
LEFT JOIN BSA_SUB_CUST_FACT_Extension_BAK_20260720 u 
    ON u.CIF_KEY = a.CIF_KEY
WHERE u.CIF_KEY IS NULL;

 * 比對規則：純新光客戶全數沿用新光端資料，一對多帳號依規則以 Bitwise OR 聚合寫入。
 * 檢核結果：檢核總數 [X] 筆，完全一致 [X] 筆，差異 0 筆。
 * 結論：寫入值完全符合來源聚合邏輯，驗證通過。
情境 3：共有戶（Bitwise OR 聯集從嚴判定）
共有戶採聯集整併：Target = (BAK \mid NP)。驗證「數值不變」與「成功增列 PEP 旗標」兩者，且原有的 bit 絕不能丟失。
WITH PURE_TS AS
(
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG = '1'
    
    EXCEPT
    
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO a 
    JOIN Customer_Migrate_buffer b ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG IN ('2','3')
),
AggNP AS (
    SELECT 
        m.NEW_CIF_KEY,
        ISNULL(
            MAX(s.PEPBitwiseCode & 1)
          | MAX(s.PEPBitwiseCode & 2)
          | MAX(s.PEPBitwiseCode & 4)
          | MAX(s.PEPBitwiseCode & 8)
          | MAX(s.PEPBitwiseCode & 16)
          | MAX(s.PEPBitwiseCode & 32)
          | MAX(s.PEPBitwiseCode & 64)
          | MAX(s.PEPBitwiseCode & 128)
          | MAX(s.PEPBitwiseCode & 256), 0
        ) AS NP_PEPBitwiseCode
    FROM CIF_Migrate_Mapping_TEMP m
    JOIN Cust_NP_Migrate_buffer s 
        ON s.CIF_KEY = m.SOURCE_CIF_KEY
    GROUP BY m.NEW_CIF_KEY
)
SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 1. 寫入前後數值完全相同筆數
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) = ISNULL(u.PEPBitwiseCode, 0) 
        THEN 1 
    END) AS SAME_VALUE_COUNT,
    -- 2. 新光帶入新 PEP 屬性，成功聯集擴充筆數
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) <> ISNULL(u.PEPBitwiseCode, 0)
         AND ISNULL(a.PEPBitwiseCode, 0) = (ISNULL(u.PEPBitwiseCode, 0) | p.NP_PEPBitwiseCode)
        THEN 1 
    END) AS MERGED_EXPAND_COUNT,
    -- 3. 異常筆數：未符合聯集規則或遺失原屬性 (預期必須為 0)
    COUNT(CASE 
        WHEN ISNULL(a.PEPBitwiseCode, 0) <> (ISNULL(u.PEPBitwiseCode, 0) | p.NP_PEPBitwiseCode)
        THEN 1 
    END) AS UNEXPECTED_COUNT
FROM BSA_SUB_CUST_FACT_Extension a
JOIN BSA_SUB_CUST_FACT f 
    ON f.CIF_KEY = a.CIF_KEY
JOIN PURE_TS d 
    ON d.TS_CUST_ID = f.CustomerNo
JOIN BSA_SUB_CUST_FACT_Extension_BAK_20260720 u 
    ON u.CIF_KEY = a.CIF_KEY
JOIN AggNP p 
    ON p.NEW_CIF_KEY = a.CIF_KEY;

 * 比對規則：共有戶依洗錢防制原則採 Bitwise OR 聯集（台新原值 \mid 新光來源值），確保原有重要政治人物身分完整保留並累加新光屬性。
 * 檢核結果：
   * 檢核總數：[X] 筆
   * 數值維持不變：[X] 筆（新光未帶有額外 PEP 屬性）
   * 聯集從嚴擴充：[X] 筆（新光帶有不同 PEP 屬性，成功合入）
   * 異常筆數：0 筆
 * 結論：共有戶 100% 符合聯集整併邏輯，原身分無遺失，驗證通過。
