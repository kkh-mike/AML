SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 註記一致筆數
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(t.IsSARFiled AS INT), 0) = ISNULL(TRY_CAST(z.IsSARFiled AS INT), 0) 
        THEN 1 
    END) AS MATCH_COUNT,
    -- 總差異筆數 (133 筆)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(t.IsSARFiled AS INT), 0) <> ISNULL(TRY_CAST(z.IsSARFiled AS INT), 0) 
        THEN 1 
    END) AS DIFF_COUNT,
    -- 證明差異且符合多帳號標記 (應剛好為 133 筆)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(t.IsSARFiled AS INT), 0) <> ISNULL(TRY_CAST(z.IsSARFiled AS INT), 0)
         AND b.CUST_RE_NO_FLG = 1
        THEN 1 
    END) AS DIFF_AND_FLAG1_COUNT,
    -- 異常差異筆數 (若有其他未預期差異應為 0 筆)
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(t.IsSARFiled AS INT), 0) <> ISNULL(TRY_CAST(z.IsSARFiled AS INT), 0)
         AND ISNULL(b.CUST_RE_NO_FLG, 0) <> 1
        THEN 1 
    END) AS DIFF_OTHER_UNEXPECTED_COUNT
FROM BSA_SUB_CUST_FACT z
JOIN CIF_Migrate_Mapping_TEMP h 
    ON h.NEW_CIF_KEY = z.CIF_KEY
JOIN Cust_NP_Migrate_buffer t 
    ON t.CIF_KEY = h.SOURCE_CIF_KEY
JOIN Customer_Migrate_buffer y
    ON y.CIF_KEY = h.SOURCE_CIF_KEY
LEFT JOIN BANCS_SK_CUST_INFO b 
    ON b.SK_CUST_ID = y.CustomerNo
LEFT JOIN BSA_SUB_CUST_FACT_BAK_20260720 c 
    ON c.CIF_KEY = z.CIF_KEY
WHERE c.CIF_KEY IS NULL;
