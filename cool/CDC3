USE [BatchJobDB];
GO

-- 1. 查該員編在特殊對應表是否有資料、TYP 是什麼
SELECT * 
FROM [dbo].[AML_EMP_DEPT_MAP] 
WHERE EMPCODE = '1128072';

-- 2. 若 TYP 是 '01'，查對應的群組展開有幾筆分行代號
SELECT N.GRP, N.ACCT_DEPT_CD
FROM [dbo].[AML_EMP_DEPT_MAP] M
JOIN [dbo].[AML_RIGHTS_GROUP] N ON M.ACCT_DEPT_CD = N.GRP
WHERE M.EMPCODE = '1128072' AND M.TYP = '01';

-- 3. 查該員在主系統 (TAS9-T) 有幾個 AML 權限代碼
SELECT EMPCODE, APPCODE, PERMCODE 
FROM [TAS9-T].[TSAAS].[dbo].[TBL_CMPEMPAPP]
WHERE EMPCODE = '1128072' AND APPCODE = 'AML';

