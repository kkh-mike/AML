



SELECT 
    COUNT(*) AS TOTAL_COUNT,
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(t.IsSARFiled AS INT), 0) = ISNULL(TRY_CAST(z.IsSARFiled AS INT), 0) 
        THEN 1 
    END) AS MATCH_COUNT,
    COUNT(CASE 
        WHEN ISNULL(TRY_CAST(t.IsSARFiled AS INT), 0) <> ISNULL(TRY_CAST(z.IsSARFiled AS INT), 0) 
        THEN 1 
    END) AS DIFF_COUNT
FROM BSA_SUB_CUST_FACT z
JOIN CIF_Migrate_Mapping_TEMP h 
    ON h.NEW_CIF_KEY = z.CIF_KEY
JOIN Cust_NP_Migrate_buffer t 
    ON t.CIF_KEY = h.SOURCE_CIF_KEY
LEFT JOIN BSA_SUB_CUST_FACT_BAK_20260720 c 
    ON c.CIF_KEY = z.CIF_KEY
WHERE c.CIF_KEY IS NULL;


