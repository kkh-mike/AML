# ============================================
# 1. 路徑與基本設定
# ============================================
$folderPath   = "D:\UATR3\AMLDataMigrator"
$baselineFile = Join-Path $folderPath "AML_CHECK_SUM_1.csv"
$logFolder    = Join-Path $folderPath "Log"

# 確保 Log 目錄存在
if (!(Test-Path $logFolder)) {
    New-Item -ItemType Directory -Path $logFolder | Out-Null
}

# 帶有時間戳記的 Log 檔案
$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$logFile   = Join-Path $logFolder "SKcheck_CHECK_SUM_CIF_$timestamp.log"

$hasError = $false

# ============================================
# 2. Log 輸出函式 (同時記錄到檔案與 Console)
# ============================================
function Write-Log {
    param(
        [string]$msg,
        [string]$level = "INFO"
    )

    $time    = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logLine = "[$time] [$level] $msg"

    # 輸出到 Control-M Console
    Write-Output $logLine

    # 寫入實體 Log 檔
    Add-Content -Path $logFile -Value $logLine -Encoding UTF8
}

# ============================================
# 2.1 CSV 資料筆數計算函式 (支援欄位內含折行/雙引號)
# ============================================
function Get-CsvRecordCount {
    param (
        [string]$filePath
    )

    $recordCount = 0
    $inQuotes    = $false
    $hasContent  = $false

    # 以串流逐字元讀取，避免記憶體溢位且精準處理 RFC 4180 引號折行
    $stream = [System.IO.File]::OpenRead($filePath)
    $reader = New-Object System.IO.StreamReader($stream, [System.Text.Encoding]::UTF8)

    try {
        while (-not $reader.EndOfStream) {
            $char = [char]$reader.Read()
            $hasContent = $true

            if ($char -eq '"') {
                $inQuotes = -not $inQuotes
            }
            elseif ($char -eq "`n" -and -not $inQuotes) {
                $recordCount++
            }
        }
        # 若最後一行結尾無換行符號
        if ($hasContent -and $char -ne "`n") {
            $recordCount++
        }
    }
    finally {
        $reader.Close()
        $reader.Dispose()
        $stream.Close()
        $stream.Dispose()
    }

    return $recordCount
}

# ============================================
# 3. 作業開始
# ============================================
Write-Log "============================================"
Write-Log "JOB START: Checksum & RowCount Verification"
Write-Log "Input Path   : $folderPath"
Write-Log "Baseline File: $baselineFile"
Write-Log "Log File     : $logFile"
Write-Log "============================================"

# 檢查 Input Folder
if (!(Test-Path $folderPath)) {
    Write-Log "ERROR TYPE : INPUT FOLDER NOT FOUND (Path: $folderPath)" "ERROR"
    $hasError = $true
}

# 檢查 Baseline File
if (!$hasError -and !(Test-Path $baselineFile)) {
    Write-Log "ERROR TYPE : BASELINE FILE NOT FOUND (File: $baselineFile)" "ERROR"
    $hasError = $true
}

# 基本環境檢核失敗直接退出
if ($hasError) {
    Write-Log "============================================"
    Write-Log "STATUS : FAILED (Exit Code: 1)" "ERROR"
    Write-Log "============================================"
    exit 1
}

# ============================================
# 4. 讀取與解析 AML_CHECK_SUM.csv
# ============================================
$baseline = @{}

try {
    $lines = Get-Content -Path $baselineFile -Encoding UTF8

    foreach ($line in $lines) {
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }

        $parts = $line.Split(";")

        if ($parts.Count -lt 3) {
            Write-Log "ERROR TYPE : BASELINE FORMAT ERROR -> Line: $line" "ERROR"
            $hasError = $true
            continue
        }

        $fileName  = $parts[0].Trim()
        $countText = $parts[1].Trim()
        $md5       = $parts[2].Trim().ToLowerInvariant()

        if ([string]::IsNullOrWhiteSpace($fileName)) {
            Write-Log "ERROR TYPE : EMPTY FILE NAME -> Line: $line" "ERROR"
            $hasError = $true
            continue
        }

        $expectedCount = 0
        if (-not [int64]::TryParse($countText, [ref]$expectedCount)) {
            Write-Log "ERROR TYPE : INVALID COUNT -> File: $fileName, Count: $countText" "ERROR"
            $hasError = $true
            continue
        }

        if ($md5 -notmatch '^[0-9a-f]{32}$') {
            Write-Log "ERROR TYPE : INVALID MD5 FORMAT -> File: $fileName, MD5: $md5" "ERROR"
            $hasError = $true
            continue
        }

        $key = $fileName.ToLowerInvariant()
        $baseline[$key] = @{
            FileName = $fileName
            Count    = $expectedCount
            MD5      = $md5
        }
    }
}
catch {
    Write-Log "ERROR TYPE : BASELINE READ ERROR -> $($_.Exception.Message)" "ERROR"
    $hasError = $true
}

if ($hasError) {
    Write-Log "============================================"
    Write-Log "STATUS : FAILED (Exit Code: 1)" "ERROR"
    Write-Log "============================================"
    exit 1
}

# ============================================
# 5. 逐檔比對 (Count 行數與 MD5 Hash)
# ============================================
foreach ($key in $baseline.Keys) {

    $expectedFileName = $baseline[$key].FileName
    $expectedCount    = $baseline[$key].Count
    $expectedMD5      = $baseline[$key].MD5

    $targetFile = $null

    # 1. 直接比對檔名
    $directPath = Join-Path $folderPath $expectedFileName
    if (Test-Path $directPath) {
        $targetFile = $directPath
    }
    else {
        # 2. 自動嘗試副檔名變體
        $baseStem = $expectedFileName -replace '(\.Table)?\.(sql|csv)$', ''
        $candidateFiles = @(
            (Join-Path $folderPath "$baseStem.sql"),
            (Join-Path $folderPath "$baseStem.Table.sql"),
            (Join-Path $folderPath "$baseStem.csv")
        )

        foreach ($candidate in $candidateFiles) {
            if (Test-Path $candidate) {
                $targetFile = $candidate
                $matchedLeaf = Split-Path $targetFile -Leaf
                Write-Log "Matched '$expectedFileName' -> local file '$matchedLeaf'"
                break
            }
        }
    }

    # 檢查目標檔案是否存在
    if ($null -eq $targetFile) {
        Write-Log "ERROR TYPE : FILE NOT FOUND -> Expected: $expectedFileName" "ERROR"
        $hasError = $true
        continue
    }

    # 計算行數/筆數與 MD5
    try {
        # 1. 計算 MD5
        $actualMD5 = (Get-FileHash -Path $targetFile -Algorithm MD5).Hash.ToLowerInvariant()
        $md5Matched = ($actualMD5 -eq $expectedMD5)

        # 2. 計算原始實體行數
        $actualPhysicalCount = 0
        $reader = New-Object System.IO.StreamReader($targetFile)
        try {
            while ($reader.ReadLine() -ne $null) {
                $actualPhysicalCount++
            }
        }
        finally {
            $reader.Close()
            $reader.Dispose()
        }

        # 3. 判斷筆數（若實體行數不同，則啟動 CSV 引號解析計算 Record Count）
        $actualCount = $actualPhysicalCount
        $isWrappedLine = $false

        if ($actualPhysicalCount -ne $expectedCount) {
            $csvRecordCount = Get-CsvRecordCount -filePath $targetFile
            if ($csvRecordCount -eq $expectedCount) {
                $actualCount = $csvRecordCount
                $isWrappedLine = $true
            }
        }

        # 4. 驗證結果輸出
        if ($actualCount -ne $expectedCount) {
            Write-Log "COUNT MISMATCH -> File: $expectedFileName (Expected: $expectedCount, Actual Physical: $actualPhysicalCount, CSV Records: $actualCount)" "ERROR"
            $hasError = $true
        }

        if (-not $md5Matched) {
            Write-Log "MD5 MISMATCH -> File: $expectedFileName (Expected: $expectedMD5, Actual: $actualMD5)" "ERROR"
            $hasError = $true
        }

        if ($actualCount -eq $expectedCount -and $md5Matched) {
            if ($isWrappedLine) {
                Write-Log "PASSED -> File: $expectedFileName (CSV Records: $actualCount, Physical Lines: $actualPhysicalCount [Multiline Embedded], MD5: OK)"
            }
            else {
                Write-Log "PASSED -> File: $expectedFileName (Count: $actualCount, MD5: OK)"
            }
        }
    }
    catch {
        Write-Log "ERROR TYPE : FILE PROCESS ERROR -> File: $expectedFileName, Message: $($_.Exception.Message)" "ERROR"
        $hasError = $true
    }
}

# ============================================
# 6. 最終結果與 Exit Code
# ============================================
Write-Log "============================================"

if ($hasError) {
    Write-Log "JOB STATUS : FAILED (Exit Code: 1)" "ERROR"
    Write-Log "============================================"
    exit 1
}
else {
    Write-Log "JOB STATUS : SUCCESS (Exit Code: 0)" "INFO"
    Write-Log "============================================"
    exit 0
}
