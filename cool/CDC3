WITH PURE_TS AS
(
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO a
    JOIN Customer_Migrate_buffer b
        ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG = '1'

    EXCEPT

    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO a
    JOIN Customer_Migrate_buffer b
        ON a.SK_CUST_ID = b.CustomerNo
    WHERE a.CUST_RE_NO_FLG IN ('2','3')
)
SELECT
    a.CIF_KEY AS NEW_CIF_KEY,
    h.SOURCE_CIF_KEY,
    a.CustomerNo,
    u.IsSARFiled AS BAK_IsSARFiled,
    a.IsSARFiled AS FACT_IsSARFiled,
    ISNULL(TRY_CAST(u.IsSARFiled AS INT),0) AS BAK_IsSARFiled_Int,
    ISNULL(TRY_CAST(a.IsSARFiled AS INT),0) AS FACT_IsSARFiled_Int,
    b.SK_CUST_ID,
    b.TS_CUST_ID,
    b.CUST_RE_NO_FLG
FROM BSA_SUB_CUST_FACT a
JOIN PURE_TS d
    ON d.TS_CUST_ID = a.CustomerNo
JOIN CIF_Migrate_Mapping_TEMP h
    ON h.NEW_CIF_KEY = a.CIF_KEY
JOIN Cust_NP_Migrate_buffer t
    ON t.CIF_KEY = h.SOURCE_CIF_KEY
JOIN BSA_SUB_CUST_FACT_BAK_20260720 u
    ON u.CIF_KEY = a.CIF_KEY
LEFT JOIN Customer_Migrate_buffer y
    ON y.CIF_KEY = h.SOURCE_CIF_KEY
LEFT JOIN BANCS_SK_CUST_INFO b
    ON b.SK_CUST_ID = y.CustomerNo
WHERE ISNULL(TRY_CAST(a.IsSARFiled AS INT),0)
    <> ISNULL(TRY_CAST(u.IsSARFiled AS INT),0)
ORDER BY a.CIF_KEY;



