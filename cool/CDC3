情境 1：純台新客戶風險等級（HIGHRISK）檢核
定義為「僅存在於台新、未參與本次新光轉檔整併」的既有客戶，其風險等級在轉檔後必須完全保持不變（目標表與備份表 100% 一致），且不得出現在轉檔對應表（CIF_Migrate_Mapping_TEMP）中。
驗證 SQL
SELECT 
    COUNT(*) AS TOTAL_COUNT,
    -- 1. 風險等級維持不變筆數
    COUNT(CASE 
        WHEN ISNULL(a.HIGHRISK, '') = ISNULL(u.HIGHRISK, '') 
        THEN 1 
    END) AS MATCH_COUNT,
    -- 2. 異常異動筆數 (純台新等級不應有任何變更，預期必須為 0)
    COUNT(CASE 
        WHEN ISNULL(a.HIGHRISK, '') <> ISNULL(u.HIGHRISK, '') 
        THEN 1 
    END) AS DIFF_COUNT
FROM BSA_SUB_CUST_FACT a
JOIN BSA_SUB_CUST_FACT_BAK_20260720 u 
    ON u.CIF_KEY = a.CIF_KEY
-- 排除所有參與本次轉檔整併的客群 (純新光及共有戶)
LEFT JOIN CIF_Migrate_Mapping_TEMP h 
    ON h.NEW_CIF_KEY = a.CIF_KEY
WHERE h.NEW_CIF_KEY IS NULL;

