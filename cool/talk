d   GROUP BY A.QueueID, A.Role   UNION ALL      --HRS   SELECT COUNT(B.Role)   FROM @TempQueue A LEFT JOIN dbo.HRS_CUST_RISK_MGMT B WITH(NOLOCK) ON A.QueueID = B.QueueId AND A.Role = B.Role AND B.Status <> '3' AND B.HandledBy = @Eid   GROUP BY A.QueueID, A.Role   UNION ALL      --SAR   SELECT COUNT(B.Role)   FROM @TempQueue A LEFT JOIN dbo.SAR_Header_Main B WITH(NOLOCK) ON A.QueueID = B.QueueId AND A.Role = B.Role AND B.Status <> '3' AND B.HandledBy = @Eid   WHERE A.SRC = 'SAR'    GROUP BY A.QueueID, A.Role   UNION ALL       --FST   SELECT COUNT(B.Role)   FROM @TempQueue A LEFT JOIN dbo.SAR_Header_Main B WITH(NOLOCK) ON A.QueueID = B.QueueId AND A.Role = B.Role AND B.Status <> '3' AND B.HandledBy = @Eid   WHERE A.SRC = 'FST'    GROUP BY A.QueueID, A.Role   UNION ALL       --DOmestic Wire   SELECT COUNT(B.Role)    FROM @TempQueue A LEFT JOIN dbo.DWire_ReviewMain B WITH(NOLOCK) ON A.QueueID = B.QueueId AND A.Role = B.Role AND B.Status <> 3 AND B.HandledBy = @Eid   GROUP BY A.QueueId, A.Role   UNION ALL       -- TradeFin   SELECT COUNT(B.Role)   FROM @TempQueue A LEFT JOIN dbo.TradeFin_Header_Main B WITH(NOLOCK) ON B.QueueID = A.QueueId AND B.Role = A.Role AND B.Status <> 3 AND B.HandledBy = @Eid   GROUP BY A.QueueId, A.Role   UNION ALL      -- SWIFTMX   SELECT COUNT(B.Role)   FROM @TempQueue A LEFT JOIN dbo.SwiftMX_Review_Main B WITH(NOLOCK) ON B.QueueID = A.QueueId AND B.Role = A.Role AND B.Status <> 3 AND B.HandledBy = @Eid   GROUP BY A.QueueId, A.Role    )  SELECT SUM(CaseCount) AS 'CaseCount'  FROM TempFullData A       END    
