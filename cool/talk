CIP_CreateScenarioGroup	CREATE PROCEDURE [dbo].[CIP_CreateScenarioGroup]   @GroupName NVARCHAR(20),   @GroupDescription NVARCHAR(100) = NULL,   @CreatedBy NVARCHAR(40),   @Category TINYINT,   @GroupID INT OUTPUT  AS  BEGIN   SET NOCOUNT ON;      SET @GroupID = NULL;      IF NOT EXISTS(SELECT NULL FROM dbo.CIP_SyntaxGroups    WHERE GroupName = @GroupName AND Category = @Category and Deleted = 'FALSE')   BEGIN    DECLARE @today DATETIME = GETUTCDATE();    DECLARE @today_local DATETIME = dbo.ConvertToBankLocalTime(@today);      DECLARE @IsFirstInCategory BIT = 'FALSE';    /*IF NOT EXISTS(SELECT NULL FROM dbo.CIP_SyntaxGroups     WHERE Category = @Category AND Deleted = 'FALSE')    BEGIN     SET @IsFirstInCategory = 'TRUE';    END*/        INSERT INTO dbo.CIP_SyntaxGroups(GroupName, GroupDescription,      CreatedDate, CreatedDate_UTC, CreatedBy,Deleted,Category, IsActive, LastModifiedDate, LastModifiedDate_UTC, LastModifiedBy)    SELECT @GroupName, @GroupDescription,      @today_local, @today, @CreatedBy, 'FALSE', @Category, @IsFirstInCategory, @today_local, @today, @CreatedBy            SELECT @GroupID = SCOPE_IDENTITY();        /*Insert a record into HRS_SyntaxGroups*/    INSERT INTO dbo.HRS_SyntaxGroups(ID, GroupName, GroupDescription,      CreatedDate, CreatedDate_UTC, CreatedBy,Deleted,Category, IsActive, LastModifiedDate, LastModifiedDate_UTC, LastModifiedBy)    SELECT @GroupID, @GroupName, @GroupDescription,      @today_local, @today, @CreatedBy, 'FALSE', @Category, @IsFirstInCategory, @today_local, @today, @CreatedBy            INSERT INTO dbo.CIP_QuerySyntaxes(TemplateId,GroupId,CreatedDate,CreatedDate_UTC,CreatedBy,[Enabled],Deleted,LastModifiedDate,LastModifiedDate_UTC,LastModifiedBy)    SELECT A.ID, B.ID, @today_local, @today, @CreatedBy, '1', 'N', @today_local, @today, @CreatedBy     FROM dbo.CIP_TEMPLATE_DIM A WITH (NOLOCK), dbo.CIP_SyntaxGroups B WITH(NOLOCK)    WHERE VISIBLE = 'Y' AND NOT EXISTS(SELECT 1 FROM dbo.CIP_QuerySyntaxes WITH (NOLOCK) WHERE TemplateId = A.ID    AND GroupId = B.ID AND B.ID = @GroupID)     AND (CASE A.CUST_TYPE WHEN 'P' THEN '1' ELSE '2' END) = @Category     AND B.Category = @Category AND B.Deleted <> '1' AND B.ID = @GroupID         DECLARE @UserAccountId BIGINT;        SELECT TOP 1 @UserAccountId = [ID]    FROM [dbo].[UserAccounts]    WHERE [UserID] = @CreatedBy AND     [Deleted] = 'FALSE'        /*INSERT 1 SET INTO HRS*/     INSERT INTO [dbo].[HRS_ScenarioTemplateSettings]([TemplateId], [ScenarioGroupId], [Enabled])    OUTPUT INSERTED.[Id], INSERTED.[TemplateId], INSERTED.[ScenarioGroupId],     INSERTED.[Enabled], N'01', @UserAccountId, @today_local, @today    INTO [dbo].[HRS_ScenarioTemplateSettings_Log](     [Id], [TemplateId], [ScenarioGroupId], [Enabled], [ActionCode],     [ActionBy], [ActionDate], [ActionDate_UTC])         SELECT [ID], @GroupID, 'TRUE'    FROM [dbo].[HRS_ScenarioTemplates]    WHERE [Visible] = 'TRUE' AND     [Category] = @Category    END  END  
