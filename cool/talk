NSERT INTO dbo.WORKFLOW_MGMT_REVIEWUSERS_HISTORY(QUEUEID, USERID, TYPE, CREATEDBY, CREATEDDT, CREATEDDT_UTC)   SELECT QUEUEID, USERID, TYPE, @USERID, @DATELOCAL, @DATEUTC   FROM dbo.WORKFLOW_MGMT_REVIEWUSERS   WHERE QUEUEID = @QUEUEID      INSERT INTO dbo.WORKFLOW_MGMT_ScenarioGroup_History(QueueID, ScenarioGroupID, CREATEDBY, CREATEDDT, CREATEDDT_UTC)   SELECT QueueID, ScenarioGroupID, @USERID, @DATELOCAL, @DATEUTC   FROM dbo.WORKFLOW_MGMT_ScenarioGroup   WHERE QueueID = @QUEUEID
