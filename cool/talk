WORKFLOW_GetQueueByUser	CREATE PROCEDURE [dbo].[WORKFLOW_GetQueueByUser]   @UserId AS NVARCHAR(40),  @Src AS NVARCHAR(100)  AS  BEGIN   IF EXISTS(SELECT 1 FROM dbo.UserAccounts A JOIN dbo.AccountUserGroups B ON A.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID     WHERE A.UserID = @UserId AND C.Deleted = 0 AND C.UserGroupType = 1)   BEGIN    /*Bank Admin*/    SELECT A.QUEUEID, A.QUEUENAME     FROM dbo.WORKFLOW_MGMT_QUEUE A     JOIN dbo.UserDashboard_Module C ON C.ModuleCode = A.SRC    WHERE (@Src IS NULL OR A.SRC = @Src OR (@Src = 'CaseOverdueStatisticReport' AND C.EnableInCaseOverdueReport = 'Y'))    ORDER BY C.SortingOrder   END   ELSE   BEGIN    SELECT A.QUEUEID, A.QUEUENAME     FROM dbo.WORKFLOW_MGMT_QUEUE A     JOIN dbo.UserDashboard_Module C ON C.ModuleCode = A.SRC    WHERE EXISTS (SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS B WHERE A.QUEUEID = B.QUEUEID AND B.USERID = @UserId)     AND (@Src IS NULL OR A.SRC = @Src OR (@Src = 'CaseOverdueStatisticReport' AND C.EnableInCaseOverdueReport = 'Y'))    ORDER BY C.SortingOrder   END  END
WORKFLOW_GetUserBranch	  CREATE PROCEDURE [dbo].[WORKFLOW_GetUserBranch]    @USERID nvarchar(60),   @SRC nvarchar (20)  AS  BEGIN  DECLARE   @bit int       IF @SRC = 'EDD'   BEGIN    IF OBJECT_ID('tempdb..#tempQueue') IS NOT NULL     DROP TABLE #tempQueue      CREATE TABLE #tempQueue (QUEUEID INT NOT NULL, QUEUENAME NVARCHAR(120) NULL)      INSERT INTO #tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.CIP_GetQueue @USERID = @USERID, @TYPE = 'C'       INSERT INTO #tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.HRS_GetQueue @USERID = @USERID, @TYPE = 'C'       SELECT '' AS BRNCH_NBR, '' AS BRNCH_DESC     UNION     SELECT B.BRNCH_NBR, B.BRNCH_DESC    FROM dbo.UserAccounts A, dbo.BRANCH_DIM B    WHERE A.BranchID = B.ID AND A.UserID = @USERID     UNION     SELECT B.BRNCH_NBR, C.BRNCH_DESC    FROM #tempQueue A     JOIN dbo.WORKFLOW_MGMT_BRANCH B ON B.QUEUEID = A.QUEUEID     JOIN dbo.BRANCH_DIM C ON B.BRNCH_NBR = C.BRNCH_NBR     UNION    SELECT A.BRNCH_NBR, A.BRNCH_DESC    FROM dbo.BRANCH_DIM A     WHERE EXISTS(SELECT 1 FROM #tempQueue C JOIN dbo.WORKFLOW_MGMT_QUEUE B ON C.QUEUEID = B.QUEUEID AND B.IsIncludeAllBranch = 1)         END   ELSE   BEGIN    IF EXISTS (SELECT 1 FROM GCMAINDB..POADMIN WHERE AdminModule = 'TDCC')    BEGIN     SELECT DISTINCT BRNCH_NBR, BRNCH_DESC     FROM BRANCH_DIM A     JOIN UserAccounts B     ON A.ID = B.BranchID     where UserID =  @USERID    END    ELSE    BEGIN     IF EXISTS(SELECT 1 FROM dbo.UserAccounts A           JOIN dbo.AccountUserGroups B ON A.ID = B.AccountID          JOIN dbo.UserGroups C ON B.GroupID = C.ID           WHERE A.UserID = @USERID AND C.Deleted = 0 AND C.UserGroupType IN (1, 8)) /*if bank admin or report auditor*/     BEGIN /*bank admin can see all branch*/      SELECT DISTINCT BRNCH_NBR, BRNCH_DESC FROM dbo.BRANCH_DIM A      END      ELSE IF EXISTS(SELECT 1 FROM dbo.UserAccounts A JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID        WHERE A.UserID = @USERID AND C.Deleted = 0 AND C.UserGroupType = 2)     BEGIN /*branch admin only can see particular branch */      SELECT DISTINCT D.BranchNo AS 'BRNCH_NBR', E.BRNCH_DESC AS 'BRNCH_DESC'      FROM dbo.UserAccounts A        JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID        JOIN dbo.UserGroups C ON B.GroupID = C.ID       JOIN dbo.UserGroup_BranchPermission D ON C.ID = D.GroupId       JOIN dbo.BRANCH_DIM E ON D.BranchNo = E.BRNCH_NBR      WHERE A.UserID = @USERID AND C.Deleted = 0 AND C.UserGroupType = 2     END      ELSE IF EXISTS(SELECT 1 FROM dbo.UserAccounts A JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID        WHERE A.UserID = @USERID AND C.Deleted = 0 AND C.UserGroupType = 4)     BEGIN /*bank user only can see own branch */      SELECT DISTINCT D.BRNCH_NBR AS 'BRNCH_NBR', D.BRNCH_DESC AS 'BRNCH_DESC'      FROM dbo.UserAccounts A        JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID        JOIN dbo.UserGroups C ON B.GroupID = C.ID       JOIN dbo.BRANCH_DIM D ON D.ID = A.BranchID      WHERE A.UserID = @USERID AND C.Deleted = 0      END     END   END  END    
