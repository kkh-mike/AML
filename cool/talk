DWire_UpdateReviewCaseToUser	CREATE PROCEDURE [dbo].[DWire_UpdateReviewCaseToUser]  @TransId BIGINT,  @ToUserId NVARCHAR(40), --case assign to who  @ByUserId NVARCHAR(40), --case assign by who   @ToRole TINYINT,  @Action TINYINT,  @Remark NVARCHAR(MAX),  @ResultStatus VARCHAR(2) OUTPUT   AS  BEGIN   /*Action Code :      1 Accept     2 Reject     3 Escalate     4 Return      6 Assign    */   DECLARE @CaseQueueId INT,      @CaseRole INT        SELECT @CaseQueueId = QueueId, @CaseRole = Role FROM dbo.DWire_ReviewMain WHERE TransID = @TransId AND Status < 3             IF @CaseQueueId IS NOT NULL AND @CaseRole IS NOT NULL    BEGIN    IF @Action IN (1,2)  /*release or reject*/    BEGIN /**/     UPDATE dbo.DWire_ReviewMain     SET LastUpdatedDate_UTC = GETUTCDATE(), LastUpdatedBy = @ByUserId, HandledBy = NULL,       Status = CASE WHEN @CaseRole < 2 THEN 2 ELSE 3 END,       Role = CASE WHEN @CaseRole < 2 THEN 2 ELSE @CaseRole END,       Action = @Action     OUTPUT Inserted.TransID, Inserted.Action, Inserted.Role, Inserted.Status, Inserted.HandledBy, Inserted.QueueId, Inserted.LastUpdatedBy, Inserted.Role, Inserted.LastUpdatedDate_UTC     INTO dbo.DWire_DiagramLog ( TransId, Action, Role, Status, HandledBy, QueueId, UpdatedBy, UpdatedPersonRole, UpdatedDate_UTC )     WHERE TransID = @TransId       INSERT INTO dbo.DWire_RemarkLog ( TransId, HandledBy, Status, Action, Role, Remark, UpdatedDate_UTC, UpdatedBy )     VALUES  ( @TransId, NULL, CASE WHEN @CaseRole < 2 THEN 2 ELSE 3 END, @Action, CASE WHEN @CaseRole < 2 THEN 2 ELSE @CaseRole END, @Remark, GETUTCDATE(), @ByUserId )       SET @ResultStatus = 'S';    END     ELSE    BEGIN /*action code 3,4,6*/     IF @ToUserId IS NULL OR EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS A WITH(NOLOCK) WHERE A.QUEUEID = @CaseQueueId AND A.USERID = @ToUserId AND A.ROLE = @ToRole)     BEGIN       IF @CaseRole > 1 AND EXISTS(SELECT 1 FROM dbo.DWire_DiagramLog WITH(NOLOCK) WHERE TransId = @TransId AND QueueId = @CaseQueueId AND Role < @CaseRole AND HandledBy = @ToUserId) AND @Action <> 4      BEGIN        SET @ResultStatus = 'E3' /*same person cannot handle the same case */      END       ELSE       BEGIN        UPDATE dbo.DWire_ReviewMain        SET LastUpdatedDate_UTC = GETUTCDATE(), LastUpdatedBy = @ByUserId, HandledBy = @ToUserId, Status = 2, Role = @ToRole, Action = @Action       OUTPUT Inserted.TransID, Inserted.Action, Inserted.Role, Inserted.Status, Inserted.HandledBy, Inserted.QueueId, Inserted.LastUpdatedBy, Inserted.Role, Inserted.LastUpdatedDate_UTC       INTO dbo.DWire_DiagramLog ( TransId, Action, Role, Status, HandledBy, QueueId, UpdatedBy, UpdatedPersonRole, UpdatedDate_UTC )       WHERE TransID = @TransId         INSERT INTO dbo.DWire_RemarkLog ( TransId, HandledBy, Status, Action, Role, Remark, UpdatedDate_UTC, UpdatedBy )       VALUES  ( @TransId, @ToUserId, 2, @Action, @ToRole, @Remark, GETUTCDATE(), @ByUserId )         SET @ResultStatus = 'S';      END      END      ELSE      BEGIN       SET @ResultStatus = 'E2'; /*User has no permission to pick the case*/     END     END    END    ELSE    BEGIN     SET @ResultStatus = 'E1'; /*case already complete or not exists*/   END      END         
EDD_CheckUserPermissionForCase	  CREATE PROCEDURE [dbo].[EDD_CheckUserPermissionForCase]  @UserId NVARCHAR(40),  @CifKey UNIQUEIDENTIFIER,  @RolePermission SMALLINT OUTPUT /* 0 = no permission, 1=EDD Maker permission, 2=EDD Checker permission, 3=EDD Maker&Checker both permission*/  AS  BEGIN      SET @RolePermission = 0;     DECLARE @TempQueueId AS TABLE(QueueId INT NOT NULL)     DECLARE @Creator NVARCHAR(40),     @CreatorBranchId BIGINT,     @CreatorBranch NVARCHAR(100) = NULL      /*get the creator's branch number*/   SELECT @Creator = CreatedBy FROM dbo.EDD_AnswerBatch WHERE BatchStatus = 1 AND CustomerId = @CifKey   SELECT TOP 1 @CreatorBranchId = BranchID FROM dbo.UserAccounts WHERE UserID = @Creator ORDER BY Deleted   SELECT @CreatorBranch = BRNCH_NBR FROM dbo.BRANCH_DIM WHERE ID = @CreatorBranchId     /*get queueid where customer's branch is the same with CIP/HRS workgroup branch*/   INSERT INTO @TempQueueId ( QueueId )   SELECT QUEUEID FROM dbo.WORKFLOW_MGMT_QUEUE WHERE DEL_FLAG = 'N' AND SRC IN ('CIP', 'HRS') AND IsIncludeAllBranch = 1    UNION    SELECT A.QUEUEID FROM dbo.WORKFLOW_MGMT_QUEUE A JOIN dbo.WORKFLOW_MGMT_BRANCH B ON B.QUEUEID = A.QUEUEID    WHERE A.DEL_FLAG = 'N' AND A.SRC IN ('CIP','HRS') AND ISNULL(A.IsIncludeAllBranch,0) = 0     AND B.BRNCH_NBR IN (SELECT BRNCH_NBR FROM dbo.PB_CUSTOMER_FACT WHERE CIF_KEY = @CifKey UNION ALL SELECT @CreatorBranch)     /*get queueid from CIP */   INSERT INTO @TempQueueId ( QueueId )   SELECT A.QUEUEID FROM dbo.CIP_CUST_RISK_MGMT A WITH(NOLOCK) WHERE A.CIF_KEY = @CifKey AND A.QUEUEID IS NOT NULL AND NOT EXISTS(SELECT 1 FROM @TempQueueId B WHERE A.QUEUEID = B.QueueId)      /*get queueid from HRS */   INSERT INTO @TempQueueId ( QueueId )   SELECT TOP 1 A.QUEUEID FROM dbo.HRS_CUST_RISK_MGMT A WITH(NOLOCK) WHERE A.CIF_KEY = @CifKey AND A.QUEUEID IS NOT NULL AND NOT EXISTS(SELECT 1 FROM @TempQueueId B WHERE A.QUEUEID = B.QueueId) ORDER BY A.LSTUPDATE_DATE DESC         DECLARE @tempRole AS TABLE(RolePermission INT)      INSERT INTO @tempRole ( RolePermission )   SELECT A.ROLE   FROM dbo.WORKFLOW_MGMT_USERS A WITH(NOLOCK)   WHERE A.USERID = @UserId AND EXISTS(SELECT 1 FROM @TempQueueId X WHERE A.QUEUEID = X.QueueId)   GROUP BY A.ROLE     /*if there's no permission based on customer's branch and cip/hrs workgroup, then check creator's branch match with user branch, if yes it will select all role permission from that user regardless of workgroup*/   IF NOT EXISTS(SELECT 1 FROM @tempRole) AND EXISTS(SELECT 1 FROM dbo.UserAccounts WHERE UserID = @UserId AND BranchID = @CreatorBranchId)   BEGIN    INSERT INTO @tempRole ( RolePermission )    SELECT A.ROLE    FROM dbo.WORKFLOW_MGMT_USERS A WHERE EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_QUEUE X WHERE X.DEL_FLAG = 'N' AND X.SRC IN ('CIP','HRS') AND A.QUEUEID = X.QUEUEID)     AND A.USERID = @UserId    GROUP BY A.ROLE   END      /*IF NOT EXISTS(SELECT 1 FROM @tempRole) AND EXISTS(SELECT 1 FROM dbo.EDD_AnswerBatch WHERE CustomerId = @CifKey AND CreatedBy = @UserId)   BEGIN     INSERT INTO @tempRole ( RolePermission )    SELECT A.ROLE    FROM dbo.WORKFLOW_MGMT_USERS A     WHERE EXISTS(SELECT * FROM dbo.WORKFLOW_MGMT_QUEUE X WHERE X.DEL_FLAG = 'N' AND X.SRC IN ('CIP','HRS') AND A.QUEUEID = X.QUEUEID)     AND A.USERID = @UserId    GROUP BY A.ROLE   END */     IF EXISTS(SELECT * FROM @tempRole WHERE RolePermission = 1) /*maker*/    SET @RolePermission = @RolePermission + 1;     IF EXISTS(SELECT * FROM @tempRole WHERE RolePermission >= 2) /*checker or aml officer 1 or aml officer 2 */    SET @RolePermission = @RolePermission + 2;     IF (@RolePermission = 0 OR @RolePermission = 2) AND EXISTS(SELECT NULL FROM PO_DefaultData WHERE Module = 'EDD' AND CtrlKey = 'BypassValidateMakerSave' AND CtrlVal = 'Y')/*bypass maker save*/    SET @RolePermission = @RolePermission + 1;  END     
EDD_GetAnswerBatchInfo	  CREATE PROCEDURE [dbo].[EDD_GetAnswerBatchInfo]   @CreatedBy NVARCHAR(40) = NULL,   @StartDate DATETIME = NULL,   @EndDate DATETIME = NULL,   @CustomerNo VARCHAR(50) = NULL,   @CifKey UNIQUEIDENTIFIER = NULL,   @BatchStatus TINYINT = NULL,   @BranchNo NVARCHAR(50) = NULL,   @StartIndex INT = 0,   @RowCount INT = 10,   @SortExpression NVARCHAR(30) = NULL,   @UserId NVARCHAR(40),   @TotalCount INT OUTPUT,   @IncludeCreatorBranch BIT = 1  AS  BEGIN   SET NOCOUNT ON;   DECLARE @tempBranch TABLE (BranchNo NVARCHAR(50))      DECLARE @OwnBranch NVARCHAR(100),     @OwnBranchId BIGINT;     SELECT @OwnBranch = B.BRNCH_NBR, @OwnBranchId = b.ID   FROM dbo.UserAccounts A JOIN dbo.BRANCH_DIM B ON A.BranchID = B.ID    WHERE A.UserID = @USERID AND A.Deleted = 'FALSE'     IF ISNULL(@BranchNo,'') = ''    BEGIN     DECLARE @tempQueue TABLE (QUEUEID INT NOT NULL, QUEUENAME NVARCHAR(120) NULL)      INSERT INTO @tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.CIP_GetQueue @USERID = @USERID, @TYPE = 'C'       INSERT INTO @tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.HRS_GetQueue @USERID = @USERID, @TYPE = 'C'         INSERT INTO @tempBranch ( BranchNo )    SELECT @OwnBranch 'BRNCH_NBR'     UNION     SELECT B.BRNCH_NBR    FROM @tempQueue A     JOIN dbo.WORKFLOW_MGMT_BRANCH B ON B.QUEUEID = A.QUEUEID      UNION    SELECT A.BRNCH_NBR    FROM dbo.BRANCH_DIM A     WHERE EXISTS(SELECT 1 FROM @tempQueue C JOIN dbo.WORKFLOW_MGMT_QUEUE B ON C.QUEUEID = B.QUEUEID AND B.IsIncludeAllBranch = 1)   END    ELSE    BEGIN     INSERT INTO @tempBranch ( BranchNo )    VALUES  ( @BranchNo )   END      SET @StartIndex = COALESCE(@StartIndex, 0);   SET @RowCount = COALESCE(@RowCount, 10);     DECLARE @EndIndex INT;   SET @EndIndex = @StartIndex + @RowCount;      DECLARE @AllowImportBatch CHAR(1)   SELECT @AllowImportBatch = CtrlVal FROM dbo.PO_DefaultData WHERE CtrlKey = 'AllowImportBatch'     IF @CifKey IS NULL  /*no cif key pass in , from edd history screen */   BEGIN     DECLARE @UserSameBranch AS TABLE(userId NVARCHAR(40) NOT NULL)    IF @IncludeCreatorBranch = 1    BEGIN      INSERT INTO @UserSameBranch ( userId )     SELECT UserID FROM dbo.UserAccounts WHERE BranchID = @OwnBranchId AND Deleted = 'FALSE' GROUP BY UserID    END         ;WITH TempBatch AS(     SELECT A.BatchId,       --CASE WHEN e.userId IS NOT NULL THEN A.CreatedBy + '[' + @OwnBranch + ']' ELSE A.CreatedBy END 'CreatedBy',       A.CreatedBy,      A.CreatedDate, A.CustomerId, A.DocumentId,       A.BatchStatus,       CASE WHEN A.LastModifiedBy_2 IS NULL THEN A.LastModifiedDate WHEN A.LastModifiedDate_2 > A.LastModifiedDate THEN A.LastModifiedDate_2 ELSE A.LastModifiedDate END 'LastModifiedDate',      CASE WHEN A.LastModifiedBy_2 IS NULL THEN A.LastModifiedBy WHEN A.LastModifiedDate_2 > A.LastModifiedDate THEN A.LastModifiedBy_2 ELSE A.LastModifiedBy END 'LastModifiedBy',        A.Remarks,       CASE WHEN e.userId IS NOT NULL AND  C.BRNCH_NBR <> @OwnBranch THEN C.BRNCH_NBR + ' [' + @OwnBranch + ']' ELSE C.BRNCH_NBR END 'BranchNo',      B.CustomerNo     FROM dbo.EDD_AnswerBatch A      JOIN [dbo].[BSA_SUB_CUST_FACT] B ON A.[CustomerId] = B.[CIF_KEY]      JOIN [dbo].[PB_CUSTOMER_FACT] C ON A.[CustomerId] = C.[CIF_KEY]      LEFT JOIN @UserSameBranch E ON a.CreatedBy = E.userId     WHERE A.[Deleted] = 'FALSE' AND       --(@CifKey IS NULL OR A.[CustomerId] = @CifKey) AND       (@CustomerNo IS NULL OR B.[CustomerNo] LIKE '%' + @CustomerNo + '%') AND      (@CreatedBy IS NULL OR A.CreatedBy LIKE '%' + @CreatedBy + '%') AND      (@StartDate IS NULL OR CAST(A.CreatedDate AS DATE)>= CAST(@StartDate AS DATE)) AND      (@EndDate IS NULL OR CAST(A.CreatedDate AS DATE)<= CAST(@EndDate AS DATE)) AND       (@BatchStatus IS NULL OR A.BatchStatus = @BatchStatus) AND      ( (EXISTS(SELECT 1 FROM @UserSameBranch X WHERE A.CreatedBy = X.userId)) OR C.BRNCH_NBR IN (SELECT BranchNo FROM @tempBranch))     UNION ALL     SELECT 0, Maker, CreatedDt, CIF_KEY, 0, 2, CompletedDt, Checker, '', BranchNo, CustomerNo     FROM dbo.EDD_Import
EDD_GetArchieveReport	  CREATE PROCEDURE [dbo].[EDD_GetArchieveReport]   @StartDate DATETIME = NULL,   @EndDate DATETIME = NULL,   @CustomerNo VARCHAR(50)= NULL,   @CustomerName NVARCHAR(350)= NULL,   @BranchNo VARCHAR(50)= NULL,   @Culture VARCHAR(10) = 'en-US',   @UserID NVARCHAR(60),   @ArchieveVersion NVARCHAR(50) = NULL  AS  BEGIN   SET NOCOUNT ON;     IF OBJECT_ID('tempdb..#tempBranch') IS NOT NULL     DROP TABLE #tempBranch   CREATE TABLE #tempBranch (BranchNo NVARCHAR(50), BranchDesc NVARCHAR(100))      IF ISNULL(@BranchNo,'') = ''    BEGIN     IF OBJECT_ID('tempdb..#tempQueue') IS NOT NULL      DROP TABLE #tempQueue    CREATE TABLE #tempQueue (QUEUEID INT NOT NULL, QUEUENAME NVARCHAR(120) NULL)      INSERT INTO #tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.CIP_GetQueue @USERID = @USERID, @TYPE = 'C'       INSERT INTO #tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.HRS_GetQueue @USERID = @USERID, @TYPE = 'C'         INSERT INTO #tempBranch ( BranchNo, BranchDesc )    SELECT B.BRNCH_NBR, B.BRNCH_DESC    FROM dbo.UserAccounts A, dbo.BRANCH_DIM B    WHERE A.BranchID = B.ID AND A.UserID = @USERID     UNION     SELECT B.BRNCH_NBR, C.BRNCH_DESC    FROM #tempQueue A     JOIN dbo.WORKFLOW_MGMT_BRANCH B ON B.QUEUEID = A.QUEUEID     JOIN dbo.BRANCH_DIM C ON B.BRNCH_NBR = C.BRNCH_NBR     UNION    SELECT A.BRNCH_NBR, A.BRNCH_DESC    FROM dbo.BRANCH_DIM A     WHERE EXISTS(SELECT 1 FROM #tempQueue C JOIN dbo.WORKFLOW_MGMT_QUEUE B ON C.QUEUEID = B.QUEUEID AND B.IsIncludeAllBranch = 1)   END    ELSE    BEGIN     INSERT INTO #tempBranch ( BranchNo, BranchDesc )    VALUES  ( @BranchNo, N'' )   END       DECLARE @SQLQRY NVARCHAR(MAX)   SET @SQLQRY = 'SELECT A.BatchId,   CONVERT(VARCHAR(100),A.CustomerId) AS CustomerId,   C.CustomerNo,   B.CUST_NME,   B.NATIVE_CUST_NME,   B.CUST_TYPE_CDE,   (CASE WHEN ''' + @Culture + ''' =''en-US'' THEN  E.Descr ELSE E.Descr_zh_TW END)CUST_TYPE_CDE_Desc,   F.Title,   F.DocumentVersion,   F.ProductCode,   A.CreatedBy,   A.CreatedDate,   A.LastModifiedDate,      (CASE WHEN ''' + @Culture + ''' =''en-US'' THEN        (SELECT STATUS_DESC FROM dbo.WORKFLOW_MGMT_STATUS WHERE ID = 3)       ELSE       (SELECT STATUS_DESC_zh_TW FROM WORKFLOW_MGMT_STATUS WHERE ID = 3)END) Status,      A.DocumentId   FROM ' + @ArchieveVersion + '.dbo.EDD_AnswerBatch A    JOIN dbo.PB_CUSTOMER_FACT B ON A.CustomerId = B.CIF_KEY   JOIN dbo.BSA_SUB_CUST_FACT C ON A.CustomerId = C.CIF_KEY   JOIN dbo.EDD_Documents F ON A.DocumentId = F.ID   LEFT JOIN dbo.CUST_TYPE_DIM E ON B.CUST_TYPE_CDE = E.Code   WHERE A.BranchNo IN (SELECT BranchNo FROM #tempBranch)'      IF @StartDate IS NOT NULL    SET @SQLQRY = @SQLQRY + ' AND A.CreatedDate >= @StartDate'      IF @EndDate IS NOT NULL    SET @SQLQRY = @SQLQRY + ' AND A.CreatedDate <= @EndDate'      IF ISNULL(@CustomerNo,'') <> ''    SET @SQLQRY = @SQLQRY + ' AND C.CustomerNo LIKE ''%''+''' + @CustomerNo + '''+''%'''      IF ISNULL(@CustomerName,'') <> ''    SET @SQLQRY = @SQLQRY + ' AND (B.CUST_NME LIKE ''%''+''' + @CustomerName + '''+''%'' OR B.NATIVE_CUST_NME COLLATE Chinese_Traditional_Stroke_Order_100_CI_AS LIKE ''%''+''' + @CustomerName + '''+''%'')'      SET @SQLQRY = @SQLQRY + ' ORDER BY A.CustomerId'      EXECUTE sp_executesql @SQLQRY, N'@StartDate DATETIME, @EndDate DATETIME', @StartDate = @StartDate, @EndDate = @EndDate  END    
EDD_GetReviewSchedule	CREATE  PROCEDURE [dbo].[EDD_GetReviewSchedule]   @CifKey UNIQUEIDENTIFIER  AS  BEGIN  DECLARE    @NSTRSQL NVARCHAR(MAX),   @CULTURE CHAR(5),   @BNK_NBR VARCHAR(10),   @COL_STATUS NVARCHAR(128)      SELECT @BNK_NBR = REPLACE(DB_NAME(), 'BSADB', '')   SELECT @CULTURE = ISNULL((SELECT CultureForDBColumnExtension FROM GCMAINDB..BankDBProfile WHERE BNK_NBR = @BNK_NBR), '')   SELECT @COL_STATUS = 'STATUS_DESC' + '_' + REPLACE(@CULTURE, '-', '_')      IF COL_LENGTH('GM_BATSTAT_DIM', @COL_STATUS) IS NULL      SET @COL_STATUS = N'STATUS_DESC';        SET @NSTRSQL = '    SELECT       Id,       CifKey,       ReviewDt,      ReviewDescription,       Status,      StatusDesc = (SELECT ' + @COL_STATUS + ' FROM dbo.GM_BATSTAT_DIM WITH(NOLOCK) WHERE STATUS_CODE = A.STATUS),      CreatedBy = CASE WHEN ISNULL(A.CreatedBy, '''') = '''' THEN ''SYSTEM''          WHEN NOT EXISTS (SELECT 1 FROM USERACCOUNTS WHERE USERID = A.CreatedBy) THEN A.CreatedBy          ELSE (SELECT TOP 1 USERID + '' ('' + LTRIM(RTRIM(ISNULL(FirstName, '''') + '' '' + ISNULL(LastName, ''''))) + '')''           FROM USERLICENSE' + @BNK_NBR + '.dbo.UserAccounts WITH(NOLOCK)          WHERE UserID = A.CreatedBy ORDER BY Deleted) END,      CreatedDt,      LastUpdatedBy = (SELECT TOP 1 USERID + '' ('' + LTRIM(RTRIM(ISNULL(FirstName, '''') + '' '' + ISNULL(LastName, ''''))) + '')''           FROM USERLICENSE' + @BNK_NBR + '.dbo.UserAccounts WITH(NOLOCK)          WHERE UserID = A.LastUpdatedBy ORDER BY Deleted),      LastUpdatedDt    FROM dbo.EDD_ReviewSchedule A WITH(NOLOCK)    WHERE CifKey = @CifKey    AND Status = ''P''    ORDER BY ReviewDt DESC '    PRINT @NSTRSQL   EXEC SP_EXECUTESQL @NSTRSQL, N'@CifKey UNIQUEIDENTIFIER', @CifKey  END    
EDD_RptShowCompletedEDDCases	  CREATE PROCEDURE [dbo].[EDD_RptShowCompletedEDDCases]   @StartDate DATETIME = NULL,   @EndDate DATETIME = NULL,   @CustomerNo VARCHAR(50)= NULL,   @CustomerName NVARCHAR(350)= NULL,   @BranchNo VARCHAR(50)= NULL,   @Culture VARCHAR(10) = 'en-US',   @UserID NVARCHAR(60)  AS  BEGIN   SET NOCOUNT ON;     DECLARE @tempBranch TABLE (BranchNo NVARCHAR(50), BranchDesc NVARCHAR(100))   IF ISNULL(@BranchNo,'') = ''    BEGIN     DECLARE @tempQueue TABLE (QUEUEID INT NOT NULL, QUEUENAME NVARCHAR(120) NULL)      INSERT INTO @tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.CIP_GetQueue @USERID = @USERID, @TYPE = 'C'       INSERT INTO @tempQueue ( QUEUEID, QUEUENAME )    EXEC dbo.HRS_GetQueue @USERID = @USERID, @TYPE = 'C'         INSERT INTO @tempBranch ( BranchNo, BranchDesc )    SELECT B.BRNCH_NBR, B.BRNCH_DESC    FROM dbo.UserAccounts A, dbo.BRANCH_DIM B    WHERE A.BranchID = B.ID AND A.UserID = @USERID     UNION     SELECT B.BRNCH_NBR, C.BRNCH_DESC    FROM @tempQueue A     JOIN dbo.WORKFLOW_MGMT_BRANCH B ON B.QUEUEID = A.QUEUEID     JOIN dbo.BRANCH_DIM C ON B.BRNCH_NBR = C.BRNCH_NBR     UNION    SELECT A.BRNCH_NBR, A.BRNCH_DESC    FROM dbo.BRANCH_DIM A     WHERE EXISTS(SELECT 1 FROM @tempQueue C JOIN dbo.WORKFLOW_MGMT_QUEUE B ON C.QUEUEID = B.QUEUEID AND B.IsIncludeAllBranch = 1)   END    ELSE    BEGIN     INSERT INTO @tempBranch ( BranchNo, BranchDesc )    VALUES  ( @BranchNo, N'' )   END       DECLARE @AllowImportBatch CHAR(1)   SELECT @AllowImportBatch = CtrlVal FROM dbo.PO_DefaultData WHERE CtrlKey = 'AllowImportBatch'     SELECT A.BatchId,    CONVERT(VARCHAR(100),A.CustomerId) AS CustomerId,    C.CustomerNo,    B.CUST_NME,    B.NATIVE_CUST_NME,    B.CUST_TYPE_CDE,    (CASE WHEN @Culture ='en-US' THEN  E.Descr ELSE E.Descr_zh_TW END)CUST_TYPE_CDE_Desc,    F.Title,    F.DocumentVersion,    F.ProductCode,    A.CreatedBy,    A.CreatedDate,    A.LastModifiedDate_2 'LastModifiedDate',    A.LastModifiedBy_2 'LastModifiedBy',    (CASE WHEN @Culture ='en-US' THEN      (SELECT STATUS_DESC FROM dbo.WORKFLOW_MGMT_STATUS WHERE ID = 3)     ELSE     (SELECT STATUS_DESC_zh_TW FROM WORKFLOW_MGMT_STATUS WHERE ID = 3)END) Status   FROM dbo.EDD_AnswerBatch A    JOIN dbo.PB_CUSTOMER_FACT B ON A.CustomerId = B.CIF_KEY   JOIN dbo.BSA_SUB_CUST_FACT C ON A.CustomerId = C.CIF_KEY   JOIN dbo.EDD_Documents F ON A.DocumentId = F.ID   LEFT JOIN dbo.CUST_TYPE_DIM E ON B.CUST_TYPE_CDE = E.Code   WHERE A.BranchNo IN (SELECT BranchNo FROM @tempBranch)    AND (@StartDate IS NULL OR A.CreatedDate >= @StartDate)    AND (@EndDate IS NULL OR A.CreatedDate <= @EndDate)    AND (ISNULL(@CustomerNo,'')='' OR C.CustomerNo LIKE '%'+@CustomerNo+'%')    AND (ISNULL(@CustomerName,'')='' OR B.CUST_NME LIKE '%'+@CustomerName+'%' OR B.NATIVE_CUST_NME COLLATE Chinese_Traditional_Stroke_Order_100_CI_AS LIKE '%'+@CustomerName+'%' )    AND A.BatchStatus = 2      UNION      SELECT 0, A.CIF_KEY, A.CustomerNo, B.CUST_NME, B.NATIVE_CUST_NME, B.CUST_TYPE_CDE,    (CASE WHEN @Culture ='en-US' THEN E.Descr ELSE E.Descr_zh_TW END),    '', '', '', 'System Admin', A.CreatedDt, A.CompletedDt, A.Checker,    (CASE WHEN @Culture ='en-US' THEN      (SELECT STATUS_DESC FROM dbo.WORKFLOW_MGMT_STATUS WHERE ID = 3)     ELSE     (SELECT STATUS_DESC_zh_TW FROM WORKFLOW_MGMT_STATUS WHERE ID = 3)END)   FROM dbo.EDD_ImportCase A   JOIN dbo.PB_CUSTOMER_FACT B ON A.CIF_KEY = B.CIF_KEY   JOIN dbo.BSA_SUB_CUST_FACT C ON A.CIF_KEY = C.CIF_KEY   LEFT JOIN dbo.CUST_TYPE_DIM E ON B.CUST_TYPE_CDE = E.Code   WHERE A.BranchNo IN (SELECT BranchNo FROM @tempBranch)    AND (@StartDate IS NULL OR A.CreatedDt >= @StartDate)    AND (@EndDate IS NULL OR A.CreatedDt <= @EndDate)    AND (ISNULL(@CustomerNo,'')='' OR A.CustomerNo LIKE '%'+@CustomerNo+'%')    AND (ISNULL(@CustomerName,'')='' OR B.CUST_NME LIKE '%'+@CustomerName+'%' OR B.NATIVE_CUST_NME  LIKE '%'+@CustomerName+'%' )    AND @AllowImportBatch = 'Y'  END        
EDD_SaveAnswerBatchStatus	CREATE PROCEDURE [dbo].[EDD_SaveAnswerBatchStatus]   @BatchId BIGINT,   @BatchStatus TINYINT,   @DraftSave CHAR(1) = NULL,   @Remarks NVARCHAR(2000) = NULL,   @UserId NVARCHAR(40),   @Status CHAR(5) = NULL OUTPUT  AS  BEGIN   SET NOCOUNT ON;   SET @Status = 1      IF EXISTS(SELECT 1 FROM PO_DEFAULTDATA WHERE CtrlKey = 'ValidateEDDMakerCheck' AND CtrlVal = 'Y')   BEGIN    IF @DraftSave = 'Y'    BEGIN     /*Checker Draft Save, User does not has Checker role in RMD and RMM module*/     IF @BatchStatus = 1 AND NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS X, dbo.WORKFLOW_MGMT_QUEUE Y WHERE X.QUEUEID = Y.QUEUEID AND DEL_FLAG <> 'Y' AND SRC IN ('CIP','HRS') AND X.ROLE IN (2,3,4) AND X.USERID = @UserId)     BEGIN       SET @Status = '-4'      RETURN     END     END    ELSE    BEGIN     /*If Checker Save before Maker Save*/     IF @BatchStatus = 2 AND EXISTS(SELECT 1 FROM dbo.EDD_AnswerBatch WHERE BatchId = @BatchId AND [Deleted] = 'FALSE' AND ISNULL(LastModifiedBy,'') = '')     BEGIN      SET @Status = '-1'      RETURN     END         /*After Maker Save, then Checker Save*/     /*Maker and Checker cannot be same person*/     IF @BatchStatus = 2 AND EXISTS(SELECT 1 FROM dbo.EDD_AnswerBatch WHERE BatchId = @BatchId AND [Deleted] = 'FALSE' AND ISNULL(LastModifiedBy,'') = @UserId)     BEGIN      SET @Status = '-2'      RETURN     END         /*User does not has Maker role in RMD and RMM module*/     IF @BatchStatus = 1 AND EXISTS(SELECT NULL FROM PO_DefaultData WHERE Module = 'EDD' AND CtrlKey = 'BypassValidateMakerSave' AND CtrlVal = 'Y')/*bypass maker save*/     BEGIN       SET @Status = 1     END      ELSE IF @BatchStatus = 1 AND NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS X, dbo.WORKFLOW_MGMT_QUEUE Y WHERE X.QUEUEID = Y.QUEUEID AND DEL_FLAG <> 'Y' AND SRC IN ('CIP','HRS') AND X.ROLE = 1 AND X.USERID = @UserId)     BEGIN      SET @Status = '-3'      RETURN     END         /*User does not has Checker role in RMD and RMM module*/     IF @BatchStatus = 2 AND NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS X, dbo.WORKFLOW_MGMT_QUEUE Y WHERE X.QUEUEID = Y.QUEUEID AND DEL_FLAG <> 'Y' AND SRC IN ('CIP','HRS') AND X.ROLE IN (2,3,4) AND X.USERID = @UserId)     BEGIN      SET @Status = '-4'      RETURN     END    END   END      DECLARE @Today_UTC DATETIME = GETUTCDATE();   DECLARE @Today_Local DATETIME = dbo.ConvertToBankLocalTime(@Today_UTC);      IF @BatchStatus = 1 AND @DraftSave = 'Y'   BEGIN    UPDATE dbo.EDD_AnswerBatch    SET BatchStatus = @BatchStatus,      Remarks = @Remarks,     LastModifiedDate_2 = @Today_Local,      LastModifiedDate_2_UTC = @Today_UTC,     [LastModifiedBy_2] = @UserId    WHERE BatchId = @BatchId AND     [Deleted] = 'FALSE'   END   ELSE IF @BatchStatus = 1   BEGIN    UPDATE dbo.EDD_AnswerBatch    SET BatchStatus = @BatchStatus,      Remarks = @Remarks,     LastModifiedDate = @Today_Local,      LastModifiedDate_UTC = @Today_UTC,     [LastModifiedBy] = @UserId    WHERE BatchId = @BatchId AND     [Deleted] = 'FALSE'   END   ELSE   BEGIN    UPDATE dbo.EDD_AnswerBatch    SET BatchStatus = @BatchStatus,      Remarks = @Remarks,     LastModifiedDate_2 = @Today_Local,      LastModifiedDate_2_UTC = @Today_UTC,     [LastModifiedBy_2] = @UserId    WHERE BatchId = @BatchId AND     [Deleted] = 'FALSE'   END      UPDATE dbo.EDD_Answers   SET BatchStatus = @BatchStatus   WHERE BatchId = @BatchId      DECLARE @CifKey UNIQUEIDENTIFIER;      SELECT @CifKey = [CustomerId]   FROM [dbo].[EDD_AnswerBatch]   WHERE [BatchId] = @BatchId     END   
