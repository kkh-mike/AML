WITH AcctData AS (
    SELECT 
        -- 新光端
        c.CustomerNo      AS [新光客戶ID],
        a.AccountNo       AS [新光帳號],
        
        -- 台新端
        ts_c.CustomerNo   AS [台新客戶ID],
        ts_a.ACCT_KEY     AS [台新帳號],

        -- 屬性分類
        CASE 
            WHEN v.ACTION = 'insert' THEN '純新光'
            WHEN v.ACTION = 'update' THEN '共有戶'
        END               AS [帳戶屬性],

        ROW_NUMBER() OVER (
            PARTITION BY v.ACTION 
            ORDER BY c.CustomerNo, a.AccountNo
        ) AS rn
    FROM BSADBTW..Acct_Migrate_buffer a
    JOIN CIF_Migrate_Mapping_TEMP v 
        ON v.SOURCE_CIF_KEY = a.CIF_KEY
    JOIN Customer_Migrate_buffer c 
        ON c.CIF_KEY = a.CIF_KEY
    -- 串接台新客戶 ID
    LEFT JOIN BSA_SUB_CUST_FACT ts_c 
        ON ts_c.CIF_KEY = v.NEW_CIF_KEY
    -- 串接台新帳號 (若單一客戶多帳號，建議依需要補齊帳號對應邏輯)
    LEFT JOIN BSADBTW..ACCT_XREF_DIM ts_a 
        ON ts_a.CIF_KEY = v.NEW_CIF_KEY
    WHERE v.ACTION IN ('insert', 'update')
)
SELECT 
    [新光客戶ID],
    [台新客戶ID],
    [新光帳號],
    [台新帳號],
    [帳戶屬性]
FROM AcctData
WHERE rn <= 2
ORDER BY [帳戶屬性] DESC, [新光客戶ID];




