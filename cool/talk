CaseOverdueStatisticRpt	CREATE PROCEDURE [dbo].[CaseOverdueStatisticRpt]   @SearchDate DATETIME = NULL,   @Created_StartDate DATETIME = NULL,   @Created_EndDate DATETIME = NULL,   @ModuleList NVARCHAR(MAX) = NULL,   @CaseStatus NVARCHAR(20) = NULL,   @Queue NVARCHAR(MAX) = NULL,   @UserId NVARCHAR(100)  AS  BEGIN   SET NOCOUNT ON ;     CREATE TABLE #FinalResults (    [ModuleCode] VARCHAR(20),    [ModuleName] NVARCHAR(200),    [CaseCreatedDate] DATE,    [ReferenceNo] NVARCHAR(30) NULL,    [CustNo] NVARCHAR(MAX),    [CustName] NVARCHAR(MAX),    [QueueName] NVARCHAR(100),    [CaseStatus] NVARCHAR(10),    [DetailedStatus] NVARCHAR(20),    [HandledBy] NVARCHAR(50) NULL,    [ExtendedReviewDate] DATE NULL,    [CaseCompletedDate] DATE NULL,    [SearchDate] DATE NULL,    [TotalDays] BIGINT NULL   );     DECLARE @Module TABLE (ModuleCode VARCHAR(20))   INSERT INTO @Module(ModuleCode) SELECT Value FROM dbo.fnStringSplitter(@ModuleList, ',');     DECLARE @Culture VARCHAR(10),     @ModuleName NVARCHAR(200)     SELECT @Culture = Culture FROM GCMAINDB..BankDBProfile WHERE BNK_NBR=REPLACE(DB_NAME(),'BSADB','')      IF ISNULL(@Created_StartDate,'') <> '' AND ISNULL(@Created_EndDate,'') <> '' AND  @Created_EndDate >= @Created_StartDate AND CONVERT(TIME,@Created_StartDate) = '00:00:00'   SET @Created_EndDate = DATEADD(SECOND,-1,DATEADD(DAY,1,@Created_EndDate));     /*    Bank Admin can view all workgroup, Other user only can view own workgroup   */   IF ISNULL(@Queue, '') = ''   BEGIN    IF NOT EXISTS(SELECT 1 FROM dbo.UserAccounts A          JOIN dbo.AccountUserGroups B ON A.ID = B.AccountID         JOIN dbo.UserGroups C ON B.GroupID = C.ID          WHERE A.UserID = @UserId AND C.Deleted = 0 AND C.UserGroupType = 1) /*if bank admin*/    BEGIN /*bank admin can see all branch*/     SELECT @Queue =  STUFF((SELECT CONCAT(A.QUEUEID, ',')      FROM dbo.WORKFLOW_MGMT_QUEUE A      INNER JOIN dbo.WORKFLOW_MGMT_USERS B ON B.QUEUEID = A.QUEUEID     WHERE B.USERID = @UserId FOR XML PATH('')), 1,