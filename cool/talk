OUTSOURCE_UpdateDoNotScanList_Result	CREATE PROCEDURE [dbo].[OUTSOURCE_UpdateDoNotScanList_Result]   @RefNo nvarchar(100),   @UserID nvarchar(40)  AS  DECLARE @sqlstr nvarchar(max),    @BlackList_Timezone varchar(50),    @BankNum nvarchar(10),    @BranchNum  nvarchar(7),    @BranchDesc nvarchar(35)  BEGIN   SET NOCOUNT ON;     /*Get all restricted country group*/   DECLARE @RestrictedCountryGroup Table (GroupID int)      INSERT INTO @RestrictedCountryGroup(GroupID)   SELECT A.GROUPID   FROM dbo.lowrisklistgroups A INNER JOIN dbo.OFAC_SpecType_Dim B   ON a.SpecType = b.ID    WHERE B.SpecType = 'Country'         --set variable   SELECT TOP 1 @BlackList_Timezone = CtrlVal FROM dbo.POCTRL WHERE CtrlKey = 'BLACKLIST_TIMEZONE'      SELECT @BankNum = Replace(DB_NAME(), 'BSADB', '')      SET @sqlstr = N'SELECT @BranchNum = b.brnch_nbr, @BranchDesc = b.brnch_desc         FROM USERLICENSE' + @BankNum + '.dbo.UserAccounts a, WAREHOUSE' + @BankNum + '.dbo.branch_Dim b        WHERE a.BranchID = b.ID AND UserID = @UserID;'       EXEC SP_EXECUTESQL @sqlstr, N'@BranchNum nvarchar(7) output, @BranchDesc nvarchar(35) output, @UserID nvarchar(40)',           @BranchNum output, @BranchDesc output, @UserID      --insert into OFAC_DoNotScanList_Result before finalizing message status   INSERT INTO dbo.OFAC_DoNotScanList_Result([filtered_name], [highest_rc], [message_type], [name_id], [source_key], [source_table], [source_column],               [name_all], [name_count], [no_space_name_all], [name_soundex],              [name1], [name2], [name3], [name4], [name5],               [name6], [name7], [name8], [name9], [name10],              [msg_sender_id], [msg_receiver_id], [inserted_by], [inserted_datetime], [last_updated_by], [last_updated_datetime],               [last_checked_date], [branch_num], [branch_desc], [bank_num], [del_ind])     SELECT a.FullName, c.MAXRC, 'OUTSOURCE', a.NameID, a.SourceKey, a.SourceTable, a.SourceColumn,      a.NameAll, a.NameCount, a.NoSpaceNameAll, a.NameSound