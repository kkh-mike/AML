@SORTEXPRESSION = ''BatchId'' THEN BatchId END ASC,               CASE WHEN @SORTEXPRESSION = ''BatchId DESC'' THEN BatchId END DESC),        TOTALROW = COUNT(1) OVER () '   SET @NSTRSQL = @NSTRSQL + '      FROM (           SELECT A.Id,A.CIFKey,A.Status,A.ActionCode,A.LastUpdatedBy,A.LastUpdatedDt,A.LastupdatedUTCDt,A.ReviewDescription,A.BatchId,       (SELECT TOP 1 ISNULL(FirstName,'''') + '' '' +  ISNULL(LastName,'''') FROM UserLicense' + @BANKNO + '.dbo.UserAccounts WHERE USERID = A.LastUpdatedBy ORDER BY ID DESC) LastUpdatedBy_UserName,       (SELECT FullBatchID FROM dbo.HRS_DetectionBatch X WITH(NOLOCK) WHERE A.BatchId = X.Id) FullBatchID       FROM dbo.HRS_NextReviewList_log A WITH(NOLOCK)       WHERE A.CIFKey = '''  + @CifKey + '''      ) TEMP      )      SELECT * FROM TEMP_GM_GetCustomerNextHRReviewHistory     WHERE ROWNUM > @STARTINDEX AND ROWNUM <= @ENDINDEX '      EXEC SP_EXECUTESQL @NSTRSQL, N'@STARTINDEX INT, @ENDINDEX INT, @SORTEXPRESSION NVARCHAR(255)', @STARTINDEX, @ENDINDEX, @SORTEXPRESSION  END
GM_GetLatestHighRiskBatchRptCriteria	CREATE proc [dbo].[GM_GetLatestHighRiskBatchRptCriteria]  @UserId NVARCHAR(40) = NULL  AS    IF EXISTS(SELECT 1 FROM dbo.UserAccounts A   JOIN dbo.AccountUserGroups B ON A.ID = B.AccountID  JOIN dbo.UserGroups C ON B.GroupID = C.ID   WHERE A.UserID = @UserId AND C.Deleted = 0 AND (C.UserGroupType = 1 OR C.UserGroupType = 8)) /*if bank admin or report auditor*/      BEGIN   SELECT DISTINCT TOP 20 A.ID BatchId, CreatedDt, CreatedBy, (CASE BatchStatus WHEN 'P' THEN 'Pending' WHEN 'C' THEN 'Completed' END) BatchStatus,    SearchStartDt AS SearchStartDt, CustomerBranchNo   FROM dbo.GM_HighRiskCustomerBatch A WITH (NOLOCK)   JOIN dbo.UserAccounts B ON B.UserID = @UserId   JOIN dbo.AccountUserGroups C ON B.ID = C.AccountID    JOIN dbo.UserGroups D ON C.GroupID = D.ID   ORDER BY A.ID DESC  END  ELSE  BEGIN   SELECT DISTINCT TOP 20 A.ID BatchId, CreatedDt, CreatedBy, (CASE BatchStatus WHEN 'P' THEN 'Pending' WHEN 'C' THEN 'Completed' END) BatchStatus,     SearchStartDt AS SearchStartDt, CustomerBranchNo   FROM dbo.GM_HighRiskCustomerBatch A WITH (NOLOCK)   JOIN dbo.UserAccounts B ON B.UserID = @UserId   JOIN dbo.AccountUserGroups C ON B.ID = C.AccountID    JOIN dbo.UserGroups D ON C.GroupID = D.ID   JOIN dbo.UserGroup_BranchPermission E ON D.ID = E.GroupId --Branch admin see its own branch only   WHERE (E.BranchNo = A.CustomerBranchNo)   ORDER BY A.ID DESC  END
GM_SendReminderEmail	  CREATE PROCEDURE [dbo].[GM_SendReminderEmail]  AS  BEGIN   SET NOCOUNT ON;  IF EXISTS (SELECT 1 FROM dbo.PO_DefaultData WHERE CtrlKey ='GM_SendReminderEmail' AND CtrlVal ='Y')  BEGIN   DECLARE    @today DATETIME,   @today_UTC DATETIME,   @Temp_ID BIGINT,   @Temp_Interval INT,   @sender NVARCHAR(200),   @BNK_NBR VARCHAR(10),   @NEWLINE VARCHAR(5),   @STYLE NVARCHAR(1000),   @COLNAME NVARCHAR(100),   @ENVIRONMENT_TITLE NVARCHAR(500),   @EmailContent NVARCHAR(MAX),   @UserID NVARCHAR(60)      SET @UserID = 'System Admin'      SELECT @BNK_NBR = REPLACE(DB_NAME(), 'BSADB', '')   SELECT @NEWLINE = '<BR/>',     @COLNAME = '',     @STYLE = '<STYLE>         TABLE{color:#222;margin-left:25px;padding:10px;width:1000px;border:1px solid #ccc;}          TH{text-align:left;vertical-align:top;font-weight:bold;}          TD{text-align:justify;}        </STYLE>',   @ENVIRONMENT_TITLE = '<' + UPPER(@BNK_NBR) + '> '        SELECT @sender = CtrlVal FROM dbo.POCTRL WHERE CtrlKey = 'EMAIL_NOTIFICATION'      SET @today_UTC = GETUTCDATE()   SET @today = dbo.ConvertToBankLocalTime(@today_UTC)      DECLARE @Resource_Greeting1 NVARCHAR(20)     SELECT @Resource_Greeting1 = dbo.GetResourceString('EmailTemplate_greeting1')      DECLARE @IDReachedNextSentDate TABLE(   ID BIGINT,   Interval INT   )      --Collect all the Reminder that reach its next sent date   INSERT INTO @IDReachedNextSentDate(ID,Interval)   SELECT ID,Interval FROM GM_ReminderMailSetting   WHERE NextTimeSendMail <= @today AND Deleted <> 'Y'            --Cursor loop the valid Email and insert into gm_notificationMailOutBox      DECLARE IDCursor CURSOR FOR      SELECT ID,Interval FROM @IDReachedNextSentDate            OPEN IDCursor      FETCH NEXT FROM IDCursor       INTO @Temp_ID,@Temp_Interval     WHILE @@FETCH_STATUS = 0     BEGIN       SET @EmailContent = @NEWLINE + @STYLE + @Resource_Greeting1 + @NEWLINE + @NEWLINE + '{MessageBody}'      INSERT INTO dbo.GM_NotificationMailOutbox (Sender, Recipient, [Subject], MessageBody, [Status], IsBodyHtml, Priority, CreatedDate, CreatedDate_UTC)   SELECT @sender, C.Email, A.Subject, (REPLACE(REPLACE(@EmailContent,'{USERID}',B.UserID),'{MessageBody}',A.MessageBody ))AS MessageBody,'PENDING',1,'HIGH',@today,@today_UTC   FROM GM_ReminderMailSetting A    JOIN GM_ReminderMailRecipient B ON A.ID = B.ID   JOIN dbo.UserAccounts C ON B.UserID = C.UserID   WHERE A.ID = @Temp_ID AND B.Deleted <> 'Y'      UPDATE  A    SET    NextTimeSendMail = DATEADD(mm,@Temp_Interval,NextTimeSendMail),   LastUpdatedBy = @UserID,   LastUpdatedDate = @today,   LastUpdatedDate_UTC = @today_UTC   OUTPUT Inserted.ID,inserted.Subject,inserted.MessageBody,inserted.FirstTimeSendMail,inserted.Interval,inserted.NextTimeSendMail,inserted.Deleted,inserted.LastUpdatedBy,inserted.LastUpdatedDate,inserted.LastUpdatedDate_UTC,@today,@today_UTC,'02'   INTO GM_ReminderMailSetting_Log(ID,Subject,MessageBody,FirstTimeSendMail,Interval,NextTimeSendMail,Deleted,LastUpdatedBy,LastUpdatedDate,LastUpdatedDate_UTC,ActionDate,ActionDate_UTC,ActionCode)    FROM GM_ReminderMailSetting A    WHERE A.ID = @Temp_ID      FETCH NEXT FROM IDCursor       INTO @Temp_ID,@Temp_Interval   END      CLOSE IDCursor        DEALLOCATE IDCursor   END    END
