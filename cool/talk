sqlcmd `
    -b `
    -r 1 `
    -S $Server `
    -U $User `
    -P $Password `
    -d $Database `
    -Q $branchUpdateSql `
    -o $BranchUpdateLogFile

if ($LASTEXITCODE -eq 0) {
    Write-Log "SUCCESS：分行代號更新作業完成" -ForegroundColor Green
} else {
    Write-Log "FAILED：分行代號更新失敗！請檢查 $BranchUpdateLogFile" -ForegroundColor Red -IsError
    exit 1
}

# ==========================================
# 8. 最終結果與 Exit Code 回傳
# ==========================================
Write-Log ""
Write-Log "========================================="
Write-Log "全部 SQL 檔案、CustomerNo 更新與分行代號更新皆已成功執行完成！" -ForegroundColor Green
Write-Log "========================================="
exit 0
