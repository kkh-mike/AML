OFAC_GetDNSLList_OtherList	CREATE PROC [dbo].[OFAC_GetDNSLList_OtherList]     @MSGTYPE VARCHAR(20) = NULL,     @FILTEREDNAME NVARCHAR(350) = NULL,   @RC_EQUALORLARGERTHAN INT = NULL,   @REF_NO NVARCHAR(MAX) = NULL,   @DEL_IND VARCHAR(1) = NULL,   @CREATEDDT_FROM NVARCHAR(50) = NULL,   @CREATEDDT_TO NVARCHAR(50) = NULL,   @SenderID NVARCHAR(MAX) = NULL,   @ReceiverID NVARCHAR(MAX) = NULL,   @LastUpdatedDt_From Nvarchar(50) = NULL,   @LastUpdatedDt_To Nvarchar(50) = NULL  AS    BEGIN   DECLARE @SEPARATOR_ABU NVARCHAR(20)  = NCHAR(196) + NCHAR(223) + NCHAR(181),     @Culture VARCHAR(5);     SELECT @Culture = ISNULL((SELECT CultureForDBColumnExtension FROM GCMAINDB..BankDBProfile WHERE BNK_NBR =  REPLACE(DB_NAME(),'BSADB','') ), '')     SELECT * FROM     (SELECT a.List,      a.id,      a.filtered_name,       highest_rc,       message_type,      message_desc  = (SELECT CASE WHEN @Culture = 'zh-TW' THEN MemberName_zh_TW ELSE MemberName END FROM WORKFLOW_MGMT_MODULE WHERE MemberCode = A.message_type),       msg_sender_id = REPLACE(a.msg_sender_id, @SEPARATOR_ABU, ''),      msg_receiver_id = REPLACE(a.msg_receiver_id, @SEPARATOR_ABU, ''),      inserted_by = (SELECT TOP 1 USERID + ' (' + ISNULL(FirstName + ' ', '') + ISNULL(LastName, '') + ')'           FROM dbo.UserAccounts WHERE USERID = A.inserted_by           ORDER BY DELETED),      inserted_datetime,      last_updated_by = (SELECT TOP 1 USERID + ' (' + ISNULL(FirstName + ' ', '') + ISNULL(LastName, '') + ')'           FROM dbo.UserAccounts WHERE USERID = CASE WHEN A.last_updated_by IS NULL THEN A.inserted_by ELSE A.last_updated_by END           ORDER BY DELETED),      last_updated_datetime = CASE WHEN A.last_updated_by IS NULL THEN inserted_datetime ELSE last_updated_datetime END,      del_ind,      source_key,      ref_no = CASE message_type WHEN 'SWIFT' THEN (SELECT TOP 1 Block4_UserReference FROM dbo.SWIFT_MTHEADER_MAIN WITH (NOLOCK) WHERE MT_KEY = A.source_key)             WHEN 'FEDWIRE' THEN (SELECT TOP 1 REFNO FROM dbo.FEDWIRE_HEADER_MAIN WITH (NOLOCK) WHERE ID = A.source_key)             WHEN 'FLRS' THEN (SELECT TOP 1 UserReference FROM dbo.FLRS_HEADER_MAIN WITH (NOLOCK) WHERE FLRS_KEY = A.source_key)             WHEN 'OUTSOURCE' THEN (SELECT TOP 1 UserReference FROM dbo.OUTSOURCE_HEADER_MAIN WITH (NOLOCK) WHERE OUTSOURCE_KEY = A.source_key)             ELSE '' END    FROM dbo.OFAC_DoNotScanList_Result_OtherList A WITH (NOLOCK)        )TEMP    WHERE (ISNULL(@MSGTYPE,'') = ''OR TEMP.message_type = @MSGTYPE )     AND (ISNULL(@FILTEREDNAME,'') = '' OR dbo.fn_CLR_GetRawFormattedName(filtered_name) LIKE N'%' + @FILTEREDNAME + '%' )    AND (ISNULL(@RC_EQUALORLARGERTHAN,0) = 0 OR HIGHEST_RC >= @RC_EQUALORLARGERTHAN )    AND (ISNULL(@REF_NO,'') ='' OR REF_NO LIKE N'%' + @REF_NO + '%')    AND (ISNULL(@DEL_IND,'') = '' OR DEL_IND = @DEL_IND )    AND (ISNULL(@CREATEDDT_FROM,'') = '' OR TEMP.inserted_datetime >= CAST(@CREATEDDT_FROM AS DATETIME) )    AND (ISNULL(@CREATEDDT_TO,'') = '' OR TEMP.inserted_datetime < DATEADD(DAY,1,@CREATEDDT_TO) )     AND (ISNULL(@LastUpdatedDt_From,'') = '' OR TEMP.last_updated_datetime >= CAST(@LastUpdatedDt_From AS DATETIME) )    AND (ISNULL(@LastUpdatedDt_To,'') = '' OR TEMP.last_updated_datetime < DATEADD(DAY,1,@LastUpdatedDt_To) )    AND (ISNULL(@SenderID,'') = '' OR dbo.fn_CLR_GetRawFormattedName(REPLACE(msg_sender_id, @SEPARATOR_ABU, '')) LIKE N'%' + @SenderID + '%')      AND (ISNULL(@ReceiverID,'') ='' OR dbo.fn_CLR_GetRawFormattedName(REPLACE(msg_receiver_id, @SEPARATOR_ABU, '')) LIKE N'%' + @ReceiverID + '%' )      END       
