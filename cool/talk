PEP_CustRisk_FileGenerator_GetHistoryHighRiskCustomer	  CREATE PROCEDURE [dbo].[PEP_CustRisk_FileGenerator_GetHistoryHighRiskCustomer]  @StartDate DATETIME = NULL,  @EndDate DATETIME = NULL  AS  BEGIN   DECLARE @Code NVARCHAR(50) = N'HR001'   DECLARE @ExtremelyHighRisk CHAR(1) = 'X'     ;WITH CTE_RiskAssessment AS    (    SELECT ROW_NUMBER() OVER (PARTITION BY A.CifKey ORDER BY A.ActionDate ASC) AS RowNumber,      A.CifKey, A.NewRiskRanking, A.ActionDate, A.ActionBy    FROM dbo.Customer_RiskAssessmentAuditLog A WITH (NOLOCK)    WHERE ISNULL(NewRiskRanking,'') <> ''     AND (ISNULL(@StartDate,'') = '' OR A.ActionDate >= @StartDate)     AND (ISNULL(@EndDate,'') = '' OR A.ActionDate <= @EndDate)   ),   CTE_CustomerTag AS    (    SELECT ROW_NUMBER() OVER (PARTITION BY A.CIF_KEY ORDER BY A.LastUpdatedDate ASC) AS RowNumber,      A.CIF_KEY, @ExtremelyHighRisk AS RiskRanking, A.LastUpdatedDate, A.LastUpdatedBy    FROM dbo.PB_CustomerTag_Log A WITH (NOLOCK)    WHERE A.TagCode = @Code     AND (ISNULL(@StartDate,'') = '' OR A.LastUpdatedDate >= @StartDate)     AND (ISNULL(@EndDate,'') = '' OR A.LastUpdatedDate <= @EndDate)   )   SELECT C.BRNCH_NBR, B.CustomerNo, C.CUST_NME, C.CUST_TYPE_CDE, A.NewRiskRanking AS RiskRanking,    A.ActionDate AS UpdateDate, D.UserID AS UpdateBy   FROM CTE_RiskAssessment A     JOIN dbo.BSA_SUB_CUST_FACT B WITH (NOLOCK) ON A.CifKey = B.CIF_KEY    JOIN dbo.PB_CUSTOMER_FACT C WITH (NOLOCK) ON A.CifKey = C.CIF_KEY    JOIN dbo.UserAccounts D WITH (NOLOCK) ON A.ActionBy = D.ID   WHERE A.RowNumber = '1'     OR A.NewRiskRanking <> ( SELECT TOP 1 Z.NewRiskRanking FROM CTE_RiskAssessment Z WHERE A.CifKey = Z.CifKey AND A.ActionDate > Z.ActionDate ORDER BY Z.ActionDate DESC)    UNION ALL   SELECT C.BRNCH_NBR, B.CustomerNo, C.CUST_NME, C.CUST_TYPE_CDE, @ExtremelyHighRisk AS RiskRanking,    A.LastUpdatedDate AS UpdateDate, A.LastUpdatedBy AS UpdateBy   FROM CTE_CustomerTag A     JOIN dbo.BSA_SUB_CUST_FACT B WITH (NOLOCK) ON A.CIF_KEY = B.CIF_KEY    JOIN dbo.PB_CUSTOMER_FACT C WITH (NOLOCK) ON A.CIF_KEY = C.CIF_KEY   WHERE A.RowNumber = '1'   ORDER BY B.CustomerNo ASC, A.ActionDate ASC     END    
