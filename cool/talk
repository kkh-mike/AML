WORKFLOW_MGMT_GETALLUSERS	CREATE PROC [dbo].[WORKFLOW_MGMT_GETALLUSERS]   @USERID NVARCHAR(40) = NULL  AS  DECLARE   @BNK_NBR  VARCHAR(10),   @NSTRSQL  NVARCHAR(4000),   @NSTRSQL_EXT NVARCHAR(1000)     SELECT @BNK_NBR = (SELECT REPLACE(DB_NAME(), 'BSADB', '')), @NSTRSQL = '', @NSTRSQL_EXT = ''   IF ISNULL(@USERID, '') <> ''    SET @NSTRSQL_EXT = ' AND EXISTS(SELECT 1 FROM USERLICENSE' + @BNK_NBR + '.dbo.UserAccounts WITH (NOLOCK)          WHERE USERID = @USERID AND DELETED = 0 AND ISNULL(BRANCHID, A.BRANCHID) = A.BRANCHID)'      SET @NSTRSQL = 'SELECT DISTINCT USERID, USERNAME = USERID + '' ('' + ISNULL(FirstName, '''') + '' '' + ISNULL(LastName, '''') + '')''        FROM USERLICENSE' + @BNK_NBR + '.dbo.UserAccounts A        WHERE DELETED = 0 ' + @NSTRSQL_EXT        EXEC SP_EXECUTESQL @NSTRSQL, N'@USERID NVARCHAR(40) ', @USERID    
WORKFLOW_MGMT_GETBRANCH	CREATE PROC [dbo].[WORKFLOW_MGMT_GETBRANCH]   @QUEUEID  INT,   @SELECTED  VARCHAR(1),   @CurrentUserId NVARCHAR(40)  AS  BEGIN  /*DECLARE   @BNK_NBR  VARCHAR(10),   @STRSQL   NVARCHAR(1000),   @STRSQL_EXT  NVARCHAR(1000)     SELECT @BNK_NBR = (SELECT REPLACE(DB_NAME(), 'BSADB', '')),      @STRSQL = '',      @STRSQL_EXT = ''      IF @SELECTED = 'Y'    SET @STRSQL_EXT = ' EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID) '   ELSE    SET @STRSQL_EXT = ' NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID) '       SET @STRSQL = 'SELECT DISTINCT BRNCH_NBR, BRNCH_DESC, AUTOASSIGN = (SELECT AUTOASSIGN FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID)        FROM WAREHOUSE' + @BNK_NBR + '.dbo.BRANCH_DIM A WHERE ' + @STRSQL_EXT   /* PRINT @STRSQL */   EXEC SP_EXECUTESQL @STRSQL, N'@QUEUEID INT', @QUEUEID   */     DECLARE @tempBranches AS TABLE (BranchNo NVARCHAR(50) PRIMARY KEY)     IF @CurrentUserId IS NULL OR EXISTS(SELECT 1 FROM dbo.UserAccounts A          JOIN dbo.AccountUserGroups B ON A.ID = B.AccountID         JOIN dbo.UserGroups C ON B.GroupID = C.ID          WHERE A.UserID = @CurrentUserId AND C.Deleted = 0 AND C.UserGroupType = 1) /*if bank admin*/   BEGIN /*bank admin can see all branch*/    INSERT INTO @tempBranches ( BranchNo )    SELECT BRNCH_NBR FROM dbo.BRANCH_DIM   END    ELSE IF EXISTS(SELECT 1 FROM dbo.UserAccounts A JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID      WHERE A.UserID = @CurrentUserId AND C.Deleted = 0 AND C.UserGroupType = 2)   BEGIN /*branch admin only can see particular branch */    INSERT INTO @tempBranches ( BranchNo )    SELECT DISTINCT D.BranchNo    FROM dbo.UserAccounts A      JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID      JOIN dbo.UserGroups C ON B.GroupID = C.ID     JOIN dbo.UserGroup_BranchPermission D ON C.ID = D.GroupId    WHERE A.UserID = @CurrentUserId AND C.Deleted = 0 AND C.UserGroupType = 2   END    ELSE    BEGIN     INSERT INTO @tempBranches ( BranchNo )    SELECT BRNCH_NBR FROM dbo.BRANCH_DIM   END        IF @SELECTED = 'Y'    BEGIN     SELECT DISTINCT BRNCH_NBR, BRNCH_DESC, AUTOASSIGN = (SELECT AUTOASSIGN FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID)     FROM dbo.BRANCH_DIM A     WHERE EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID)    END    ELSE    BEGIN     SELECT DISTINCT BRNCH_NBR, BRNCH_DESC, AUTOASSIGN = (SELECT AUTOASSIGN FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID)     FROM dbo.BRANCH_DIM A     WHERE NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_BRANCH WHERE BRNCH_NBR = A.BRNCH_NBR AND QUEUEID = @QUEUEID)     AND EXISTS(SELECT 1 FROM @tempBranches B WHERE A.BRNCH_NBR = B.BranchNo)   END       END 
