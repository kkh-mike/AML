SAR_DeleteScenarioGroup	CREATE PROCEDURE [dbo].[SAR_DeleteScenarioGroup]     @ID INT,   @UserAccountId BIGINT  AS    BEGIN     SET NOCOUNT ON;      DECLARE @Today_UTC DATETIME = GETUTCDATE();   DECLARE @Today_Local DATETIME = dbo.ConvertToBankLocalTime(@Today_UTC);      DECLARE @UserId NVARCHAR(40);   SELECT TOP 1 @UserId = [UserID]   FROM [dbo].[UserAccounts]   WHERE [ID] = @UserAccountId AND    [Deleted] = 'FALSE'      UPDATE dbo.SAR_SyntaxGroups     SET Deleted = 'TRUE',    [LstUpdatedBy] = @UserId,    [LastModifiedDate] = @Today_Local,    [LastModifiedDate_UTC] = @Today_UTC   WHERE ID = @ID AND IsActive = 'FALSE'     END
