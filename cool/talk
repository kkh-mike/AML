GetWorkgroupUserSettingsRpt	  CREATE PROCEDURE [dbo].[GetWorkgroupUserSettingsRpt]     @pUserName NVARCHAR(100),  @pUserID NVARCHAR(30),  @pBranch NVARCHAR(50),  @pUserGroup BIGINT,  @pStatus NVARCHAR(30),  @pSetByUserID NVARCHAR(30),  @pSetByUsername NVARCHAR(100),  @pLoginUsername NVARCHAR(100),  @pStartDt DATETIME,  @pEndDt DATETIME,  @pSRC NVARCHAR(20)     AS  BEGIN   SET NOCOUNT ON;      DECLARE @GroupID NVARCHAR(30)      IF OBJECT_ID('tempdb..#TempUserAcct') IS NOT NULL     DROP TABLE #TempUserAcct       CREATE TABLE #TempUserAcct   (    RowIndex INT NOT NULL IDENTITY(1,1),    UserID NVARCHAR(30),    Name NVARCHAR(128),    BranchID NVARCHAR(50),    GroupCode NVARCHAR(64),    BRNCH_NBR NVARCHAR(64)   );      /*get all branches that users can search*/   DECLARE @tempBranches AS TABLE (BranchNo NVARCHAR(50) PRIMARY KEY)      SELECT @GroupID = GroupCode FROM dbo.UserGroups WHERE ID = @pUserGroup      IF @pBranch IS NULL   BEGIN    IF EXISTS(SELECT 1 FROM dbo.UserAccounts A          JOIN dbo.AccountUserGroups B ON A.ID = B.AccountID         JOIN dbo.UserGroups C ON B.GroupID = C.ID          WHERE A.UserID = @pLoginUsername AND C.Deleted = 0 AND C.UserGroupType IN (1, 8)) /*if bank admin or report auditor*/    BEGIN /*bank admin can see all branch*/     INSERT INTO @tempBranches ( BranchNo )     SELECT BRNCH_NBR FROM dbo.BRANCH_DIM    END     ELSE IF EXISTS(SELECT 1 FROM dbo.UserAccounts A JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID       WHERE A.UserID = @pLoginUsername AND C.Deleted = 0 AND C.UserGroupType = 2)    BEGIN /*branch admin only can see particular branch */     INSERT INTO @tempBranches ( BranchNo )     SELECT DISTINCT D.BranchNo     FROM dbo.UserAccounts A       JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID       JOIN dbo.UserGroups C ON B.GroupID = C.ID      JOIN dbo.UserGroup_BranchPermission D ON C.ID = D.GroupId     WHERE A.UserID = @pLoginUsername AND C.Deleted = 0 AND C.UserGroupType = 2    END     ELSE IF EXISTS(SELECT 1 FROM dbo.UserAccounts A JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID       WHERE A.UserID = @pLoginUsername AND C.Deleted = 0 AND C.UserGroupType = 4)    BEGIN /*bank user only can see own branch */     INSERT INTO @tempBranches ( BranchNo )     SELECT DISTINCT D.BRNCH_NBR     FROM dbo.UserAccounts A       JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID       JOIN dbo.UserGroups C ON B.GroupID = C.ID      JOIN dbo.BRANCH_DIM D ON D.ID = A.BranchID     WHERE A.UserID = @pLoginUsername AND C.Deleted = 0     END    END       INSERT INTO #TempUserAcct(UserID, Name, BranchID, GroupCode, BRNCH_NBR)   SELECT DISTINCT A.UserID, LTRIM(ISNULL(FirstName,'') + ' ' +  ISNULL(LastName,'')) AS Name, A.BranchID, C.GroupCode, D.BRNCH_DESC   From UserAccounts A     Left Join AccountUserGroups B on A.ID = B.AccountID    Left Join UserGroups C on B.GroupID = C.ID    Left Join BRANCH_DIM D on A.BranchID = D.ID   WHERE (@pUserID IS NULL OR A.UserID = @pUserID)    AND (@GroupID IS NULL OR C.GroupCode = @GroupID)    AND (D.ID = @pBranch OR D.BRNCH_NBR IN (SELECT BranchNo FROM @tempBranches))    AND A.Deleted = 'FALSE'    AND (ISNULL(@pUserName,'') = '' OR LTRIM(ISNULL(FirstName,'') + ' ' +  ISNULL(LastName,'')) = @pUserName)            SELECT A.USERID, ISNULL(C.FirstName,'') + ' ' + ISNULL(C.LastName,'') AS 'UserName', ActionCD, A.ROLE, A.ActionDt, D.BRNCH_NBR, E.MemberName, B.QUEUENAME,    STUFF( (SELECT ',' + G.GroupCode FROM UserGroups G    WHERE EXISTS(SELECT NULL FROM AccountUserGroups AG WHERE AG.AccountID = C.ID AND AG.GroupID = G.ID)     AND (ISNULL(@pUserGroup,'') = '' OR G.ID = @pUserGroup)    FOR XML PATH('')),1,1,'') AS 'GroupCodes',      A.ActionBy,       ISNULL(F.FirstName,'') + ' ' + ISNULL(F.LastName,'') AS 'ActionByUserName'      FROM dbo.WORKFLOW_MGMT_USERS_CHG_LOG A      JOIN dbo.WORKFLOW_MGMT_QUEUE B ON B.QUEUEID = A.QUEUEID      JOIN dbo.UserAccounts C ON C.UserID = A.USERID      JOIN BRANCH_DIM D ON D.ID = C.BranchI
