ForeignTransaction_GetQueue	CREATE PROC [dbo].[ForeignTransaction_GetQueue]    @USERID NVARCHAR(60),    @TYPE CHAR(1)    AS    IF @TYPE = 'A'      BEGIN        SELECT DISTINCT A.QUEUEID, A.QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE A, dbo.WORKFLOW_MGMT_MSG B           WHERE A.QUEUEID = B.QUEUEID AND A.SRC = 'ForeignTransaction' AND A.DEL_FLAG <> 'Y' AND B.IS_ADDITIONAL  = 'Y'            ORDER BY QUEUENAME     END    ELSE      BEGIN      IF EXISTS(SELECT 1 from UserAccounts A JOIN AccountUserGroups B ON A.ID = B.AccountID       JOIN dbo.UserGroups C ON B.GroupID = C.ID       WHERE A.UserID  = @USERID AND (C.GroupCode IN ('Bank Admins','BA010000','BA020000') OR C.UserGroupType = 1))    BEGIN      SELECT DISTINCT A.QUEUEID, A.QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE A     WHERE A.SRC = 'ForeignTransaction' AND A.DEL_FLAG <> 'Y'     ORDER BY A.QUEUENAME    END     IF EXISTS (SELECT 1 FROM dbo.Useraccounts A, dbo.AccountUserGroups B, dbo.UserGroups C WHERE A.ID = B.AccountID AND B.GroupID = C.ID AND C.UserGroupType IN (1,8) AND A.UserID = @USERID)/*bank admin or report auditor */    BEGIN      WITH CTE_Queue AS(      SELECT DISTINCT A.QUEUEID, A.QUEUENAME      FROM dbo.WORKFLOW_MGMT_QUEUE A, dbo.WORKFLOW_MGMT_USERS B       WHERE A.QUEUEID = B.QUEUEID AND A.SRC = 'ForeignTransaction'     )     SELECT QUEUEID, QUEUENAME      FROM CTE_Queue    END     ELSE IF EXISTS(SELECT 1 FROM dbo.Useraccounts A JOIN dbo.AccountUserGroups B ON a.ID = B.AccountID JOIN dbo.UserGroups C ON B.GroupID = C.ID WHERE C.UserGroupType = 2 AND A.UserID = @USERID) /*branch admin*/    BEGIN      ;WITH cte_ActiveQueue AS (      SELECT E.QUEUEID, 'N' 'Deleted' /*for branch admin - active workgroup*/      FROM dbo.Useraccounts A WITH(NOLOCK)        JOIN dbo.AccountUserGroups B WITH(NOLOCK) ON a.ID = B.AccountID        JOIN dbo.UserGroups C WITH(NOLOCK) ON B.GroupID = C.ID        JOIN dbo.UserGroup_BranchPermission D WITH(NOLOCK) ON C.ID = D.GroupId       JOIN dbo.WORKFLOW_MGMT_BRANCH E WITH(NOLOCK) ON D.BranchNo = E.BRNCH_NBR      WHERE C.UserGroupType = 2 AND A.UserID = @USERID GROUP BY E.QUEUEID /*for branch admin*/      UNION       SELECT QUEUEID, 'N' 'Deleted' /*for user active queue*/      FROM  dbo.WORKFLOW_MGMT_USERS WITH(NOLOCK) WHERE USERID = @USERID GROUP BY QUEUEID      UNION       SELECT QUEUEID,  DEL_FLAG 'Deleted' /*branch admin - all branches workgroup*/      FROM dbo.WORKFLOW_MGMT_QUEUE WITH(NOLOCK) WHERE IsIncludeAllBranch = 1 AND SRC = 'ForeignTransaction'     ), cte_InactiveQueue AS (      SELECT E.QUEUEID, 'Y' 'Deleted' /*for branch admin -  deleted workgroup*/      FROM dbo.Useraccounts A WITH(NOLOCK)        JOIN dbo.AccountUserGroups B WITH(NOLOCK) ON a.ID = B.AccountID        JOIN dbo.UserGroups C WITH(NOLOCK) ON B.GroupID = C.ID        JOIN dbo.UserGroup_BranchPermission D WITH(NOLOCK) ON C.ID = D.GroupId       JOIN dbo.WORKFLOW_MGMT_BRANCH_HISTORY E WITH(NOLOCK) ON D.BranchNo = E.BRNCH_NBR      WHERE C.UserGroupType = 2 AND A.UserID = @USERID GROUP BY E.QUEUEID /*for branch admin*/      UNION       SELECT QUEUEID, 'Y' 'Deleted' /*for user deleted queue*/      FROM dbo.WORKFLOW_MGMT_USERS_HISTORY A WITH(NOLOCK) WHERE USERID = @USERID AND NOT EXISTS(SELECT 1 FROM dbo.WORKFLOW_MGMT_USERS B WITH(NOLOCK) WHERE A.USERID = B.USERID AND A.QUEUEID = B.QUEUEID) GROUP BY QUEUEID     ), cte_AllQueue AS (      SELECT QUEUEID, Deleted FROM cte_ActiveQueue      UNION                  SELECT A.QUEUEID, A.Deleted FROM cte_InactiveQueue A WHERE NOT EXISTS(SELECT 1 FROM cte_ActiveQueue B WHERE B.QUEUEID = A.QUEUEID)     )     SELECT A.QUEUEID, CASE WHEN A.DEL_FLAG = 'Y' THEN A.QUEUENAME + ' [Deleted]' ELSE A.QUEUENAME END 'QUEUENAME'     FROM dbo.WORKFLOW_MGMT_QUEUE A WITH(NOLOCK) JOIN cte_AllQueue B ON A.QUEUEID = B.QUEUEID     WHERE A.SRC = 'ForeignTransaction'     ORDER BY  A.QUEUENAME    END     ELSE     SELECT DISTINCT A.QUEUEID, A.QUEUENAME FROM dbo.WORKFLOW_MGMT_QUEUE A, dbo.WORKFLOW_MGMT_USERS B     WHERE A.QUEUEID = B.QUEUEID AND A.SRC = 'ForeignTransaction' AND A.DEL_FLAG <> 'Y'   
