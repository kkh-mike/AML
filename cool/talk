OFAC_314A_Automatic_GetReturnUserList	CREATE PROCEDURE [dbo].[OFAC_314A_Automatic_GetReturnUserList]  @USERID NVARCHAR(40),      @BatchID VARCHAR(MAX),  @ROLE INT   AS  BEGIN    DECLARE @NSQLRETURNDATE NVARCHAR(MAX)   SET @ROLE = ISNULL(@ROLE, 0) - 1       DECLARE @ReviewMain AS TABLE(    BatchID INTEGER,      LastUpdatedDate DATETIME,     LastUpdatedBy NVARCHAR(60),     AssignDate DATETIME,    QueueId INT   )     INSERT INTO @ReviewMain(BatchID, LastUpdatedDate, LastUpdatedBy, AssignDate, QueueId)   SELECT BatchID, LastUpdatedDate, LastUpdatedBy, AssignDate, QueueId   FROM OFAC_314A_Automatic_Review_Main WHERE BatchID IN (SELECT value FROM fnStringSplitter(@BatchID, '|'))     DECLARE @TempQueueId TABLE(QueueId INT NOT NULL PRIMARY KEY)     INSERT INTO @TempQueueId ( QueueId )   SELECT DISTINCT QueueId FROM @ReviewMain     DECLARE @QueueCount INT = 0 ;   SELECT @QueueCount = COUNT(1) FROM @TempQueueId;     SELECT TOP 1 @NSQLRETURNDATE = LastUpdatedBy    FROM @ReviewMain ORDER BY LastUpdatedDate DESC     IF OBJECT_ID('tempdb..#TEMP_Filter_USERID') IS NOT NULL    DROP TABLE #TEMP_Filter_USERID;     CREATE TABLE #TEMP_Filter_USERID(      [USERID] [nvarchar](60) NULL,    [FLAG] [varchar] NULL     )      IF @NSQLRETURNDATE <> ''    BEGIN     INSERT INTO #TEMP_Filter_USERID (USERID, FLAG)     SELECT A.USERID, 'A'     FROM dbo.WORKFLOW_MGMT_USERS A, dbo.UserAccounts B      WHERE A.USERID = B.USERID AND Deleted = 0 AND ROLE =  @ROLE      AND EXISTS (SELECT QueueId FROM @TempQueueId X WHERE X.QueueId = A.QUEUEID)      AND EXISTS (SELECT 1 FROM @ReviewMain WHERE LastUpdatedBy = A.USERID)       GROUP BY A.USERID      HAVING COUNT(A.QUEUEID) = @QueueCount        INSERT INTO #TEMP_Filter_USERID (USERID, FLAG)     SELECT A.USERID, 'B' FROM dbo.WORKFLOW_MGMT_USERS A, dbo.UserAccounts B      WHERE A.USERID = B.USERID AND Deleted = 0 AND ROLE =  @ROLE      AND EXISTS (SELECT QueueId FROM @TempQueueId X WHERE X.QueueId = A.QUEUEID)      AND NOT EXISTS (SELECT 1 FROM @ReviewMain WHERE LastUpdatedBy = A.USERID)       GROUP BY A.USERID      HAVING COUNT(A.QUEUEID) = @QueueCount   END    ELSE      BEGIN     INSERT INTO #TEMP_Filter_USERID (USERID, FLAG)    SELECT A.USERID, 'A' FROM dbo.WORKFLOW_MGMT_USERS A, dbo.UserAccounts B      WHERE A.USERID = B.USERID AND Deleted = 0 AND ROLE = @ROLE AND EXISTS (SELECT QueueId FROM @TempQueueId X WHERE X.QueueId = A.QUEUEID)    GROUP BY A.USERID      HAVING COUNT(A.QUEUEID) = @QueueCount   END      SELECT A.USERID + ' [' + ISNULL(B.FirstName,'') + ' ' +  ISNULL(B.LastName,'') + '] ' USERID    FROM #TEMP_Filter_USERID A JOIN dbo.UserAccounts B ON A.USERID = B.USERID   WHERE B.Deleted <> '1' AND B.Disabled = 0 --AND ISNULL(A.USERID,'') <> ''    ORDER BY FLAG;  END    
