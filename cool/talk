--加強關注客戶 企業
SELECT bb.CustomerNo, a.IsSARFiled FROM Cust_NP_Migrate_buffer a
join CIF_Migrate_Mapping_TEMP v on v.SOURCE_CIF_KEY = a.CIF_KEY
join BSA_SUB_CUST_FACT bb on bb.CIF_KEY = v.NEW_CIF_KEY
join PB_CUSTOMER_FACT cc on cc.CIF_KEY = bb.CIF_KEY
WHERE a.IsSARFiled = '1'  AND cc.CUST_TYPE_CDE = 'N'


--告誡戶 企業
SELECT bb.CustomerNo, a.SDST2400001   FROM Cust_NP_Migrate_buffer a
join CIF_Migrate_Mapping_TEMP v on v.SOURCE_CIF_KEY = a.CIF_KEY
join BSA_SUB_CUST_FACT bb on bb.CIF_KEY = v.NEW_CIF_KEY
join PB_CUSTOMER_FACT cc on cc.CIF_KEY = bb.CIF_KEY
WHERE a.SDST2400001 = '1'  AND cc.CUST_TYPE_CDE = 'N' AND v.ACTION = 'insert'


