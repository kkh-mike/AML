ioGroupID] = @ID AND    EXISTS(SELECT NULL FROM [dbo].[WORKFLOW_MGMT_QUEUE] A     WHERE A.[QUEUEID] = [WORKFLOW_MGMT_ScenarioGroup].[QueueID] AND      A.[SRC] = 'CIP')         DELETE [dbo].[WORKFLOW_MGMT_ScenarioGroup]   OUTPUT DELETED.[QueueID], DELETED.[ScenarioGroupID],    @UserAccountId, @Today_Local, @Today_UTC   INTO [dbo].[WORKFLOW_MGMT_ScenarioGroup_History](QueueID, ScenarioGroupID,    CREATEDBY, CREATEDDT, CREATEDDT_UTC)   WHERE [ScenarioGroupID] = @ID AND    EXISTS(SELECT NULL FROM [dbo].[WORKFLOW_MGMT_QUEUE] A     WHERE A.[QUEUEID] = [WORKFLOW_MGMT_ScenarioGroup].[QueueID] AND      A.[SRC] = 'HRS')     END
