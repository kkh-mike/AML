HRS_GetReturnUserList	CREATE PROC [dbo].[HRS_GetReturnUserList]   @USERID NVARCHAR(40),        @CUSTNOLIST NVARCHAR(MAX),   @BatchId NVARCHAR(100),     @ROLE INT      AS          DECLARE        @NSQLRETURNDATE NVARCHAR(MAX)          SET @ROLE = ISNULL(@ROLE, 0) - 1      DECLARE @tempRefNo AS TABLE(CifKey UNIQUEIDENTIFIER, BatchId INT)  INSERT INTO @tempRefNo ( CifKey, BatchId)  SELECT A.Value, B.Value  FROM dbo.fnStringSplitter(@CUSTNOLIST,'|') A JOIN dbo.fnStringSplitter(@BatchId,'|') B ON A.Id = B.Id  WHERE ISNULL(A.Value,'') <> '' AND ISNULL(B.Value,'') <> ''    DECLARE @HRSReviewMain AS TABLE(   CifKey UNIQUEIDENTIFIER, BatchId INT,   ReviewDate_4 DATETIME, ReviewBy_4 NVARCHAR(60),    ReviewDate_3 DATETIME, ReviewBy_3 NVARCHAR(60),   ReviewDate_2 DATETIME, ReviewBy_2 NVARCHAR(60),   ReviewDate DATETIME, ReviewBy NVARCHAR(60),   AssignDate DATETIME, AssignBy NVARCHAR(60),   QueueId INT  )    INSERT INTO @HRSReviewMain ( CifKey, BatchId, ReviewDate_4, ReviewBy_4, ReviewDate_3, ReviewBy_3, ReviewDate_2, ReviewBy_2, ReviewDate, ReviewBy,                                  AssignDate, AssignBy, QueueId )  SELECT A.CIF_KEY, A.BatchId, A.ReviewDate_4, A.ReviewBy_4, A.ReviewDate_3, A.ReviewBy_3, A.ReviewDate_2, A.ReviewBy_2, A.ReviewDate, A.ReviewBy,   A.AssignDate, A.AssignBy, QueueId  FROM dbo.HRS_CUST_RISK_MGMT A WITH(NOLOCK) JOIN @tempRefNo B ON A.BatchId = B.BatchId AND A.CIF_KEY = B.CifKey     DECLARE @TempQueueId TABLE(QueueId INT NOT NULL PRIMARY KEY)    INSERT INTO @TempQueueId ( QueueId )  SELECT DISTINCT QueueId FROM @HRSReviewMain;    DECLARE @QueueCount INT = 0 ;  SELECT @QueueCount = COUNT(1) FROM @TempQueueId;    DECLARE @TEMP_NMCHK_ReturnDate_USERID AS TABLE (     [DATETIME] DATETIME NULL,   [USERID] NVARCHAR(100)  )       INSERT INTO @TEMP_NMCHK_ReturnDate_USERID(DATETIME, USERID)  SELECT ReviewDate_4, ReviewBy_4 FROM @HRSReviewMain WHERE ISNULL(ReviewBy_4,'') <> ''  UNION ALL   SELECT ReviewDate_3, ReviewBy_3 FROM @HRSReviewMain WHERE ISNULL(ReviewBy_3,'') <> ''  UNION ALL   SELECT ReviewDate_2, ReviewBy_2 FROM @HRSReviewMain WHERE ISNULL(ReviewBy_2,'') <> ''  UNION ALL   SELECT ReviewDate, ReviewBy FROM @HRSReviewMain WHERE ISNULL(ReviewBy,'') <> ''  UNION ALL   SELECT AssignDate, AssignBy FROM @HRSReviewMain WHERE ISNULL(AssignBy,'') <> ''    SELECT TOP 1 @NSQLRETURNDATE = [USERID]   FROM @TEMP_NMCHK_ReturnDate_USERID ORDER BY [DATETIME] DESC       IF OBJECT_ID('tempdb..#TEMP_NMCHK_Filter_USERID') IS NOT NULL   DROP TABLE #TEMP_NMCHK_Filter_USERID;    CREATE TABLE #TEMP_NMCHK_Filter_USERID(     [USERID] [nvarchar](60) NULL,   [FLAG] [varchar] NULL    )     IF @NSQLRETURNDATE <> ''   BEGIN    INSERT INTO #TEMP_NMCHK_Filter_USERID (USERID, FLAG)     SELECT A.USERID, 'A'     FROM dbo.WORKFLOW_MGMT_USERS A, dbo.UserAccounts B      WHERE A.USERID = B.USERID AND Deleted = 0 AND ROLE =  @ROLE      AND EXISTS (SELECT QueueId FROM @TempQueueId X WHERE X.QueueId = A.QUEUEID)      AND EXISTS (SELECT 1 FROM @TEMP_NMCHK_ReturnDate_USERID WHERE USERID = A.USERID)       GROUP BY A.USERID      HAVING COUNT(A.QUEUEID) = @QueueCount          INSERT INTO #TEMP_NMCHK_Filter_USERID (USERID, FLAG)     SELECT A.USERID, 'B' FROM dbo.WORKFLOW_MGMT_USERS A, dbo.UserAccounts B      WHERE A.USERID = B.USERID AND Deleted = 0 AND ROLE =  @ROLE      AND EXISTS (SELECT QueueId FROM @TempQueueId X WHERE X.QueueId = A.QUEUEID)      AND NOT EXISTS (SELECT 1 FROM @TEMP_NMCHK_ReturnDate_USERID WHERE USERID = A.USERID)       GROUP BY A.USERID      HAVING COUNT(A.QUEUEID) = @QueueCount    END  ELSE   BEGIN    INSERT INTO #TEMP_NMCHK_Filter_USERID (USERID, FLAG)    SELECT A.USERID, 'A' FROM dbo.WORKFLOW_MGMT_USERS A, dbo.UserAccounts B      WHERE A.USERID = B.USERID AND Deleted = 0 AND ROLE = @ROLE AND EXISTS (SELECT QueueId FROM @TempQueueId X WHERE X.QueueId = A.QUEUEID)    GROUP BY A.USERID      HAVING COUNT(A.QUEUEID) = @QueueCount     END      SELECT A.USERID + ' [' + ISNULL(B.FirstName,'') + ' ' +  ISNULL(B.LastName,'') + '] ' USERID   FROM #TEMP_NMCHK_Filter_USERID A
