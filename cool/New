
    ============================================================
    第二段：日本金融制裁名單同步（Japanese Finance）
    活人：BSADBJP..OFAC_SPEC（GROUPID = 5）
    死人：BSADBJP..OFAC_SPEC（GROUPID = 7）
    ============================================================
*/

IF OBJECT_ID('tempdb..#tempDJBlacklistJP') IS NOT NULL DROP TABLE #tempDJBlacklistJP;
IF OBJECT_ID('tempdb..#tempDJBlacklistDetailsJP') IS NOT NULL DROP TABLE #tempDJBlacklistDetailsJP;

CREATE TABLE #tempDJBlacklistJP (
    EntNum INT NOT NULL,
    SdnName NVARCHAR(350) NOT NULL,
    UpdatedDate VARCHAR(8) NOT NULL,
    GroupID INT NOT NULL
);

CREATE TABLE #tempDJBlacklistDetailsJP (
    Num INT,
    EntNum INT NOT NULL,
    SdnName NVARCHAR(350) NOT NULL,
    UpdatedDate VARCHAR(8) NOT NULL,
    Address NVARCHAR(400),
    City NVARCHAR(200),
    Country NVARCHAR(100), 
    IdentType VARCHAR(2),
    IdentNumber NVARCHAR(44),
    DOB VARCHAR(8),
    GroupID INT NOT NULL
);


/*
從 DJ_List_Data_A 撈取名稱資料，限 Japanese Finance 制裁名單。
NamePropertyBitCode & 1 > 0 表示此筆是名稱資料。
若來源 Entity 標記為死亡，歸入 GROUPID 7；否則歸入 GROUPID 5。
*/
INSERT INTO #tempDJBlacklistJP (EntNum, SdnName, UpdatedDate, GroupID)
SELECT
    A.EntNum, A.SdnName, MAX(A.UpdatedDate) AS UpdatedDate,
    CASE WHEN EXISTS (
        SELECT 1 FROM BSADB.dbo.DJ_Entity E
        WHERE E.EntityId = A.EntNum AND E.Deceased = 1
    ) THEN 7 ELSE 5 END AS GroupID
FROM BSADB.dbo.DJ_List_Data_A A
JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntNum = B.EntityId
WHERE A.NamePropertyBitCode & 1 > 0
  AND B.SanctionListReference LIKE '%Japanese Finance%'
GROUP BY A.EntNum, A.SdnName;

/*
    ============================================================
    補抓死亡名單資料
    有些死亡 Entity 可能沒有出現在上方的名稱資料中，
    因此從 DJ_Entity 再掃描一次。

    -- 將前一段尚未抓到的死亡 Entity 補進暫存主檔，GroupID 設為 7。
    -- NOT EXISTS 避免同一個 Entity 重複加入。
    ============================================================
*/
INSERT INTO #tempDJBlacklistJP (EntNum, SdnName, UpdatedDate, GroupID)
SELECT A.EntityId, A.FullName, MAX(CONVERT(VARCHAR, A.UpdatedDate_UTC, 112)) AS UpdatedDate, 7 AS GroupID
FROM BSADB.dbo.DJ_Entity A
JOIN BSADB.dbo.DJ_SanctionListReference B ON A.EntityId = B.EntityId
WHERE A.Deceased = 1
  AND B.SanctionListReference LIKE '%Japanese Finance%'
  AND NOT EXISTS (
      SELECT 1
      FROM #tempDJBlacklistJP X
      WHERE X.EntNum = A.EntityId
  )
GROUP BY A.EntityId, A.FullName;


/*
    ============================================================
    整理地址、身分證明、出生日期，以及目標表既有資料
    ============================================================
*/
;WITH TempAddress AS (
    SELECT A.EntityId, A.Address, A.City, A.AddressCountry,
           ROW_NUMBER() OVER (PARTITION BY A.EntityId ORDER BY A.Id) AS RowId
    FROM BSADB.dbo.DJ_Address A WITH (NOLOCK)
    WHERE A.Deleted = 0
      AND EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE A.EntityId = X.EntNum)
),
TempIdent AS (
    SELECT A.EntityId,
           CASE WHEN ISNULL(A.IdentificationType, '') = '' THEN NULL ELSE @OtherIdentMthCode END AS IdentificationType,
           A.IdentificationNumber,
           ROW_NUMBER() OVER (PARTITION BY A.EntityId ORDER BY A.Id) AS RowId
    FROM BSADB.dbo.DJ_IdentificationTypeInfo A WITH (NOLOCK)
    WHERE A.Deleted = 0
      AND EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE X.EntNum = A.EntityId)
),
TempDOB AS (
    SELECT A.EntityId, A.InfoDay, A.InfoMonth, A.InfoYear,
           ROW_NUMBER() OVER (PARTITION BY A.EntityId ORDER BY A.Id) AS RowId
    FROM BSADB.dbo.DJ_DateTypeInfo A WITH (NOLOCK)
    WHERE A.DateType = 'Date of Birth'
      AND A.Deleted = 0
      AND EXISTS (SELECT 1 FROM #tempDJBlacklistJP X WHERE X.EntNum = A.EntityId)
),
TempNUM AS (
    SELECT A.spec_name, A.updated_date, A.remark, A.ent_num, A.GROUPID
    FROM BSADBJP..OFAC_SPEC A
    WHERE A.GROUPID IN (5, 7) AND A.DInd = 'N'
)

/*
-- 組裝完整明細，準備後續 MERGE 到 OFAC_SPEC。
-- 找得到目標表既有資料時沿用原 ent_num；
-- 找不到時 Num 為 NULL，稍後再配置新的 ent_num。
*/
INSERT INTO #tempDJBlacklistDetailsJP (
    Num, EntNum, SdnName, UpdatedDate, Address, City, Country,
    IdentType, IdentNumber, DOB, GroupID
)
SELECT
    E.ent_num, A.EntNum, A.SdnName, A.UpdatedDate, B.Address, LEFT(B.City, 100),
    COALESCE(F.ISO_2_CountryCode, LEFT(B.AddressCountry, 100)) AS Country,
    C.IdentificationType, LEFT(C.IdentificationNumber, 44),
    CASE
        WHEN D.InfoDay IS NULL OR D.InfoMonth IS NULL THEN D.InfoYear
        ELSE CONVERT(VARCHAR(8), dbo.TryParseDate(D.InfoYear + ' ' + D.InfoMonth + ' ' + D.InfoDay), 112)
    END,
    A.GroupID
FROM #tempDJBlacklistJP A
LEFT JOIN TempAddress B ON A.EntNum = B.EntityId AND B.RowId = 1
LEFT JOIN TempIdent C ON A.EntNum = C.EntityId AND C.RowId = 1
LEFT JOIN TempDOB D ON A.EntNum = D.EntityId AND D.RowId = 1
LEFT JOIN TempNUM E ON A.EntNum = E.remark AND A.SdnName = E.spec_name AND A.GroupID = E.GROUPID
OUTER APPLY (
    SELECT TOP 1 CD.ISO_2_CountryCode
    FROM COUNTRY_DIM CD WITH (NOLOCK)
    WHERE B.AddressCountry IS NOT NULL
      AND B.AddressCountry IN (
          CD.ISO_CountryDescription, CD.ISO_CountryDescription_zh_TW,
          CD.ISO_CountryDescription_zh_CN, CD.ISO_CountryDescription_Default
      )
) F;

DECLARE @MAXNo INT;

SELECT @MAXNo = MAX(ent_num) FROM BSADBJP..OFAC_SPEC;

UPDATE #tempDJBlacklistDetailsJP
SET @MAXNo = @MAXNo + 1, Num = @MAXNo
WHERE Num IS NULL;

