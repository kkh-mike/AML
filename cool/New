SELECT 
    O.spec_name,
    O.GROUPID,
    A.EntityId,
    A.FullName,
    A.Deceased,
    CASE 
        WHEN A.EntityId IS NULL THEN '未在 DJ_Entity 找到對應'
        WHEN A.Deceased = 0 THEN '存活 (Deceased = 0)'
        ELSE '未知/其他'
    END AS Status_Reason
FROM BSADBJP..OFAC_SPEC O
LEFT JOIN BSADBJP..BlackListData BL ON O.spec_name = BL.sdn_name
LEFT JOIN BSADB.dbo.DJ_Entity A ON A.EntityId = O.remark
WHERE O.GROUPID = '7'
  AND (A.Deceased IS NULL OR A.Deceased <> 1);



