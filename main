USE SOURCEDBTW

---RAW_TABLE HOUSEKEEP
--EXEC [PRELOAD_HOUSEKEEPING]

---宣告暫存table
DECLARE  @DelACCTTEMP TABLE (
CustomerNo VARCHAR(100),
ACCT_KEY VARCHAR(100),
APPL VARCHAR(100),
BRNCH_NBR VARCHAR(100),
ACCTYP VARCHAR(100),
ADTOPN DATETIME,
MethodOfAcctOpn VARCHAR(100),
ASTATCD INT
)

--Control-M
--   1) HOLD AMLTWDC008C (Ordered date 20220114)
--   2) 待通知 FREE AMLTWDC008C

---INSERT要關戶的客戶帳戶
INSERT INTO @DelACCTTEMP
SELECT B.CustomerNo,A.ACCT_KEY,A.APPL,A.BRNCH_NBR,A.ACCTYP,A.ADTOPN,A.MethodOfAcctOpn,A.ASTATCD FROM BSADBTW..ACCT_XREF_DIM A
 INNER JOIN BSADBTW..BSA_SUB_CUST_FACT B ON A.CIF_KEY = B.CIF_KEY
 INNER JOIN BSADBTW..PB_CUSTOMER_FACT D ON B.CIF_KEY = D.CIF_KEY
 WHERE ASTATCD = 0 AND B.CUSTOMERNO in
('JENCH01SC')


--before
select *  from RAW_CASH_ACCOUNT where CUSTOMER_ID in  (select CustomerNo from @DelACCTTEMP)
select *  from SG_FX_PASSBOOK_SAVING where CUSTOMER_ID in  (select CustomerNo from @DelACCTTEMP)
select *  from SG_FX_TD_CERTIFICATE where CUSTOMER_ID in  (select CustomerNo from @DelACCTTEMP)
select *  from LOAN_LIMIT where CUSTOMER_ID in  (select CustomerNo from @DelACCTTEMP)
select *  from RAW_CCARD_ACCOUNT where CUSTOMER_ID in  (select CustomerNo from @DelACCTTEMP)


---CASA ACCT
INSERT INTO [RAW_CASH_ACCOUNT] 
SELECT 
	   ACCT_KEY
      ,APPL
      ,CustomerNo
      ,ISNULL(BRNCH_NBR,'')
      ,''
      ,ISNULL(ACCTYP,'')
      ,''
      ,''
      ,''
      ,''
      ,''
      ,convert(varchar(10), ADTOPN, 120)
      ,''
      ,'1'
      ,''
      ,''
      ,ISNULL(MethodOfAcctOpn,'')
      ,''
      ,''
      ,''
      ,''
      ,''
      ,''
      ,convert(varchar(10), GETDATE()-1, 120)
      ,''
      ,''
      ,''
FROM @DelACCTTEMP WHERE APPL IN('TRD','DDA')


