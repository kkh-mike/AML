

SELECT b.CustPurposeOfAcc , a.NEW_CIF_KEY , a.SOURCE_CIF_KEY  FROM CIF_Migrate_Mapping_TEMP a
JOIN Customer_Migrate_buffer b on a.SOURCE_CIF_KEY = b.CIF_KEY
JOIN BSA_SUB_CUST_FACT c  on c.CIF_KEY = a.NEW_CIF_KEY
WHERE b.CustPurposeOfAcc is not NULL


