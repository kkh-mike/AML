-- 為這些員工同時給 0094 和 0028 權限
UNION ALL
-- 2026/06/23 新增1141923 等五人 0094+0028 權限
SELECT 
    H.EMP_ID, 
    H.CH_NM, 
    T.APPCODE,
    CASE WHEN CHARINDEX('_', RTRIM(T.PERMCODE)) > 0 
         THEN SUBSTRING(T.PERMCODE,1,3) 
         ELSE T.PERMCODE 
    END PERMCODE,
    H.EMAIL_ADDR, 
    H.DEPT_CD_FUNC, 
    H.DEPT_NM_FUNC, 
    ACCT_DEPT_CD
FROM TSAAS..TBL_CMPEMPAPP T 
JOIN TSAAS..HREMPM_N H ON T.EMPCODE = H.EMP_ID
CROSS JOIN (VALUES 
    ('0094'),
    ('0028')
) AS DEPTS(ACCT_DEPT_CD)
WHERE H.COMP_CD = 'TSIB' 
  AND T.APPCODE = 'AML' 
  AND H.EMP_ID IN ('1141923','1141924','1141925','1141926','1141927');