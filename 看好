# 要讀取的路徑
$FolderPath = "D:\AML_Source\Source\1141923\20260715"

# 要檢查的檔案
$Files = @(
    "AML_Acct.csv",
    "AML_Cust.csv",
    "AML_LoadTrxn.csv",
    "AML_NameProperty_Cust.csv",
    "AML_NameProperty_RP.csv",
    "AML_SPEC_lowrisklistgroups.csv",
    "AML_SPEC_OFAC_SPEC.csv"
)

# 輸出檔案
$OutputFile = Join-Path $FolderPath "FileMD5.csv"

# 如果輸出檔已存在則先刪除
if (Test-Path $OutputFile) {
    Remove-Item $OutputFile
}

foreach ($FileName in $Files) {

    $FullPath = Join-Path $FolderPath $FileName

    if (Test-Path $FullPath) {

        # 計算 CSV 總行數(包含表頭)
        $LineCount = (Get-Content -Path $FullPath | Measure-Object -Line).Lines

        # 計算 MD5
        $MD5 = (Get-FileHash -Path $FullPath -Algorithm MD5).Hash.ToLower()

        # 組合結果
        $Result = "$FileName;$LineCount;$MD5"

        # 寫入 CSV
        Add-Content -Path $OutputFile -Value $Result

        # 顯示於畫面
        Write-Host $Result
    }
    else {
        Write-Host "File Not Found : $FileName" -ForegroundColor Yellow
    }
}

Write-Host ""
Write-Host "Generate Success : $OutputFile" -ForegroundColor Green