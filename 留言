
SELECT * FROM BSA_SUB_CUST_FACT WHERE CUSTOMERNO in
(

SELECT DISTINCT s.TS_CUST_ID
FROM (
    SELECT 
        TS_CUST_ID,
        COUNT(DISTINCT SK_CUST_ID) AS SK_COUNT
    FROM BANCS_SK_CUST_INFO
    GROUP BY TS_CUST_ID
    HAVING COUNT(DISTINCT SK_CUST_ID) > 1
) t
JOIN BANCS_SK_CUST_INFO s ON t.TS_CUST_ID = s.TS_CUST_ID
WHERE SK_COUNT > '6'
) AND IsSARFiled != '0'


