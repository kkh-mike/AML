✅ 問題診斷與修正
錯誤原因： SQL Server 不支援 NULLS FIRST（這是 PostgreSQL 的語法）。 你目前的資料庫是 SQL Server，所以 ORDER BY ... NULLS FIRST 會報錯。

修正後的完整查詢（直接複製執行）
WITH multi_sk AS (
    SELECT 
        TS_CUST_ID,
        COUNT(DISTINCT SK_CUST_ID) AS sk_count
    FROM BANCS_SK_CUST_INFO
    GROUP BY TS_CUST_ID
    HAVING COUNT(DISTINCT SK_CUST_ID) > 1
),

sar_nonzero AS (
    SELECT DISTINCT CUSTOMERNO AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT
    WHERE IsSARFiled != '0'
),

problematic_ts AS (
    SELECT m.TS_CUST_ID
    FROM multi_sk m
    INNER JOIN sar_nonzero s ON m.TS_CUST_ID = s.TS_CUST_ID
),

related_sk AS (
    SELECT DISTINCT 
        s.TS_CUST_ID,
        s.SK_CUST_ID AS customer_identifier
    FROM BANCS_SK_CUST_INFO s
    INNER JOIN problematic_ts p ON s.TS_CUST_ID = p.TS_CUST_ID
),

related_cif AS (
    SELECT DISTINCT CIF_KEY
    FROM Customer_Migrate_buffer
    WHERE customerNo IN (SELECT customer_identifier FROM related_sk)
)

-- ====================== 最終查詢：IsSARFiled 分布 ======================
SELECT 
    IsSARFiled,
    COUNT(*) AS record_count,
    COUNT(DISTINCT CIF_KEY) AS affected_cif_count
FROM Cust_NP_Migrate_buffer
WHERE CIF_KEY IN (SELECT CIF_KEY FROM related_cif)
GROUP BY IsSARFiled
ORDER BY 
    CASE WHEN IsSARFiled IS NULL THEN 0 ELSE 1 END,   -- NULL 排最前面
    IsSARFiled;

如果想先看問題客戶清單（建議先跑這段確認有沒有資料）
把上面 WITH ... related_cif 的部分保留，然後改用下面這段：
-- 先看有多少問題的 TS_CUST_ID
SELECT 
    p.TS_CUST_ID,
    m.sk_count
FROM problematic_ts p
INNER JOIN multi_sk m ON p.TS_CUST_ID = m.TS_CUST_ID
ORDER BY m.sk_count DESC, p.TS_CUST_ID;

