以下是針對你需求的兩個優化版本：
1. 分布檢查版（加上「我要檢查的總數量」）
WITH multi_sk AS (
    SELECT TS_CUST_ID, COUNT(DISTINCT SK_CUST_ID) AS sk_count
    FROM BANCS_SK_CUST_INFO
    GROUP BY TS_CUST_ID
    HAVING COUNT(DISTINCT SK_CUST_ID) > 1
),
sar_nonzero AS (
    SELECT DISTINCT CUSTOMERNO AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT
    WHERE IsSARFiled != '0'
),
problematic_ts AS (
    SELECT m.TS_CUST_ID FROM multi_sk m
    INNER JOIN sar_nonzero s ON m.TS_CUST_ID = s.TS_CUST_ID
),
related_sk AS (
    SELECT DISTINCT s.TS_CUST_ID, s.SK_CUST_ID AS customer_identifier
    FROM BANCS_SK_CUST_INFO s
    INNER JOIN problematic_ts p ON s.TS_CUST_ID = p.TS_CUST_ID
),
related_cif AS (
    SELECT DISTINCT CIF_KEY
    FROM Customer_Migrate_buffer
    WHERE customerNo IN (SELECT customer_identifier FROM related_sk)
)
-- ====================== 分布 + 總檢查數量 ======================
SELECT 
    IsSARFiled                  AS [IsSARFiled 值],
    COUNT(*)                    AS [筆數],
    COUNT(DISTINCT CIF_KEY)     AS [受影響 CIF 數量]
FROM Cust_NP_Migrate_buffer
WHERE CIF_KEY IN (SELECT CIF_KEY FROM related_cif)
GROUP BY IsSARFiled

UNION ALL

SELECT 
    '=== 總檢查數量 ==='        AS [IsSARFiled 值],
    COUNT(*)                    AS [筆數],
    COUNT(DISTINCT CIF_KEY)     AS [受影響 CIF 數量]
FROM Cust_NP_Migrate_buffer
WHERE CIF_KEY IN (SELECT CIF_KEY FROM related_cif)
ORDER BY [IsSARFiled 值];
這樣執行後，最後會多一行顯示「=== 總檢查數量 ===」，告訴你這次總共檢查了多少筆資料。

2. 違規明細版（加上「有違規的有幾個」）
WITH multi_sk AS (
    SELECT TS_CUST_ID, COUNT(DISTINCT SK_CUST_ID) AS sk_count
    FROM BANCS_SK_CUST_INFO
    GROUP BY TS_CUST_ID
    HAVING COUNT(DISTINCT SK_CUST_ID) > 1
),
sar_nonzero AS (
    SELECT DISTINCT CUSTOMERNO AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT
    WHERE IsSARFiled != '0'
),
problematic_ts AS (
    SELECT m.TS_CUST_ID FROM multi_sk m
    INNER JOIN sar_nonzero s ON m.TS_CUST_ID = s.TS_CUST_ID
),
related_sk AS (
    SELECT DISTINCT s.TS_CUST_ID, s.SK_CUST_ID AS customer_identifier
    FROM BANCS_SK_CUST_INFO s
    INNER JOIN problematic_ts p ON s.TS_CUST_ID = p.TS_CUST_ID
),
related_cif AS (
    SELECT DISTINCT CIF_KEY
    FROM Customer_Migrate_buffer
    WHERE customerNo IN (SELECT customer_identifier FROM related_sk)
)
SELECT 
    p.TS_CUST_ID             AS [TS_CUST_ID],
    rs.customer_identifier   AS [SK_CUST_ID_or_CustomerNo],
    c.CIF_KEY                AS [CIF_KEY],
    np.IsSARFiled            AS [IsSARFiled 值],
    COUNT(*) OVER (PARTITION BY p.TS_CUST_ID) AS [該TS的一對多總筆數]
FROM Cust_NP_Migrate_buffer np
INNER JOIN Customer_Migrate_buffer c ON np.CIF_KEY = c.CIF_KEY
INNER JOIN related_sk rs ON c.customerNo = rs.customer_identifier
INNER JOIN problematic_ts p ON rs.TS_CUST_ID = p.TS_CUST_ID
WHERE np.IsSARFiled IS NOT NULL 
  AND np.IsSARFiled NOT IN ('0', '1')
ORDER BY np.IsSARFiled, p.TS_CUST_ID, rs.customer_identifier;
如果想同時看到違規總數，可以用下面這個總結版（推薦）：
WITH ... (同上面到 related_cif 的 CTE) 
SELECT 
    COUNT(*) AS [違規總筆數],
    COUNT(DISTINCT p.TS_CUST_ID) AS [違規 TS_CUST_ID 數量],
    COUNT(DISTINCT c.CIF_KEY) AS [違規 CIF 數量]
FROM Cust_NP_Migrate_buffer np
INNER JOIN Customer_Migrate_buffer c ON np.CIF_KEY = c.CIF_KEY
INNER JOIN related_sk rs ON c.customerNo = rs.customer_identifier
INNER JOIN problematic_ts p ON rs.TS_CUST_ID = p.TS_CUST_ID
WHERE np.IsSARFiled IS NOT NULL 
  AND np.IsSARFiled NOT IN ('0', '1');

使用建議：
	1	先執行第1個（分布 + 總檢查數量）
	2	如果有違規，再執行違規明細或違規總結
