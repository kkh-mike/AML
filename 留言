TC06 下次審查日驗證
情境3：共有戶
新光風險等級 > 台新風險等級
取較近的 Review Date
預期結果，採用兩邊較近日期。



WITH 
Shared_Cust AS (
    -- 嚴格共有戶：同時存在於台新與新光
    SELECT b.CustomerNo AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
),

Shared_Review AS (
    SELECT 
        c.TS_CUST_ID,
        b.HIGHRISK AS BSA_HIGHRISK,
        v.HIGHRISK AS VERIFY_HIGHRISK,
        b.NXTRVDT AS BSA_NXTRVDT,
        v.NXTRVDT AS VERIFY_NXTRVDT,
        e.ReviewDt AS EDD_ReviewDt,

        -- 風險等級轉換
        CASE b.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END AS BSA_RiskLevel,
        CASE v.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END AS VERIFY_RiskLevel,

        -- 是否需要取兩邊較近日期
        CASE WHEN 
            CASE v.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END 
            > 
            CASE b.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END 
        THEN '是' ELSE '否' END AS Should_Take_Min_Date

    FROM Shared_Cust c
    INNER JOIN BSA_SUB_CUST_FACT b ON c.TS_CUST_ID = b.CustomerNo
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
)

-- ==================== 明細資料 ====================
SELECT 
    TS_CUST_ID,
    BSA_HIGHRISK,
    VERIFY_HIGHRISK,
    Should_Take_Min_Date,
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,
    
    -- 兩邊較近的日期（較早）
    (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt)) AS Min_of_Both,

    -- 驗證結果
    CASE 
        WHEN Should_Take_Min_Date = '是' 
             AND EDD_ReviewDt = (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt)) 
            THEN '? PASS（正確取兩邊較近日期）'
        WHEN Should_Take_Min_Date = '否' 
             AND EDD_ReviewDt = BSA_NXTRVDT 
            THEN '? PASS（正確取台新日期）'
        ELSE '? FAIL'
    END AS Validation_Result

FROM Shared_Review
ORDER BY Should_Take_Min_Date DESC, Validation_Result DESC, TS_CUST_ID;


