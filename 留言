SELECT * FROM EDD_ReviewSchedule

-- 純台新
SELECT CustomerNo
FROM VERIFY..BSA_SUB_CUST_FACT
EXCEPT
SELECT CustomerNo
FROM BSA_SUB_CUST_FACT a
JOIN CIF_Migrate_Mapping_TEMP b    ON a.cif_key = b.NEW_CIF_KEY


-- 純新光
SELECT TS_CUST_ID FROM BANCS_SK_CUST_INFO WHERE CUST_RE_NO_FLG = '1'
EXCEPT
SELECT TS_CUST_ID FROM BANCS_SK_CUST_INFO WHERE CUST_RE_NO_FLG IN ('2','3')


--共有戶
WITH CUST_LIST AS
(
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO
    WHERE CUST_RE_NO_FLG = '1'
    EXCEPT
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO
    WHERE CUST_RE_NO_FLG IN ('2','3')
)
SELECT
    c.TS_CUST_ID,
    b.CustomerNo AS BSA_CustomerNo,
    v.CustomerNo AS VERIFY_CustomerNo
FROM CUST_LIST c
LEFT JOIN BSA_SUB_CUST_FACT b    ON c.TS_CUST_ID = b.CustomerNo
LEFT JOIN VERIFY..BSA_SUB_CUST_FACT v    ON c.TS_CUST_ID = v.CustomerNo
WHERE b.CustomerNo is not null 
