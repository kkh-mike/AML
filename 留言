是的，可以寫得更簡潔清楚一點！
以下是簡化版，我把它拆成幾個 CTE，讓邏輯更易讀，也方便你分段驗證。
推薦寫法（簡潔版）
WITH 
-- 1. 共有戶
Shared_Cust AS (
    SELECT b.CustomerNo AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
),

-- 2. 共有戶審查資訊 + 風險等級轉換
Shared_Review AS (
    SELECT 
        c.TS_CUST_ID,
        b.HIGHRISK AS BSA_HIGHRISK,
        v.HIGHRISK AS VERIFY_HIGHRISK,
        b.NXTRVDT AS BSA_NXTRVDT,
        v.NXTRVDT AS VERIFY_NXTRVDT,
        e.ReviewDt AS EDD_ReviewDt,

        -- 風險等級數字化
        CASE b.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END AS BSA_Risk,
        CASE v.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END AS VERIFY_Risk
    FROM Shared_Cust c
    JOIN BSA_SUB_CUST_FACT b ON c.TS_CUST_ID = b.CustomerNo
    JOIN VERIFY..BSA_SUB_CUST_FACT v ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
)

-- ==================== 最終驗證 ====================
SELECT 
    TS_CUST_ID,
    BSA_HIGHRISK,
    VERIFY_HIGHRISK,
    BSA_Risk,
    VERIFY_Risk,
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,

    -- 預期應採用的日期（情境3：新光風險較高 → 取較近日期）
    CASE 
        WHEN VERIFY_Risk > BSA_Risk 
            THEN (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
        ELSE BSA_NXTRVDT 
    END AS Expected_ReviewDt,

    -- 驗證結果
    CASE 
        WHEN VERIFY_Risk > BSA_Risk AND EDD_ReviewDt = (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN 'PASS（正確取兩邊較近日期）'
        WHEN VERIFY_Risk <= BSA_Risk AND EDD_ReviewDt = BSA_NXTRVDT
            THEN 'PASS（正確取台新日期）'
        ELSE 'FAIL'
    END AS Validation_Result

FROM Shared_Review
ORDER BY VERIFY_Risk DESC, BSA_Risk DESC, TS_CUST_ID;

更簡潔的另一種寫法（推薦用這個）
如果想再簡短一點，可以直接在 SELECT 裡算 Expected_ReviewDt：
WITH 
Shared_Cust AS (
    SELECT b.CustomerNo AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
)
SELECT 
    b.CustomerNo AS TS_CUST_ID,
    b.HIGHRISK AS BSA_HIGHRISK,
    v.HIGHRISK AS VERIFY_HIGHRISK,
    b.NXTRVDT AS BSA_NXTRVDT,
    v.NXTRVDT AS VERIFY_NXTRVDT,
    e.ReviewDt AS EDD_ReviewDt,

    CASE 
        WHEN CASE v.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END 
             > 
             CASE b.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END 
        THEN LEAST(b.NXTRVDT, v.NXTRVDT)           -- SQL Server 2022+ 可用 LEAST
        ELSE b.NXTRVDT 
    END AS Expected_ReviewDt,

    CASE 
        WHEN EDD_ReviewDt = 
             CASE 
                 WHEN CASE v.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END 
                      > CASE b.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END 
                 THEN LEAST(b.NXTRVDT, v.NXTRVDT)
                 ELSE b.NXTRVDT 
             END 
        THEN 'PASS'
        ELSE 'FAIL'
    END AS Validation_Result

FROM Shared_Cust c
JOIN BSA_SUB_CUST_FACT b ON c.TS_CUST_ID = b.CustomerNo
JOIN VERIFY..BSA_SUB_CUST_FACT v ON c.TS_CUST_ID = v.CustomerNo
LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
ORDER BY Validation_Result DESC, TS_CUST_ID;

小建議：
	1	如果你的 SQL Server 版本 ≥ 2022，強烈建議用 LEAST()，會比 VALUES 那種寫法乾淨很多。
	2	如果版本較舊，就用第一個版本的寫法（比較清楚）。
	3	你可以先跑 Shared_Review 這個 CTE 單獨檢查資料，再跑最終驗證，方便除錯。
