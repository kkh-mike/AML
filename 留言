更安全的寫法（推薦先檢查）
-- 1. 先查詢確認資料
SELECT 
    CIF_KEY, 
    CUST_NME, 
    RecordStatus, 
    CLOSED_DTE,
    CustomerNo
FROM PB_CUSTOMER_FACT 
WHERE CUST_NME LIKE '%DOMA CHIN%' 
   OR CustomerNo = 'JENCH01SC';

-- 2. 確認沒問題後再執行 UPDATE
BEGIN TRANSACTION;

UPDATE PB_CUSTOMER_FACT
SET 
    RecordStatus = 'C',                    -- 請確認系統中 CLOSE 的實際代碼（可能是 'C' 或 'CLOSE'）
    CLOSED_DTE = '2026-04-24',
    PRCS_DTE = GETDATE()
WHERE CustomerNo = 'JENCH01SC';            -- 用 ID 最精準

COMMIT TRANSACTION;  -- 成功後 commit
-- ROLLBACK TRANSACTION; -- 如果有問題就 rollback

注意事項：
	1	RecordStatus 的值：請確認你系統中「CLOSE」的實際儲存值（可能是 'C'、'CLOSE'、'Closed' 等）。
	2	CIF_KEY 是 uniqueidentifier，主鍵最準確。
	3	日期格式：民國115年4月24日 → 西元 2026-04-24。
	4	建議先 SELECT 確認再 UPDATE，並使用 Transaction 保護。

