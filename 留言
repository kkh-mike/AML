WITH Mapping AS (
    SELECT 
        m.NEW_CIF_KEY,
        b.CustomerNo AS TS_CUST_ID,
        b.CIF_KEY AS BSA_CIF_KEY
    FROM CIF_Migrate_Mapping_TEMP m
    INNER JOIN BSA_SUB_CUST_FACT b 
        ON m.NEW_CIF_KEY = b.CIF_KEY
),
Review_Compare AS (
    SELECT 
        m.TS_CUST_ID,
        m.NEW_CIF_KEY,
        m.BSA_CIF_KEY,
        b.ReviewDt AS Buffer_ReviewDt,           -- Cust_NP_Migrate_buffer
        e.ReviewDt AS EDD_ReviewDt,              -- EDD_ReviewSchedule
        CASE 
            WHEN b.ReviewDt IS NULL AND e.ReviewDt IS NULL THEN 0
            WHEN b.ReviewDt IS NULL OR e.ReviewDt IS NULL THEN 1
            WHEN b.ReviewDt <> e.ReviewDt THEN 1 
            ELSE 0 
        END AS ReviewDt_Diff_Flag
    FROM Mapping m
    LEFT JOIN Cust_NP_Migrate_buffer b 
        ON m.BSA_CIF_KEY = b.CIF_KEY
    LEFT JOIN EDD_ReviewSchedule e 
        ON m.NEW_CIF_KEY = e.CIFKey
    WHERE b.ReviewDt IS NOT NULL OR e.ReviewDt IS NOT NULL  -- 至少有一邊有日期
)
SELECT 
    TS_CUST_ID,
    NEW_CIF_KEY,
    BSA_CIF_KEY,
    Buffer_ReviewDt,
    EDD_ReviewDt,
    CASE 
        WHEN Buffer_ReviewDt IS NULL THEN 'Buffer 無日期'
        WHEN EDD_ReviewDt IS NULL THEN 'EDD 無日期'
        ELSE '日期不同'
    END AS Diff_Reason
FROM Review_Compare
WHERE ReviewDt_Diff_Flag = 1
ORDER BY TS_CUST_ID;



