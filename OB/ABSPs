
WITH SOURCE_PEP AS
(
    SELECT
        g.TS_CUST_ID,
        MAX(n.PEPBitwiseCode) AS EXPECT_PEP
    FROM BANCS_SK_CUST_INFO g
    JOIN Customer_Migrate_buffer c        ON c.CustomerNo = g.SK_CUST_ID
    JOIN Cust_NP_Migrate_buffer n        ON n.CIF_KEY = c.CIF_KEY
    WHERE g.CUST_RE_NO_FLG IN (1,2)
    GROUP BY g.TS_CUST_ID
)
SELECT
    s.TS_CUST_ID,
    s.EXPECT_PEP,
    e.PEPBitwiseCode AS ACTUAL_PEP,
    g.SK_CUST_ID,
    c.CIF_KEY
FROM SOURCE_PEP s
JOIN BANCS_SK_CUST_INFO g    ON g.TS_CUST_ID = s.TS_CUST_ID
JOIN Customer_Migrate_buffer c    ON c.CustomerNo = g.SK_CUST_ID
JOIN CIF_Migrate_Mapping_TEMP m    ON m.SOURCE_CIF_KEY = c.CIF_KEY
JOIN BSA_SUB_CUST_FACT_Extension e    ON e.CIF_KEY = m.NEW_CIF_KEY
WHERE s.EXPECT_PEP <> e.PEPBitwiseCode;



