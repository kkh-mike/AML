ALTER VIEW [dbo].[vw_RISKSYS_WBS_CUSTOMER_AO]
AS
/*
使用系統: RISKSYS 風險管理系統
程式名稱: HKDB.dbo.vw_RISKSYS_WBS_CUSTOMER_AO
程式說明: HKWBS 客戶主檔與AO資訊
參考程式: WBS Source: ODSP.ODDBP01.dbo.WBS_VW_COL_FAC_LON / WBS IT: 張書坤
開發人員: RISKSYS IT: 王勝玄 / HKWBS IT: 王盛禾
開發日期: 2021/10/21
修改記錄:
2022/07/11 王勝玄 林佳慧 提案單IT20202202161057 彙整海外分行(新加坡分行、布里斯本分行、東京分行、納閔分行)擔保品(含存款)資訊需求。
           香港分行別BRN_NO欄位值, 由現行代碼0900改為HK。
*/

   SELECT CIF.CIF_CUST_INFO_SEQ,
          CIF.CUSTOMER_ID AS CUST_ID,
          CIF.CUSTOMER_GLOBAL_ID AS CUSTOMER_GLOBAL_ID,
          --CIF.RM1_EMP_ID,
          --CIF.RM1_PCC,
          --CIF.RM2_EMP_ID,
          --CIF.RM2_EMP_PCC,
          SUBSTRING(AO.AO_ID,1,10) AS AO_ID,
          AO.AO_NM,
          AO.EMP_NO,
          AO.PRFT_CNTR
     FROM dbo.WBS_CIF_CUST_INFO CIF
    INNER JOIN dbo.WBS_COM_AO_CUST_REL AOR
     --HKWBS改看GLOBAL_ID
       --ON AOR.CUST_ID = CASE WHEN CIF.ID_TYPE IN (11,12,13) THEN RTRIM(CIF.CUSTOMER_ID) + '0' ELSE CIF.CUSTOMER_ID END
       ON AOR.CUST_ID = CASE WHEN CIF.ID_TYPE IN (11,12,13) THEN RTRIM(CIF.CUSTOMER_GLOBAL_ID) + '0' ELSE CIF.CUSTOMER_ID END
      AND AOR.CUST_ACCT_SYS = 'CIF'
    INNER JOIN dbo.WBS_COM_AO_INFO AO
       ON AO.AO_ID = RTRIM(AOR.AO_ID) AND AO.AO_TYP NOT IN ('AO1P', 'PFMS')
   --HKDB無ODORG.HR_EMP資料表
   --LEFT OUTER JOIN ODORG.HR_EMP HR ON HR.EMP_ID = TRIM(AO.EMP_NO) AND HR.JOB_STATUS = '1'

