
你的需求可以拆成兩個部分：

1. 找出同一個 TS_CUST_ID 同時存在 CUST_RE_NO_FLG = 1 跟 2 的資料。
2. 確認最後寫入的 PEPBitwiseCode 是否取了較嚴格(較大或不同)的那筆。

如果只是要先找出來源 (Cust_NP_Migrate_buffer) 有不同 PEPBitwiseCode 的 TS_CUST_ID，可以直接這樣寫：

WITH TS_LIST AS
(
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO
    WHERE CUST_RE_NO_FLG IN (1,2)
    GROUP BY TS_CUST_ID
    HAVING COUNT(DISTINCT CUST_RE_NO_FLG) = 2
)
SELECT
    g.TS_CUST_ID,
    COUNT(DISTINCT n.PEPBitwiseCode) AS PEP_CNT,
    MIN(n.PEPBitwiseCode) AS MIN_PEP,
    MAX(n.PEPBitwiseCode) AS MAX_PEP
FROM TS_LIST t
JOIN BANCS_SK_CUST_INFO g
    ON g.TS_CUST_ID = t.TS_CUST_ID
JOIN Customer_Migrate_buffer c
    ON c.CustomerNo = g.SK_CUST_ID
JOIN Cust_NP_Migrate_buffer n
    ON n.CIF_KEY = c.CIF_KEY
GROUP BY g.TS_CUST_ID
HAVING COUNT(DISTINCT n.PEPBitwiseCode) > 1;

