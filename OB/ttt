@echo off
chcp 65001 >nul

echo ===================================================
echo   SQL Server BCP CSV Export (Quoted UTF-8 CSV)
echo ===================================================
echo.

:: ===============================
:: Connection / Parameter
:: ===============================
set SERVER=amlist
set DB=BSADBTW
set TABLE=dbo.Customer_Migrate_buffer_uat202607

set USER=aml
set PASS=aml1234

set OUTDIR=D:\AML_Source\Source\1141923
set FINAL_CSV=%OUTDIR%\SK_CIF.csv

if not exist "%OUTDIR%" (
    mkdir "%OUTDIR%"
)


echo [1/3] Generate Header...

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$conn = New-Object System.Data.SqlClient.SqlConnection('Server=%SERVER%;Database=%DB%;User Id=%USER%;Password=%PASS%;'); ^
$conn.Open(); ^
$cmd = $conn.CreateCommand(); ^
$cmd.CommandText='SELECT TOP 0 * FROM %TABLE%'; ^
$r=$cmd.ExecuteReader(); ^
$cols=(0..($r.FieldCount-1) | ForEach-Object { '"' + $r.GetName($_) + '"' }) -join ','; ^
$conn.Close(); ^
Set-Content '%OUTDIR%\header.csv' $cols -Encoding UTF8"


echo [2/3] Generate SQL Query...


powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$conn = New-Object System.Data.SqlClient.SqlConnection('Server=%SERVER%;Database=%DB%;User Id=%USER%;Password=%PASS%;'); ^
$conn.Open(); ^
$cmd=$conn.CreateCommand(); ^
$cmd.CommandText='SELECT TOP 0 * FROM %TABLE%'; ^
$r=$cmd.ExecuteReader(); ^

$list = (0..($r.FieldCount-1) | ForEach-Object { ^
$name=$r.GetName($_); ^
'CHAR(34)+REPLACE(ISNULL(CAST(['+$name+'] AS NVARCHAR(MAX)),''''),CHAR(34),CHAR(34)+CHAR(34))+CHAR(34) AS ['+$name+']' ^
}) -join ','; ^

$conn.Close(); ^

$sql='SELECT '+$list+' FROM %TABLE%'; ^

Set-Content '%OUTDIR%\export.sql' $sql -Encoding UTF8"


echo [3/3] Export CSV...


sqlcmd ^
-S %SERVER% ^
-d %DB% ^
-U %USER% ^
-P %PASS% ^
-i "%OUTDIR%\export.sql" ^
-o "%OUTDIR%\data.csv" ^
-s "," ^
-W ^
-f 65001


if errorlevel 1 (
    echo.
    echo ===============================
    echo Export Failed
    echo ===============================
    pause
    exit /b 1
)


echo Merge Header + Data...


copy /b "%OUTDIR%\header.csv"+"%OUTDIR%\data.csv" "%FINAL_CSV%" >nul


echo Cleanup...

del "%OUTDIR%\header.csv"
del "%OUTDIR%\data.csv"
del "%OUTDIR%\export.sql"


echo.
echo ===================================================
echo Export Success:
echo %FINAL_CSV%
echo ===================================================

pause