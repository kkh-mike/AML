@echo off
chcp 65001 >nul
echo ===================================================
echo   SQL Server 全欄位自動匯出腳本 (UTF-8 + 正確CSV引號)
echo ===================================================
echo.

:: 連線與路徑參數設定
set SERVER=amlist
set DB=BSADBTW
set TABLE=dbo.Customer_Migrate_buffer_uat202607
set USER=aml
set PASS=aml1234
set OUTDIR=D:\AML_Source\Source\1141923
set FINAL_CSV=%OUTDIR%\SK_CIF.csv

if not exist "%OUTDIR%" (
    mkdir "%OUTDIR%"
)

echo 正在連線資料庫並匯出所有資料（自動處理逗號與雙引號）...
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$ErrorActionPreference = 'Stop'; ^
try { ^
    $connStr = 'Server=%SERVER%;Database=%DB%;User Id=%USER%;Password=%PASS%;'; ^
    $conn = New-Object System.Data.SqlClient.SqlConnection($connStr); ^
    $conn.Open(); ^
    $cmd = $conn.CreateCommand(); ^
    $cmd.CommandTimeout = 0; ^
    $cmd.CommandText = 'SELECT * FROM %TABLE%'; ^
    $adapter = New-Object System.Data.SqlClient.SqlDataAdapter($cmd); ^
    $table = New-Object System.Data.DataTable; ^
    [void]$adapter.Fill($table); ^
    $conn.Close(); ^
    $table | Export-Csv -Path '%FINAL_CSV%' -NoTypeInformation -Encoding UTF8; ^
    Write-Host ''; ^
    Write-Host '==================================================='; ^
    Write-Host ('匯出成功！共 ' + $table.Rows.Count + ' 筆資料'); ^
    Write-Host ('檔案位置：%FINAL_CSV%'); ^
    Write-Host '==================================================='; ^
} catch { ^
    Write-Host ''; ^
    Write-Host '[錯誤] 匯出失敗：' -ForegroundColor Red; ^
    Write-Host $_.Exception.Message -ForegroundColor Red; ^
    exit 1; ^
}"

if errorlevel 1 (
    echo.
    echo 請檢查資料庫連線資訊是否正確。
    pause
    exit /b 1
)

echo.
pause