    CREATE PROC [dbo].[LOAD_PRELOAD_003]  AS  /*  Date  SE   Desc  --------------------------------------------------------------------------  20120525  Steven  FCC CIF mapping    */  declare   @bankNo varchar(10),   @SQLSTR nvarchar(4000),   @OUTPUT_ID varchar(50),   @SUCCEED varchar(1),   @VostroCustNo varchar(50),   @Org varchar(200),   @Org_Id varchar(200),   @Intermediate_Bank_Cust_Prefix varchar(3) = 'IBW',   @TimeKey_Customer varchar(8),   @TimeKey_Account_CASH varchar(8),   @TimeKey_Account_COD varchar(8),   @TimeKey_Account_LOAN varchar(8),   @TimeKey_Account_CCD varchar(8),   @TimeKey_CustomerRP varchar(8),   @DummyBranchNbr varchar(50),   @ModuleName varchar(10) = 'ETL',   @Intermediate_Bank_Wire varchar(30) = 'INTERMEDIATE_BNK_WIRE',   @RP_ID varchar(50),   @RP_TYPE varchar(50)        DECLARE @InterBank_Customer TABLE(  Internal_Cif_Key uniqueidentifier null,  VostroCustNo varchar(50) null,  Cif_Key varchar(50) null,  org_ID varchar(200) null,  org varchar(350) null,  org_ID_Key varchar(200) null,  org_Key varchar(350) null,  Appl varchar(50) null,  Acct_Key varchar(50) null,  CoreSystem varchar(50) null  );            set nocount on    truncate table dbo.CIF_SOURCE  truncate TABLE dbo.CustomerCDDSource  truncate TABLE dbo.CustomerCDDAnswerSource  truncate table dbo.CUSTOMER_RP_SOURCE    truncate table dbo.sav_source  truncate table dbo.dda_source  truncate table dbo.cod_source  truncate table dbo.loan_source  truncate table dbo.trade_source  truncate table dbo.dummy_source  truncate table dbo.CreditCardAccount_Source  truncate table dbo.SafeBoxAccount_Source    truncate table dbo.chk_source  truncate table dbo.trsf_source  truncate table dbo.other_source  truncate table dbo.cash_source  truncate table dbo.wire_source   truncate table dbo.CreditCardTransaction_Source  truncate table dbo.MOITransaction_Source  truncate table dbo.Safebox_Source  truncate table dbo.TRADE_LOC_TRXN_SOURCE  truncate table dbo.TRADE_LOC_PARTIES_TRXN_SOURCE  truncate table dbo.TRADE_LOC_DETAILS_TRXN_SOURCE  truncate table dbo.TRADE_BOL_TRXN_SOURCE  truncate table dbo.TRADE_BOL_DETAILS_TRXN_SOURCE  truncate table dbo.TRADE_INVOICE_TRXN_SOURCE  truncate table dbo.TRADE_INVOICE_DETAILS_TRXN_SOURCE  truncate table dbo.TRADE_LOC_AMENDMENT_TRXN_SOURCE    truncate table dbo.RAW_WIRE_TRXN_IN  truncate table dbo.RAW_WIRE_TRXN_OUT    truncate table dbo.Conductor_Source  truncate table dbo.Relationship_Source    TRUNCATE TABLE dbo.AccountMonthlySummary_Source  TRUNCATE TABLE dbo.ContactPerson_Source  TRUNCATE TABLE dbo.ContactForTransmitter_Source    TRUNCATE TABLE dbo.NewIdCustomerSource    TRUNCATE TABLE dbo.FinancialSpecialist_Source  TRUNCATE TABLE dbo.FSTCustomer_Source    SELECT TOP 1 @TimeKey_Customer = dbo.cvt_date(Processing_Date) FROM dbo.Preload_Customer  SELECT TOP 1 @TimeKey_Account_CASH = dbo.cvt_date(Processing_Date) FROM dbo.RAW_CASH_ACCOUNT  SELECT TOP 1 @TimeKey_Account_COD = dbo.cvt_date(Processing_Date) FROM dbo.SG_FX_TD_CERTIFICATE  SELECT TOP 1 @TimeKey_Account_LOAN = dbo.cvt_date(Processing_Date) FROM dbo.LOAN_LIMIT  SELECT TOP 1 @TimeKey_Account_CCD = dbo.cvt_date(Processing_Date) FROM dbo.RAW_CCARD_ACCOUNT  SELECT TOP 1 @TimeKey_CustomerRP = dbo.cvt_date(Processing_Date) FROM dbo.RAW_CUSTOMER_RP    select @bankNo = dbo.get_BankNumber()    /*Delete duplicated record in exception tables*/  delete from Account_Exception where TimeKey = @TimeKey_Account_CASH and (Appl = 'SAV' or Appl = 'DDA')  delete from Account_Exception where TimeKey = @TimeKey_Account_COD and Appl = 'COD'  delete from Account_Exception where TimeKey = @TimeKey_Account_LOAN and Appl = 'LNA'  delete from Account_Exception where TimeKey = @TimeKey_Account_CCD and Appl = 'CCD'  delete from Customer_Exception where TimeKey = @TimeKey_Customer  delete from Customer_RP_Exception where TimeKey = @TimeKey_CustomerRP    /*20141231 MC, Filter duplicated Record*/  DECLARE @TEMP_Account TABLE(   [CUSTOMER_ID] [nvarchar](50) NULL,   [ACCOUNT_NBR] [nvarchar](50) NULL,   [APPL] [varchar](5) NULL  )    DECLARE @TEMP_Account_Exception TABLE(   [Acct_Key] [varchar](50) NULL,   [Appl] [varchar](5) NULL,   [Cif_Key] [varchar](50) NULL,   [Brnch_Nbr] [varchar](50) NULL,   [Brnch_Desc] [nvarchar](100) NULL,   [Acct_Type_Code] [varchar](50) NULL,   [Acct_Type_Desc] [nvarchar](100) NULL,   [Prmy_Offcr_Nbr] [varchar](50) NULL,   [Prmy_Offcr_Nme] [nvarchar](100) NULL,   [Current_Bal] [decimal](24, 2) NULL,   [Available_Bal] [decimal](24, 2) NULL,   [Date_Open] [varchar](8) NULL,   [Date_Close] [varchar](8) NULL,   [Acct_Status] [varchar](1) NULL,   [OD_Limit_Amt] [decimal](24, 2) NULL,   [Dt_Lst_Acty] [varchar](8) NULL,   [Orig_Loan_Amt] [decimal](24, 2) NULL,/*LOAN*/   [Payoff_Amt] [decimal](24, 2) NULL,/*LOAN*/   [Adv_Capital_Repayment_Amt] [decimal](24, 2) NULL,/*LOAN*/   [Term_Mths] [numeric](5,0) NULL,/*COD,LOAN*/   [Maturity_Dt] [varchar](8) NULL,/*COD,LOAN*/   [Collateral_Flag] [varchar](50) NULL,/*LOAN*/   [Collateral_Code] [varchar](50) NULL,/*LOAN*/   [Collateral_Desc] [varchar](100) NULL,/*LOAN*/   [AccountOpeningMethod] [varchar](50) NULL,   [AccountOpeningMethodDesc] [nvarchar](100) NULL,   [Product_Code] [varchar](100) NULL,   [Product_Desc] [nvarchar](100) NULL,   [AccountPurposeCode] [varchar](50) NULL,   [AccountPurposeDesc] [nvarchar](100) NULL,   [Purpose_Code] [varchar](50) NULL,/*LOAN*/   [Purpose_Desc] [nvarchar](100) NULL,/*LOAN*/   [Past_Due_Amt] [decimal](24, 2) NULL,/*LOAN*/   [Delinquent_Flag] [varchar](1) NULL,/*LOAN*/   [Core_System] [varchar](50) NULL,   [Proc_Date] [varchar](8) NULL,   [Seq] [int] null,   [OverPayment_Amount] [decimal](24, 2) NULL,/*CCD*/   [Current_Cycle_Due_Amount] [decimal](24, 2) NULL,/*CCD*/   [Previous_Cycle_Due_Amount] [decimal](24, 2) NULL,/*CCD*/   [SAR_Exclude_Flag] [int],   [Transfer_Flag] [nchar](1),   [Banking_Acc_Type_Code][varchar](20) NULL     )  /*START CASH ACCOUNT*/    INSERT INTO @TEMP_Account(CUSTOMER_ID,ACCOUNT_NBR,APPL)  SELECT DISTINCT CUSTOMER_ID,ACCOUNT_NBR,dbo.cvt_appl(APPLICATION_CODE)  FROM dbo.RAW_CASH_ACCOUNT A  WHERE dbo.cvt_appl(APPLICATION_CODE) = 'DDA' OR dbo.cvt_appl(APPLICATION_CODE) = 'SAV' OR dbo.cvt_appl(APPLICATION_CODE) = 'TRD'   OR EXISTS (SELECT 1 FROM dbo.BSAPAR5 Z WHERE dbo.cvt_appl(A.APPLICATION_CODE) = Z.APPL AND Z.ACCT_TYPE_REF_APPL = 'ACDMY')  GROUP BY CUSTOMER_ID,ACCOUNT_NBR,dbo.cvt_appl(APPLICATION_CODE) HAVING COUNT(1)>1    INSERT INTO @TEMP_Account_Exception(   [Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],   [Seq],[Banking_Acc_Type_Code]  )  SELECT   LEFT(a.[ACCOUNT_NBR],50),dbo.cvt_appl(LEFT([APPLICATION_CODE],5)),LEFT(a.[CUSTOMER_ID],50),LEFT([BRANCH_NBR],50),LEFT([BRANCH_NAME],100),LEFT([ACCOUNT_TYPE_CODE],50),LEFT([ACCOUNT_TYPE_DESC],100),LEFT([OFFICER_NBR],50),   LEFT([OFFICER_NAME],100),CASE WHEN ISNULL([CURRENT_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[CURRENT_BALANCE]) END,CASE WHEN ISNULL([AVAILABLE_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[AVAILABLE_BALANCE]) END,dbo.cvt_date(OPENING_DATE),dbo.cvt_date(CLOSED_DATE),LEFT([ACCOUNT_STATUS],1),CASE WHEN ISNULL([OVERDRAFT_LIMIT],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[OVERDRAFT_LIMIT]) END,   dbo.cvt_date(DATE_OF_LAST_ACTIVITY),dbo.cvt_methodOfOpeningAccount(LEFT([OPENING_METHOD_CODE],50)),LEFT([OPENING_METHOD_DESC],100),LEFT([PRODUCT_CODE],100),LEFT([PRODUCT_DESC],100),   LEFT([ACCOUNT_PURPOSE_CODE],50),LEFT([ACCOUNT_PURPOSE_DESC],100),LEFT([CORE_SYSTEM],50),dbo.cvt_date(PROCESSING_DATE),   dbo.cvt_SARFlag(SAR_EXCLUDE_FLAG),CASE WHEN TRANSFER_FLAG in ('Y','N') THEN TRANSFER_FLAG ELSE NULL END,   ROW_NUMBER() over (PARTITION BY a.CUSTOMER_ID,a.ACCOUNT_NBR,dbo.cvt_appl(a.APPLICATION_CODE) ORDER BY a.CUSTOMER_ID,a.ACCOUNT_NBR,a.ACCOUNT_STATUS),   LEFT([Banking_Acc_Type_Code],20)  from dbo.RAW_CASH_ACCOUNT a, @TEMP_Account b  WHERE a.[CUSTOMER_ID] = b.[CUSTOMER_ID] AND a.[ACCOUNT_NBR] = b.[ACCOUNT_NBR] AND dbo.cvt_appl(a.APPLICATION_CODE) = b.APPL    INSERT INTO dbo.Account_Exception(   [Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],      [TimeKey],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  )  SELECT   [Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],      @TimeKey_Account_CASH,[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  from @TEMP_Account_Exception    --load dda account   INSERT INTO dbo.dda_source(   [Bnk_Nbr],[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  )  SELECT   @bankNo,LEFT(a.[ACCOUNT_NBR],50),dbo.cvt_appl(LEFT([APPLICATION_CODE],5)),LEFT(a.[CUSTOMER_ID],50),LEFT([BRANCH_NBR],50),LEFT([BRANCH_NAME],100),LEFT([ACCOUNT_TYPE_CODE],50),LEFT([ACCOUNT_TYPE_DESC],100),LEFT([OFFICER_NBR],50),   LEFT([OFFICER_NAME],100),CASE WHEN ISNULL([CURRENT_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[CURRENT_BALANCE]) END,CASE WHEN ISNULL([AVAILABLE_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[AVAILABLE_BALANCE]) END,dbo.cvt_date(OPENING_DATE),dbo.cvt_date(CLOSED_DATE),LEFT([ACCOUNT_STATUS],1),CASE WHEN ISNULL([OVERDRAFT_LIMIT],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[OVERDRAFT_LIMIT]) END,   dbo.cvt_date(DATE_OF_LAST_ACTIVITY),dbo.cvt_methodOfOpeningAccount(LEFT([OPENING_METHOD_CODE],50)),LEFT([OPENING_METHOD_DESC],100),LEFT([PRODUCT_CODE],100),LEFT([PRODUCT_DESC],100),   LEFT([ACCOUNT_PURPOSE_CODE],50),LEFT([ACCOUNT_PURPOSE_DESC],100),LEFT([CORE_SYSTEM],50),dbo.cvt_date(PROCESSING_DATE),   dbo.cvt_SARFlag(SAR_EXCLUDE_FLAG),CASE WHEN TRANSFER_FLAG in ('Y','N') THEN TRANSFER_FLAG ELSE NULL END,   LEFT([Banking_Acc_Type_Code],20)  from dbo.RAW_CASH_ACCOUNT a  WHERE NOT EXISTS(SELECT 1 from @TEMP_Account b where a.[CUSTOMER_ID] = b.[CUSTOMER_ID] AND a.[ACCOUNT_NBR] = b.[ACCOUNT_NBR] AND dbo.cvt_appl(a.[APPLICATION_CODE]) = b.APPL) AND dbo.cvt_appl(APPLICATION_CODE) = 'DDA'    INSERT INTO dbo.dda_source(   [Bnk_Nbr],[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  )  SELECT   @bankNo,[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  from @TEMP_Account_Exception  WHERE Seq = 1 AND Appl = 'DDA'    --load saving account  insert into dbo.sav_source(      [Bnk_Nbr],[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  )  select    @bankNo,LEFT(a.[ACCOUNT_NBR],50),dbo.cvt_appl(LEFT([APPLICATION_CODE],5)),LEFT(a.[CUSTOMER_ID],50),LEFT([BRANCH_NBR],50),LEFT([BRANCH_NAME],100),LEFT([ACCOUNT_TYPE_CODE],50),LEFT([ACCOUNT_TYPE_DESC],100),LEFT([OFFICER_NBR],50),   LEFT([OFFICER_NAME],100),CASE WHEN ISNULL([CURRENT_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[CURRENT_BALANCE]) END,CASE WHEN ISNULL([AVAILABLE_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[AVAILABLE_BALANCE]) END,dbo.cvt_date(OPENING_DATE),dbo.cvt_date(CLOSED_DATE),LEFT([ACCOUNT_STATUS],1),CASE WHEN ISNULL([OVERDRAFT_LIMIT],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[OVERDRAFT_LIMIT]) END,   dbo.cvt_date(DATE_OF_LAST_ACTIVITY),dbo.cvt_methodOfOpeningAccount(LEFT([OPENING_METHOD_CODE],50)),LEFT([OPENING_METHOD_DESC],100),LEFT([PRODUCT_CODE],100),LEFT([PRODUCT_DESC],100),   LEFT([ACCOUNT_PURPOSE_CODE],50),LEFT([ACCOUNT_PURPOSE_DESC],100),LEFT([CORE_SYSTEM],50),dbo.cvt_date(PROCESSING_DATE),   dbo.cvt_SARFlag(SAR_EXCLUDE_FLAG),CASE WHEN TRANSFER_FLAG in ('Y','N') THEN TRANSFER_FLAG ELSE NULL END,   LEFT([Banking_Acc_Type_Code],20)  FROM dbo.RAW_CASH_ACCOUNT a  WHERE NOT EXISTS(SELECT 1 from @TEMP_Account b where a.[CUSTOMER_ID] = b.[CUSTOMER_ID] AND a.[ACCOUNT_NBR] = b.[ACCOUNT_NBR] AND dbo.cvt_appl(a.[APPLICATION_CODE]) = b.APPL) AND dbo.cvt_appl(APPLICATION_CODE) = 'SAV'    insert into dbo.sav_source(   [Bnk_Nbr],[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  )  select    @bankNo,[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  FROM @TEMP_Account_Exception   WHERE Seq = 1 AND Appl = 'SAV'    --load trade account   INSERT INTO dbo.trade_source(   [Bnk_Nbr],[Acct_Key],[Appl],[Cif_Key],[Brnch_Nbr],[Brnch_Desc],[Acct_Type_Code],[Acct_Type_Desc],[Prmy_Offcr_Nbr],   [Prmy_Offcr_Nme],[Current_Bal],[Available_Bal],[Date_Open],[Date_Close],[Acct_Status],[OD_Limit_Amt],   [Dt_Lst_Acty],[AccountOpeningMethod],[AccountOpeningMethodDesc],[Product_Code],[Product_Desc],   [AccountPurposeCode],[AccountPurposeDesc],[Core_System],[Proc_Date],[SAR_Exclude_Flag],[Transfer_Flag],[Banking_Acc_Type_Code]  )  SELECT   @bankNo,LEFT(a.[ACCOUNT_NBR],50),dbo.cvt_appl(LEFT([APPLICATION_CODE],5)),LEFT(a.[CUSTOMER_ID],50),LEFT([BRANCH_NBR],50),LEFT([BRANCH_NAME],100),LEFT([ACCOUNT_TYPE_CODE],50),LEFT([ACCOUNT_TYPE_DESC],100),LEFT([OFFICER_NBR],50),   LEFT([OFFICER_NAME],100),CASE WHEN ISNULL([CURRENT_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[CURRENT_BALANCE]) END,CASE WHEN ISNULL([AVAILABLE_BALANCE],'') = '' THEN 0 ELSE CONVERT(DECIMAL(24,2),[AVAILABLE_BALANCE]) END,dbo.cvt_date(OPENING_DATE),dbo.cvt_date(CLOSED_DA