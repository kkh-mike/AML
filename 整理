-- 建立對照用 CTE（抓出日本 OFAC_SPEC 已存在的資料）
;WITH TempNUM AS (
    SELECT A.spec_name, A.updated_date, A.remark, A.TaxID, A.IDENT, A.IDENTO, A.TaxIDCD, A.IDNUM,
           A.issBy, A.DInd, A.creUserID, A.STATE, A.ADDRESS, A.COUNTRY, A.GROUPID, A.SOURCE,
           A.EnterFlag, A.ApprovedBy, A.ApprovedDate, A.DelUserID, A.DelDate, A.ApproveDelUserID,
