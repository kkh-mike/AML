WITH  PURE_TS AS
(
	SELECT TS_CUST_ID FROM BANCS_SK_CUST_INFO a JOIN Customer_Migrate_buffer b on a.SK_CUST_ID = b.CustomerNo
	WHERE a.CUST_RE_NO_FLG  = '1'
	EXCEPT
	SELECT TS_CUST_ID FROM BANCS_SK_CUST_INFO a JOIN Customer_Migrate_buffer b on a.SK_CUST_ID = b.CustomerNo
	WHERE a.CUST_RE_NO_FLG IN ('2','3')
)
SELECT a.HIGHRISK ,u.HIGHRISK  FROM BSA_SUB_CUST_FACT a
JOIN PURE_TS d on d.TS_CUST_ID = a.customerno
JOIN CIF_Migrate_Mapping_TEMP h on h.NEW_CIF_KEY = a.CIF_KEY
JOIN Cust_NP_Migrate_buffer t on t.CIF_KEY = h.SOURCE_CIF_KEY
JOIN VERIFY..BSA_SUB_CUST_FACT u on u.CIF_KEY = a.CIF_KEY
WHERE a.HIGHRISK != u.HIGHRISK


