-- 取得 Dow Jones Sanctions 清單
INSERT INTO #tempDJBlacklistSID_JP (EntNum, IdentificationType, IdentificationNumber, UpdatedDate)
SELECT 
    A.EntityId, D.IdentificationType, D.IdentificationNumber, MAX(C.UpdatedDate)
FROM BSADB.dbo.DJ_Entity A
