USE BSADBTW

-- 202112 PEP,HIGHRISK,TOT_CNT
SELECT BRNCH_NBR,BRNCH_DESC,SUM(PEP_CNT) AS PEP_CNT, SUM(HIGHRISK) AS HIGHRISK, SUM(TOT_CNT) AS TOT_CNT   FROM 
(
 SELECT BRNCH_NBR,BRNCH_DESC, COUNT(1) AS PEP_CNT,0 AS HIGHRISK, 0 AS TOT_CNT FROM
(
 SELECT  '_'+A.BRNCH_NBR AS BRNCH_NBR,L.BRNCH_DESC
 FROM BSADBTW..PB_CUSTOMER_FACT A  WITH (NOLOCK)  
INNER JOIN BSADBTW..BSA_SUB_CUST_FACT B  WITH (NOLOCK)  ON A.CIF_KEY = B.CIF_KEY
LEFT JOIN BSADBTW..BRANCH_DIM L ON A.BRNCH_NBR = L.BRNCH_NBR
LEFT JOIN (
SELECT CIF_KEY,IsBearerShares,
CASE WHEN PEPBitwiseCode & 1=1 THEN 'Y' ELSE 'N' END BlackList,
CASE WHEN PEPBitwiseCode & 2=2 THEN 'Y' ELSE 'N' END PEP,
CASE WHEN PEPBitwiseCode & 8=8 THEN 'Y' ELSE 'N' END ForeignPEP,
CASE WHEN PEPBitwiseCode & 16=16 THEN 'Y' ELSE 'N' END LocalPEP,
CASE WHEN PEPBitwiseCode & 32=32 THEN 'Y' ELSE 'N' END ForeignOrgPEP,
CASE WHEN PEPBitwiseCode & 64=64 THEN 'Y' ELSE 'N' END ExPEP,
CASE WHEN PEPBitwiseCode & 128=128 THEN 'Y' ELSE 'N' END CustRPIsPEP ,
CASE WHEN PEPBitwiseCode & 4=4 THEN 'Y' ELSE 'N' END NN
FROM BSADBTW..BSA_SUB_CUST_FACT_Extension
 ) F ON B.CIF_KEY = F.CIF_KEY
WHERE A.RecordStatus='O'  AND b.CUSTOMERLEVEL <> 2
 AND F.pep = 'Y'
 ) A
 GROUP BY A.BRNCH_NBR,BRNCH_DESC
UNION ALL
 SELECT BRNCH_NBR,BRNCH_DESC,0  AS PEP_CNT,COUNT(1) AS HIGHRISK,0 AS TOT_CNT FROM
(
 SELECT  '_'+A.BRNCH_NBR AS BRNCH_NBR,L.BRNCH_DESC
 FROM BSADBTW..PB_CUSTOMER_FACT A  WITH (NOLOCK)  
INNER JOIN BSADBTW..BSA_SUB_CUST_FACT B  WITH (NOLOCK)  ON A.CIF_KEY = B.CIF_KEY
LEFT JOIN BSADBTW..BRANCH_DIM L ON A.BRNCH_NBR = L.BRNCH_NBR
WHERE A.RecordStatus='O'  AND b.CUSTOMERLEVEL <> 2
 AND B.HIGHRISK ='H' 
 ) A
 GROUP BY A.BRNCH_NBR,BRNCH_DESC
UNION ALL
  SELECT BRNCH_NBR,BRNCH_DESC,0  AS PEP_CNT, 0 AS HIGHRISK,COUNT(1) AS TOT_CNT FROM
(
 SELECT  '_'+A.BRNCH_NBR AS BRNCH_NBR,L.BRNCH_DESC
 FROM BSADBTW..PB_CUSTOMER_FACT A  WITH (NOLOCK)  
INNER JOIN BSADBTW..BSA_SUB_CUST_FACT B  WITH (NOLOCK)  ON A.CIF_KEY = B.CIF_KEY
LEFT JOIN BSADBTW..BRANCH_DIM L ON A.BRNCH_NBR = L.BRNCH_NBR
WHERE A.RecordStatus='O'  AND b.CUSTOMERLEVEL <> 2
 ) A
 GROUP BY A.BRNCH_NBR,BRNCH_DESC
) C
 GROUP BY C.BRNCH_NBR,BRNCH_DESC
 ORDER BY C.BRNCH_NBR,BRNCH_DESC
