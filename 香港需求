    IF OBJECT_ID('tempdb..#tempDJBlacklistDetailsSID_GL') IS NOT NULL DROP TABLE #tempDJBlacklistDetailsSID_GL

    CREATE TABLE #tempDJBlacklistSID_GL (...) 
    CREATE TABLE #tempDJBlacklistDetailsSID_GL (...)

    INSERT INTO #tempDJBlacklistSID_GL (...)
    SELECT ...   --（你的查詢保持不變）

    ;WITH TempNUM AS (SELECT ... FROM BSADB.dbo.OFAC_GLSpec WHERE GROUPID = @GroupId AND DInd = 'N')
    INSERT INTO #tempDJBlacklistDetailsSID_GL (...)
    SELECT ...

    -- Sanctions IDs 區塊使用 @MAXNo（不再 DECLARE）
    SELECT @MAXNo = ISNULL(MAX(ent_num), 0) 
    FROM BSADB.dbo.OFAC_GLSpec 
    WHERE GROUPID = @GroupId

    UPDATE #tempDJBlacklistDetailsSID_GL
    SET @MAXNo = @MAXNo + 1, Num = @MAXNo
    WHERE Num IS NULL

    ;WITH TargetTable AS (SELECT ... FROM BSADB.dbo.OFAC_GLSpec WHERE GROUPID = @GroupId)
    MERGE TargetTable T
    USING (...) S
