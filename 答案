✅ TC06 下次審查日驗證 — 完整詳細版
我已根據你 GitHub BSADBTW 目錄下的最新 Markdown 表格（BSA_SUB_CUST_FACT 和 PB_CUSTOMER_FACT）整理出最詳細、可直接執行的 SQL。
1. 驗證邏輯總結（非常詳細）
	•	純台新客戶：使用台新系統（BSA / PB）的 NXTRVDT 或 EDD_ReviewSchedule.ReviewDt
	•	純新光客戶：使用新光系統的下審日
	•	共有戶（同時存在台新 + 新光）：
	◦	如果新光 RiskScore > 台新 RiskScore → 取兩邊較近的日期（即較早的那一個，MIN()）
	◦	否則 → 取台新的下審日

2. 完整驗證 SQL（推薦一次執行）
-- =============================================
-- TC06 下次審查日驗證 - 完整詳細版
-- =============================================

WITH 
-- 步驟1: 找出共有戶 (台新+新光都有紀錄)
Shared_Cust AS (
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG = '1'                    -- 台新客戶
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG IN ('2','3')             -- 排除純新光
),

-- 步驟2: 彙整所有相關資料
Cust_Review AS (
    SELECT 
        c.TS_CUST_ID,
        
        -- 台新系統資料
        b.CIF_KEY AS BSA_CIF_KEY,
        b.CustomerNo AS BSA_CustomerNo,
        b.NXTRVDT AS BSA_NXTRVDT,           -- 台新 下次審核日
        b.RiskScore AS BSA_RiskScore,        -- 台新 風險分數
        b.HIGHRISK AS BSA_HIGHRISK,
        
        -- 新光系統資料
        v.CIF_KEY AS VERIFY_CIF_KEY,
        v.CustomerNo AS VERIFY_CustomerNo,
        v.NXTRVDT AS VERIFY_NXTRVDT,         -- 新光 下次審核日
        v.RiskScore AS VERIFY_RiskScore,     -- 新光 風險分數
        v.HIGHRISK AS VERIFY_HIGHRISK,
        
        -- EDD 排程表（最終應採用此表）
        e.ReviewDt AS EDD_ReviewDt,
        e.CIFKey AS EDD_CIFKey,
        
        -- 風險比較結果
        CASE 
            WHEN b.RiskScore IS NULL AND v.RiskScore IS NULL THEN '無風險分數'
            WHEN v.RiskScore > b.RiskScore THEN '新光風險較高'
            WHEN v.RiskScore < b.RiskScore THEN '台新風險較高'
            ELSE '風險等級相同'
        END AS Risk_Compare

    FROM Shared_Cust c
    LEFT JOIN BSA_SUB_CUST_FACT b 
        ON c.TS_CUST_ID = b.CustomerNo
    LEFT JOIN VERIFY..BSA_SUB_CUST_FACT v 
        ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e 
        ON b.CIF_KEY = e.CIFKey          -- 以台新 CIF_KEY 為主關聯
)

-- 步驟3: 最終驗證結果
SELECT 
    TS_CUST_ID,
    BSA_CustomerNo,
    VERIFY_CustomerNo,
    
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,
    
    BSA_RiskScore,
    VERIFY_RiskScore,
    Risk_Compare,
    
    -- 【預期正確的下次審查日】
    CASE 
        WHEN Risk_Compare = '新光風險較高' 
            THEN (SELECT MIN(dt) 
                  FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
        ELSE COALESCE(BSA_NXTRVDT, EDD_ReviewDt)          -- 其他情況取台新
    END AS Expected_NextReviewDt,

    -- 【驗證結果】
    CASE 
        WHEN Risk_Compare = '新光風險較高' 
             AND EDD_ReviewDt = (SELECT MIN(dt) 
                                 FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN 'PASS'
        WHEN EDD_ReviewDt = COALESCE(BSA_NXTRVDT, EDD_ReviewDt)
            THEN 'PASS'
        ELSE 'FAIL'
    END AS Validation_Result,

    -- 額外診斷資訊
    CASE WHEN BSA_NXTRVDT IS NULL THEN '台新無下審日' ELSE '' END +
    CASE WHEN VERIFY_NXTRVDT IS NULL THEN ' 新光無下審日' ELSE '' END AS Note

FROM Cust_Review
ORDER BY Validation_Result DESC, TS_CUST_ID;

3. 分開查詢（方便除錯）
純台新客戶
SELECT b.CustomerNo, b.NXTRVDT, e.ReviewDt
FROM BSA_SUB_CUST_FACT b
LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
WHERE b.CustomerNo NOT IN (SELECT TS_CUST_ID FROM Shared_Cust);
純新光客戶
SELECT v.CustomerNo, v.NXTRVDT
FROM VERIFY..BSA_SUB_CUST_FACT v
WHERE v.CustomerNo NOT IN (SELECT TS_CUST_ID FROM Shared_Cust);

