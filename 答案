SQL 查詢（直接執行即可）
-- 新光風險等級高於台新的共有戶客戶清單
WITH Shared_Cust AS (
    SELECT 
        b.CustomerNo AS TS_CUST_ID,
        b.HIGHRISK AS BSA_HIGHRISK,      -- 台新風險等級
        v.HIGHRISK AS VERIFY_HIGHRISK,   -- 新光風險等級
        b.NXTRVDT AS 台新_下審日,
        v.NXTRVDT AS 新光_下審日,
        e.ReviewDt AS EDD_下審日
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v 
        ON b.CustomerNo = v.CustomerNo          -- 共有戶
    LEFT JOIN EDD_ReviewSchedule e 
        ON b.CIF_KEY = e.CIFKey
    WHERE v.HIGHRISK IS NOT NULL 
      AND b.HIGHRISK IS NOT NULL
)

SELECT 
    TS_CUST_ID AS 客戶帳號,
    BSA_HIGHRISK AS 台新_風險,
    VERIFY_HIGHRISK AS 新光_風險,
    台新_下審日,
    新光_下審日,
    EDD_下審日,
    CASE 
        WHEN VERIFY_HIGHRISK = 'H' AND BSA_HIGHRISK IN ('M','L') THEN '新光H > 台新'
        WHEN VERIFY_HIGHRISK = 'M' AND BSA_HIGHRISK = 'L' THEN '新光M > 台新L'
        ELSE '其他'
    END AS 風險比較說明
FROM Shared_Cust
WHERE 
    (VERIFY_HIGHRISK = 'H' AND BSA_HIGHRISK IN ('M','L')) 
    OR 
    (VERIFY_HIGHRISK = 'M' AND BSA_HIGHRISK = 'L')
ORDER BY 新光_風險 DESC, 台新_風險, TS_CUST_ID;

如果你想看統計（有幾筆）
-- 統計：新光風險高於台新共有幾筆
WITH Shared_Cust AS (
    SELECT 
        b.CustomerNo,
        b.HIGHRISK AS BSA_H,
        v.HIGHRISK AS VERIFY_H
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
)
SELECT 
    COUNT(*) AS 符合條件筆數,
    COUNT(CASE WHEN VERIFY_H = 'H' THEN 1 END) AS 新光H_高於台新,
    COUNT(CASE WHEN VERIFY_H = 'M' AND BSA_H = 'L' THEN 1 END) AS 新光M_高於台新L
FROM Shared_Cust
WHERE 
    (VERIFY_H = 'H' AND BSA_H IN ('M','L')) 
    OR (VERIFY_H = 'M' AND BSA_H = 'L');

