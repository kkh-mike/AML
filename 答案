TC06 共有戶下次審查日驗證 — 新手版（分步驟）
步驟 1：先找出共有戶（同時存在台新 + 新光）
-- 步驟1：找出共有戶
SELECT 
    b.CustomerNo AS TS_CUST_ID,
    b.HIGHRISK AS 台新_風險,
    v.HIGHRISK AS 新光_風險,
    b.NXTRVDT AS 台新_下審日,
    v.NXTRVDT AS 新光_下審日,
    e.ReviewDt AS EDD_下審日
FROM BSA_SUB_CUST_FACT b
INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
ORDER BY b.CustomerNo;

步驟 2：逐筆判斷（新手最推薦）
-- 步驟2：逐筆詳細驗證（最清楚！）
WITH Shared AS (
    SELECT 
        b.CustomerNo AS TS_CUST_ID,
        b.HIGHRISK AS BSA_HIGHRISK,
        v.HIGHRISK AS VERIFY_HIGHRISK,
        b.NXTRVDT AS BSA_NXTRVDT,
        v.NXTRVDT AS VERIFY_NXTRVDT,
        e.ReviewDt AS EDD_ReviewDt
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
)
SELECT 
    TS_CUST_ID,
    BSA_HIGHRISK,
    VERIFY_HIGHRISK,
    
    -- 新手友善欄位
    CASE 
        WHEN VERIFY_HIGHRISK = 'H' AND BSA_HIGHRISK IN ('M','L') THEN '新光風險較高'
        WHEN VERIFY_HIGHRISK = 'M' AND BSA_HIGHRISK = 'L' THEN '新光風險較高'
        ELSE '新光風險不高於台新'
    END AS 風險比較,

    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,

    -- 兩邊較近的日期（較早的那一天）
    CASE 
        WHEN BSA_NXTRVDT IS NULL OR VERIFY_NXTRVDT IS NULL THEN NULL
        ELSE (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt)) 
    END AS 應取的較近日期,

    -- 最終驗證結果
    CASE 
        WHEN VERIFY_HIGHRISK IN ('H','M') 
             AND BSA_HIGHRISK IN ('M','L') 
             AND VERIFY_HIGHRISK > BSA_HIGHRISK   -- 新光真的比較高
             AND EDD_ReviewDt = (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN '✅ PASS（正確取兩邊較近日期）'
        
        WHEN NOT (VERIFY_HIGHRISK > BSA_HIGHRISK) 
             AND EDD_ReviewDt = BSA_NXTRVDT
            THEN '✅ PASS（正確取台新日期）'
        
        ELSE '❌ FAIL'
    END AS 驗證結果

FROM Shared
ORDER BY 驗證結果 DESC, TS_CUST_ID;

步驟 3：統計總覽（一看就懂）
-- 步驟3：統計結果（新手最愛看）
WITH Shared AS (
    SELECT 
        b.CustomerNo,
        b.HIGHRISK AS BSA_H,
        v.HIGHRISK AS VERIFY_H,
        b.NXTRVDT,
        v.NXTRVDT,
        e.ReviewDt
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
)
SELECT 
    COUNT(*) AS 共有戶總數,
    
    SUM(CASE WHEN VERIFY_H > BSA_H THEN 1 ELSE 0 END) AS 需要取兩邊較近日期_筆數,
    
    SUM(CASE WHEN VERIFY_H > BSA_H 
             AND ReviewDt = (SELECT MIN(dt) FROM (VALUES (NXTRVDT), (v.NXTRVDT)) AS t(dt)) 
             THEN 1 ELSE 0 END) AS 實際正確取較近日期_筆數,
    
    SUM(CASE WHEN VERIFY_H > BSA_H 
             AND ReviewDt <> (SELECT MIN(dt) FROM (VALUES (NXTRVDT), (v.NXTRVDT)) AS t(dt)) 
             THEN 1 ELSE 0 END) AS 應該取但沒取_筆數

FROM Shared;

使用建議（新手流程）
	1	先跑 步驟1 看有幾筆共有戶。
	2	再跑 步驟2 逐筆檢查（推薦）。
	3	最後跑 步驟3 看整體統計。

