✅ 了解！風險等級使用 H (High)、M (Medium)、L (Low)
我已調整共有戶的驗證 SQL，使用正確的風險等級比較邏輯（而非直接字串比較）。
調整重點
	•	H > M > L（高風險優先）
	•	新光 HIGHRISK 高於台新時 → 取兩邊較近（較早）的日期 = MIN(BSA_NXTRVDT, VERIFY_NXTRVDT)

共有戶專用驗證 SQL（已修正風險比較）
-- =============================================
-- TC06 共有戶 下次審查日驗證 (H/M/L 風險等級)
-- =============================================

WITH 
-- 1. 共有戶列表
Shared_Cust AS (
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG = '1'
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG IN ('2','3')
),

-- 2. 資料彙整 + 風險等級轉換
Shared_Review AS (
    SELECT 
        c.TS_CUST_ID,
        
        -- 台新 (BSA)
        b.CIF_KEY AS BSA_CIF_KEY,
        b.CustomerNo AS BSA_CustomerNo,
        b.NXTRVDT AS BSA_NXTRVDT,
        b.HIGHRISK AS BSA_HIGHRISK,
        
        -- 新光 (VERIFY)
        v.CIF_KEY AS VERIFY_CIF_KEY,
        v.CustomerNo AS VERIFY_CustomerNo,
        v.NXTRVDT AS VERIFY_NXTRVDT,
        v.HIGHRISK AS VERIFY_HIGHRISK,
        
        -- EDD 排程
        e.ReviewDt AS EDD_ReviewDt,

        -- 風險等級數值轉換 (H=3, M=2, L=1)
        CASE b.HIGHRISK 
            WHEN 'H' THEN 3 
            WHEN 'M' THEN 2 
            WHEN 'L' THEN 1 
            ELSE 0 
        END AS BSA_RiskLevel,

        CASE v.HIGHRISK 
            WHEN 'H' THEN 3 
            WHEN 'M' THEN 2 
            WHEN 'L' THEN 1 
            ELSE 0 
        END AS VERIFY_RiskLevel

    FROM Shared_Cust c
    LEFT JOIN BSA_SUB_CUST_FACT b ON c.TS_CUST_ID = b.CustomerNo
    LEFT JOIN VERIFY..BSA_SUB_CUST_FACT v ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
    WHERE b.CustomerNo IS NOT NULL OR v.CustomerNo IS NOT NULL
)

-- 3. 最終驗證
SELECT 
    TS_CUST_ID,
    BSA_CustomerNo,
    VERIFY_CustomerNo,
    
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,
    
    BSA_HIGHRISK,
    VERIFY_HIGHRISK,
    BSA_RiskLevel,
    VERIFY_RiskLevel,

    -- 風險比較結果
    CASE 
        WHEN VERIFY_RiskLevel > BSA_RiskLevel THEN '新光風險較高 → 應取較近日期'
        WHEN VERIFY_RiskLevel < BSA_RiskLevel THEN '台新風險較高 → 應取台新日期'
        WHEN VERIFY_RiskLevel = BSA_RiskLevel THEN '風險等級相同'
        ELSE '風險等級有 NULL 或異常'
    END AS Risk_Compare,

    -- 預期正確的下審日
    CASE 
        WHEN VERIFY_RiskLevel > BSA_RiskLevel 
            THEN (SELECT MIN(dt) 
                  FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
        ELSE COALESCE(BSA_NXTRVDT, EDD_ReviewDt)
    END AS Expected_NextReviewDt,

    -- 驗證結果
    CASE 
        WHEN VERIFY_RiskLevel > BSA_RiskLevel 
             AND EDD_ReviewDt = (SELECT MIN(dt) 
                                 FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN 'PASS'
        WHEN EDD_ReviewDt = COALESCE(BSA_NXTRVDT, EDD_ReviewDt)
            THEN 'PASS'
        ELSE 'FAIL'
    END AS Validation_Result,

    DATEDIFF(DAY, BSA_NXTRVDT, VERIFY_NXTRVDT) AS Date_Diff_Days

FROM Shared_Review
ORDER BY Validation_Result DESC, TS_CUST_ID;

