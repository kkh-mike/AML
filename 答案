✅ 共有戶（Shared Customers）專用驗證 SQL — 詳細版
以下 SQL 只處理共有戶，並針對你的規則進行驗證：
共有戶的下審日：若新光（VERIFY）風險等級高於台新（BSA），則下審日必須取兩邊較近的日期（即較早的日期 = MIN(BSA_NXTRVDT, VERIFY_NXTRVDT)）
風險等級使用 HIGHRISK 欄位。
完整驗證 SQL（共有戶專用）
-- =============================================
-- TC06 共有戶 下次審查日驗證
-- =============================================

WITH 
-- 1. 共有戶列表
Shared_Cust AS (
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG = '1'                    -- 台新客戶
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG IN ('2','3')             -- 排除純新光
),

-- 2. 資料彙整
Shared_Review AS (
    SELECT 
        c.TS_CUST_ID,
        
        -- 台新 (BSA)
        b.CIF_KEY AS BSA_CIF_KEY,
        b.CustomerNo AS BSA_CustomerNo,
        b.NXTRVDT AS BSA_NXTRVDT,           -- 台新 下次審核日
        b.HIGHRISK AS BSA_HIGHRISK,          -- 台新 風險等級
        
        -- 新光 (VERIFY)
        v.CIF_KEY AS VERIFY_CIF_KEY,
        v.CustomerNo AS VERIFY_CustomerNo,
        v.NXTRVDT AS VERIFY_NXTRVDT,         -- 新光 下次審核日
        v.HIGHRISK AS VERIFY_HIGHRISK,       -- 新光 風險等級
        
        -- EDD 最終排程表
        e.ReviewDt AS EDD_ReviewDt,
        e.CIFKey AS EDD_CIFKey

    FROM Shared_Cust c
    LEFT JOIN BSA_SUB_CUST_FACT b 
        ON c.TS_CUST_ID = b.CustomerNo
    LEFT JOIN VERIFY..BSA_SUB_CUST_FACT v 
        ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e 
        ON b.CIF_KEY = e.CIFKey                  -- 以台新 CIF_KEY 為主
    WHERE b.CustomerNo IS NOT NULL 
       OR v.CustomerNo IS NOT NULL
)

-- 3. 最終驗證結果
SELECT 
    TS_CUST_ID,
    BSA_CustomerNo,
    VERIFY_CustomerNo,
    
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,
    
    BSA_HIGHRISK,
    VERIFY_HIGHRISK,
    
    -- 風險比較
    CASE 
        WHEN VERIFY_HIGHRISK > BSA_HIGHRISK THEN '新光風險較高 → 應取較近日期'
        WHEN VERIFY_HIGHRISK < BSA_HIGHRISK THEN '台新風險較高 → 應取台新日期'
        WHEN VERIFY_HIGHRISK = BSA_HIGHRISK THEN '風險等級相同'
        ELSE '風險等級有 NULL'
    END AS Risk_Compare,

    -- 預期正確的下審日
    CASE 
        WHEN VERIFY_HIGHRISK > BSA_HIGHRISK 
            THEN (SELECT MIN(dt) 
                  FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))   -- 取較早日期
        ELSE COALESCE(BSA_NXTRVDT, EDD_ReviewDt)                           -- 其他情況取台新
    END AS Expected_NextReviewDt,

    -- 驗證結果
    CASE 
        WHEN VERIFY_HIGHRISK > BSA_HIGHRISK 
             AND EDD_ReviewDt = (SELECT MIN(dt) 
                                 FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN 'PASS'   -- 正確取較近日期
        WHEN EDD_ReviewDt = COALESCE(BSA_NXTRVDT, EDD_ReviewDt)
            THEN 'PASS'
        ELSE 'FAIL'
    END AS Validation_Result,

    -- 診斷資訊
    DATEDIFF(DAY, BSA_NXTRVDT, VERIFY_NXTRVDT) AS Date_Diff_Days,
    CASE WHEN BSA_NXTRVDT IS NULL THEN '台新無日期' ELSE '' END +
    CASE WHEN VERIFY_NXTRVDT IS NULL THEN ' 新光無日期' ELSE '' END AS Note

FROM Shared_Review
ORDER BY Validation_Result DESC, TS_CUST_ID;

