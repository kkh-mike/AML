✅ 了解 TC06 下次審查日驗證邏輯
我已參考你的 GitHub BSADBTW 目錄下的表格結構（BSA_SUB_CUST_FACT、PB_CUSTOMER_FACT、EDD_ReviewSchedule 等）。
核心邏輯總結
	•	純台新：直接用台新（BSA / PB）的 NXTRVDT 或 EDD_ReviewSchedule.ReviewDt
	•	純新光：直接用新光（VERIFY 或 BANCS_SK）的下審日
	•	共有戶：
	◦	如果新光風險等級 > 台新風險等級 → 取兩邊較近的日期（較早的那個）
	◦	否則 → 取台新的下審日

完整驗證 SQL（分三類）
-- =============================================
-- TC06 下次審查日驗證
-- =============================================

WITH 
-- 1. 共有戶列表
Shared_Cust AS (
    SELECT TS_CUST_ID
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG = '1'
    EXCEPT
    SELECT TS_CUST_ID 
    FROM BANCS_SK_CUST_INFO 
    WHERE CUST_RE_NO_FLG IN ('2','3')
),

-- 2. 主資料彙整
Cust_Review AS (
    SELECT 
        c.TS_CUST_ID,
        b.CIF_KEY AS BSA_CIF_KEY,
        v.CIF_KEY AS VERIFY_CIF_KEY,
        b.NXTRVDT AS BSA_NXTRVDT,           -- 台新 BSA 下次審核日
        v.NXTRVDT AS VERIFY_NXTRVDT,         -- 新光 VERIFY 下次審核日
        b.RiskScore AS BSA_RiskScore,        -- 台新風險分數
        v.RiskScore AS VERIFY_RiskScore,     -- 新光風險分數
        e.ReviewDt AS EDD_ReviewDt,          -- EDD 排程的下審日
        CASE 
            WHEN b.RiskScore IS NULL OR v.RiskScore IS NULL THEN '純台新或純新光'
            WHEN v.RiskScore > b.RiskScore THEN '新光風險較高'
            ELSE '台新風險較高或相等'
        END AS Risk_Compare
    FROM Shared_Cust c
    LEFT JOIN BSA_SUB_CUST_FACT b ON c.TS_CUST_ID = b.CustomerNo
    LEFT JOIN VERIFY..BSA_SUB_CUST_FACT v ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey   -- 以台新 CIF_KEY 為主
)

-- =============================================
-- 最終驗證結果
SELECT 
    TS_CUST_ID,
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,
    Risk_Compare,
    
    -- 預期下次審查日（根據規則計算）
    CASE 
        -- 共有戶：新光風險較高 → 取較近日期
        WHEN Risk_Compare = '新光風險較高' 
            THEN (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
        
        -- 其他共有戶 + 純台新 → 取台新日期
        ELSE COALESCE(BSA_NXTRVDT, EDD_ReviewDt)
    END AS Expected_NextReviewDt,

    -- 實際是否正確
    CASE 
        WHEN Risk_Compare = '新光風險較高' AND EDD_ReviewDt = (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN 'PASS'
        WHEN EDD_ReviewDt = COALESCE(BSA_NXTRVDT, EDD_ReviewDt)
            THEN 'PASS'
        ELSE 'FAIL'
    END AS Validation_Result

FROM Cust_Review
ORDER BY Validation_Result DESC, TS_CUST_ID;

分類獨立驗證（如果你想分開看）
1. 純台新客戶
SELECT ... 
FROM BSA_SUB_CUST_FACT b
WHERE b.CustomerNo NOT IN (SELECT TS_CUST_ID FROM Shared_Cust)
2. 純新光客戶
SELECT ... 
FROM VERIFY..BSA_SUB_CUST_FACT v
WHERE v.CustomerNo NOT IN (SELECT TS_CUST_ID FROM Shared_Cust)
3. 共有戶（上面主查詢已經處理）

