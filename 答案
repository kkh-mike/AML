完整 SQL（共有戶 + 統計摘要）
-- =============================================
-- TC06 共有戶 下次審查日驗證 + 統計
-- =============================================

WITH 
-- 1. 嚴格共有戶（兩邊都要有資料）
Shared_Cust AS (
    SELECT b.CustomerNo AS TS_CUST_ID
    FROM BSA_SUB_CUST_FACT b
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON b.CustomerNo = v.CustomerNo
),

-- 2. 詳細資料
Shared_Review AS (
    SELECT 
        c.TS_CUST_ID,
        b.NXTRVDT AS BSA_NXTRVDT,
        v.NXTRVDT AS VERIFY_NXTRVDT,
        e.ReviewDt AS EDD_ReviewDt,
        b.HIGHRISK AS BSA_HIGHRISK,
        v.HIGHRISK AS VERIFY_HIGHRISK,
        
        CASE b.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END AS BSA_RiskLevel,
        CASE v.HIGHRISK WHEN 'H' THEN 3 WHEN 'M' THEN 2 WHEN 'L' THEN 1 ELSE 0 END AS VERIFY_RiskLevel

    FROM Shared_Cust c
    INNER JOIN BSA_SUB_CUST_FACT b ON c.TS_CUST_ID = b.CustomerNo
    INNER JOIN VERIFY..BSA_SUB_CUST_FACT v ON c.TS_CUST_ID = v.CustomerNo
    LEFT JOIN EDD_ReviewSchedule e ON b.CIF_KEY = e.CIFKey
)

-- 3. 明細資料（可選查看）
SELECT 
    TS_CUST_ID,
    BSA_NXTRVDT,
    VERIFY_NXTRVDT,
    EDD_ReviewDt,
    BSA_HIGHRISK,
    VERIFY_HIGHRISK,
    CASE WHEN VERIFY_RiskLevel > BSA_RiskLevel THEN '是' ELSE '否' END AS Should_Take_Min_Date,
    CASE 
        WHEN VERIFY_RiskLevel > BSA_RiskLevel 
             AND EDD_ReviewDt = (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt))
            THEN '✅ 有取較近日期'
        ELSE '否'
    END AS Actually_Took_Min_Date
FROM Shared_Review
ORDER BY (CASE WHEN VERIFY_RiskLevel > BSA_RiskLevel THEN 1 ELSE 0 END) DESC, TS_CUST_ID;

-- =============================================
-- 4. 統計摘要（重點！）
-- =============================================
SELECT 
    COUNT(*) AS 共有戶總筆數,
    
    SUM(CASE WHEN VERIFY_RiskLevel > BSA_RiskLevel THEN 1 ELSE 0 END) AS 應取兩邊較近日期_筆數,
    
    SUM(CASE WHEN VERIFY_RiskLevel > BSA_RiskLevel 
             AND EDD_ReviewDt = (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt)) 
             THEN 1 ELSE 0 END) AS 實際有取兩邊較近日期_筆數,
    
    SUM(CASE WHEN VERIFY_RiskLevel > BSA_RiskLevel 
             AND EDD_ReviewDt <> (SELECT MIN(dt) FROM (VALUES (BSA_NXTRVDT), (VERIFY_NXTRVDT)) AS t(dt)) 
             THEN 1 ELSE 0 END) AS 應取但沒取較近日期_筆數

FROM Shared_Review;

