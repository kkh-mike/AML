查詢 1：確認你關心的那筆資料有沒有進到 GROUPID=10
SELECT 
    spec_name, IDNUM, ADDRESS, DInd, updated_date, remark
FROM BSADB.dbo.OFAC_GLSpec 
WHERE GROUPID = 10 
  AND DInd = 'N'
  AND (spec_name LIKE '%0x931846D9%' OR spec_name LIKE '%MX%' OR IDNUM LIKE '%你要找的關鍵字%')
查詢 2：檢查 Dow Jones 裡那筆資料的條件
SELECT 
    A.EntityId,
    B.Description2,
    B.Description3,
    D.IdentificationType,
    D.IdentificationNumber,
    A.PersonStatus
FROM BSADB.dbo.DJ_Entity A
JOIN BSADB.dbo.DJ_ListCategory B ON A.EntityId = B.EntityId
LEFT JOIN BSADB.dbo.DJ_IdentificationTypeInfo D ON A.EntityId = D.EntityId
WHERE D.IdentificationNumber LIKE '%0x931846D9%'   -- 或換成你那串關鍵字
   OR A.EntityId = 你懷疑的 EntNum
