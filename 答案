SELECT 
    spec_name,
    IDNUM,
    IDENT,
    remark,
    REPLACE(ADDRESS, '; Please go to Dowjones website for more detail', '') AS IdentificationType,
    DInd,
    STATE,
    updated_date,
    EnterFlag
FROM BSADB.dbo.OFAC_GLSpec 
WHERE GROUPID = 10
  AND DInd = 'N'
  AND IDNUM IS NOT NULL 
  AND IDNUM <> ''
  AND REPLACE(ADDRESS, '; Please go to Dowjones website for more detail', '') <> 'Others'
ORDER BY updated_date DESC;